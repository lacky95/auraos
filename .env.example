# AuraOS Environment Variables

# Paths
AURA_APPS_DIR=/workspace/apps
AURA_DATA_DIR=/data
AURA_BASE_ROOTFS=/os/base-rootfs
AURA_TOOLCHAIN_DIR=/os/toolchain

# App port range (allocated to PRoot app servers)
AURA_APP_PORT_START=4001
AURA_APP_PORT_END=4999

# Shell server port
AURA_SHELL_PORT=3000

# Auth mode: none | token | multi-user
AURA_AUTH_MODE=none

# Multi-master (optional — leave empty for single-master)
AURA_NODE_ID=
AURA_VALKEY_URL=

# macOS note: the compose bind of /var/run/docker.sock is resolved INSIDE the
# Linux VM (Docker Desktop / Rancher Desktop / OrbStack), so no compose change
# is needed. But the host CLI needs DOCKER_HOST when no /var/run/docker.sock
# symlink exists on the host — e.g. Rancher Desktop without admin access:
#   export DOCKER_HOST="unix://$HOME/.rd/docker.sock"
# Docker Desktop: export DOCKER_HOST="unix://$HOME/.docker/run/docker.sock"
