# AuraOS Environment Variables

# Paths
AURA_APPS_DIR=/workspace/apps
AURA_DATA_DIR=/data
AURA_BASE_ROOTFS=/os/base-rootfs
AURA_TOOLCHAIN_DIR=/os/toolchain

# App port range (allocated to PRoot app servers)
AURA_APP_PORT_START=4001
AURA_APP_PORT_END=4999

# Shell server port
AURA_SHELL_PORT=3000

# Auth mode: none | token | multi-user
AURA_AUTH_MODE=none

# Multi-master (optional — leave empty for single-master)
AURA_NODE_ID=
AURA_REDIS_URL=
