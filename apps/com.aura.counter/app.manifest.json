{
  "id": "com.aura.counter",
  "name": "Counter",
  "icon": "CT",
  "version": "0.1.0",
  "description": "Per-instance counter. Demonstrates multi×multi: each instance has its own counter; activities on the same instance share it.",
  "category": "utility",
  "permissions": [],
  "tools": ["bash", "node"],
  "sandbox": "container",
  "instanceMode": "multi",
  "maxInstances": 5,
  "activityMode": "multi",
  "maxActivitiesPerInstance": 4,
  "viewConfig": {
    "defaultWidth": 360,
    "defaultHeight": 300,
    "resizable": true
  },
  "preferredLayout": "tiling"
}
