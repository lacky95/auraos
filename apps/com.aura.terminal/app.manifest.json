{
  "id": "com.aura.terminal",
  "name": "Terminal",
  "icon": "T",
  "version": "0.1.0",
  "description": "System terminal with AI toolchain access",
  "category": "system",
  "permissions": [
    "storage.read",
    "storage.write",
    "network.local",
    "apps.mount"
  ],
  "tools": [
    "*",
    "aura",
    "bash",
    "git",
    "node",
    "claude-code",
    "adb"
  ],
  "instanceMode": "multi",
  "maxInstances": 4,
  "activityMode": "multi",
  "defaultLaunch": "new-activity",
  "warmPool": 1,
  "backgroundService": true,
  "sandbox": "container",
  "viewConfig": {
    "defaultWidth": 800,
    "defaultHeight": 500,
    "resizable": true
  },
  "preferredLayout": "tiling"
}
