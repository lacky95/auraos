{
  "id": "com.aura.terminal",
  "name": "Terminal",
  "icon": "T",
  "version": "0.1.0",
  "description": "System terminal with AI toolchain access",
  "category": "system",
  "permissions": [
    "storage.read",
    "storage.write",
    "network.local",
    "apps.mount"
  ],
  "tools": [
    "*",
    "aura",
    "bash",
    "git",
    "node",
    "claude-code",
    "adb"
  ],
  "provides": [
    {
      "name": "terminal",
      "kind": "mcp",
      "address": "/mcp/terminal",
      "version": "1",
      "description": "MCP over terminal sessions on every terminal instance: list/open/kill sessions, read the screen as a text grid (cursor, alternate-screen mode, scrollback), type text and send keys."
    }
  ],
  "instanceMode": "multi",
  "maxInstances": 4,
  "activityMode": "multi",
  "defaultLaunch": "new-activity",
  "warmPool": 1,
  "backgroundService": true,
  "sandbox": "container",
  "viewConfig": {
    "defaultWidth": 800,
    "defaultHeight": 500,
    "resizable": true
  },
  "preferredLayout": "tiling"
}
