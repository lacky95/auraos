---
const appId = Astro.request.headers.get('x-aura-app-id') ?? 'com.aura.terminal';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Terminal — AuraOS</title>
  <!--
    Self-hosted xterm under public/vendor/xterm/. Served by the app's own
    astro dev (loopback inside the container), proxied through the shell.
    Eliminates the ~300-500 ms cold-load CDN round-trip to jsdelivr and
    removes a third-party SPOF.
  -->
  <link rel="stylesheet" href="vendor/xterm/xterm.min.css" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: #0a0a0a;
      color: #ccffcc;
      font-family: 'Courier New', monospace;
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    #terminal-bar {
      display: flex;
      align-items: center;
      padding: 0 12px;
      height: 24px;
      background: #111;
      border-bottom: 1px solid rgba(0,255,65,.2);
      font-size: 0.7rem;
      color: #557755;
      text-transform: uppercase;
      letter-spacing: .1em;
      flex-shrink: 0;
    }
    #terminal-bar span { color: #00ff41; margin-right: 8px; }
    #terminal-bar #ws-url {
      color: #557755;
      font-size: 0.6rem;
      letter-spacing: 0.04em;
      text-transform: none;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      min-width: 0;
    }
    #terminal { flex: 1; padding: 4px; overflow: hidden; }
    .xterm { height: 100%; }
    .xterm-viewport { background: #0a0a0a !important; }
    #status {
      padding: 2px 12px;
      font-size: 0.65rem;
      color: #557755;
      background: #111;
      border-top: 1px solid rgba(0,255,65,.1);
      flex-shrink: 0;
    }
  </style>
</head>
<body>
  <div id="terminal-bar">
    <span>></span> AURA TERMINAL
    <span id="ws-url" title="WebSocket endpoint" style="margin-left: 2em;"></span>
    <span style="margin-left:auto;" id="conn-status">CONNECTING...</span>
  </div>
  <div id="terminal"></div>

  <script is:inline src="vendor/xterm/xterm.min.js"></script>
  <script is:inline src="vendor/xterm/xterm-addon-fit.min.js"></script>
  <script is:inline define:vars={{ appId }}>
    const term = new Terminal({
      theme: {
        background:  '#0a0a0a',
        foreground:  '#ccffcc',
        cursor:      '#00ff41',
        cursorAccent:'#0a0a0a',
        selectionBackground: 'rgba(0,255,65,.3)',
        black:   '#0a0a0a', brightBlack:   '#557755',
        red:     '#ff2020', brightRed:     '#ff4444',
        green:   '#00ff41', brightGreen:   '#00ff41',
        yellow:  '#ff9900', brightYellow:  '#ffbb00',
        blue:    '#0088ff', brightBlue:    '#44aaff',
        magenta: '#ff00ff', brightMagenta: '#ff44ff',
        cyan:    '#00ffff', brightCyan:    '#44ffff',
        white:   '#ccffcc', brightWhite:   '#ffffff',
      },
      fontFamily: "'Courier New', monospace",
      fontSize: 14,
      cursorBlink: true,
      allowProposedApi: true,
    });

    const fitAddon = new FitAddon.FitAddon();
    term.loadAddon(fitAddon);
    term.open(document.getElementById('terminal'));
    fitAddon.fit();

    const statusEl = document.getElementById('conn-status');
    const wsProto = location.protocol === 'https:' ? 'wss:' : 'ws:';
    const wsUrl = `${wsProto}//${location.host}/api/proxy/${appId}/ws`;
    document.getElementById('ws-url').textContent = wsUrl;

    // ANSI color helpers — xterm.js parses these inline.
    const GRN  = '\x1b[38;5;82m';  // bright green
    const DIM  = '\x1b[38;5;65m';  // dim green
    const ORG  = '\x1b[38;5;208m'; // orange (warn)
    const RED  = '\x1b[38;5;196m'; // red (error)
    const RST  = '\x1b[0m';
    const BOLD = '\x1b[1m';

    // Pre-WS splash so the terminal isn't a blank black box while the PTY
    // backend boots. We write into the xterm itself (no extra DOM), then
    // clear the screen the moment the WS opens and the PTY takes over.
    function writeSplash() {
      term.write('\x1b[2J\x1b[H'); // clear + home
      term.writeln(`${GRN}${BOLD}  ╭──────────────────────────────╮${RST}`);
      term.writeln(`${GRN}${BOLD}  │      A U R A   T E R M       │${RST}`);
      term.writeln(`${GRN}${BOLD}  ╰──────────────────────────────╯${RST}`);
      term.writeln('');
      term.writeln(`${DIM}  app      ${RST}${appId}`);
      term.writeln('');
    }
    writeSplash();

    let dotsTimer  = null;
    let dotsLine   = '';
    function startDots(label) {
      stopDots();
      let n = 0;
      const render = () => {
        const dots = '.'.repeat(n % 4);
        // \r returns to column 0; pad to overwrite previous longer line.
        const text = `${DIM}  ${label}${dots}${RST}`;
        term.write(`\r\x1b[2K${text}`);
        dotsLine = text;
        n++;
      };
      render();
      dotsTimer = setInterval(render, 350);
    }
    function stopDots() {
      if (dotsTimer) clearInterval(dotsTimer);
      dotsTimer = null;
    }

    startDots('connecting to pty');

    let attempt = 0;
    function connect() {
      attempt++;
      const ws = new WebSocket(wsUrl);
      let opened = false;

      ws.onopen = () => {
        opened = true;
        stopDots();
        statusEl.textContent = 'CONNECTED';
        statusEl.style.color = '#00ff41';
        // Clear the splash up-front, BEFORE the resize/PTY output arrives.
        // (Earlier we did this on a 120ms timer which raced with the bash
        // prompt and sometimes wiped the prompt itself — leaving the user
        // staring at an empty blinking cursor.)
        term.write('\x1b[2J\x1b[H');
        ws.send(JSON.stringify({ type: 'resize', cols: term.cols, rows: term.rows }));
      };

      ws.onmessage = (e) => term.write(e.data);

      ws.onclose = () => {
        statusEl.textContent = 'DISCONNECTED — RECONNECTING...';
        statusEl.style.color = '#ff9900';
        if (opened) {
          // Was connected, now dropped — surface in-band.
          term.writeln('');
          term.writeln(`${ORG}  [disconnected — reconnecting]${RST}`);
          startDots('reconnecting');
        } else {
          // Never connected this attempt; keep the connecting animation
          // but bump it to a "retry" label so the user sees something is happening.
          startDots(`retry ${attempt}`);
        }
        setTimeout(connect, 2000);
      };

      ws.onerror = () => {
        statusEl.textContent = 'ERROR';
        statusEl.style.color = '#ff2020';
        if (!opened) {
          // Connection refused / handshake error — surface inline so the
          // user knows it's not just a black screen.
          term.write(`\r\x1b[2K${RED}  ws error — retrying${RST}\r\n`);
        }
      };

      term.onData((data) => ws.readyState === 1 && ws.send(JSON.stringify({ type: 'data', data })));
    }

    connect();

    const resizeObs = new ResizeObserver(() => fitAddon.fit());
    resizeObs.observe(document.getElementById('terminal'));

    window.addEventListener('resize', () => fitAddon.fit());
  </script>
</body>
</html>
