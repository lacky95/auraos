---
const appId = Astro.request.headers.get('x-aura-app-id') ?? 'com.aura.terminal';
// Pre-prompt placeholder for the session-host indicator: the AuraOS master
// host name. We avoid os.hostname() because the container runs with
// `--hostname <appId>`, so that would render the package id. The live value
// arrives via term.onTitleChange once the shell emits its first OSC title —
// and follows the user as they `aura jump` between sandboxes.
const sessionHost = process.env['AURA_SHELL_HOSTNAME'] ?? 'aura-shell';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Terminal — AuraOS</title>
  <!--
    xterm.js is bundled from npm (@xterm/xterm + @xterm/addon-fit) by the app's
    own Vite build — the module <script> at the end of <body> imports the library
    and its CSS. No CDN, no hand-vendored files: upgrades are tracked in
    package.json and the bundle is served (minified, hashed) by the app itself,
    proxied through the shell like every other asset.
  -->
  <!-- /api/os/theme.css is auto-injected by the proxy for themeStrategy='inherit'
       apps (the default). The explicit link below is harmless and survives
       direct curl/headless renders that don't go through the proxy. -->
  <link rel="stylesheet" href="/api/os/theme.css" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: var(--aura-color-bg);
      color: var(--aura-color-text);
      font-family: var(--aura-font-mono, 'Courier New', monospace);
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    #terminal-bar {
      display: flex;
      align-items: center;
      padding: 0 12px;
      height: 24px;
      background: var(--aura-color-surface);
      border-bottom: 1px solid var(--aura-color-border);
      font-size: 0.7rem;
      color: var(--aura-color-text-dim);
      text-transform: uppercase;
      letter-spacing: .1em;
      flex-shrink: 0;
    }
    #terminal-bar span { color: var(--aura-color-primary); margin-right: 8px; }
    #terminal-bar #ws-url {
      color: var(--aura-color-text-dim);
      font-size: 0.6rem;
      letter-spacing: 0.04em;
      text-transform: none;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      min-width: 0;
    }
    /* Hidden until the first authoritative fit reveals it (see revealTerminal),
       so the user never sees the grid resize from its initial guess to the
       final column count — the boot fit happens behind the curtain. */
    /* Extra 3px on the bottom so the last row never sits flush against the
       slot's bottom edge (it was occasionally clipped there). chromeInset()
       measures this padding, so the row count adjusts automatically. */
    #terminal { flex: 1; padding: 4px 4px 7px; overflow: hidden; visibility: hidden; }
    .xterm { height: 100%; }
    .xterm-viewport { background: var(--aura-color-bg) !important; }
    /* xterm flips `.xterm-screen` to `cursor: crosshair` whenever Alt is
       held over the terminal — a hint that Alt+drag does column
       selection. That hint fires for every Alt-bearing OS shortcut
       (Ctrl+Alt+Space etc.) and looks like our intercept misfired even
       though it didn't. Override back to the text I-beam; Alt+drag
       still selects columns, just without the visual cue. */
    .xterm .xterm-screen,
    .xterm-screen-mouse,
    .xterm.column-select { cursor: text !important; }
    #status {
      padding: 2px 12px;
      font-size: 0.65rem;
      color: var(--aura-color-text-dim);
      background: var(--aura-color-surface);
      border-top: 1px solid var(--aura-color-border);
      flex-shrink: 0;
    }
    /* Quick-commands sidebar — structural/layout only (static elements, so
       scoped CSS reaches them like the bar). All BUTTONS are styled inline
       (see markup + qcRender) because scoped CSS proved unreliable for
       <button>s and the command buttons are built via innerHTML (no scope
       attr). Slides in from the left over the console. */
    #qc-panel {
      position: fixed;
      top: 24px; left: 0; bottom: 0;
      width: 280px; max-width: 80%;
      display: flex;
      flex-direction: column;
      background: var(--aura-color-surface);
      border-right: 1px solid var(--aura-color-border);
      box-shadow: 4px 0 18px rgba(0, 0, 0, 0.45);
      transform: translateX(-100%);
      transition: transform .18s ease-out;
      z-index: 50;
      overflow: hidden;
    }
    #qc-panel[aria-hidden="false"] { transform: translateX(0); }
    #qc-panel .qc-head {
      display: flex;
      align-items: center;
      gap: 5px;
      height: 24px;
      padding: 0 6px 0 10px;
      border-bottom: 1px solid var(--aura-color-border);
      color: var(--aura-color-text-dim);
      text-transform: uppercase;
      letter-spacing: .12em;
      font-size: 0.6rem;
      flex-shrink: 0;
    }
    #qc-list {
      flex: 1;
      list-style: none;
      margin: 0;
      padding: 6px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    #qc-add {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 6px;
      border-top: 1px solid var(--aura-color-border);
      flex-shrink: 0;
    }
    #qc-add input {
      box-sizing: border-box;
      width: 100%;
      background: var(--aura-color-bg);
      color: var(--aura-color-text);
      border: 1px solid var(--aura-color-border);
      padding: 4px 6px;
      font-family: var(--aura-font-mono, 'Courier New', monospace);
      font-size: 0.7rem;
      outline: none;
    }
    #qc-add input:focus { border-color: var(--aura-color-primary); }
  </style>
</head>
<body>
  <div id="terminal-bar">
    <button id="qc-toggle" type="button" title="Quick commands"
            style="appearance:none;-webkit-appearance:none;display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:22px;height:18px;padding:0 6px;margin-right:8px;border:1px solid var(--aura-color-border,rgba(0,255,65,0.2));border-radius:0;background:transparent;color:var(--aura-color-primary,#00ff41);font-family:var(--aura-font-mono,'Courier New',monospace);font-size:0.8rem;line-height:1;cursor:pointer;outline:none;">⚡</button>
    <span id="ws-url" title="Session host" style="margin-left: 2em;">{sessionHost}</span>
    <span style="margin-left:auto;" id="conn-status">CONNECTING...</span>
  </div>
  <div id="terminal" data-app-id={appId}></div>

  <!-- Shown INSTEAD of the terminal while another browser view holds this
       session (driven by the server's control frames — see the ws.onmessage
       demux). The window and all its other state stay exactly as they are;
       only the live terminal moves. Styled inline for the same reason the
       bar's buttons are: Astro's scoped CSS proved unreliable for elements
       inside the proxied app iframe, and inline styles never depend on a
       scope attribute landing. -->
  <div id="session-lock" role="status" aria-live="polite"
       style="display:none;flex:1;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:24px;text-align:center;">
    <div style="font-size:0.95rem;line-height:1;letter-spacing:.18em;text-transform:uppercase;color:var(--aura-color-primary,#00ff41);">Terminal</div>
    <div style="font-size:0.8rem;letter-spacing:.04em;color:var(--aura-color-text,#ccffcc);">This terminal is in use somewhere else.</div>
    <div style="display:flex;flex-direction:column;align-items:center;gap:5px;">
      <button id="lock-claim" type="button"
              style="appearance:none;-webkit-appearance:none;box-sizing:border-box;padding:7px 14px;border:1px solid var(--aura-color-primary,#00ff41);border-radius:0;background:transparent;color:var(--aura-color-primary,#00ff41);font-family:var(--aura-font-mono,'Courier New',monospace);font-size:0.7rem;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;outline:none;transition:color .1s,background .1s,box-shadow .1s;">Use terminal here</button>
      <!-- Decorative separator between the two actions. aria-hidden so it is
           never read out as content between two buttons. -->
      <div aria-hidden="true" style="font-size:0.62rem;line-height:1;color:var(--aura-color-text-dim,#557755);">·</div>
      <!-- Deliberately the quiet one: dim border + dim text, and it never
           fills on hover the way the primary action does. Same job, wider
           blast radius, so it shouldn't compete for the click. -->
      <button id="lock-claim-all" type="button"
              title="Bring every terminal session to this browser"
              style="appearance:none;-webkit-appearance:none;box-sizing:border-box;padding:5px 12px;border:1px solid var(--aura-color-border,rgba(0,255,65,0.2));border-radius:0;background:transparent;color:var(--aura-color-text-dim,#557755);font-family:var(--aura-font-mono,'Courier New',monospace);font-size:0.62rem;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;outline:none;transition:color .1s,border-color .1s;">Use all terminals here</button>
    </div>
    <div style="max-width:44ch;font-size:0.62rem;line-height:1.6;color:var(--aura-color-text-dim,#557755);">
      The session keeps running either way. Taking it over here hides the
      terminal in the other browser — that window stays open.
    </div>
  </div>

  <!-- Quick-commands sidebar: slides in from the left over the console. -->
  <aside id="qc-panel" aria-hidden="true">
    <div class="qc-head">
      <span>QUICK COMMANDS</span>
      <button id="qc-edit" type="button" title="Edit: add / rename / remove"
              style="appearance:none;-webkit-appearance:none;display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:20px;height:18px;margin-left:auto;padding:0 5px;border:1px solid var(--aura-color-border,rgba(0,255,65,0.2));border-radius:0;background:transparent;color:var(--aura-color-primary,#00ff41);font-family:var(--aura-font-mono,'Courier New',monospace);font-size:0.72rem;line-height:1;cursor:pointer;outline:none;">✎</button>
      <button id="qc-close" type="button" title="Close"
              style="appearance:none;-webkit-appearance:none;display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:20px;height:18px;padding:0 5px;border:1px solid var(--aura-color-border,rgba(0,255,65,0.2));border-radius:0;background:transparent;color:var(--aura-color-primary,#00ff41);font-family:var(--aura-font-mono,'Courier New',monospace);font-size:0.72rem;line-height:1;cursor:pointer;outline:none;">✕</button>
    </div>
    <ul id="qc-list"></ul>
    <form id="qc-add" hidden>
      <input id="qc-cmd"  type="text" placeholder="command — e.g. git status" autocomplete="off" spellcheck="false" />
      <input id="qc-name" type="text" placeholder="display name (optional)"   autocomplete="off" spellcheck="false" />
      <!-- Where this entry is stored. Chosen per entry at add/edit time; on
           save an existing entry MOVES between stores if the choice changed. -->
      <div id="qc-store" style="display:flex;gap:4px;">
        <button id="qc-store-remote" type="button" data-store="remote"
                title="Synced — saved on the terminal backend, shared by every terminal and browser"
                style="flex:1;appearance:none;-webkit-appearance:none;box-sizing:border-box;padding:4px;border:1px solid var(--aura-color-border,rgba(0,255,65,0.2));border-radius:0;background:transparent;color:var(--aura-color-primary,#00ff41);font-family:var(--aura-font-mono,'Courier New',monospace);font-size:0.58rem;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;outline:none;">&#8645; Synced</button>
        <button id="qc-store-local" type="button" data-store="local"
                title="Local — saved in this browser only"
                style="flex:1;appearance:none;-webkit-appearance:none;box-sizing:border-box;padding:4px;border:1px dotted var(--aura-color-border,rgba(0,255,65,0.2));border-radius:0;background:transparent;color:var(--aura-color-text-dim,#557755);font-family:var(--aura-font-mono,'Courier New',monospace);font-size:0.58rem;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;outline:none;">&#9642; Local</button>
      </div>
      <button id="qc-save" type="submit"
              style="appearance:none;-webkit-appearance:none;box-sizing:border-box;padding:5px;border:1px solid var(--aura-color-primary,#00ff41);border-radius:0;background:var(--aura-color-primary,#00ff41);color:var(--aura-color-bg,#0a0a0a);font-family:var(--aura-font-mono,'Courier New',monospace);font-size:0.62rem;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;outline:none;">Add</button>
    </form>
  </aside>

  <script>
    import { Terminal } from '@xterm/xterm';
    import { FitAddon } from '@xterm/addon-fit';
    import '@xterm/xterm/css/xterm.css';

    // appId is server-rendered onto #terminal's data-app-id. A bundled module
    // script can't use Astro's define:vars (that requires is:inline), so we read
    // it from the DOM instead — same pattern as the aura-activity-id meta tag.
    // The fallback keeps the label sane for direct/headless renders.
    const appId = document.getElementById('terminal')?.dataset.appId ?? 'com.aura.terminal';

    // Resolve current OS palette by reading the CSS vars injected by
    // /api/os/theme.css. Re-runs on theme:changed / mode:changed broadcasts
    // so xterm's internal theme follows the OS.
    function readVar(name) {
      return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    }
    function readPalette() {
      return {
        background:  readVar('--aura-color-bg')        || '#0a0a0a',
        foreground:  readVar('--aura-color-text')      || '#ccffcc',
        cursor:      readVar('--aura-color-primary')   || '#00ff41',
        cursorAccent: readVar('--aura-color-bg')       || '#0a0a0a',
        selectionBackground: 'rgba(0,255,65,.3)',
        black:   readVar('--aura-color-bg')           || '#0a0a0a',
        brightBlack: readVar('--aura-color-text-dim') || '#557755',
        red:     readVar('--aura-color-danger')       || '#ff2020',
        brightRed: '#ff4444',
        green:   readVar('--aura-color-primary')      || '#00ff41',
        brightGreen: readVar('--aura-color-primary')  || '#00ff41',
        yellow:  readVar('--aura-color-secondary')    || '#ff9900',
        brightYellow: readVar('--aura-color-warning') || '#ffbb00',
        blue:    readVar('--aura-color-info')         || '#0088ff',
        brightBlue:  readVar('--aura-color-info')     || '#44aaff',
        magenta: '#ff00ff', brightMagenta: '#ff44ff',
        cyan:    readVar('--aura-color-info')         || '#00ffff',
        brightCyan: '#44ffff',
        white:   readVar('--aura-color-text')         || '#ccffcc',
        brightWhite: '#ffffff',
      };
    }

    const term = new Terminal({
      theme: readPalette(),
      fontFamily: "'Courier New', monospace",
      fontSize: 14,
      cursorBlink: true,
      allowProposedApi: true,
    });

    // ─── One live view per session ───────────────────────────────────────
    // The shell behind this window is a long-lived remote session; the xterm in
    // front of it is not. A PTY has ONE winsize, so two live terminals of
    // different sizes on the same session fought over it — the old ⊟/★ buttons
    // tried to referee that (fit-to-smallest vs. a "primary" device) and never
    // worked well enough to keep.
    //
    // Instead exactly ONE browser renders a session at a time. Any other one
    // keeps its window — and all of its state — and swaps the terminal for
    // "This terminal is in use somewhere else. [Use terminal here]". Pressing
    // that moves the live view here and hides it over there; the shell itself
    // never stops, it just isn't drawn in two places at once. The server
    // arbitrates (see pty-server) and tells us which side we're on via control
    // frames on the same socket.
    //
    // The browser id identifies this browser TAB: sessionStorage is per-tab and
    // shared by same-origin iframes within it, so every terminal iframe in this
    // tab reports the same id and survives a reload, while another tab or
    // another browser gets its own. (Not to be confused with the shell's
    // `viewId`, which identifies a WINDOW — activityId ?? instanceId.)
    const BROWSER_KEY = 'aura.terminal.browserId';
    function randomId() { return Math.random().toString(36).slice(2, 10); }
    const browserId = (() => {
      try {
        let v = sessionStorage.getItem(BROWSER_KEY);
        if (!v) { v = 'b-' + randomId() + randomId(); sessionStorage.setItem(BROWSER_KEY, v); }
        return v;
      } catch { return 'b-' + randomId() + randomId(); }  // private mode — fresh id per load
    })();

    // true ⇒ another view holds the terminal and ours is swapped for the
    // take-over panel. Set only from the server's control frames (setLocked).
    let locked = false;
    const ctlDecoder = new TextDecoder();

    // ─── Session host indicator ──────────────────────────────────────────
    // The shell's PROMPT_COMMAND (os/bashrc.aura.sh) emits an OSC window-title
    // sequence carrying the current hostname on every prompt. xterm parses it
    // and fires onTitleChange — so as the user `aura jump`s between sandboxes
    // the bar follows them to wherever the live shell now is. The server-
    // rendered {sessionHost} is just the pre-prompt placeholder.
    const hostEl = document.getElementById('ws-url');
    term.onTitleChange((title) => {
      const host = title?.trim();
      if (host) hostEl.textContent = host;
    });

    // ─── OS shortcut yield ───────────────────────────────────────────────
    // The proxy injects a window-capture-phase keydown forwarder that
    // intercepts every combo in the OS claim list (Ctrl+Alt+Space etc.)
    // BEFORE the event reaches xterm's textarea. That alone is enough
    // for `aura.launcher.toggle` to fire while the user is typing.
    //
    // We ALSO tell xterm explicitly to ignore the same combos via
    // `attachCustomKeyEventHandler` — returning false makes xterm skip
    // its own preventDefault/handle pipeline. Defense in depth: if a
    // future xterm release ever moves its keydown handling to a higher-
    // priority listener (e.g. document-capture), this guarantees the OS
    // still gets the key.
    //
    // The claim list is read from the `aura-keymap-bindings` meta tag the
    // proxy emits — that map honours user keymap overrides, so a user who
    // rebinds the launcher away from Ctrl+Alt+Space gets the new combo
    // yielded instead of stale defaults.
    const osComboSet = new Set();
    try {
      const bindingsMeta = document.querySelector('meta[name="aura-keymap-bindings"]');
      const bindings = JSON.parse(bindingsMeta?.getAttribute('content') ?? '{}');
      for (const [id, combo] of Object.entries(bindings)) {
        // Only yield combos that look OS-level (modifier+key), not bare keys
        // — bare-key bindings are claimed by os-nav, which is mode-gated and
        // shouldn't steal typed characters from a focused terminal.
        if (typeof combo === 'string' && combo.includes('+')) osComboSet.add(combo);
      }
    } catch { /* meta missing or malformed — no extra yields, the forwarder still works */ }

    function comboFromEvent(e) {
      const parts = [];
      if (e.ctrlKey)  parts.push('Ctrl');
      if (e.altKey)   parts.push('Alt');
      if (e.shiftKey) parts.push('Shift');
      if (e.metaKey)  parts.push('Super');
      parts.push(e.code);
      return parts.join('+');
    }
    term.attachCustomKeyEventHandler((event) => {
      if (event.type !== 'keydown') return true;
      return !osComboSet.has(comboFromEvent(event));
    });

    // NOTE: there used to be a direct `window.parent.postMessage({type:
    // 'aura.system.toggleLauncher'})` handler here that intercepted
    // Ctrl+Alt+Space and force-toggled the launcher panel. It was
    // redundant — the proxy-injected `aura.key` forwarder (see the
    // comment block above) already forwards the same combo through the
    // OS dispatcher — AND it was actively wrong: the dispatcher now
    // binds Ctrl+Alt+Space to "focus the first dock button" (chrome
    // entry), not "toggle the launcher". The direct path overrode the
    // intended behaviour, so we let the dispatcher own this combo.

    // Live-update the yielded combos when the user remaps something. The
    // shell broadcasts `aura.keymap.changed` to every iframe whenever
    // bindings change, with the same shape as the meta tag.
    window.addEventListener('message', (ev) => {
      if (ev?.data?.type !== 'aura.keymap.changed') return;
      const next = ev.data.bindings;
      if (!next || typeof next !== 'object') return;
      osComboSet.clear();
      for (const [id, combo] of Object.entries(next)) {
        if (typeof combo === 'string' && combo.includes('+')) osComboSet.add(combo);
      }
    });

    // Re-apply the palette when the OS broadcasts a theme or mode change.
    // CSS vars update automatically via the proxy-injected theme.css link,
    // but xterm caches its theme internally — push the new colors in.
    function refreshTerminalTheme() {
      // Slight defer so the new theme.css (cache-busted) has actually applied.
      setTimeout(() => term.options.theme = readPalette(), 50);
    }
    window.addEventListener('message', (ev) => {
      const t = ev.data?.type;
      if (t === 'aura.theme.changed' || t === 'aura.mode.changed') refreshTerminalTheme();
      // OS told us this window just got focused (user pressed Enter on the
      // highlighted slot in window-selection mode). Plain `iframe.focus()`
      // only focuses the iframe element — without an explicit `term.focus()`
      // xterm's textarea never receives focus and keystrokes go to the
      // body, not the prompt.
      //
      // requestAnimationFrame is critical: the browser's focus transfer
      // (parent calls iframe.focus() → iframe's document gets focus →
      // last-focused descendant is restored, default = body) happens in
      // microtasks AFTER our message listener runs. Calling term.focus()
      // synchronously here loses the race; xterm focuses the textarea,
      // then the browser overwrites that with the body. Deferring one
      // frame puts our focus call after the browser's restoration so it
      // sticks.
      if (t === 'aura.window.focus') {
        // requestAnimationFrame defers past the browser's iframe-focus-
        // transfer microtask so term.focus() lands AFTER the body's
        // restoration (otherwise the body steals focus back).
        //
        // Focus only — no refit here. Any layout change that happened while
        // we were away (neighbour closed → grid reflowed, focus-maximize
        // exit) already rebroadcast our box via `aura.viewport.changed`, so
        // our size is current by the time we're re-entered.
        requestAnimationFrame(() => term.focus());
      }
    });

    // FitAddon is kept ONLY as the ground-truth measurer for the slow watchdog
    // (verifyAndRepair below). The hot resize path is pure arithmetic
    // (applyFit) and never calls fit(). No eager fit() here: the grid stays at
    // xterm's default (and #terminal is visibility:hidden) until the first
    // authoritative box arrives and reveals it — so the boot fit is invisible
    // instead of a visible jump from a wrong guess.
    const fitAddon = new FitAddon();
    term.loadAddon(fitAddon);
    term.open(document.getElementById('terminal'));

    // Once fonts settle the mono cell can change, so invalidate the cached cell
    // (next applyFit re-reads xterm's real metrics) and refit. Resolves
    // immediately for cached fonts, so it's safe on every reload; if it lands
    // before the first box it just primes the metrics for the first real fit.
    if (document.fonts && typeof document.fonts.ready?.then === 'function') {
      document.fonts.ready.then(() => { cellW = 0; cellH = 0; applyFit(); });
    }

    const statusEl = document.getElementById('conn-status');
    const wsProto = location.protocol === 'https:' ? 'wss:' : 'ws:';
    // Route the WS to OUR OWN backend instance (the one this iframe was
    // loaded from), NOT the app id. The shell's WS proxy resolves
    // `/api/proxy/<instanceId>/...` directly to that instance (Pass 1 in
    // wsProxyPlugin); routing by app id falls into Pass 2's "pick first
    // matching instance" which lands EVERY terminal tab on the same
    // backend container — they then fight over a single PTY session
    // every 2 s.
    //
    // The iframe path is `/api/proxy/<instanceId>/...`, so the first
    // segment after `/api/proxy/` is our backend identity.
    const pathParts  = location.pathname.split('/').filter(Boolean);
    const instanceId = pathParts[0] === 'api' && pathParts[1] === 'proxy' && pathParts[2] ? pathParts[2] : appId;
    // Session id picks where the PTY-server's registry stores our shell.
    // Inside each backend container there's at most one terminal anyway
    // (each instance == one shell process), so a per-instance key is the
    // right granularity. If activity-mode terminals land here later, the
    // meta tag will be present and a per-activity key takes priority.
    const activityId = document.querySelector('meta[name="aura-activity-id"]')?.getAttribute('content') ?? instanceId;
    // `_aura_browser` is how the server knows which browser this socket belongs
    // to, and therefore whether we get the live terminal or the take-over
    // panel. It's on the URL (not a first message) so the decision is made at
    // attach time — no window where we'd render before knowing.
    const wsUrl = `${wsProto}//${location.host}/api/proxy/${instanceId}/ws`
      + `?_aura_session=${encodeURIComponent(activityId)}`
      + `&_aura_browser=${encodeURIComponent(browserId)}`;

    // ─── Did THIS browser launch this window? ────────────────────────────
    // A launch is server-side state, so the new window appears in EVERY browser
    // the user has open and each mounts its own iframe for it. First-come
    // ownership then hands the session to whichever iframe's socket connected
    // first — regularly the browser the user is NOT at, who then sees "in use
    // somewhere else" on a terminal they just opened.
    //
    // So the launching browser leaves a one-shot mark (shell lib/launchOrigin.ts)
    // keyed by this window's id, written before our iframe existed. Finding it
    // means "this page load IS the launch" → take the session outright rather
    // than racing for it. Consume it immediately: a later reload of the same
    // window must never steal the terminal back from wherever the user moved it.
    const LAUNCHED_HERE_KEY = 'aura.launchedHere';
    const launchedHere = (() => {
      try {
        const raw = sessionStorage.getItem(LAUNCHED_HERE_KEY);
        if (!raw) return false;
        const map = JSON.parse(raw);
        if (!map || typeof map !== 'object' || !(activityId in map)) return false;
        delete map[activityId];
        sessionStorage.setItem(LAUNCHED_HERE_KEY, JSON.stringify(map));
        return true;
      } catch { return false; }   // no storage → plain first-come, as before
    })();
    // Held until a socket actually OPENS, not just until the first attempt, so
    // a retry (backend still booting) still carries the claim.
    let claimOnConnect = launchedHere;
    // Keep the server-rendered session host as the visible label; surface
    // the WS endpoint on hover for debugging.
    document.getElementById('ws-url').title = wsUrl;

    // ANSI color helpers — xterm.js parses these inline.
    const GRN  = '\x1b[38;5;82m';  // bright green
    const DIM  = '\x1b[38;5;65m';  // dim green
    const ORG  = '\x1b[38;5;208m'; // orange (warn)
    const RED  = '\x1b[38;5;196m'; // red (error)
    const RST  = '\x1b[0m';
    const BOLD = '\x1b[1m';

    // Pre-WS splash so the terminal isn't a blank black box while the PTY
    // backend boots. We write into the xterm itself (no extra DOM), then
    // clear the screen the moment the WS opens and the PTY takes over.
    function writeSplash() {
      term.write('\x1b[2J\x1b[H'); // clear + home
      term.writeln(`${GRN}${BOLD}  ╭──────────────────────────────╮${RST}`);
      term.writeln(`${GRN}${BOLD}  │      A U R A   T E R M       │${RST}`);
      term.writeln(`${GRN}${BOLD}  ╰──────────────────────────────╯${RST}`);
      term.writeln('');
      term.writeln(`${DIM}  app      ${RST}${appId}`);
      term.writeln('');
    }
    writeSplash();

    let dotsTimer  = null;
    let dotsLine   = '';
    function startDots(label) {
      stopDots();
      let n = 0;
      const render = () => {
        const dots = '.'.repeat(n % 4);
        // \r returns to column 0; pad to overwrite previous longer line.
        const text = `${DIM}  ${label}${dots}${RST}`;
        term.write(`\r\x1b[2K${text}`);
        dotsLine = text;
        n++;
      };
      render();
      dotsTimer = setInterval(render, 350);
    }
    function stopDots() {
      if (dotsTimer) clearInterval(dotsTimer);
      dotsTimer = null;
    }

    startDots('connecting to pty');

    // Active WS, so resize/data handlers below can reach the current socket
    // across reconnects without recreating their listeners.
    let activeWs = null;

    // ─── Resize plumbing ─────────────────────────────────────────────────
    // One driver, authoritative box, pure arithmetic:
    //
    //  • SINGLE DRIVER. The shell owns layout and emits `aura.viewport.changed`
    //    once per size change, AFTER the grid has re-laid-out and painted (its
    //    double-rAF settle). `applyFit` runs only from that signal (plus
    //    fonts.ready and ws.onopen). No ResizeObserver / window-resize /
    //    keydown / data fallbacks and no local debounce.
    //
    //  • AUTHORITATIVE BOX, NO INNER RE-MEASURE. The earlier flakiness came
    //    from `fitAddon.fit()` re-measuring xterm's OWN DOM: when the shell
    //    resizes the iframe (grid reflow on launch / add-window), the iframe's
    //    INTERNAL layout lags the new iframe box by a frame, so fit() read the
    //    stale inner width and xterm settled on the wrong column count. Instead
    //    we take the box the SHELL measured (`contentW/contentH`, already
    //    correct + settled) and divide by cached cell metrics → `term.resize`
    //    with no DOM read, so there is nothing left to race. fonts.ready /
    //    ws.onopen have no message in hand, so they self-measure the iframe
    //    viewport (window.innerWidth/Height === the shell's contentW/H, since
    //    the iframe has no internal transform).
    //
    //  • SEND ONLY ON CHANGE. `sendResizeIfChanged` forwards cols/rows to the
    //    PTY only when they differ from the last value we sent, so a broadcast
    //    whose reflow doesn't change OUR size produces NO PTY traffic — and
    //    therefore no SIGWINCH storm repainting a full-screen TUI (htop, Claude
    //    Code).
    let lastSentCols = -1, lastSentRows = -1;

    function sendResizeIfChanged() {
      if (locked) return;                     // not the live view — our size must not move the shared PTY
      if (term.cols === lastSentCols && term.rows === lastSentRows) return;
      lastSentCols = term.cols; lastSentRows = term.rows;
      if (activeWs && activeWs.readyState === 1) {
        try { activeWs.send(JSON.stringify({ type: 'resize', cols: term.cols, rows: term.rows })); }
        catch { /* socket closed between check and send */ }
      }
    }

    // Re-report our size even when the dimensions are unchanged — used right
    // after we're granted the session, where the PTY is now sized to US but our
    // own cols/rows never moved, so send-on-change alone would say nothing.
    function forceSendResize() {
      lastSentCols = -1; lastSentRows = -1;
      sendResizeIfChanged();
    }

    // ── Cell metrics: the size of one xterm grid cell, in CSS px ──────────
    // xterm sizes its grid from its OWN rendered cell (a char's advance width +
    // the line box), rounded to device pixels. We read that EXACT value from
    // xterm's render service so our arithmetic agrees with proposeDimensions()
    // to the pixel — one resize per change, no "repair" second pass, no
    // flicker. The render service only exists after the first paint, so a
    // one-time estimate seeds the very first fit; realCell() overwrites it the
    // instant xterm has rendered. We invalidate (cellW=0) only on font load and
    // devicePixelRatio change — the two things that actually move the cell.
    const FONT_FAMILY = "'Courier New', monospace";
    const FONT_SIZE   = 14;
    let cellW = 0, cellH = 0;

    // Read xterm's actual rendered cell. False until the first render populates
    // renderService.dimensions.
    function realCell() {
      const c = term?._core?._renderService?.dimensions?.css?.cell;
      if (c && c.width > 0 && c.height > 0) { cellW = c.width; cellH = c.height; return true; }
      return false;
    }
    // Pre-first-render estimate ONLY (realCell overwrites it on the first fit).
    // Mirrors xterm's own formula: advance width from a `line-height:1` probe
    // (NOT `normal` — xterm's default lineHeight is 1), cell height = fontSize ×
    // lineHeight rounded. Good enough to seed the hidden boot grid.
    function estimateCell() {
      const probe = document.createElement('div');
      probe.style.cssText =
        'position:absolute;visibility:hidden;white-space:pre;top:-9999px;left:-9999px;' +
        `font-family:${FONT_FAMILY};font-size:${FONT_SIZE}px;line-height:1;`;
      probe.textContent = 'W'.repeat(100);
      document.body.appendChild(probe);
      cellW = probe.getBoundingClientRect().width / 100;
      probe.remove();
      cellH = Math.round(FONT_SIZE * (term.options.lineHeight ?? 1));
    }

    // ── Chrome inset: pixels around the grid the cols/rows can't use ──────
    // MEASURED, not hardcoded, so it can't silently drift from the CSS (the old
    // BAR_H=24 ignored the bar's 1px border — a guaranteed off-by-one). #terminal
    // padding + the #terminal-bar's real box height + the OS scrollbar xterm
    // reserves (it forces overflow-y:scroll). Width never lags the iframe reflow
    // (the terminal is full-width); the bar height is static, so subtracting it
    // from the authoritative box stays race-free.
    let scrollbarW = -1; // cached first non-degenerate read
    function measureScrollbar() {
      const vp = document.querySelector('.xterm-viewport');
      if (vp && vp.offsetWidth > 0) scrollbarW = vp.offsetWidth - vp.clientWidth;
    }
    function chromeInset() {
      const el = document.getElementById('terminal');
      const cs = getComputedStyle(el);
      const padX = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
      const padY = parseFloat(cs.paddingTop)  + parseFloat(cs.paddingBottom);
      const barH = document.getElementById('terminal-bar')?.getBoundingClientRect().height ?? 0;
      if (scrollbarW < 0) measureScrollbar();
      const sb = scrollbarW > 0 ? scrollbarW : 0;
      return { x: padX + sb, y: padY + barH };
    }

    // Compute + apply the grid for a known LOGICAL box (CSS px). Pure
    // arithmetic on xterm's REAL cell + MEASURED chrome, so floor(avail/cell)
    // === proposeDimensions() — the result is exact on the first try, with no
    // DOM read of xterm's own (lagging) layout and no follow-up repair. boxW/H
    // default to the iframe viewport for the message-less callers (fonts.ready,
    // ws.onopen), which equals the shell's contentW/H (the iframe has no inner
    // transform). The first call with a real box reveals the terminal.
    function applyFit(boxW, boxH) {
      if (locked) return;                   // another view owns the terminal → nothing of ours to fit
      const w = boxW ?? window.innerWidth;
      const h = boxH ?? window.innerHeight;
      if (!w || !h) return;                 // hidden / off-workspace → never resize
      if (!cellW || !cellH) { if (!realCell()) estimateCell(); }
      if (!cellW || !cellH) return;         // nothing safe to compute with yet
      const { x, y } = chromeInset();
      const cols = Math.max(1, Math.floor((w - x) / cellW));
      const rows = Math.max(1, Math.floor((h - y) / cellH));
      if (cols !== term.cols || rows !== term.rows) {
        term.resize(cols, rows);
        realCell();                         // refresh cache from ground truth post-resize (cheap, no extra render)
        console.debug('[terminal] fit →', cols, '×', rows, boxW != null ? '(box)' : '(self)'); // TEMP: resize-count instrumentation
      }
      sendResizeIfChanged();
      revealTerminal();
    }

    // Reveal the grid on the first authoritative fit (idempotent). Until then
    // #terminal is visibility:hidden so the boot fit is invisible.
    let revealed = false;
    function revealTerminal() {
      if (revealed) return;
      revealed = true;
      const el = document.getElementById('terminal');
      if (el) el.style.visibility = 'visible';
    }
    // Safety net: never leave the terminal invisible. If — for any reason — no
    // applyFit lands a valid box in the first second (e.g. metrics probe fails,
    // no viewport message, ws never opens), reveal anyway so the user always
    // sees the terminal. The watchdog will still correct the grid afterwards.
    setTimeout(revealTerminal, 1000);

    // ── Watchdog (safety net only) ────────────────────────────────────────
    // With a real cell + measured chrome the event-driven applyFit is already
    // exact, so this should essentially never repair. It stays as a slow
    // heartbeat for drift the event path can't see (a CSS-var/font swap that
    // moved the cell, a layout mutation that didn't broadcast). It recalibrates
    // from xterm's render metrics and only resizes if proposeDimensions truly
    // disagrees — idempotent and silent in steady state. The repair counter is
    // temporary instrumentation: it should read 0 across a session; if it
    // climbs, the cell/chrome model still disagrees with xterm.
    let watchdogRepairs = 0;
    function verifyAndRepair() {
      if (!document.getElementById('terminal')?.offsetWidth) return false; // hidden → skip
      realCell();
      measureScrollbar();
      let dims;
      try { dims = fitAddon.proposeDimensions(); } catch { return false; }
      if (!dims || !dims.cols || !dims.rows) return false;
      if (dims.cols === term.cols && dims.rows === term.rows) return false; // already perfect
      term.resize(dims.cols, dims.rows);
      sendResizeIfChanged();
      watchdogRepairs++;
      console.debug('[terminal] watchdog repaired grid →', dims.cols, '×', dims.rows, '(total', watchdogRepairs + ')');
      return true;
    }
    setInterval(verifyAndRepair, 5000);

    // devicePixelRatio changes (monitor move, browser zoom) re-round xterm's
    // cell — invalidate, re-read from the new render, refit, and re-arm for the
    // next dpr (matchMedia resolution queries are one-shot per threshold).
    function watchDpr() {
      const mq = matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`);
      mq.addEventListener('change', () => {
        cellW = cellH = 0;
        realCell();
        applyFit();
        watchDpr();
      }, { once: true });
    }
    watchDpr();

    // xterm's own cols/rows changed (any internal path) → forward to the PTY so
    // bash's $COLUMNS tracks the real width.
    term.onResize(() => sendResizeIfChanged());

    // PTY sessions are multicast — multiple iframes (e.g. two browser
    // tabs of the same activity) attach to the same shell and see/share
    // the same output. So there's no "displaced" state for us to
    // handle; we just open, listen, and reconnect on actual drops.

    // ─── Reconnect policy ────────────────────────────────────────────────
    // The PTY on the server side now outlives its sockets indefinitely, so a
    // dropped WS is never fatal — it just has to be noticed and redialled.
    // The hard part is that the drop usually happens while nobody is looking:
    // the tab is backgrounded, the laptop is shut, the phone is asleep. In
    // that state browsers throttle timers to ~1/min and may FREEZE the page
    // outright, so a plain `setTimeout(connect, 2000)` can sit unfired for an
    // hour. We therefore drive reconnection from three sources:
    //
    //   1. the close event (backoff timer, for drops we're awake for),
    //   2. wake-up signals — visibilitychange / focus / pageshow / online —
    //      which fire the instant the user actually returns, and
    //   3. a slow watchdog, as a floor under both.
    //
    // All three funnel through `ensureConnected`, which is idempotent: if a
    // socket is already OPEN or CONNECTING it does nothing, so the wake-up
    // burst (several of these fire together when a tab is restored) can't
    // produce duplicate sockets.
    let reconnectTimer = null;
    function clearReconnectTimer() {
      if (reconnectTimer) { clearTimeout(reconnectTimer); reconnectTimer = null; }
    }
    function wsHealthy() {
      return activeWs && (activeWs.readyState === 0 /* CONNECTING */ || activeWs.readyState === 1 /* OPEN */);
    }
    // Backoff for unattended retries: quick at first (a shell restart is back
    // in a second or two), capped at 10s so a long outage doesn't turn into a
    // long wait once the network returns. The wake-up path below bypasses this
    // entirely — when the user is present we redial immediately.
    function backoffMs() {
      return Math.min(500 * Math.pow(2, Math.max(0, attempt - 1)), 10_000);
    }
    function scheduleReconnect() {
      if (reconnectTimer || wsHealthy()) return;
      const delay = backoffMs();
      reconnectTimer = setTimeout(() => { reconnectTimer = null; connect(); }, delay);
    }
    function ensureConnected(reason) {
      if (wsHealthy()) return;
      clearReconnectTimer();
      console.debug('[terminal] reconnect →', reason);
      connect();
    }

    let attempt = 0;
    function connect() {
      attempt++;
      const ws = new WebSocket(claimOnConnect ? `${wsUrl}&_aura_claim=1` : wsUrl);
      // Control frames arrive as binary (see pty-server sendCtl); read them
      // synchronously as an ArrayBuffer rather than a Blob.
      ws.binaryType = 'arraybuffer';
      activeWs = ws;
      let opened = false;

      ws.onopen = () => {
        opened = true;
        claimOnConnect = false;      // the launch claim is spent once it lands
        attempt = 0;                 // reset the backoff ladder for the next drop
        clearReconnectTimer();
        stopDots();
        statusEl.textContent = 'CONNECTED';
        statusEl.style.color = 'var(--aura-color-primary)';
        // Clear the splash up-front, BEFORE the resize/PTY output arrives.
        // (Earlier we did this on a 120ms timer which raced with the bash
        // prompt and sometimes wiped the prompt itself — leaving the user
        // staring at an empty blinking cursor.)
        term.write('\x1b[2J\x1b[H');
        // Fresh PTY on (re)connect: reset the send baseline so the first sync
        // always asserts our real size to it, even if our cols didn't change
        // since before the drop. No double-rAF settle needed — the shell's
        // viewport broadcast already fits us to the settled box; this just
        // (re)asserts that size to the new PTY.
        lastSentCols = -1; lastSentRows = -1;
        applyFit();
      };

      // TEXT frame ⇒ raw PTY output. BINARY frame ⇒ a control message from the
      // session arbiter. Demuxing on the frame type means there is no sentinel
      // to escape and no way for shell output that happens to look like JSON to
      // be mistaken for a control message.
      ws.onmessage = (e) => {
        if (typeof e.data === 'string') { term.write(e.data); return; }
        let msg;
        try { msg = JSON.parse(ctlDecoder.decode(e.data)); } catch { return; }
        if (msg?.type === 'granted')   setLocked(false);
        else if (msg?.type === 'busy') setLocked(true);
      };

      ws.onclose = () => {
        statusEl.textContent = 'DISCONNECTED — RECONNECTING...';
        statusEl.style.color = 'var(--aura-color-secondary)';
        if (opened && !locked) {
          // Was connected, now dropped — surface in-band.
          term.writeln('');
          term.writeln(`${ORG}  [disconnected — reconnecting]${RST}`);
          startDots('reconnecting');
        } else {
          // Never connected this attempt; keep the connecting animation
          // but bump it to a "retry" label so the user sees something is happening.
          startDots(`retry ${attempt}`);
        }
        scheduleReconnect();
      };

      ws.onerror = () => {
        statusEl.textContent = 'ERROR';
        statusEl.style.color = 'var(--aura-color-danger)';
        if (!opened && !locked) {
          // Connection refused / handshake error — surface inline so the
          // user knows it's not just a black screen.
          term.write(`\r\x1b[2K${RED}  ws error — retrying${RST}\r\n`);
        }
      };
    }

    // Keystrokes go to whatever socket is current. Bound ONCE, outside
    // connect(): registering it per-connection stacked a new (permanently
    // inert, since its captured `ws` is closed forever) handler on every
    // reconnect, so an overnight session accumulated one dead listener per
    // drop and ran them all on every keypress.
    term.onData((data) => {
      if (activeWs && activeWs.readyState === 1) {
        activeWs.send(JSON.stringify({ type: 'data', data }));
      }
    });

    connect();

    // Wake-up reconnects. These fire the moment the user is actually back —
    // before any throttled timer would — which is what turns "my session died
    // while I was away" into "it was there when I came back".
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) ensureConnected('visible');
    });
    window.addEventListener('focus',   () => ensureConnected('focus'));
    window.addEventListener('online',  () => ensureConnected('online'));
    window.addEventListener('pageshow', () => ensureConnected('pageshow'));

    // Floor under everything: if the socket is dead and no retry is pending
    // (a close event we somehow missed, a frozen-then-thawed timer), redial.
    setInterval(() => {
      if (!wsHealthy() && !reconnectTimer) ensureConnected('watchdog');
    }, 5000);

    // THE single resize driver. The shell posts `aura.viewport.changed` for
    // every size change — tiling reflow, workspace switch (reveals our tile),
    // zoom (a paint-only `transform: scale()` no ResizeObserver can see), free-
    // window drag-resize release, and browser window resize — each carrying
    // this iframe's authoritative logical box. We feed contentW/contentH
    // straight into the arithmetic (no inner re-measure → no race), then the
    // verify pass confirms it. `contentW === 0` means we're hidden / off the
    // active workspace: skip. send-on-change keeps an unrelated broadcast (one
    // that doesn't move OUR box) from churning the PTY.
    window.addEventListener('message', (ev) => {
      if (ev.source !== window.parent) return;
      const d = ev.data;
      if (d?.type !== 'aura.viewport.changed') return;
      if (d.contentW === 0) return;
      applyFit(d.contentW, d.contentH);
    });

    // ─── Take-over panel ("in use somewhere else") ───────────────────────
    // Driven entirely by the server's control frames: `busy` ⇒ another view has
    // the terminal, `granted` ⇒ it's ours. We never guess locally, so the two
    // sides can't both think they're live.
    const lockEl      = document.getElementById('session-lock');
    const lockBtn     = document.getElementById('lock-claim');
    const lockAllBtn  = document.getElementById('lock-claim-all');
    const terminalEl  = document.getElementById('terminal');

    function setLocked(next) {
      const changed = next !== locked;
      locked = next;
      // Swap terminal ↔ panel. `display:none` (not visibility) so the hidden
      // one takes no space and applyFit's box arithmetic is never fed a
      // collapsed terminal.
      if (lockEl)     lockEl.style.display     = next ? 'flex' : 'none';
      if (terminalEl) terminalEl.style.display = next ? 'none' : '';
      if (next) {
        // Hide the terminal HERE — nothing is closed or stopped, the shell goes
        // on running behind another browser. We drop the rendered screen and
        // scrollback so no stale frame sits behind the panel (the server
        // replays all of it when we're live again) and stop the connect
        // animation. The socket stays open as a control channel — that's what
        // makes the take-over button work and lets the server hand the session
        // back to us the moment the other side lets go.
        stopDots();
        if (changed) term.reset();
        statusEl.textContent = 'IN USE ELSEWHERE';
        statusEl.style.color = 'var(--aura-color-secondary)';
      } else if (changed) {
        // We're the live view again, and the order here is the whole trick:
        //   1. the terminal is already back to display:'' (above), so
        //      chromeInset/measureScrollbar force a real layout and measure the
        //      visible box instead of the collapsed one;
        //   2. reset BEFORE the server's scrollback replay, which follows
        //      `granted` on the very next frame — otherwise it paints on top of
        //      whatever was on screen when we were revoked;
        //   3. fit BEFORE that replay too, so it reflows into the final width
        //      once instead of being written narrow and re-wrapped;
        //   4. forceSendResize because the PTY is sized to US now even though
        //      our own cols/rows never moved (send-on-change would say nothing).
        stopDots();
        statusEl.textContent = 'CONNECTED';
        statusEl.style.color = 'var(--aura-color-primary)';
        revealTerminal();
        term.reset();
        applyFit();
        forceSendResize();
        term.focus();
      }
    }

    /** Ask the server for this session. Returns false if we have no socket. */
    function sendClaim() {
      if (!activeWs || activeWs.readyState !== 1) return false;
      try { activeWs.send(JSON.stringify({ type: 'claim' })); return true; }
      catch { return false; }   // socket died between the check and the send
    }

    // ─── "Use ALL terminals here" ────────────────────────────────────────
    // Every terminal window is its own app instance with its own socket to its
    // own backend, so there is no single server call that means "all of them".
    // The fan-out happens in the browser instead: each terminal iframe claims
    // its OWN session when it hears the broadcast.
    //
    // BroadcastChannel reaches every same-origin context in the whole browser
    // profile — including terminals in a SECOND tab, which are a different
    // browser view with their own id and must not be dragged along. So the
    // message carries our browser id (per-tab) and each listener ignores
    // anything that isn't its own. Without the API we simply claim ourselves,
    // which is the button's single-terminal behaviour.
    const CLAIM_ALL_CHANNEL = 'aura.terminal.claimAll';
    let claimAllBus = null;
    try { claimAllBus = new BroadcastChannel(CLAIM_ALL_CHANNEL); } catch { /* unsupported */ }
    claimAllBus?.addEventListener('message', (ev) => {
      if (ev?.data?.type !== CLAIM_ALL_CHANNEL) return;
      if (ev.data.browserId !== browserId) return;   // another tab's terminals
      sendClaim();                                   // a live terminal re-claiming is a no-op
    });

    lockBtn?.addEventListener('click', () => {
      // No optimistic unlock: the server answers with `granted`, which is what
      // flips the panel. Until then, say something happened.
      if (sendClaim()) statusEl.textContent = 'CLAIMING...';
    });
    lockAllBtn?.addEventListener('click', () => {
      // The channel doesn't echo to the sender, so claim ourselves too.
      try { claimAllBus?.postMessage({ type: CLAIM_ALL_CHANNEL, browserId }); } catch { /* channel closed */ }
      if (sendClaim()) statusEl.textContent = 'CLAIMING...';
    });

    // Inline styles have no :hover, so paint by hand (same approach as the
    // quick-commands buttons). The primary action fills; the "all" variant only
    // brightens, so the two never read as equals.
    lockBtn?.addEventListener('mouseenter', () => {
      lockBtn.style.background = 'var(--aura-color-primary,#00ff41)';
      lockBtn.style.color      = 'var(--aura-color-bg,#0a0a0a)';
      lockBtn.style.boxShadow  = 'var(--aura-glow-primary, 0 0 8px #00ff41)';
    });
    lockBtn?.addEventListener('mouseleave', () => {
      lockBtn.style.background = 'transparent';
      lockBtn.style.color      = 'var(--aura-color-primary,#00ff41)';
      lockBtn.style.boxShadow  = 'none';
    });
    lockAllBtn?.addEventListener('mouseenter', () => {
      lockAllBtn.style.color       = 'var(--aura-color-primary,#00ff41)';
      lockAllBtn.style.borderColor = 'var(--aura-color-primary,#00ff41)';
    });
    lockAllBtn?.addEventListener('mouseleave', () => {
      lockAllBtn.style.color       = 'var(--aura-color-text-dim,#557755)';
      lockAllBtn.style.borderColor = 'var(--aura-color-border,rgba(0,255,65,0.2))';
    });

    // ─── Quick commands (left sidebar overlay) ───────────────────────────
    // A slide-in panel of saved commands. Clicking one types it into the PTY
    // and runs it. Edit mode (✎) reveals the add form + per-item remove, and
    // clicking an item loads it back into the form to rename/edit. Each entry
    // is {command, name?}; the button shows `name` if set, else the command
    // (truncated with an ellipsis). Persisted in localStorage so they survive
    // reloads and are shared across this device's terminals.
    const QC_KEY = 'aura.terminal.quickCommands';
    // Backend endpoint for the synced list. Our page is served through the OS
    // proxy at /api/proxy/<instanceId>/…, so a bare '/api/…' would hit the
    // SHELL instead of our own backend — prefix it the same way the WS URL is.
    const qcApiUrl = (pathParts[0] === 'api' && pathParts[1] === 'proxy' && pathParts[2]
      ? `/api/proxy/${pathParts[2]}`
      : '') + '/api/quick-commands';
    const qcPanel    = document.getElementById('qc-panel');
    const qcToggleBtn= document.getElementById('qc-toggle');
    const qcEditBtn  = document.getElementById('qc-edit');
    const qcCloseBtn = document.getElementById('qc-close');
    const qcList     = document.getElementById('qc-list');
    const qcAddForm  = document.getElementById('qc-add');
    const qcCmdInput = document.getElementById('qc-cmd');
    const qcNameInput= document.getElementById('qc-name');
    const qcSaveBtn  = document.getElementById('qc-save');
    // Two independent lists, rendered as one panel: `remote` lives on the app
    // backend (shared by every terminal instance and browser, survives an OS
    // rebuild), `local` lives in this browser's localStorage. Neither is a
    // cache of the other — an entry is in exactly one of them, and the store
    // is chosen per entry when it is added or edited.
    const qcStoreRemoteBtn = document.getElementById('qc-store-remote');
    const qcStoreLocalBtn  = document.getElementById('qc-store-local');
    function qcLoadLocal() {
      try { const v = JSON.parse(localStorage.getItem(QC_KEY) || '[]'); return Array.isArray(v) ? v : []; }
      catch { return []; }
    }
    let qcLocal  = qcLoadLocal();
    let qcRemote = [];
    // Whether the backend answered last time we asked. When it hasn't, the
    // synced half is hidden rather than shown empty — an empty list would read
    // as "you have no synced commands", which is a different (and alarming)
    // statement from "we couldn't reach the backend".
    let qcRemoteOk = false;
    let qcEditing  = false;
    let qcEditIdx  = null;   // index within qcEditStore's list, or null
    let qcEditStore = null;  // which list the entry being edited came from
    let qcFormStore = 'remote'; // store the form will save to

    function qcSaveLocal() { try { localStorage.setItem(QC_KEY, JSON.stringify(qcLocal)); } catch { /* private mode */ } }
    async function qcFetchRemote() {
      try {
        const res = await fetch(qcApiUrl, { cache: 'no-store' });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const body = await res.json();
        qcRemote = Array.isArray(body?.commands) ? body.commands : [];
        qcRemoteOk = true;
      } catch (err) {
        // Backend down / not yet reachable: keep working with the local list.
        qcRemoteOk = false;
        console.warn('[quick-commands] backend unreachable:', err);
      }
    }
    /** Push the whole synced list; returns false when it didn't land. */
    async function qcSaveRemote() {
      try {
        const res = await fetch(qcApiUrl, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ commands: qcRemote }),
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        qcRemoteOk = true;
        return true;
      } catch (err) {
        qcRemoteOk = false;
        console.warn('[quick-commands] could not save to backend:', err);
        return false;
      }
    }
    /** The list an entry lives in, by store name. */
    function qcListOf(store) { return store === 'remote' ? qcRemote : qcLocal; }
    /** Persist whichever list just changed. */
    async function qcPersist(store) {
      if (store === 'remote') return qcSaveRemote();
      qcSaveLocal();
      return true;
    }
    function qcEsc(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    // Inline style strings (scope-proof) for the dynamically-built buttons.
    const qcCmdBtnCss =
      "appearance:none;-webkit-appearance:none;display:block;flex:1;min-width:0;box-sizing:border-box;" +
      "text-align:left;padding:5px 8px;border:1px solid var(--aura-color-border,rgba(0,255,65,0.2));" +
      "border-radius:0;background:transparent;color:var(--aura-color-primary,#00ff41);" +
      "font-family:var(--aura-font-mono,'Courier New',monospace);font-size:0.7rem;line-height:1.3;" +
      "cursor:pointer;outline:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;";
    // The '>' button that types a command WITHOUT running it. Primary-coloured
    // (it's a normal action, not a destructive one like ✕) and narrow, since
    // it sits at the far right of every row in run mode.
    const qcInsBtnCss =
      "appearance:none;-webkit-appearance:none;flex:0 0 auto;box-sizing:border-box;padding:0 7px;" +
      "border:1px solid var(--aura-color-border,rgba(0,255,65,0.2));border-radius:0;background:transparent;" +
      "color:var(--aura-color-primary,#00ff41);font-family:var(--aura-font-mono,'Courier New',monospace);" +
      "font-size:0.7rem;line-height:1.3;cursor:pointer;outline:none;";
    const qcDelBtnCss =
      "appearance:none;-webkit-appearance:none;flex:0 0 auto;box-sizing:border-box;padding:0 8px;" +
      "border:1px solid var(--aura-color-danger,#ff2020);border-radius:0;background:transparent;" +
      "color:var(--aura-color-danger,#ff2020);font-family:var(--aura-font-mono,'Courier New',monospace);" +
      "font-size:0.7rem;cursor:pointer;outline:none;";

    // The two stores are told apart by the left edge of the row only: a solid
    // accent bar for synced, a dotted dim one for local. Deliberately quiet —
    // enough to see the grouping and answer "will this follow me?", not a
    // second colour scheme fighting the terminal for attention.
    const qcRowAccent = {
      remote: "border-left:2px solid var(--aura-color-primary,#00ff41);",
      local:  "border-left:2px dotted var(--aura-color-text-dim,#557755);",
    };

    function qcRowHtml(c, i, store) {
      const label = (c && c.name && c.name.trim()) ? c.name : (c ? c.command : '');
      const where = store === 'remote' ? 'synced' : 'this browser only';
      const main =
        '<button data-qc="' + (qcEditing ? 'edit' : 'run') + '" data-idx="' + i + '" ' +
        'data-store="' + store + '" title="' + qcEsc(c ? c.command : '') + '\n(' + where + ')" ' +
        'style="' + qcCmdBtnCss + qcRowAccent[store] + '">' + qcEsc(label) + '</button>';
      // Run mode: an insert-only '>' at the far right. Edit mode: the remove
      // ✕ in that slot instead — never both, so the row width is stable.
      const ins = qcEditing
        ? ''
        : '<button data-qc="ins" data-idx="' + i + '" data-store="' + store + '" ' +
          'title="Type it without running" style="' + qcInsBtnCss + '">&gt;</button>';
      const del = qcEditing
        ? '<button data-qc="del" data-idx="' + i + '" data-store="' + store + '" ' +
          'title="Remove" style="' + qcDelBtnCss + '">✕</button>'
        : '';
      return '<li style="display:flex;gap:4px;">' + main + ins + del + '</li>';
    }

    function qcGroupLabel(text) {
      return '<li style="color:var(--aura-color-text-dim,#557755);font-size:0.55rem;' +
             'letter-spacing:.12em;text-transform:uppercase;padding:4px 2px 1px;">' + text + '</li>';
    }

    function qcRender() {
      if (!qcList) return;
      const remote = qcRemoteOk ? qcRemote : [];
      if (remote.length === 0 && qcLocal.length === 0) {
        qcList.innerHTML =
          '<li style="color:var(--aura-color-text-dim,#557755);padding:10px 6px;text-align:center;' +
          'font-size:0.62rem;line-height:1.5;">No quick commands yet.' +
          (qcEditing ? '<br>Add one below.' : '<br>Press ✎ to add.') + '</li>';
        return;
      }
      // Synced first, then local. Headings appear only when BOTH stores have
      // entries — with one store in play the accent bar alone is enough, and a
      // lone heading would just eat vertical space in a narrow panel.
      const showHeads = remote.length > 0 && qcLocal.length > 0;
      const parts = [];
      if (showHeads && remote.length) parts.push(qcGroupLabel('⇅ Synced'));
      parts.push(...remote.map((c, i) => qcRowHtml(c, i, 'remote')));
      if (showHeads && qcLocal.length) parts.push(qcGroupLabel('▪ This browser'));
      parts.push(...qcLocal.map((c, i) => qcRowHtml(c, i, 'local')));
      qcList.innerHTML = parts.join('');
      // Dim the Synced choice while the backend is unreachable, so the form
      // shows WHY it defaulted to Local instead of silently preferring it.
      if (qcStoreRemoteBtn) {
        qcStoreRemoteBtn.style.opacity = qcRemoteOk ? '1' : '0.45';
        qcStoreRemoteBtn.title = qcRemoteOk
          ? 'Synced — saved on the terminal backend, shared by every terminal and browser'
          : 'Synced — backend unreachable right now';
      }
    }

    // Style the panel + its structure INLINE (scope-proof) so the overlay and
    // slide work even when the scoped <style> doesn't reach these elements in
    // the proxied iframe. The panel is position:fixed over the console (below
    // the 24px bar) and slides in via a transform we toggle in open/close.
    function qcInitStyles() {
      if (qcPanel) Object.assign(qcPanel.style, {
        position: 'fixed', top: '24px', left: '0', bottom: '0',
        width: '280px', maxWidth: '80%',
        display: 'flex', flexDirection: 'column',
        background: 'var(--aura-color-surface, #111)',
        borderRight: '1px solid var(--aura-color-border, rgba(0,255,65,0.2))',
        boxShadow: '4px 0 18px rgba(0,0,0,0.45)',
        transform: 'translateX(-100%)',
        transition: 'transform .18s ease-out',
        zIndex: '50', overflow: 'hidden',
      });
      const head = qcPanel && qcPanel.querySelector('.qc-head');
      if (head) Object.assign(head.style, {
        display: 'flex', alignItems: 'center', gap: '5px',
        height: '24px', padding: '0 6px 0 10px',
        borderBottom: '1px solid var(--aura-color-border, rgba(0,255,65,0.2))',
        color: 'var(--aura-color-text-dim, #557755)',
        textTransform: 'uppercase', letterSpacing: '.12em',
        fontSize: '0.6rem', flexShrink: '0',
      });
      if (qcList) Object.assign(qcList.style, {
        flex: '1', listStyle: 'none', margin: '0', padding: '6px',
        overflowY: 'auto', display: 'flex', flexDirection: 'column', gap: '4px',
      });
      if (qcAddForm) {
        qcAddForm.removeAttribute('hidden');
        Object.assign(qcAddForm.style, {
          flexDirection: 'column', gap: '5px', padding: '6px',
          borderTop: '1px solid var(--aura-color-border, rgba(0,255,65,0.2))',
          flexShrink: '0', display: 'none', // shown only in edit mode
        });
      }
      for (const inp of [qcCmdInput, qcNameInput]) {
        if (inp) Object.assign(inp.style, {
          boxSizing: 'border-box', width: '100%',
          background: 'var(--aura-color-bg, #0a0a0a)',
          color: 'var(--aura-color-text, #ccffcc)',
          border: '1px solid var(--aura-color-border, rgba(0,255,65,0.2))',
          padding: '4px 6px',
          fontFamily: "var(--aura-font-mono, 'Courier New', monospace)",
          fontSize: '0.7rem', outline: 'none',
        });
      }
    }
    function qcOpen()  {
      // Render immediately from what we have, then fold the backend list in
      // when it answers — the panel must never wait on the network to open.
      qcLocal = qcLoadLocal();
      qcRender();
      if (qcPanel) { qcPanel.setAttribute('aria-hidden', 'false'); qcPanel.style.transform = 'translateX(0)'; }
      qcFetchRemote().then(qcRender);
    }
    function qcClose() {
      if (qcPanel) { qcPanel.setAttribute('aria-hidden', 'true'); qcPanel.style.transform = 'translateX(-100%)'; }
    }
    /**
     * Type a command into the PTY. `enter` appends the carriage return that
     * makes the shell execute it — the difference between clicking the entry
     * (run it) and clicking its '>' (leave it on the prompt to edit first).
     * Either way the panel closes and focus returns to the terminal, so the
     * user can keep typing straight after the click.
     */
    function qcSend(cmd, enter) {
      if (activeWs && activeWs.readyState === 1) {
        try { activeWs.send(JSON.stringify({ type: 'data', data: enter ? cmd + '\r' : cmd })); }
        catch { /* socket gone */ }
      }
      qcClose();
      term.focus();
    }
    function qcRun(cmd) { qcSend(cmd, true); }
    /** Reflect + set which store the add/edit form will write to. */
    function qcSetFormStore(store) {
      qcFormStore = store === 'local' ? 'local' : 'remote';
      const on = {
        background: 'var(--aura-color-primary,#00ff41)',
        color: 'var(--aura-color-bg,#0a0a0a)',
        borderColor: 'var(--aura-color-primary,#00ff41)',
      };
      const off = { background: 'transparent', borderColor: 'var(--aura-color-border,rgba(0,255,65,0.2))' };
      if (qcStoreRemoteBtn) Object.assign(qcStoreRemoteBtn.style,
        qcFormStore === 'remote' ? on : { ...off, color: 'var(--aura-color-primary,#00ff41)' });
      if (qcStoreLocalBtn) Object.assign(qcStoreLocalBtn.style,
        qcFormStore === 'local' ? on : { ...off, color: 'var(--aura-color-text-dim,#557755)' });
    }
    qcStoreRemoteBtn?.addEventListener('click', () => qcSetFormStore('remote'));
    qcStoreLocalBtn?.addEventListener('click',  () => qcSetFormStore('local'));

    function qcSetEditing(on) {
      qcEditing = on;
      qcEditIdx = null;
      qcEditStore = null;
      // New entries default to synced — the store you almost always want —
      // unless the backend is unreachable, where local is the only one that
      // can actually accept the write.
      qcSetFormStore(qcRemoteOk ? 'remote' : 'local');
      if (qcAddForm) qcAddForm.style.display = on ? 'flex' : 'none';
      if (qcSaveBtn) qcSaveBtn.textContent = 'Add';
      if (qcCmdInput)  qcCmdInput.value = '';
      if (qcNameInput) qcNameInput.value = '';
      if (qcEditBtn) {  // reflect active edit-mode on the ✎ button (filled when on)
        const s = qcEditBtn.style;
        s.background  = on ? 'var(--aura-color-primary,#00ff41)' : 'transparent';
        s.color       = on ? 'var(--aura-color-bg,#0a0a0a)' : 'var(--aura-color-primary,#00ff41)';
        s.borderColor = 'var(--aura-color-primary,#00ff41)';
      }
      qcRender();
    }

    qcToggleBtn?.addEventListener('click', () => {
      if (qcPanel?.getAttribute('aria-hidden') === 'false') qcClose();
      else qcOpen();
    });
    qcCloseBtn?.addEventListener('click', qcClose);
    qcEditBtn?.addEventListener('click', () => qcSetEditing(!qcEditing));

    qcList?.addEventListener('click', async (e) => {
      const btn = e.target.closest('button[data-qc]');
      if (!btn) return;
      const store = btn.dataset.store === 'local' ? 'local' : 'remote';
      const idx = parseInt(btn.dataset.idx, 10);
      const list = qcListOf(store);
      const c = list[idx];
      if (!c) return;
      const action = btn.dataset.qc;
      if (action === 'run') qcRun(c.command);
      else if (action === 'ins') qcSend(c.command, false);
      else if (action === 'del') {
        const removed = list.splice(idx, 1);
        // Cancel any in-progress edit (indices just shifted) and reset the form.
        qcEditIdx = null;
        qcEditStore = null;
        if (qcCmdInput)  qcCmdInput.value = '';
        if (qcNameInput) qcNameInput.value = '';
        if (qcSaveBtn)   qcSaveBtn.textContent = 'Add';
        qcRender();
        // A failed backend write must not silently swallow the entry: put it
        // back and re-render so what's on screen is what's actually stored.
        if (!(await qcPersist(store))) { list.splice(idx, 0, ...removed); qcRender(); }
      }
      else if (action === 'edit') {
        qcEditIdx = idx;
        qcEditStore = store;
        if (qcCmdInput)  qcCmdInput.value  = c.command;
        if (qcNameInput) qcNameInput.value = c.name || '';
        if (qcSaveBtn)   qcSaveBtn.textContent = 'Save';
        qcSetFormStore(store);   // pre-select where it currently lives
        qcCmdInput?.focus();
      }
    });

    qcAddForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const command = (qcCmdInput?.value || '').trim();
      if (!command) { qcCmdInput?.focus(); return; }
      const name = (qcNameInput?.value || '').trim();
      const entry = name ? { command, name } : { command };
      const target = qcFormStore;

      // Editing an entry whose store changed is a MOVE: drop it from the old
      // list, append to the new one, and persist both. Same-store edits just
      // replace in place.
      const from = qcEditStore;
      const fromIdx = qcEditIdx;
      const editing = from != null && fromIdx != null && qcListOf(from)[fromIdx];
      if (editing && from === target) {
        qcListOf(target)[fromIdx] = entry;
      } else {
        if (editing) qcListOf(from).splice(fromIdx, 1);
        qcListOf(target).push(entry);
      }
      qcEditIdx = null;
      qcEditStore = null;
      if (qcCmdInput)  qcCmdInput.value = '';
      if (qcNameInput) qcNameInput.value = '';
      if (qcSaveBtn)   qcSaveBtn.textContent = 'Add';
      qcRender();
      qcCmdInput?.focus();

      const ok = await qcPersist(target);
      if (editing && from !== target) await qcPersist(from);
      if (!ok) {
        // Backend refused the write — say so instead of leaving a row on
        // screen that isn't stored anywhere.
        qcRemoteOk = false;
        qcRender();
        alert('Could not save to the terminal backend — the entry is not stored. Try "Local" instead.');
      }
    });

    // Esc closes — bound to the panel so it only fires when focus is inside it
    // (never steals Esc from the terminal / a running TUI).
    qcPanel?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { e.stopPropagation(); qcClose(); term.focus(); }
    });

    qcInitStyles();
    qcSetFormStore('remote');
    qcRender();
    // Warm the synced list once at start-up so the first open shows it without
    // a flash, and so qcSetEditing's "default to synced unless unreachable"
    // decision is based on a real answer rather than the initial `false`.
    qcFetchRemote().then(qcRender);
  </script>
</body>
</html>
