{
  "id":             "com.aura.registry",
  "originId": "02f21820-9215-4dc9-9473-56284a1c4025",
  "name":           "Registry",
  "version":        "0.1.0",
  "description":    "Local OCI registry (Zot) — system infrastructure. Nexus pushes/pulls @aura/* packages and AuraOS apps through here.",
  "icon":           "REG",
  "category":       "system",
  "componentType":  "service",
  "instanceMode":   "single",
  "activityMode":   "none",
  "sandbox":        "container",
  "runtime":        "raw",
  "entrypoint":     "entrypoint.sh",
  "autoStart":      true,
  "critical":       true,
  "tools":          ["bash", "node", "zot"],
  "permissions":    ["storage.read", "storage.write"],
  "serverPort":     4090,
  "proxy": {
    "rewriteHtml":          "none",
    "preservePrefix":       false,
    "injectMeta":           false,
    "injectConsoleRelay":   false,
    "injectKeyForwarder":   false,
    "injectIdentityScript": false,
    "exposeAllPaths":       true
  }
}
