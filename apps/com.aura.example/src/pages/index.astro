---
const appId      = Astro.request.headers.get('x-aura-app-id')      ?? 'com.aura.example';
const instanceId = Astro.request.headers.get('x-aura-instance-id') ?? appId;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Example — AuraOS</title>
  <style>
    body { margin: 0; padding: 24px; background: #0a0a0a; color: #ccffcc;
           font-family: 'Courier New', monospace; }
    h1 { color: #00ff41; margin: 0 0 12px; }
    pre { color: #557755; }
  </style>
</head>
<body>
  <h1>Example</h1>
  <pre>app:      {appId}
instance: {instanceId}</pre>
  <p>Edit <code>src/pages/index.astro</code> to start building your app.</p>
</body>
</html>
