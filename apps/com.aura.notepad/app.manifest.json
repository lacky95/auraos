{
  "id": "com.aura.notepad",
  "name": "Notepad",
  "icon": "NP",
  "version": "0.1.0",
  "description": "Shared note buffer — multiple activities edit the same text live (single backend, multi activities)",
  "category": "productivity",
  "permissions": ["storage.read", "storage.write"],
  "tools": ["bash", "node"],
  "instanceMode": "single",
  "activityMode": "multi",
  "defaultLaunch": "new-activity",
  "viewConfig": {
    "defaultWidth": 600,
    "defaultHeight": 400,
    "resizable": true
  },
  "preferredLayout": "tiling",
  "intentFilters": [
    {
      "action": "aura.intent.action.SEND",
      "category": ["aura.intent.category.DEFAULT"],
      "dataMime": ["text/plain"]
    }
  ]
}
