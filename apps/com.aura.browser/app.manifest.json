{
  "id": "com.aura.browser",
  "name": "Browser",
  "version": "0.1.0",
  "description": "minimal web browser",
  "icon": "BR",
  "instanceMode": "single",
  "activityMode": "multi",
  "backgroundService": true,
  "sandbox": "container",
  "tools": [
    "bash",
    "git",
    "claude"
  ],
  "intentFilters": [
    {
      "action": "aura.intent.action.VIEW",
      "category": ["aura.intent.category.DEFAULT"],
      "dataScheme": ["http", "https"]
    }
  ]
}
