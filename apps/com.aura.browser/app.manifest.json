{
  "id": "com.aura.browser",
  "originId": "4889422d-af8c-416a-b51d-873aeb140edf",
  "name": "Browser",
  "version": "0.1.0",
  "description": "minimal web browser",
  "icon": "BR",
  "instanceMode": "single",
  "activityMode": "multi",
  "backgroundService": true,
  "sandbox": "container",
  "tools": [
    "bash",
    "git",
    "claude",
    "code-server"
  ],
  "intentFilters": [
    {
      "action": "aura.intent.action.VIEW",
      "category": [
        "aura.intent.category.DEFAULT"
      ],
      "dataScheme": [
        "http",
        "https"
      ]
    }
  ]
}
