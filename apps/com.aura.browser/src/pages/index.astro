---
/**
 * com.aura.browser — minimal web browser.
 *
 * Layout: a sticky toolbar at the top (back / forward / reload / URL bar /
 * go / home) and a single nested <iframe> filling the rest of the viewport.
 * That nested iframe is the "browser engine" — when the user hits Enter on
 * the URL bar we just point the iframe at the typed URL. Aura's own window
 * is already an iframe; the engine is an iframe inside that iframe.
 *
 * History is a plain in-memory array we push to on every navigation. We
 * don't (and can't, cross-origin) rely on the inner iframe's own history,
 * so back/forward walk our own list — same way every native browser UI
 * separates "tab history" from the underlying window history.
 *
 * Practical limit users will hit: most popular sites set
 * `X-Frame-Options: DENY` or `Content-Security-Policy: frame-ancestors`
 * which forbid being framed. Those refuse to load and the iframe stays
 * blank — that's a browser-side restriction we can't bypass. Sites that
 * permit framing (lite/AMP variants, many docs sites, our own AuraOS
 * pages, etc.) work fine.
 */
import { readIdentityHeaders } from '@aura/app-sdk';

const DEFAULT_HOME = 'https://duckduckgo.com/?q=AuraOS';

// Initial URL seeding. When the OS dispatches a VIEW intent (e.g. a
// host-intercepted popup), onActivityCreate builds the iframe URL as
// `/?url=<encoded>` so the engine paints the right destination on first
// load. Without a `?url=`, we fall back to DEFAULT_HOME. The home button
// always navigates to DEFAULT_HOME regardless — see `data-home` below.
const rawUrl = Astro.url.searchParams.get('url');
const INITIAL_URL = rawUrl && /^https?:\/\//i.test(rawUrl) ? rawUrl : DEFAULT_HOME;

// Identity for the host's URL-relay script. Every nested frame the
// WebView host loads runs an injected script that postMessages
// `aura.host.url-changed` to `window.top` on every navigation (SPA
// pushState, popstate, hashchange, title mutations, …). The script
// includes `instanceId` + `activityId` parsed from the iframe's
// `window.name`, so we encode them here. The shell routes the event
// back down to THIS browser activity by `activityId`.
const ids = readIdentityHeaders(Astro.request);
const FRAME_NAME = JSON.stringify({
  instanceId: ids.instanceId ?? null,
  activityId: ids.activityId ?? null,
});
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Browser — AuraOS</title>
  </head>
  <body>
    <header class="chrome">
      <div class="nav-group">
        <button id="back-btn"    title="Back (Alt+←)"    aria-label="Back"    disabled>◂</button>
        <button id="fwd-btn"     title="Forward (Alt+→)" aria-label="Forward" disabled>▸</button>
        <button id="reload-btn"  title="Reload (Ctrl+R)" aria-label="Reload">⟳</button>
        <button id="home-btn"    title="Home"            aria-label="Home">⌂</button>
      </div>
      <form id="url-form" class="url-form" autocomplete="off">
        <input id="url-input" type="text" spellcheck="false" placeholder="Enter URL or search query…" value={INITIAL_URL} />
        <button id="go-btn" type="submit" title="Go (Enter)">GO</button>
      </form>
      <div class="tools-group">
        <button id="zoom-out-btn"   title="Zoom out (Ctrl+-)"     aria-label="Zoom out">−</button>
        <button id="zoom-reset-btn" title="Reset zoom (Ctrl+0)"   aria-label="Reset zoom">100%</button>
        <button id="zoom-in-btn"    title="Zoom in (Ctrl++)"      aria-label="Zoom in">+</button>
        <div class="menu-wrap">
          <button id="settings-btn" title="Settings" aria-label="Settings" aria-haspopup="true" aria-expanded="false">⚙</button>
          <div id="settings-menu" class="settings-menu" role="menu" hidden>
            <button id="menu-debug-btn" type="button" role="menuitem" aria-pressed="false">Debug panel</button>
          </div>
        </div>
      </div>
    </header>

    <div class="engine-wrap">
      <iframe
        id="engine"
        class="engine"
        title="Web view"
        name={FRAME_NAME}
        data-home={DEFAULT_HOME}
        src={INITIAL_URL}
        referrerpolicy="no-referrer-when-downgrade"
        allow="clipboard-read; clipboard-write; fullscreen"
        sandbox="allow-scripts allow-forms allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-modals allow-downloads"
      ></iframe>
      <aside id="debug-panel" class="debug-panel" hidden aria-label="Debug">
        <header class="debug-head">
          <span>// DEBUG</span>
          <button id="debug-clear" type="button" title="Clear log">CLEAR</button>
          <button id="debug-close" type="button" title="Close debug panel">✕</button>
        </header>
        <dl class="debug-stats">
          <dt>state</dt>      <dd id="dbg-state">idle</dd>
          <dt>last load</dt>  <dd id="dbg-loadms">—</dd>
          <dt>cursor</dt>     <dd id="dbg-cursor">0 / 1</dd>
          <dt>current url</dt><dd id="dbg-url"></dd>
        </dl>
        <div class="debug-section">
          <div class="debug-section-title">HISTORY</div>
          <ol id="dbg-history" class="debug-history"></ol>
        </div>
        <div class="debug-section">
          <div class="debug-section-title">EVENTS</div>
          <pre id="dbg-log" class="debug-log"></pre>
        </div>
      </aside>
    </div>

    <style is:global>
      :root { color-scheme: dark; }
      html, body {
        margin: 0;
        padding: 0;
        height: 100vh;
        overflow: hidden;
        font-family: var(--aura-font-mono, 'IBM Plex Mono', ui-monospace, monospace);
        background: var(--aura-color-bg, #0a0a0a);
        color: var(--aura-color-text, #ccffcc);
        display: flex;
        flex-direction: column;
      }

      /* ── Top chrome ──────────────────────────────────────────────── */
      .chrome {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        gap: 8px;
        padding: 6px 10px;
        background: var(--aura-color-surface, #111);
        border-bottom: 1px solid var(--aura-color-border, #222);
        flex-shrink: 0;
      }
      .nav-group, .tools-group { display: flex; gap: 2px; flex-shrink: 0; order: 1; }
      /* Layout: both button groups live on row 1 — nav-group pinned left,
       * tools-group (zoom + settings) pushed right via margin-left:auto. The
       * URL form has flex-basis:100% + order:2, so it always wraps onto its
       * own row 2 below the buttons. */
      .tools-group { margin-left: auto; }
      .nav-group button, .tools-group button {
        font: inherit;
        font-size: 0.95rem;
        line-height: 1;
        background: transparent;
        color: var(--aura-color-primary, #00ff41);
        border: 1px solid var(--aura-color-border, #222);
        cursor: pointer;
        min-width: 32px;
        padding: 0 8px;
        transition: border-color 0.1s, box-shadow 0.1s;
      }
      /* The zoom-reset button shows a "100%" label, so it needs a touch more
       * room and a smaller font than the single-glyph icon buttons. */
      #zoom-reset-btn { font-size: 0.7rem; min-width: 44px; letter-spacing: 0.02em; }
      .nav-group button:hover:not([disabled]),
      .nav-group button:focus-visible:not([disabled]),
      .tools-group button:hover:not([disabled]),
      .tools-group button:focus-visible:not([disabled]) {
        border-color: var(--aura-color-primary, #00ff41);
        box-shadow: 0 0 8px var(--aura-color-primary, #00ff41);
        outline: none;
      }
      .nav-group button[disabled], .tools-group button[disabled] { opacity: 0.3; cursor: not-allowed; }

      .url-form { display: flex; flex: 1 1 100%; order: 2; min-width: 0; gap: 0; }
      .url-form input {
        flex: 1 1 auto;
        min-width: 0;
        font: inherit;
        font-size: 0.85rem;
        background: var(--aura-color-bg, #0a0a0a);
        color: var(--aura-color-text, #ccffcc);
        border: 1px solid var(--aura-color-border, #222);
        padding: 6px 10px;
        letter-spacing: 0.02em;
      }
      .url-form input:focus { outline: none; border-color: var(--aura-color-primary, #00ff41); }
      /* When the engine has navigated cross-origin since the URL bar was
       * last truthful (link click / form submit inside the iframe taking
       * us off-host), browser security prevents reading the new URL. We
       * dim the bar and prefix it with `≈` to make that visible — the
       * value shown is the *last known* URL, not necessarily the current
       * one. Cleared the moment we navigate ourselves or capture a fresh
       * same-origin URL from the load event. */
      .url-form input[data-stale="true"] {
        color: var(--aura-color-text-dim, #888);
        font-style: italic;
      }
      .url-form button {
        font: inherit;
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        background: transparent;
        color: var(--aura-color-primary, #00ff41);
        border: 1px solid var(--aura-color-border, #222);
        border-left: none;
        padding: 0 12px;
        cursor: pointer;
        flex-shrink: 0;
      }
      .url-form button:hover {
        border-color: var(--aura-color-primary, #00ff41);
        box-shadow: 0 0 8px var(--aura-color-primary, #00ff41);
      }
      .chrome[data-loading="true"] .url-form button { animation: pulse 0.8s ease-in-out infinite; }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

      /* ── Engine viewport ──────────────────────────────────────── */
      .engine-wrap {
        position: relative;
        flex: 1 1 auto;
        background: var(--aura-color-bg, #0a0a0a);
        overflow: hidden;
      }
      /* Zoom is applied via transform: scale() on the iframe with a
       * counter-sized width/height (set inline from JS), so the engine still
       * exactly fills the wrap at any zoom level. The iframe is pinned to the
       * wrap's top-left corner and scaled from that same corner (origin 0 0),
       * so the content never drifts off-centre when zooming. */
      .engine {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: none;
        background: white;
        transform-origin: 0 0;
      }
      /* ── Debug panel ─────────────────────────────────────────── */
      /* Anchored bottom-right of the engine viewport, never blocks the
       * page. Toggled by the ⚙ button in the chrome. */
      .debug-panel {
        position: absolute;
        right: 12px;
        bottom: 12px;
        width: min(380px, calc(100% - 24px));
        max-height: min(70%, 480px);
        background: var(--aura-color-surface, #111);
        border: 1px solid var(--aura-color-primary, #00ff41);
        box-shadow: 0 8px 24px rgba(0,0,0,0.5);
        font-size: 0.72rem;
        line-height: 1.4;
        display: flex;
        flex-direction: column;
        z-index: 5;
      }
      .debug-panel[hidden] { display: none; }
      .debug-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 6px 10px;
        background: color-mix(in srgb, var(--aura-color-primary, #00ff41) 12%, transparent);
        color: var(--aura-color-primary, #00ff41);
        letter-spacing: 0.15em;
        border-bottom: 1px solid var(--aura-color-border, #222);
      }
      .debug-head button {
        font: inherit;
        font-size: 0.65rem;
        letter-spacing: 0.1em;
        background: transparent;
        color: var(--aura-color-text-dim, #557755);
        border: 1px solid var(--aura-color-border, #222);
        padding: 2px 8px;
        cursor: pointer;
      }
      .debug-head button:hover { color: var(--aura-color-primary, #00ff41); border-color: var(--aura-color-primary, #00ff41); }
      .debug-stats {
        display: grid;
        grid-template-columns: minmax(0, max-content) 1fr;
        gap: 4px 12px;
        margin: 0;
        padding: 10px 12px;
        border-bottom: 1px solid var(--aura-color-border, #222);
      }
      .debug-stats dt {
        color: var(--aura-color-text-dim, #557755);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.65rem;
      }
      .debug-stats dd {
        margin: 0;
        color: var(--aura-color-text, #ccffcc);
        word-break: break-all;
      }
      .debug-section {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        padding: 10px 12px;
        border-bottom: 1px solid var(--aura-color-border, #222);
      }
      .debug-section:last-of-type { border-bottom: none; }
      .debug-section-title {
        color: var(--aura-color-text-dim, #557755);
        font-size: 0.6rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        margin-bottom: 6px;
      }
      .debug-history {
        margin: 0;
        padding: 0 0 0 20px;
        overflow-y: auto;
        max-height: 100px;
        color: var(--aura-color-text-dim, #557755);
      }
      .debug-history li { word-break: break-all; }
      .debug-history li[data-current="true"] {
        color: var(--aura-color-primary, #00ff41);
        list-style-type: square;
      }
      .debug-log {
        margin: 0;
        flex: 1 1 auto;
        min-height: 80px;
        max-height: 160px;
        overflow-y: auto;
        white-space: pre-wrap;
        word-break: break-all;
        font-size: 0.7rem;
        color: var(--aura-color-text-dim, #557755);
      }
      .debug-log .ev-warn { color: var(--aura-color-warning, #ffd166); }
      .debug-log .ev-error { color: var(--aura-color-danger, #ff2020); }
      .debug-log .ev-ok    { color: var(--aura-color-primary, #00ff41); }

      /* Settings/debug button uses the same styling but highlights when on
       * (debug active) or while its dropdown is open. */
      .tools-group button[aria-pressed="true"],
      .tools-group button[aria-expanded="true"] {
        background: color-mix(in srgb, var(--aura-color-primary, #00ff41) 12%, transparent);
        border-color: var(--aura-color-primary, #00ff41);
      }

      /* ── Settings dropdown ─────────────────────────────────────── */
      /* Anchored to the bottom-right of the ⚙ trigger. Clicking an item
       * runs its action (e.g. open the debug panel) and closes the menu. */
      .menu-wrap { position: relative; display: flex; }
      .settings-menu {
        position: absolute;
        top: calc(100% + 4px);
        right: 0;
        min-width: 160px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 4px;
        background: var(--aura-color-surface, #111);
        border: 1px solid var(--aura-color-primary, #00ff41);
        box-shadow: 0 8px 24px rgba(0,0,0,0.5);
        z-index: 10;
      }
      .settings-menu[hidden] { display: none; }
      .settings-menu button {
        font: inherit;
        font-size: 0.78rem;
        line-height: 1.3;
        text-align: left;
        min-width: 0;
        background: transparent;
        color: var(--aura-color-text, #ccffcc);
        border: 1px solid transparent;
        padding: 6px 10px;
        cursor: pointer;
        white-space: nowrap;
      }
      .settings-menu button:hover,
      .settings-menu button:focus-visible {
        border-color: var(--aura-color-primary, #00ff41);
        color: var(--aura-color-primary, #00ff41);
        outline: none;
      }
      .settings-menu button[aria-pressed="true"] {
        background: color-mix(in srgb, var(--aura-color-primary, #00ff41) 12%, transparent);
        border-color: var(--aura-color-primary, #00ff41);
        color: var(--aura-color-primary, #00ff41);
      }

      /* ── Narrow tile: tighten spacing (row layout is already two-row) ── */
      @media (max-width: 480px) {
        .chrome { gap: 6px; padding: 6px; }
        .nav-group button, .tools-group button { min-width: 28px; padding: 0 6px; }
        #zoom-reset-btn { min-width: 40px; padding: 0 4px; }
      }
    </style>

    <script is:inline>
      (function () {
        var chrome   = document.querySelector('.chrome');
        var engine   = document.getElementById('engine');
        var urlInput = document.getElementById('url-input');
        var urlForm  = document.getElementById('url-form');
        var backBtn  = document.getElementById('back-btn');
        var fwdBtn   = document.getElementById('fwd-btn');
        var reloadB  = document.getElementById('reload-btn');
        var homeBtn  = document.getElementById('home-btn');
        var settingsBtn = document.getElementById('settings-btn');
        var settingsMenu= document.getElementById('settings-menu');
        var menuDebugBtn= document.getElementById('menu-debug-btn');
        var zoomInB  = document.getElementById('zoom-in-btn');
        var zoomOutB = document.getElementById('zoom-out-btn');
        var zoomRstB = document.getElementById('zoom-reset-btn');

        // Debug panel handles
        var dbgPanel = document.getElementById('debug-panel');
        var dbgState = document.getElementById('dbg-state');
        var dbgLoadMs= document.getElementById('dbg-loadms');
        var dbgCursor= document.getElementById('dbg-cursor');
        var dbgUrl   = document.getElementById('dbg-url');
        var dbgHist  = document.getElementById('dbg-history');
        var dbgLog   = document.getElementById('dbg-log');
        var dbgClear = document.getElementById('debug-clear');
        var dbgClose = document.getElementById('debug-close');

        // HOME = the home-button target (DEFAULT_HOME, baked in by SSR
        // via the iframe's data-home attribute). The engine's initial
        // `src` may differ when an intent dispatched us at a specific
        // URL — that's the first history entry, not the home target.
        var HOME = engine.dataset.home || engine.getAttribute('src');
        var INITIAL = engine.getAttribute('src');
        // History stack of URLs. cursor points at the currently-visible
        // entry. Pushing a new URL truncates anything past the cursor.
        var history = [INITIAL];
        var cursor = 0;
        // True while we triggered the next iframe `load`; lets us skip
        // history pushes for back/forward jumps.
        var suppressPush = true;        // initial home load is the seed entry
        // Per-navigation timing.
        var navStartedAt = 0;
        var loadWatchdog = null;        // 15s timer for "still loading" warn

        function normalize(value) {
          var v = (value || '').trim();
          if (!v) return null;
          if (/^(https?|file|about|data):/i.test(v)) return v;          // explicit scheme
          if (/^[^\s]+\.[^\s]+$/.test(v)) return 'https://' + v;        // looks like a host
          return 'https://duckduckgo.com/?q=' + encodeURIComponent(v);  // fallthrough: search
        }
        function syncInputFromHistory() {
          // Don't clobber the user mid-edit — if they have the URL bar
          // focused and have typed something, leave their input alone
          // and let the next submit / blur take over.
          if (document.activeElement === urlInput) return;
          urlInput.value = history[cursor] || '';
        }
        function setUrlStale(stale) {
          if (stale) urlInput.setAttribute('data-stale', 'true');
          else       urlInput.removeAttribute('data-stale');
        }
        function syncButtons() {
          // In native mode the button state arrives with aura.surface.state —
          // our history array is only a mirror and would disagree.
          if (nativeMode && surfaceId) return;
          backBtn.disabled = cursor <= 0;
          fwdBtn.disabled  = cursor >= history.length - 1;
        }

        // ── Zoom ─────────────────────────────────────────────────
        // Most framed sites are cross-origin, so we can't touch their DOM
        // to zoom. Instead we scale the iframe element itself and counter-
        // size it (width/height = 100/zoom %) so it still fills the wrap.
        // The transform lives on the element, not the document, so it
        // survives navigation without re-applying.
        var ZOOM_MIN = 0.3, ZOOM_MAX = 3, ZOOM_STEP = 0.1;
        var zoom = 1;
        function applyZoom() {
          zoom = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, Math.round(zoom * 100) / 100));
          // Pin the scale anchor to the top-left inline too — a stray
          // transform-origin from anywhere else would make content drift.
          engine.style.transformOrigin = '0 0';
          engine.style.transform = 'scale(' + zoom + ')';
          engine.style.width  = (100 / zoom) + '%';
          engine.style.height = (100 / zoom) + '%';
          if (nativeMode && surfaceId) surfaceCommand('setZoom', { factor: zoom });
          var pct = Math.round(zoom * 100);
          zoomRstB.textContent = pct + '%';
          zoomInB.disabled  = zoom >= ZOOM_MAX;
          zoomOutB.disabled = zoom <= ZOOM_MIN;
          dbgLog_line('ok', 'zoom → ' + pct + '%');
        }

        // ── Debug logger ─────────────────────────────────────────
        function dbgLog_line(level, msg) {
          if (!dbgLog) return;
          var ts = new Date().toISOString().slice(11, 23);  // HH:MM:SS.mmm
          var line = '[' + ts + '] ' + msg + '\n';
          var span = document.createElement('span');
          span.className = 'ev-' + level;
          span.textContent = line;
          dbgLog.appendChild(span);
          dbgLog.scrollTop = dbgLog.scrollHeight;
        }
        function dbgRefresh() {
          if (!dbgPanel || dbgPanel.hidden) return;
          dbgCursor.textContent = (cursor + 1) + ' / ' + history.length;
          dbgUrl.textContent    = history[cursor] || '';
          dbgHist.innerHTML = '';
          for (var i = 0; i < history.length; i++) {
            var li = document.createElement('li');
            li.textContent = history[i];
            if (i === cursor) li.dataset.current = 'true';
            dbgHist.appendChild(li);
          }
        }
        function dbgSetState(s) { if (dbgState) dbgState.textContent = s; }
        function dbgSetLoadMs(ms) {
          if (dbgLoadMs) dbgLoadMs.textContent = ms == null ? '—' : ms + ' ms';
        }

        function navigate(url, opts) {
          opts = opts || {};
          var push = opts.push !== false;
          if (!url) return;
          if (push) {
            history.length = cursor + 1;
            history.push(url);
            cursor = history.length - 1;
          }
          suppressPush = true;
          // We're setting the src ourselves — the URL bar is truthful again.
          setUrlStale(false);
          chrome.dataset.loading = 'true';
          navStartedAt = performance.now();
          dbgSetState('loading');
          dbgSetLoadMs(null);
          dbgLog_line('ok', 'navigate → ' + url);
          // Watchdog: if load doesn't fire in 15s the engine may be
          // hung (slow site / XFO block). We just log it to the debug
          // panel — no modal overlay, the user keeps using the browser.
          clearTimeout(loadWatchdog);
          loadWatchdog = setTimeout(function () {
            dbgLog_line('warn', 'still loading after 15s — site may refuse framing (X-Frame-Options / CSP frame-ancestors)');
            dbgSetState('slow');
          }, 15000);
          if (nativeMode) {
            // The native window IS the engine here; the iframe stays parked at
            // about:blank underneath it.
            if (surfaceId) surfaceCommand('navigate', { url: url });
            else attachSurface(url);
          } else {
            detachSurface('navigate');
            engine.setAttribute('src', url);
          }
          syncInputFromHistory();
          syncButtons();
          dbgRefresh();
        }

        engine.addEventListener('load', function () {
          clearTimeout(loadWatchdog);
          chrome.dataset.loading = '';
          var ms = Math.round(performance.now() - navStartedAt);
          dbgSetLoadMs(ms);
          dbgSetState('idle');
          // Same-origin frames let us peek contentWindow.location to
          // capture user-driven nav (link clicks). Cross-origin throws;
          // we just trust the URL we set ourselves in that case.
          try {
            var real = engine.contentWindow && engine.contentWindow.location.href;
            if (real && !suppressPush && real !== history[cursor]) {
              history.length = cursor + 1;
              history.push(real);
              cursor = history.length - 1;
              syncInputFromHistory();
              syncButtons();
              dbgLog_line('ok', 'same-origin nav captured → ' + real);
            }
            // Successfully read the URL — the bar is truthful.
            setUrlStale(false);
            dbgLog_line('ok', 'load ' + ms + 'ms');
          } catch (_) {
            // Cross-origin: we got a load event so a navigation happened,
            // but browser security forbids reading where to. If this load
            // wasn't our own setAttribute, the URL bar value is now stale.
            if (!suppressPush) setUrlStale(true);
            dbgLog_line('ok', 'load ' + ms + 'ms (cross-origin, can\'t read URL)');
          }
          suppressPush = false;
          dbgRefresh();
        });
        engine.addEventListener('error', function () {
          clearTimeout(loadWatchdog);
          chrome.dataset.loading = '';
          dbgSetState('error');
          dbgLog_line('error', 'engine error event fired');
        });

        urlForm.addEventListener('submit', function (e) {
          e.preventDefault();
          var url = normalize(urlInput.value);
          if (url) navigate(url);
        });
        backBtn.addEventListener('click', function () {
          // In native mode the WebView owns the real session history, including
          // in-page navigations we never saw. Ask it to go back rather than
          // re-navigating to a URL from our own list.
          if (nativeMode && surfaceId) { surfaceCommand('goBack'); return; }
          if (cursor > 0) { cursor -= 1; navigate(history[cursor], { push: false }); }
        });
        fwdBtn.addEventListener('click', function () {
          if (nativeMode && surfaceId) { surfaceCommand('goForward'); return; }
          if (cursor < history.length - 1) { cursor += 1; navigate(history[cursor], { push: false }); }
        });
        reloadB.addEventListener('click', function () {
          if (nativeMode && surfaceId) { surfaceCommand('reload'); return; }
          navigate(history[cursor], { push: false });
        });
        homeBtn.addEventListener('click', function () { navigate(HOME); });
        zoomInB.addEventListener('click',  function () { zoom += ZOOM_STEP; applyZoom(); });
        zoomOutB.addEventListener('click', function () { zoom -= ZOOM_STEP; applyZoom(); });
        zoomRstB.addEventListener('click', function () { zoom = 1; applyZoom(); });

        // ── Host URL-relay (cross-origin URL tracking) ───────────
        // The WebView host injects a script into every nested frame
        // that postMessages `aura.host.url-changed` to window.top on
        // every navigation (initial / pushState / replaceState /
        // popstate / hashchange / title). The shell receives those
        // and forwards the matching event back to *this* browser
        // activity. We update the URL bar + in-memory history so
        // back/forward and the address bar reflect the real iframe
        // location even across origins.
        window.addEventListener('message', function (e) {
          var d = e.data;
          if (!d || typeof d !== 'object') return;
          if (d.type !== 'aura.host.url-changed') return;
          if (d.source !== 'host') return;
          if (typeof d.url !== 'string' || !d.url) return;
          var reason = typeof d.reason === 'string' ? d.reason : 'unknown';
          // `title` arrives without a URL change — leave history alone,
          // just refresh the URL bar styling to "fresh".
          if (reason !== 'title' && d.url !== history[cursor]) {
            history.length = cursor + 1;
            history.push(d.url);
            cursor = history.length - 1;
            syncButtons();
          }
          // Force the URL bar even if the user is mid-edit? No: keep
          // syncInputFromHistory's blur-respect rule. The bar will
          // re-sync on next blur / submit.
          syncInputFromHistory();
          setUrlStale(false);
          dbgLog_line('ok', 'host url-changed (' + reason + ') → ' + d.url);
          dbgRefresh();
        });

        // ── Native surface: pages that refuse to be framed ────────
        //
        // Some sites can only run as a top-level document — duck.ai's
        // anti-abuse challenge reads window.top.location while computing the
        // token that unlocks its UI, and frame-busters fail the same way.
        // window.top is [LegacyUnforgeable], so no shim is possible; the page
        // has to be top-level, which only the native host can provide.
        //
        // The OS detects the failure and tells us. We decide what to do with
        // it, and which part of our layout the native view should cover — the
        // OS then keeps it glued there through every window move, resize,
        // zoom and workspace switch.
        // nativeMode is decided once, at startup, by asking the OS whether the
        // host can give us a native window. We cannot check for Capacitor
        // ourselves: the host injects its bridge only into the shell's own
        // document, so window.Capacitor is undefined in here. Only the OS knows.
        var nativeMode  = false;
        var surfaceId   = null;
        var surfaceUrl  = null;
        var surfaceRO   = null;
        var nativeState = null;

        function sameSite(a, b) {
          try { return new URL(a).host === new URL(b).host; } catch (err) { return a === b; }
        }

        function engineRect() {
          // Our own CSS pixels — the OS converts out of this space.
          var r = engine.getBoundingClientRect();
          return { x: r.left, y: r.top, width: r.width, height: r.height };
        }

        function postToOs(type, extras) {
          if (window.parent === window) return;
          var msg = { type: type };
          for (var k in extras) if (Object.prototype.hasOwnProperty.call(extras, k)) msg[k] = extras[k];
          try { window.parent.postMessage(msg, '*'); } catch (err) { /* parent gone */ }
        }

        // Everything that wants the native window out of the way registers a
        // reason here. It is shown again only when the last reason clears —
        // two independent booleans would race (close the menu while the
        // launcher is still open and the window would pop up over it).
        //
        // Two sources: the OS reports its own overlays (launcher, process
        // manager, dialogs, lock screen) via aura.surface.occluded, and we add
        // our own popups, which are painted under the surface just the same.
        var hideReasons = {};

        function setHidden(reason, hidden) {
          if (hidden) hideReasons[reason] = true; else delete hideReasons[reason];
          var anyone = Object.keys(hideReasons).length > 0;
          if (anyone === surfaceHidden) return;
          surfaceHidden = anyone;
          surfaceCommand('setVisible', { visible: !anyone });
          dbgLog_line('ok', 'native window ' + (anyone ? 'hidden (' + Object.keys(hideReasons).join(',') + ')' : 'shown'));
        }
        var surfaceHidden = false;

        function surfaceCommand(action, payload) {
          if (!surfaceId) return;
          postToOs('aura.surface.command', {
            surfaceId: surfaceId, action: action, payload: payload || {},
          });
        }

        function attachSurface(url) {
          if (surfaceId && surfaceUrl === url) return;
          detachSurface('replace');
          // Unique per window: two Browser windows launching in the same
          // millisecond would otherwise pick the same id and fight over one
          // native view, since the host keys its surfaces by this string.
          surfaceId  = 's' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 8);
          surfaceUrl = url;
          postToOs('aura.surface.attach', {
            surfaceId: surfaceId, url: url, rect: engineRect(),
            // We already have an address bar and back/forward/reload/zoom —
            // the native window renders the page only.
            chrome: false,
          });
          // The iframe underneath is blanked so nothing peeks out around the
          // native view (in nativeMode it never renders a page at all).
          // visibility, not display: its rect is what defines the surface
          // bounds, so it has to keep its place in the layout. Without this the
          // iframe's white about:blank flashes through whenever the surface
          // hides for an overlay, on an otherwise dark desktop.
          engine.style.visibility = 'hidden';
          engine.setAttribute('src', 'about:blank');
          chrome.dataset.loading = 'false';
          dbgSetState('native');
          dbgLog_line('ok', 'native surface attached → ' + url);
          // Our own layout can change without the window moving (debug panel
          // opening, toolbar wrapping); the OS handles the window, we handle us.
          if (window.ResizeObserver && !surfaceRO) {
            surfaceRO = new ResizeObserver(function () { syncSurfaceBox(); });
            surfaceRO.observe(engine);
          }
          syncSurfaceBox();
        }

        /**
         * Our own box, watched by a ResizeObserver, is the workspace-switch
         * hook. The shell puts an off-workspace slot behind `display: none`, so
         * everything inside it — including this element — collapses to 0x0, and
         * that is a signal the app can read without knowing anything about
         * workspaces. Minimising the window looks identical, which is the point.
         *
         * The surface has to be hidden rather than just left alone: it is a
         * native view positioned in screen coordinates, so it does not follow
         * the iframe out of view — it would keep painting over whatever
         * workspace you switched to.
         */
        function syncSurfaceBox() {
          if (!surfaceId) return;
          var r = engineRect();
          var offscreen = r.width <= 0 || r.height <= 0;
          setHidden('offscreen', offscreen);
          // A zero rect is not a position; only send real geometry.
          if (!offscreen) postToOs('aura.surface.setRect', { surfaceId: surfaceId, rect: r });
        }

        function detachSurface(why) {
          if (!surfaceId) return;
          postToOs('aura.surface.detach', { surfaceId: surfaceId });
          dbgLog_line('ok', 'native surface detached (' + why + ')');
          surfaceId = null;
          surfaceUrl = null;
          hideReasons = {};
          surfaceHidden = false;
          engine.style.visibility = '';
          if (surfaceRO) { try { surfaceRO.disconnect(); } catch (err) {} surfaceRO = null; }
        }

        window.addEventListener('message', function (e) {
          var d = e.data;
          if (!d || typeof d !== 'object') return;

          // Startup capability answer.
          if (d.type === 'aura.surface.capability') {
            nativeMode = d.supported === true;
            dbgLog_line('ok', 'native window support: ' + (nativeMode ? 'yes' : 'no'));
            if (nativeMode) {
              // Take over immediately: whatever the iframe was showing gets
              // re-opened natively so there is one consistent engine.
              var start = history[cursor] || HOME;
              engine.setAttribute('src', 'about:blank');
              attachSurface(start);
            }
            return;
          }

          // A shell overlay (launcher, process manager, dialog, lock screen)
          // has moved over our window. Nothing in the DOM can draw above a
          // native surface, so the overlay would be invisible until we step
          // aside. The OS only reports the overlap; hiding is ours to do.
          if (d.type === 'aura.surface.occluded' && d.surfaceId === surfaceId) {
            // One reason slot, not one per overlay name: the OS tracks a single
            // occluder and reports `by: null` when it clears, so keying on the
            // name would leave the hide-reason stuck forever and the window
            // would never come back.
            if (d.by) dbgLog_line('ok', 'covered by ' + d.by);
            setHidden('shellOverlay', d.occluded === true);
            return;
          }

          // Live navigation state from the native window. Our address bar,
          // title and back/forward buttons run entirely off this.
          if (d.type === 'aura.surface.state' && d.surfaceId === surfaceId) {
            var st = d.state || {};
            nativeState = st;
            if (typeof st.url === 'string' && st.url && st.url !== 'about:blank') {
              if (st.url !== history[cursor]) {
                history.length = cursor + 1;
                history.push(st.url);
                cursor = history.length - 1;
              }
              surfaceUrl = st.url;
              syncInputFromHistory();
              setUrlStale(false);
            }
            // canGoBack/Forward come from the native view's own history, which
            // is the truth — our array only mirrors what we asked for.
            if (typeof st.canGoBack === 'boolean') backBtn.disabled = !st.canGoBack;
            if (typeof st.canGoForward === 'boolean') fwdBtn.disabled = !st.canGoForward;
            chrome.dataset.loading = (st.progress != null && st.progress < 100) ? 'true' : 'false';
            if (st.reason === 'pageFinished') { dbgSetState('idle'); dbgRefresh(); }
            return;
          }

          if (d.type !== 'aura.host.needsTopLevel') return;
          if (typeof d.url !== 'string' || !d.url) return;
          // Only act when it is OUR page: the OS broadcasts remembered hosts
          // to every window, since it cannot tell which one framed the URL.
          var current = history[cursor];
          if (!current || !sameSite(d.url, current)) return;
          dbgLog_line('warn', 'cannot be framed (' + (d.reason || '?') + ') → going native');
          attachSurface(d.url);
        });

        // Startup probe: does the host offer native windows? The answer
        // arrives as aura.surface.capability and decides nativeMode for the
        // rest of this session.
        postToOs('aura.surface.query', {});

        // ── Settings dropdown ─────────────────────────────────────
        function toggleMenu(open) {
          var next = (open == null) ? settingsMenu.hidden : open;
          settingsMenu.hidden = !next;
          settingsBtn.setAttribute('aria-expanded', String(next));
          // The dropdown opens downward over the engine area.
          if (nativeMode) setHidden('settingsMenu', next);
        }
        settingsBtn.addEventListener('click', function (e) {
          e.stopPropagation();   // don't let the outside-click handler re-close it
          toggleMenu();
        });
        // Close the menu on any click outside it (the ⚙ click is stopped above).
        document.addEventListener('click', function (e) {
          if (settingsMenu.hidden) return;
          if (settingsMenu.contains(e.target)) return;
          toggleMenu(false);
        });

        // ── Debug panel toggle ────────────────────────────────────
        function toggleDebug(open) {
          var next = (open == null) ? dbgPanel.hidden : open;
          dbgPanel.hidden = !next;
          menuDebugBtn.setAttribute('aria-pressed', String(next));
          if (next) dbgRefresh();
          // The debug panel is absolutely positioned inside .engine-wrap.
          if (nativeMode) setHidden('debugPanel', next);
        }
        menuDebugBtn.addEventListener('click', function () {
          toggleDebug();
          toggleMenu(false);   // selecting an item closes the dropdown
        });
        dbgClose.addEventListener('click', function () { toggleDebug(false); });
        dbgClear.addEventListener('click', function () {
          dbgLog.textContent = '';
          dbgLog_line('ok', 'log cleared');
        });

        // Common browser shortcuts. Bubble phase so URL-bar typing still
        // works normally — input consumes the event first when focused.
        window.addEventListener('keydown', function (e) {
          if (e.altKey && e.key === 'ArrowLeft')  { e.preventDefault(); backBtn.click(); }
          if (e.altKey && e.key === 'ArrowRight') { e.preventDefault(); fwdBtn.click();  }
          if (e.ctrlKey && (e.key === 'r' || e.key === 'R')) { e.preventDefault(); reloadB.click(); }
          if (e.ctrlKey && (e.key === 'l' || e.key === 'L')) { e.preventDefault(); urlInput.focus(); urlInput.select(); }
          if (e.ctrlKey && e.shiftKey && (e.key === 'd' || e.key === 'D')) { e.preventDefault(); toggleDebug(); }
          if (e.key === 'Escape' && !settingsMenu.hidden) { e.preventDefault(); toggleMenu(false); }
          if (e.ctrlKey && (e.key === '=' || e.key === '+')) { e.preventDefault(); zoomInB.click(); }
          if (e.ctrlKey && e.key === '-')                    { e.preventDefault(); zoomOutB.click(); }
          if (e.ctrlKey && e.key === '0')                    { e.preventDefault(); zoomRstB.click(); }
        });

        syncInputFromHistory();
        syncButtons();
        dbgLog_line('ok', 'browser ready · home = ' + HOME);
        navStartedAt = performance.now();   // first paint timing starts here
      })();
    </script>
  </body>
</html>
