        var nativeMode  = false;
        var nativeSupported = false;
        var NATIVE_PREF_KEY = 'aura.browser.nativeMode';
        var nativeWanted = true;
        try { nativeWanted = localStorage.getItem(NATIVE_PREF_KEY) !== 'off'; } catch (err) { /* storage blocked */ }
