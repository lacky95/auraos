        font-size: 0.78rem;
        line-height: 1.3;
        text-align: left;
        min-width: 0;
        background: transparent;
        color: var(--aura-color-text, #ccffcc);
        border: 1px solid transparent;
        padding: 6px 10px;
        cursor: pointer;
        white-space: nowrap;
      }
