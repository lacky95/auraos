        border-color: var(--aura-color-primary, #00ff41);
        color: var(--aura-color-primary, #00ff41);
        outline: none;
      }
      .settings-menu button:disabled { opacity: 0.5; cursor: default; }
      .settings-menu button:disabled:hover { border-color: transparent; color: var(--aura-color-text, #ccffcc); }
      .settings-menu button[aria-checked="true"],
