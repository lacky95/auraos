        top: calc(100% + 4px);
        right: 0;
        min-width: 160px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 4px;
        background: var(--aura-color-surface, #111);
        border: 1px solid var(--aura-color-primary, #00ff41);
        box-shadow: 0 8px 24px rgba(0,0,0,0.5);
        z-index: 10;
      }
      .settings-menu[hidden] { display: none; }
