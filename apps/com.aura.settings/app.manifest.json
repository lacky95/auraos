{
  "id": "com.aura.settings",
  "name": "Settings",
  "icon": "SET",
  "version": "0.1.0",
  "description": "OS settings \u2014 themes, workspaces, general preferences. UI over the OS KV (no longer a content provider). Also serves the Interface Registry as an MCP server.",
  "category": "system",
  "permissions": [
    "storage.read",
    "storage.write",
    "system.theme.broadcast",
    "system.kv.os.theme.write",
    "system.kv.os.workspaces.write",
    "system.kv.os.clockFormat.write",
    "system.kv.os.locale.write",
    "system.kv.os.keymap.write",
    "system.kv.os.lockscreen.write"
  ],
  "provides": [
    {
      "name": "interfaces",
      "kind": "mcp",
      "address": "/mcp/interfaces",
      "version": "1",
      "description": "MCP server over the OS Interface Registry: list providers, resolve a ref, read the consumer report."
    }
  ],
  "tools": [
    "bash",
    "node",
    "claude",
    "gh"
  ],
  "instanceMode": "single",
  "activityMode": "multi",
  "defaultLaunch": "new-activity",
  "backgroundService": true,
  "autoStart": false,
  "useProot": true,
  "sandbox": "container",
  "viewConfig": {
    "defaultWidth": 700,
    "defaultHeight": 500,
    "resizable": true
  },
  "preferredLayout": "tiling"
}
