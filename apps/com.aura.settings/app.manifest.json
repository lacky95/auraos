{
  "id": "com.aura.settings",
  "name": "Settings",
  "version": "0.1.0",
  "description": "OS settings — themes, general preferences. Acts as a content provider for other apps.",
  "category": "system",
  "permissions": ["storage.read", "storage.write", "system.theme.broadcast"],
  "tools": ["bash", "node"],
  "instanceMode": "single",
  "activityMode": "multi",
  "defaultLaunch": "new-activity",
  "backgroundService": true,
  "viewConfig": {
    "defaultWidth": 700,
    "defaultHeight": 500,
    "resizable": true
  },
  "preferredLayout": "tiling",
  "dataProvider": {
    "authority": "com.aura.settings",
    "providers": [
      { "path": "/api/data/settings", "readPermission": "settings.read", "writePermission": "settings.write" },
      { "path": "/api/data/theme",    "readPermission": "settings.read", "writePermission": "settings.theme.write" },
      { "path": "/api/data/themes",   "readPermission": "settings.read" }
    ]
  }
}
