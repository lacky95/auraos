---
import '../styles/settings.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Settings — AuraOS</title>
  <link rel="stylesheet" href="/api/os/theme.css" />
</head>
<body>
  <main class="settings-body">
    <div class="tile-grid">
      <button class="tile" data-section="theme">
        <h3>▦ THEME</h3>
        <p>Phosphor color · live preview · 4 presets</p>
      </button>
      <button class="tile" data-section="workspaces">
        <h3>▥ WORKSPACES</h3>
        <p>Virtual desktops · layouts · rename + delete</p>
      </button>
      <button class="tile" data-section="layouts">
        <h3>▦ LAYOUT MANAGERS</h3>
        <p>Window strategies · parameters · per-strategy settings</p>
      </button>
      <button class="tile" data-section="keyboard">
        <h3>⌨ KEYBOARD</h3>
        <p>Hotkeys · per-app actions · user shortcuts</p>
      </button>
      <button class="tile" data-section="general">
        <h3>⏱ GENERAL</h3>
        <p>Clock format · locale</p>
      </button>
      <button class="tile" data-section="apps">
        <h3>▦ APPS</h3>
        <p>Enable · disable · force-stop installed apps</p>
      </button>
      <button class="tile" data-section="about">
        <h3>ℹ ABOUT</h3>
        <p>AuraOS · versions</p>
      </button>
    </div>
  </main>
  <footer class="settings-foot">CONTENT PROVIDER · com.aura.settings</footer>

  <script is:inline>
    // Two launch modes for Settings sections:
    //
    //   • Click       → IN-PLACE navigate. The current iframe URL changes
    //                   to the section's path; OS Back returns here.
    //   • Shift+Click → NEW ACTIVITY. Spawns a separate Settings panel in
    //                   the layout (the original behavior). Useful for
    //                   side-by-side compare or pinning a section.
    //
    // The in-place path uses the OS endpoint /api/activities/<id>/navigate.
    // We resolve the activity id from the meta tag the shell proxy injects.
    function getActivityId() {
      const meta = document.querySelector('meta[name="aura-activity-id"]');
      return meta ? meta.getAttribute('content') : null;
    }

    function pathForSection(section) {
      switch (section) {
        case 'theme':      return ['/theme',      'Settings · Theme'];
        case 'workspaces': return ['/workspaces', 'Settings · Workspaces'];
        case 'layouts':    return ['/layouts',    'Settings · Layout Managers'];
        case 'keyboard':   return ['/keyboard',   'Settings · Keyboard'];
        case 'general':    return ['/general',    'Settings · General'];
        case 'apps':       return ['/apps',       'Settings · Apps'];
        case 'about':      return ['/about',      'Settings · About'];
        default:           return ['/',           'Settings'];
      }
    }

    document.querySelectorAll('.tile[data-section]').forEach((btn) => {
      btn.addEventListener('click', async (ev) => {
        const section = btn.dataset.section;
        // Shift+Click → keep the old "new activity" behavior so the user
        // can have multiple Settings panels open.
        if (ev.shiftKey) {
          try {
            const r = await fetch('/api/instances/com.aura.settings/activities', {
              method:  'POST',
              headers: { 'Content-Type': 'application/json' },
              body:    JSON.stringify({ data: { section } }),
            });
            if (!r.ok) console.error('[settings] open activity HTTP', r.status, await r.text());
          } catch (err) { console.error('[settings] open activity failed', err); }
          return;
        }

        // Plain click → in-place navigation. The OS records '/' on the
        // back stack so Escape returns to the overview.
        const id = getActivityId();
        const [path, title] = pathForSection(section);
        if (!id) {
          // No activity context (shouldn't happen in practice) — fall
          // back to opening a new activity so the click still works.
          await fetch('/api/instances/com.aura.settings/activities', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ data: { section } }),
          });
          return;
        }
        try {
          const r = await fetch(`/api/activities/${encodeURIComponent(id)}/navigate`, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ path, title }),
          });
          if (!r.ok) console.error('[settings] navigate HTTP', r.status, await r.text());
        } catch (err) { console.error('[settings] navigate failed', err); }
      });
    });

    // Window-selection mode → Enter on the Settings window posts
    // `aura.window.focus` to this iframe. Auto-focus the first tile so the
    // arrow-nav helper has a starting point. Inline (not in the bundled
    // SDK script below) so this is GUARANTEED to install on page load —
    // any Vite resolution hiccup on the SDK import wouldn't break the
    // initial focus.
    //
    // Retry across a few frames: the browser's "restore iframe last-
    // focused descendant" task can fire AFTER our handler and overwrite
    // our `.focus()` call with `body`. Up to 4 frames is enough in
    // practice.
    window.addEventListener('message', (ev) => {
      if (ev.data?.type !== 'aura.window.focus') return;
      const tiles = Array.from(document.querySelectorAll('.tile[data-section]'));
      if (tiles.length === 0) return;
      const first = tiles[0];
      let attempt = 0;
      const tryFocus = () => {
        first.focus();
        if (document.activeElement === first || attempt >= 4) return;
        attempt += 1;
        requestAnimationFrame(tryFocus);
      };
      requestAnimationFrame(tryFocus);
    });
  </script>

  <!--
    Arrow-walk the 7 tiles. Enter activates (native button click). Bound
    here via the OS SDK so user remaps of `aura.nav.{up,down,left,right}`
    (Settings → Keyboard) take effect on next load. The auto-focus on
    `aura.window.focus` is duplicated above as an inline fallback in case
    Astro/Vite hasn't bundled this script yet.
  -->
  <script>
    import { OsClient } from '@aura/app-sdk';
    new OsClient().nav.installGridNav({ selector: '.tile[data-section]' });
  </script>
</body>
</html>
