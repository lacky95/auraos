---
import '@aura/ui/styles/scificn-bridge.css';
import '../styles/settings.css';

/**
 * Layout Managers — catalogue + per-strategy settings.
 *
 * Each registered layout strategy gets a card listing its metadata and
 * (eventually) editable parameters. The picker that assigns a strategy
 * to a workspace stays in Settings › Workspaces; this page is the
 * inventory + configuration surface.
 *
 * Strategy metadata is sourced from the OS-side registry endpoint so
 * Settings doesn't need to redeclare the catalogue.
 */

interface LayoutMeta {
  id:                       string;
  name:                     string;
  description:              string;
  icon?:                    string;
  minViews?:                number;
  supportsManualPlacement?: boolean;
}

const osBase = process.env['OS_API_BASE'] ?? 'http://127.0.0.1:3000';
let layouts: LayoutMeta[] = [];
try {
  const r = await fetch(`${osBase}/api/os/layouts`, { signal: AbortSignal.timeout(2000) });
  if (r.ok) layouts = await r.json() as LayoutMeta[];
} catch {
  // Endpoint unreachable (shell still booting / dev mode hiccup) — render
  // an empty state instead of failing the page. Refresh restores normally.
}

// Active per-workspace assignment count so each card can show how many
// workspaces currently use the strategy — gives the page a "where is this
// in use?" signal without needing a second click into Workspaces.
let usage: Record<string, number> = {};
try {
  const r = await fetch(`${osBase}/api/kv/os/workspaces`, { signal: AbortSignal.timeout(2000) });
  if (r.ok) {
    const body = await r.json() as { value?: { workspaces?: Array<{ layoutId: string }> } };
    for (const w of body.value?.workspaces ?? []) {
      usage[w.layoutId] = (usage[w.layoutId] ?? 0) + 1;
    }
  }
} catch { /* non-fatal — usage column just shows 0 */ }
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Settings · Layout Managers — AuraOS</title>
  <link rel="stylesheet" href="/api/os/theme.css" />
</head>
<body>
  <main class="settings-body">
    <p class="theme-intro">
      WINDOW LAYOUT STRATEGIES · ASSIGN PER-WORKSPACE IN SETTINGS › WORKSPACES
    </p>

    {layouts.length === 0 ? (
      <div class="lm-empty">
        <div class="lm-empty-icon">○</div>
        <div class="lm-empty-text">NO LAYOUT MANAGERS REGISTERED</div>
        <div class="lm-empty-hint">// CHECK /api/os/layouts</div>
      </div>
    ) : (
      <ul class="lm-list">
        {layouts.map((L) => {
          const inUse = usage[L.id] ?? 0;
          return (
            <li class="lm-card" data-layout-id={L.id}>
              <div class="lm-card-head">
                <span class="lm-card-glyph" aria-hidden="true">{L.icon ?? '▦'}</span>
                <div class="lm-card-title-block">
                  <div class="lm-card-title">
                    <span class="lm-card-name">{L.name}</span>
                    <span class="lm-card-id">{L.id}</span>
                  </div>
                  <p class="lm-card-desc">{L.description}</p>
                </div>
                <div class="lm-card-meta">
                  <span class="lm-meta-chip" title="Workspaces using this layout">
                    <span class="lm-meta-label">USED</span>
                    <span class="lm-meta-value">{inUse}</span>
                  </span>
                  {L.minViews && L.minViews > 1 && (
                    <span class="lm-meta-chip" title="Minimum view count this strategy needs">
                      <span class="lm-meta-label">MIN VIEWS</span>
                      <span class="lm-meta-value">{L.minViews}</span>
                    </span>
                  )}
                  {L.supportsManualPlacement && (
                    <span class="lm-meta-chip lm-meta-flag" title="User-positioned slots (drag + resize)">DRAG</span>
                  )}
                </div>
              </div>
              <div class="lm-card-params">
                <div class="lm-params-head">PARAMETERS</div>
                <div class="lm-params-body lm-params-empty">
                  // NO CONFIGURABLE PARAMETERS YET
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </main>
  <footer class="settings-foot">CONTENT PROVIDER · OS /api/os/layouts</footer>

  <style>
    .lm-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      padding: 48px 12px;
      color: var(--aura-color-text-dim);
    }
    .lm-empty-icon { font-size: 2.4rem; color: var(--aura-color-border); }
    .lm-empty-text { font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; }
    .lm-empty-hint { font-size: 0.6rem; letter-spacing: 0.1em; }

    .lm-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .lm-card {
      background: var(--aura-color-surface-2);
      border: 1px solid var(--aura-color-border);
      display: flex;
      flex-direction: column;
    }
    .lm-card-head {
      display: grid;
      grid-template-columns: 44px 1fr auto;
      gap: 12px;
      align-items: flex-start;
      padding: 12px;
    }
    .lm-card-glyph {
      width: 44px; height: 44px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem;
      color: var(--aura-color-primary);
      border: 1px solid var(--aura-color-border);
    }
    .lm-card-title-block { min-width: 0; }
    .lm-card-title {
      display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;
    }
    .lm-card-name {
      font-size: 0.9rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--aura-color-primary);
    }
    .lm-card-id {
      font-size: 0.65rem;
      color: var(--aura-color-text-dim);
      letter-spacing: 0.06em;
    }
    .lm-card-desc {
      margin: 4px 0 0;
      font-size: 0.7rem;
      line-height: 1.5;
      letter-spacing: 0.04em;
      color: var(--aura-color-text);
    }
    .lm-card-meta {
      display: flex;
      gap: 6px;
      flex-shrink: 0;
      flex-wrap: wrap;
      justify-content: flex-end;
    }
    .lm-meta-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 8px;
      border: 1px solid var(--aura-color-border);
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      color: var(--aura-color-text-dim);
    }
    .lm-meta-label { color: var(--aura-color-text-dim); }
    .lm-meta-value { color: var(--aura-color-primary); font-weight: 600; }
    .lm-meta-flag  { color: var(--aura-color-secondary); border-color: var(--aura-color-secondary); }

    .lm-card-params {
      border-top: 1px dashed var(--aura-color-border);
      padding: 10px 12px 12px;
    }
    .lm-params-head {
      font-size: 0.6rem;
      letter-spacing: 0.14em;
      color: var(--aura-color-text-dim);
      margin-bottom: 6px;
    }
    .lm-params-body {
      font-size: 0.7rem;
      color: var(--aura-color-text);
      letter-spacing: 0.04em;
    }
    .lm-params-empty {
      color: var(--aura-color-text-dim);
      font-style: italic;
    }
  </style>
</body>
</html>
