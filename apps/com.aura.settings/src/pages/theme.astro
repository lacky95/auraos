---
import '@aura/ui/styles/scificn-bridge.css';
import '../styles/settings.css';
import ColorModePicker from '../components/ColorModePicker.tsx';

// SSR-read the active theme selection from the OS KV. The page lives in
// the Settings iframe, which is proxied by the shell — we hit the shell's
// internal port (OS_API_BASE injected by ProotRunner) to bypass the proxy
// and avoid the Referer-based permission gate.
const osBase = process.env['OS_API_BASE'] ?? 'http://127.0.0.1:3000';
let currentDarkId    = 'sci-fi';
let currentLightId   = 'paper';
let currentColorMode: 'light' | 'dark' | 'auto' = 'dark';
try {
  const r = await fetch(`${osBase}/api/kv/os/theme`, { signal: AbortSignal.timeout(2000) });
  if (r.ok) {
    const body = await r.json() as { value?: { themeIdDark?: string; themeIdLight?: string; colorMode?: typeof currentColorMode } };
    if (body.value?.themeIdDark)  currentDarkId    = body.value.themeIdDark;
    if (body.value?.themeIdLight) currentLightId   = body.value.themeIdLight;
    if (body.value?.colorMode)    currentColorMode = body.value.colorMode;
  }
} catch { /* fall back to defaults */ }

/* Theme catalog — sourced LIVE from the OS so this picker never drifts from
 * the real ThemeManager (the viewport dialog reads the same catalog). We hit
 * the shell's `/api/os/themes` endpoint, which serves ThemeManager.listSummaries()
 * including a preview swatch. Falls back to an empty list only if the shell is
 * unreachable; the active selection still comes from /api/kv/os/theme above. */
type ToneSwatch = { primary: string; secondary: string; bg: string };
type ThemeCard  = { id: string; name: string; description: string; tone: 'dark' | 'light'; swatch: ToneSwatch };

let THEMES: ThemeCard[] = [];
try {
  const tr = await fetch(`${osBase}/api/os/themes`, { signal: AbortSignal.timeout(2000) });
  if (tr.ok) {
    const body = await tr.json() as {
      themes?: Array<{ id: string; name: string; description?: string; tone: 'dark' | 'light'; swatch: ToneSwatch }>;
    };
    THEMES = (body.themes ?? []).map(t => ({
      id: t.id, name: t.name, tone: t.tone, description: t.description ?? '', swatch: t.swatch,
    }));
  }
} catch { /* shell unreachable — render with no cards rather than a stale copy */ }

const darkThemes  = THEMES.filter(t => t.tone === 'dark');
const lightThemes = THEMES.filter(t => t.tone === 'light');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Settings · Theme — AuraOS</title>
  <link rel="stylesheet" href="/api/os/theme.css" />
</head>
<body>
  <main class="settings-body">
    <p class="theme-intro">
      PICK YOUR DARK THEME AND YOUR LIGHT THEME — COLOR MODE TOGGLES BETWEEN THEM
    </p>

    <section class="theme-section">
      <header class="theme-section-head">
        <h2>// DARK THEMES</h2>
        <span class="active-when">ACTIVE WHEN COLOR MODE = DARK<br/>OR AUTO + OS PREFERS DARK</span>
      </header>
      <div class="theme-row" data-slot="dark">
        {darkThemes.map(t => (
          <button class="theme-card" data-theme-id={t.id} data-slot="dark" data-active={t.id === currentDarkId} title={t.description}>
            <div class="swatches">
              <div class="swatch" style={`background:${t.swatch.primary}`}></div>
              <div class="swatch" style={`background:${t.swatch.secondary}`}></div>
              <div class="swatch" style={`background:${t.swatch.bg}; border-color:rgba(255,255,255,0.15)`}></div>
            </div>
            <div class="name">{t.name}</div>
            <div class="card-desc">{t.description}</div>
            {t.id === currentDarkId && <span class="active-tag">● ACTIVE</span>}
          </button>
        ))}
      </div>
    </section>

    <section class="theme-section">
      <header class="theme-section-head">
        <h2>// LIGHT THEMES</h2>
        <span class="active-when">ACTIVE WHEN COLOR MODE = LIGHT<br/>OR AUTO + OS PREFERS LIGHT</span>
      </header>
      <div class="theme-row" data-slot="light">
        {lightThemes.map(t => (
          <button class="theme-card" data-theme-id={t.id} data-slot="light" data-active={t.id === currentLightId} title={t.description}>
            <div class="swatches">
              <div class="swatch" style={`background:${t.swatch.primary}`}></div>
              <div class="swatch" style={`background:${t.swatch.secondary}`}></div>
              <div class="swatch" style={`background:${t.swatch.bg}; border-color:rgba(0,0,0,0.15)`}></div>
            </div>
            <div class="name">{t.name}</div>
            <div class="card-desc">{t.description}</div>
            {t.id === currentLightId && <span class="active-tag">● ACTIVE</span>}
          </button>
        ))}
      </div>
    </section>

    <section class="theme-section">
      <header class="theme-section-head">
        <h2>// COLOR MODE</h2>
        <span class="active-when">DECIDES WHICH SLOT IS ACTIVE</span>
      </header>
      <ColorModePicker client:load defaultMode={currentColorMode} />
      <p class="auto-hint">AUTO FOLLOWS YOUR OPERATING SYSTEM'S PREFERS-COLOR-SCHEME.</p>
    </section>

    <p id="status" class="theme-status">
      DARK: <b style="color: var(--aura-color-primary);">{currentDarkId.toUpperCase()}</b>
      &nbsp;·&nbsp;
      LIGHT: <b style="color: var(--aura-color-primary);">{currentLightId.toUpperCase()}</b>
      &nbsp;·&nbsp;
      MODE: <b style="color: var(--aura-color-primary);">{currentColorMode.toUpperCase()}</b>
    </p>
  </main>
  <footer class="settings-foot">PROVIDER · PUT /api/kv/os/theme · BROADCASTS theme:changed + mode:changed</footer>

  <script is:inline>
    const statusEl = document.getElementById('status');

    function paintStatus({ themeIdDark, themeIdLight, colorMode }) {
      statusEl.innerHTML =
        `DARK: <b style="color: var(--aura-color-primary);">${themeIdDark.toUpperCase()}</b>` +
        ` &middot; LIGHT: <b style="color: var(--aura-color-primary);">${themeIdLight.toUpperCase()}</b>` +
        ` &middot; MODE: <b style="color: var(--aura-color-primary);">${colorMode.toUpperCase()}</b>`;
    }

    function markActiveCard(slot, themeId) {
      document.querySelectorAll(`.theme-card[data-slot="${slot}"]`).forEach((c) => {
        const active = c.dataset.themeId === themeId;
        c.dataset.active = active ? 'true' : 'false';
        let tag = c.querySelector('.active-tag');
        if (active && !tag) {
          tag = document.createElement('span');
          tag.className = 'active-tag';
          tag.textContent = '● ACTIVE';
          c.appendChild(tag);
        } else if (!active && tag) {
          tag.remove();
        }
      });
    }

    async function selectTheme(slot, themeId) {
      try {
        // KV is full-value-replace, so read-modify-write to merge the
        // single field the user just clicked.
        const cur = await fetch('/api/kv/os/theme');
        const previous = cur.ok ? ((await cur.json()).value ?? {}) : {};
        const field = slot === 'dark' ? 'themeIdDark' : 'themeIdLight';
        const next = { ...previous, [field]: themeId };
        const res = await fetch('/api/kv/os/theme', {
          method:  'PUT',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ value: next }),
        });
        if (!res.ok) throw new Error(await res.text());
        markActiveCard(slot, themeId);
        paintStatus(next);
      } catch (err) {
        statusEl.innerHTML = `<b style="color: var(--aura-color-danger);">ERROR — ${err.message}</b>`;
      }
    }

    document.querySelectorAll('.theme-card[data-theme-id]').forEach((card) => {
      card.addEventListener('click', () => selectTheme(card.dataset.slot, card.dataset.themeId));
    });

    /* ---- Color-mode picker ----
     * Now owned by the <ColorModePicker /> React island. The island handles
     * matchMedia, postMessage sync, PUT broadcasts, and its own visual state.
     * We just keep the theme-card live-update logic + the status line refresh
     * below, both of which sit outside the island. */

    /* ---- Live updates from the shell (theme cards + status line) ---- */
    window.addEventListener('message', (ev) => {
      const t = ev.data?.type;
      if (t !== 'aura.theme.changed' && t !== 'aura.mode.changed') return;
      const link = document.querySelector('link[rel="stylesheet"][href^="/api/os/theme.css"]');
      if (link) link.setAttribute('href', '/api/os/theme.css?t=' + Date.now());
      if (ev.data.themeIdDark)  markActiveCard('dark',  ev.data.themeIdDark);
      if (ev.data.themeIdLight) markActiveCard('light', ev.data.themeIdLight);
      if (ev.data.themeIdDark && ev.data.themeIdLight && ev.data.colorMode) paintStatus(ev.data);
    });
  </script>

  <!-- Arrow-walk the theme cards; Enter activates a card. Spatial picker
       crosses the dark / light section boundary naturally because the two
       rows live in different y-bands. -->
  <script>
    import { OsClient } from '@aura/app-sdk';
    new OsClient().nav.installGridNav({ selector: '.theme-card[data-theme-id]' });
  </script>
</body>
</html>
