---
import '@aura/ui/styles/scificn-bridge.css';
import '../../../styles/settings.css';
import '../../../components/interface-form.css';
import InterfaceForm, { type CustomInterface } from '../../../components/InterfaceForm';

// Edit a custom interface. SSR loads the stored entry; the island PUTs it back.
const osBase = process.env['OS_API_BASE'] ?? 'http://127.0.0.1:3000';
const name = Astro.params['name'] ?? '';
let entry: CustomInterface | null = null;
try {
  const r = await fetch(`${osBase}/api/interfaces/custom/${encodeURIComponent(name)}`, { signal: AbortSignal.timeout(2000) });
  if (r.ok) entry = ((await r.json()) as { interface: CustomInterface }).interface;
} catch { /* rendered as not found below */ }
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Settings · Edit interface — AuraOS</title>
  <link rel="stylesheet" href="/api/os/theme.css" />
</head>
<body>
  <main class="settings-body">
    <p class="theme-intro">EDIT INTERFACE · custom/{name}</p>
    {entry
      ? <InterfaceForm client:load initial={entry} />
      : <p class="theme-intro">NO CUSTOM INTERFACE NAMED '{name}'.</p>}
  </main>
  <footer class="settings-foot">PROVIDER · /api/interfaces/custom</footer>

  <script>
    import { OsClient } from '@aura/app-sdk';
    new OsClient().nav.installGridNav({
      selector: '.settings-body button, .settings-body input[type="text"]',
    });
  </script>
</body>
</html>
