---
import '@aura/ui/styles/scificn-bridge.css';
import '../styles/settings.css';
import WorkspaceManager from '../components/WorkspaceManager.tsx';

/**
 * Workspace + layout-strategy management page.
 *
 * SSR seeds the initial workspace list from the persisted state; the React
 * island ({@link WorkspaceManager}) takes over for interactivity and pulls
 * fresh state on window focus + after every mutation. Layout strategies
 * come from `/api/data/layouts` (a Settings-mirror of @aura/core's
 * `LayoutStrategyRegistry`).
 */
// SSR-read workspace state directly from the shell's KV. OS_API_BASE
// is injected by ProotRunner so we can talk to the shell over the
// internal localhost interface without the Referer permission gate.
const osBase = process.env['OS_API_BASE'] ?? 'http://127.0.0.1:3000';
let workspaces = {
  workspaces: [{ id: 'ws-1', name: 'Main', layoutId: 'tiling', members: [] }],
  activeWorkspaceId: 'ws-1',
};
try {
  const r = await fetch(`${osBase}/api/kv/os/workspaces`, { signal: AbortSignal.timeout(2000) });
  if (r.ok) {
    const body = await r.json() as { value?: typeof workspaces };
    if (body.value) workspaces = body.value;
  }
} catch { /* keep defaults */ }
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Settings · Workspaces — AuraOS</title>
  <link rel="stylesheet" href="/api/os/theme.css" />
</head>
<body>
  <main class="settings-body">
    <p class="theme-intro">
      VIRTUAL DESKTOPS · EACH WORKSPACE HAS ITS OWN LAYOUT STRATEGY AND MEMBER SET
    </p>
    <WorkspaceManager client:load initialState={workspaces} />
  </main>
  <footer class="settings-foot">CONTENT PROVIDER · com.aura.settings/workspaces</footer>

  <!-- Arrow-walk the WorkspaceManager island: panel buttons (activate /
       delete / select / new workspace) + rename inputs. The rename input
       is caught by the SDK's input bail so arrows inside it move the
       caret instead of stealing focus. -->
  <script>
    import { OsClient } from '@aura/app-sdk';
    new OsClient().nav.installGridNav({
      selector: '.settings-body button, .settings-body input[type="text"]',
    });
  </script>
</body>
</html>
