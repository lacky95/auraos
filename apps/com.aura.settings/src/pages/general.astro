---
import '../styles/settings.css';
import { getState } from '../state.js';
const state = getState();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Settings · General — AuraOS</title>
  <link rel="stylesheet" href="/api/os/theme.css" />
</head>
<body>
  <header class="settings-bar">
    <span class="name">⚙ SETTINGS</span>
    <span class="crumbs">› GENERAL</span>
  </header>
  <main class="settings-body">
    <div class="form-row">
      <label>CLOCK FORMAT</label>
      <select id="clock-format">
        <option value="24h"  selected={state.clockFormat === '24h'}>24-hour</option>
        <option value="12h"  selected={state.clockFormat === '12h'}>12-hour</option>
      </select>
    </div>
    <div class="form-row">
      <label>LOCALE</label>
      <input id="locale" type="text" value={state.locale} placeholder="en-US" />
    </div>
    <div class="form-row" style="align-items: flex-start;">
      <label>COLOR MODE</label>
      <div>
        <div class="mode-row" id="mode-row" role="radiogroup" aria-label="Color mode">
          <button class="mode-btn" data-mode="light" data-active={state.colorMode === 'light'} role="radio">LIGHT</button>
          <button class="mode-btn" data-mode="dark"  data-active={state.colorMode === 'dark'}  role="radio">DARK</button>
          <button class="mode-btn" data-mode="auto"  data-active={state.colorMode === 'auto'}  role="radio">AUTO</button>
          <span class="mode-resolved" id="mode-resolved">{state.colorMode.toUpperCase()}</span>
        </div>
        <p style="margin-top: 6px; font-size: 0.6rem; color: var(--aura-color-text-dim); letter-spacing: 0.06em;">
          AUTO FOLLOWS YOUR OPERATING SYSTEM'S PREFERS-COLOR-SCHEME
        </p>
      </div>
    </div>
    <p id="status" style="margin-top: 14px; font-size: 0.7rem; color: var(--aura-color-text-dim); letter-spacing: 0.08em;">
      CHANGES PERSIST IMMEDIATELY · /api/data/settings PUT
    </p>
  </main>
  <footer class="settings-foot">PROVIDER · /api/data/settings + /api/data/theme (mode)</footer>

  <script is:inline>
    const statusEl = document.getElementById('status');
    const debounceTimers = new Map();

    function patch(field, value) {
      clearTimeout(debounceTimers.get(field));
      debounceTimers.set(field, setTimeout(async () => {
        try {
          await fetch('api/data/settings', {
            method:  'PUT',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ [field]: value }),
          });
          statusEl.innerHTML = `SAVED <b>${field}</b> = ${value} · ${new Date().toLocaleTimeString()}`;
        } catch (err) {
          statusEl.innerHTML = `<b style="color: var(--aura-color-danger);">ERROR — ${err.message}</b>`;
        }
      }, 200));
    }

    document.getElementById('clock-format').addEventListener('change', (e) => patch('clockFormat', e.target.value));
    document.getElementById('locale').addEventListener('input', (e) => patch('locale', e.target.value));

    // Color-mode picker — PUTs to /api/data/theme so the mode-changed broadcast fires.
    const modeResolved = document.getElementById('mode-resolved');
    function resolveMode(pref) {
      if (pref === 'light') return 'light';
      if (pref === 'dark')  return 'dark';
      return (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) ? 'light' : 'dark';
    }
    function paintModeButtons(pref) {
      document.querySelectorAll('.mode-btn').forEach((b) => {
        b.dataset.active = (b.dataset.mode === pref) ? 'true' : 'false';
      });
      if (modeResolved) modeResolved.textContent = resolveMode(pref).toUpperCase();
    }
    paintModeButtons(document.querySelector('.mode-btn[data-active="true"]')?.dataset?.mode || 'dark');

    document.querySelectorAll('.mode-btn').forEach((b) => {
      b.addEventListener('click', async () => {
        const mode = b.dataset.mode;
        if (!['light', 'dark', 'auto'].includes(mode)) return;
        paintModeButtons(mode);
        try {
          await fetch('api/data/theme', {
            method:  'PUT',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ colorMode: mode }),
          });
          statusEl.innerHTML = `SAVED <b>colorMode</b> = ${mode} · ${new Date().toLocaleTimeString()}`;
        } catch (err) { console.warn('[settings] set colorMode failed', err); }
      });
    });

    window.addEventListener('message', (ev) => {
      if (ev.data?.type === 'aura.theme.changed' || ev.data?.type === 'aura.mode.changed') {
        const link = document.querySelector('link[rel="stylesheet"][href^="/api/os/theme.css"]');
        if (link) link.setAttribute('href', '/api/os/theme.css?t=' + Date.now());
        if (ev.data?.type === 'aura.mode.changed' && ev.data.colorMode) paintModeButtons(ev.data.colorMode);
      }
    });

    if (window.matchMedia) {
      const mql = window.matchMedia('(prefers-color-scheme: light)');
      const handle = () => {
        const active = document.querySelector('.mode-btn[data-active="true"]');
        if (active?.dataset.mode === 'auto') paintModeButtons('auto');
      };
      if (mql.addEventListener) mql.addEventListener('change', handle);
      else                       mql.addListener?.(handle);
    }
  </script>
</body>
</html>
