---
import '@aura/ui/styles/scificn-bridge.css';
import '../styles/settings.css';
import ColorModePicker from '../components/ColorModePicker';

// SSR-read from the OS KV directly via the shell's internal port. Each
// general-pref lives under its own key so a single field write doesn't
// require a read-modify-write cycle.
const osBase = process.env['OS_API_BASE'] ?? 'http://127.0.0.1:3000';
async function readKv<T>(key: string, fallback: T): Promise<T> {
  try {
    const r = await fetch(`${osBase}/api/kv/os/${key}`, { signal: AbortSignal.timeout(1500) });
    if (!r.ok) return fallback;
    const body = await r.json() as { value?: T };
    return body.value ?? fallback;
  } catch { return fallback; }
}
const clockFormat = await readKv<'12h' | '24h'>('clockFormat', '24h');
const locale      = await readKv<string>('locale', 'en-US');
// '' = the device's own zone. The device running the browser may sit on UTC
// (a kiosk or WebView host), which is why this is a setting at all.
const timeZone    = await readKv<string>('timeZone', '');
const zones: string[] = (() => { try { return Intl.supportedValuesOf('timeZone'); } catch { return []; } })();
const theme       = await readKv<{ colorMode?: 'light' | 'dark' | 'auto' }>('theme', {});
const colorMode   = theme.colorMode ?? 'dark';
const state = { clockFormat, locale, timeZone, colorMode };
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Settings · General — AuraOS</title>
  <link rel="stylesheet" href="/api/os/theme.css" />
</head>
<body>
  <main class="settings-body">
    <div class="form-row">
      <label>CLOCK FORMAT</label>
      <select id="clock-format">
        <option value="24h"  selected={state.clockFormat === '24h'}>24-hour</option>
        <option value="12h"  selected={state.clockFormat === '12h'}>12-hour</option>
      </select>
    </div>
    <div class="form-row">
      <label>LOCALE</label>
      <input id="locale" type="text" value={state.locale} placeholder="en-US" />
    </div>
    <div class="form-row">
      <label>TIME ZONE</label>
      <div>
        <!-- A searchable combobox: ~420 IANA zones are too many for a select.
             The list is rendered at runtime, so its rules live in settings.css
             (a plain global stylesheet), not a scoped <style>. -->
        <div class="combo" data-combo="time-zone" data-value={state.timeZone}>
          <input id="time-zone" class="combo-input" type="text" role="combobox" autocomplete="off" spellcheck="false"
                 aria-expanded="false" aria-controls="time-zone-list" aria-autocomplete="list"
                 placeholder="DEVICE DEFAULT" value={state.timeZone} />
          <button type="button" class="combo-toggle" tabindex="-1" aria-label="Open the time zone list" data-combo-toggle>▾</button>
          <ul id="time-zone-list" class="combo-list" role="listbox" hidden></ul>
        </div>
        <script type="application/json" id="time-zone-zones" set:html={JSON.stringify(zones)}></script>
        <p id="time-zone-hint" style="margin-top: 6px; font-size: 0.6rem; color: var(--aura-color-text-dim); letter-spacing: 0.06em;">
          TYPE TO SEARCH · USED BY THE STATUS BAR, LOCK SCREEN AND THE SHELL MCP'S DATE/TIME
        </p>
      </div>
    </div>
    <div class="form-row" style="align-items: flex-start;">
      <label>COLOR MODE</label>
      <div>
        <ColorModePicker client:load defaultMode={state.colorMode} />
        <p style="margin-top: 6px; font-size: 0.6rem; color: var(--aura-color-text-dim); letter-spacing: 0.06em;">
          AUTO FOLLOWS YOUR OPERATING SYSTEM'S PREFERS-COLOR-SCHEME
        </p>
      </div>
    </div>
    <p id="status" style="margin-top: 14px; font-size: 0.7rem; color: var(--aura-color-text-dim); letter-spacing: 0.08em;">
      CHANGES PERSIST IMMEDIATELY · PUT /api/kv/os/&lt;field&gt;
    </p>
  </main>
  <footer class="settings-foot">PROVIDER · /api/kv/os/clockFormat + /api/kv/os/locale + /api/kv/os/timeZone + /api/kv/os/theme (mode)</footer>

  <script is:inline>
    const statusEl = document.getElementById('status');
    const debounceTimers = new Map();

    function patch(field, value) {
      clearTimeout(debounceTimers.get(field));
      debounceTimers.set(field, setTimeout(async () => {
        try {
          await fetch(`/api/kv/os/${field}`, {
            method:  'PUT',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ value }),
          });
          statusEl.innerHTML = `SAVED <b>${field}</b> = ${value} · ${new Date().toLocaleTimeString()}`;
        } catch (err) {
          statusEl.innerHTML = `<b style="color: var(--aura-color-danger);">ERROR — ${err.message}</b>`;
        }
      }, 200));
    }

    document.getElementById('clock-format').addEventListener('change', (e) => patch('clockFormat', e.target.value));
    document.getElementById('locale').addEventListener('input', (e) => patch('locale', e.target.value));
    // ── Time-zone combobox ─────────────────────────────────────────────
    // Fuzzy search over the IANA list: every typed character must appear in
    // order (so "nyork" finds America/New_York and "berl" Europe/Berlin);
    // contiguous runs and hits at the start of a word score higher, and the
    // matched characters are highlighted. Each row shows the zone's current
    // UTC offset, which is usually the fastest way to spot the right one.
    (function () {
      const combo = document.querySelector('[data-combo="time-zone"]');
      const input = document.getElementById('time-zone');
      const list  = document.getElementById('time-zone-list');
      const toggle = combo.querySelector('[data-combo-toggle]');
      const zones = JSON.parse(document.getElementById('time-zone-zones').textContent || '[]');
      const DEVICE = { value: '', label: 'DEVICE DEFAULT' };
      const MAX = 60;
      let items = [];          // currently rendered rows: { value, label, score, hits }
      let active = -1;         // highlighted row index
      let committed = combo.dataset.value || '';

      const deviceZone = (() => { try { return Intl.DateTimeFormat().resolvedOptions().timeZone; } catch (_) { return ''; } })();
      const hint = document.getElementById('time-zone-hint');
      if (deviceZone) hint.textContent = `DEVICE DEFAULT IS ${deviceZone.toUpperCase()} · TYPE TO SEARCH · USED BY THE STATUS BAR, LOCK SCREEN AND THE SHELL MCP'S DATE/TIME`;

      const offsetCache = new Map();
      function offsetOf(zone) {
        if (!zone) return deviceZone ? offsetOf(deviceZone) : '';
        if (offsetCache.has(zone)) return offsetCache.get(zone);
        let out = '';
        try {
          const part = new Intl.DateTimeFormat('en-US', { timeZone: zone, timeZoneName: 'shortOffset' })
            .formatToParts(new Date()).find((p) => p.type === 'timeZoneName');
          out = (part ? part.value : '').replace(/^GMT$/, 'UTC±0').replace(/^GMT/, 'UTC');
        } catch (_) { out = ''; }
        offsetCache.set(zone, out);
        return out;
      }

      /** Subsequence match with a score; null when a char is missing. */
      function fuzzy(query, text) {
        const q = query.toLowerCase(), t = text.toLowerCase();
        if (!q) return { score: 0, hits: [] };
        const hits = []; let ti = 0, score = 0, run = 0;
        for (let qi = 0; qi < q.length; qi++) {
          const c = q[qi];
          if (c === ' ') continue;                   // spaces never have to match
          const at = t.indexOf(c, ti);
          if (at < 0) return null;
          const prev = t[at - 1];
          const wordStart = at === 0 || prev === '/' || prev === '_' || prev === '-';
          run = at === ti ? run + 1 : 0;              // contiguous with the last hit
          score += 1 + run * 2 + (wordStart ? 3 : 0);
          hits.push(at); ti = at + 1;
        }
        score -= (t.length - q.length) * 0.02;        // shorter names first on a tie
        return { score, hits };
      }

      function search(query) {
        const q = query.trim();
        const rows = [];
        const dev = fuzzy(q, DEVICE.label) || (q === '' ? { score: 0, hits: [] } : null);
        if (dev) rows.push({ ...DEVICE, ...dev, score: dev.score + 1 });
        for (const z of zones) {
          const m = fuzzy(q, z) || fuzzy(q, z.replace(/_/g, ' '));
          if (m) rows.push({ value: z, label: z, ...m });
        }
        rows.sort((a, b) => b.score - a.score || a.label.localeCompare(b.label));
        return rows.slice(0, MAX);
      }

      const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      function highlight(label, hits) {
        const set = new Set(hits); let out = '';
        for (let i = 0; i < label.length; i++) out += set.has(i) ? `<mark>${esc(label[i])}</mark>` : esc(label[i]);
        return out;
      }

      function render(rows) {
        items = rows;
        list.innerHTML = rows.length
          ? rows.map((r, i) =>
              `<li class="combo-item" role="option" id="time-zone-opt-${i}" data-index="${i}" data-value="${esc(r.value)}"` +
              ` aria-selected="${r.value === committed}">` +
              `<span class="combo-label">${highlight(r.label, r.hits)}</span>` +
              `<span class="combo-meta">${esc(offsetOf(r.value))}</span></li>`).join('')
          : '<li class="combo-empty" role="option" aria-disabled="true">NO ZONE MATCHES</li>';
        setActive(rows.length ? Math.max(0, rows.findIndex((r) => r.value === committed)) : -1);
      }

      function setActive(i) {
        active = i;
        list.querySelectorAll('.combo-item').forEach((el) => { el.dataset.active = String(Number(el.dataset.index) === i); });
        const el = list.querySelector(`.combo-item[data-index="${i}"]`);
        input.setAttribute('aria-activedescendant', el ? el.id : '');
        if (el) el.scrollIntoView({ block: 'nearest' });
      }

      function open(query) {
        render(search(query === undefined ? '' : query));
        list.hidden = false;
        input.setAttribute('aria-expanded', 'true');
        combo.dataset.open = 'true';
      }
      function close() {
        list.hidden = true;
        input.setAttribute('aria-expanded', 'false');
        combo.dataset.open = 'false';
        active = -1;
      }
      const isOpen = () => !list.hidden;

      function commit(value) {
        committed = value;
        combo.dataset.value = value;
        input.value = value;                       // '' shows the DEVICE DEFAULT placeholder
        close();
        patch('timeZone', value);
      }
      /** Leaving without choosing puts the committed value back. */
      function revert() { input.value = committed; close(); }

      input.addEventListener('input', () => open(input.value));
      input.addEventListener('focus', () => { input.select(); open(''); });
      toggle.addEventListener('mousedown', (e) => { e.preventDefault(); if (isOpen()) close(); else { input.focus(); open(''); } });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault(); e.stopPropagation();           // keep the page's grid-nav out of it
          if (!isOpen()) { open(input.value); return; }
          if (!items.length) return;
          setActive((active + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length);
        } else if (e.key === 'Home' && isOpen()) { e.preventDefault(); setActive(0); }
        else if (e.key === 'End' && isOpen())    { e.preventDefault(); setActive(items.length - 1); }
        else if (e.key === 'Enter') {
          e.preventDefault();
          if (isOpen() && active >= 0 && items[active]) commit(items[active].value);
          else if (!isOpen()) open(input.value);
        } else if (e.key === 'Escape') {
          if (isOpen()) { e.preventDefault(); e.stopPropagation(); revert(); }
        }
      });
      list.addEventListener('mousedown', (e) => {
        e.preventDefault();                                   // keep focus on the input
        const row = e.target.closest('.combo-item[data-value]');
        if (row) commit(row.dataset.value);
      });
      list.addEventListener('mousemove', (e) => {
        const row = e.target.closest('.combo-item[data-index]');
        if (row && Number(row.dataset.index) !== active) setActive(Number(row.dataset.index));
      });
      input.addEventListener('blur', () => { if (isOpen()) revert(); });
    })();

    /* Color-mode picker now owned by <ColorModePicker /> React island.
     * Live-update link refresh stays — the page's stylesheet link still needs
     * to bump its href when the OS broadcasts a theme/mode change. */
    window.addEventListener('message', (ev) => {
      if (ev.data?.type === 'aura.theme.changed' || ev.data?.type === 'aura.mode.changed') {
        const link = document.querySelector('link[rel="stylesheet"][href^="/api/os/theme.css"]');
        if (link) link.setAttribute('href', '/api/os/theme.css?t=' + Date.now());
      }
    });
  </script>

  <!-- Arrow-walk the form controls + ColorModePicker tabs. The SDK's
       installGridNav bails on `<input>`/`<select>` `e.target` so arrows
       inside the locale input move the caret rather than jumping focus. -->
  <script>
    import { OsClient } from '@aura/app-sdk';
    new OsClient().nav.installGridNav({
      selector: '#clock-format, #locale, #time-zone, [role="tab"]',
    });
  </script>
</body>
</html>
