---
import '@aura/ui/styles/scificn-bridge.css';
import '../styles/settings.css';
import ColorModePicker from '../components/ColorModePicker.tsx';

// SSR-read from the OS KV directly via the shell's internal port. Each
// general-pref lives under its own key so a single field write doesn't
// require a read-modify-write cycle.
const osBase = process.env['OS_API_BASE'] ?? 'http://127.0.0.1:3000';
async function readKv<T>(key: string, fallback: T): Promise<T> {
  try {
    const r = await fetch(`${osBase}/api/kv/os/${key}`, { signal: AbortSignal.timeout(1500) });
    if (!r.ok) return fallback;
    const body = await r.json() as { value?: T };
    return body.value ?? fallback;
  } catch { return fallback; }
}
const clockFormat = await readKv<'12h' | '24h'>('clockFormat', '24h');
const locale      = await readKv<string>('locale', 'en-US');
const theme       = await readKv<{ colorMode?: 'light' | 'dark' | 'auto' }>('theme', {});
const colorMode   = theme.colorMode ?? 'dark';
const state = { clockFormat, locale, colorMode };
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Settings · General — AuraOS</title>
  <link rel="stylesheet" href="/api/os/theme.css" />
</head>
<body>
  <main class="settings-body">
    <div class="form-row">
      <label>CLOCK FORMAT</label>
      <select id="clock-format">
        <option value="24h"  selected={state.clockFormat === '24h'}>24-hour</option>
        <option value="12h"  selected={state.clockFormat === '12h'}>12-hour</option>
      </select>
    </div>
    <div class="form-row">
      <label>LOCALE</label>
      <input id="locale" type="text" value={state.locale} placeholder="en-US" />
    </div>
    <div class="form-row" style="align-items: flex-start;">
      <label>COLOR MODE</label>
      <div>
        <ColorModePicker client:load defaultMode={state.colorMode} />
        <p style="margin-top: 6px; font-size: 0.6rem; color: var(--aura-color-text-dim); letter-spacing: 0.06em;">
          AUTO FOLLOWS YOUR OPERATING SYSTEM'S PREFERS-COLOR-SCHEME
        </p>
      </div>
    </div>
    <p id="status" style="margin-top: 14px; font-size: 0.7rem; color: var(--aura-color-text-dim); letter-spacing: 0.08em;">
      CHANGES PERSIST IMMEDIATELY · PUT /api/kv/os/&lt;field&gt;
    </p>
  </main>
  <footer class="settings-foot">PROVIDER · /api/kv/os/clockFormat + /api/kv/os/locale + /api/kv/os/theme (mode)</footer>

  <script is:inline>
    const statusEl = document.getElementById('status');
    const debounceTimers = new Map();

    function patch(field, value) {
      clearTimeout(debounceTimers.get(field));
      debounceTimers.set(field, setTimeout(async () => {
        try {
          await fetch(`/api/kv/os/${field}`, {
            method:  'PUT',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ value }),
          });
          statusEl.innerHTML = `SAVED <b>${field}</b> = ${value} · ${new Date().toLocaleTimeString()}`;
        } catch (err) {
          statusEl.innerHTML = `<b style="color: var(--aura-color-danger);">ERROR — ${err.message}</b>`;
        }
      }, 200));
    }

    document.getElementById('clock-format').addEventListener('change', (e) => patch('clockFormat', e.target.value));
    document.getElementById('locale').addEventListener('input', (e) => patch('locale', e.target.value));

    /* Color-mode picker now owned by <ColorModePicker /> React island.
     * Live-update link refresh stays — the page's stylesheet link still needs
     * to bump its href when the OS broadcasts a theme/mode change. */
    window.addEventListener('message', (ev) => {
      if (ev.data?.type === 'aura.theme.changed' || ev.data?.type === 'aura.mode.changed') {
        const link = document.querySelector('link[rel="stylesheet"][href^="/api/os/theme.css"]');
        if (link) link.setAttribute('href', '/api/os/theme.css?t=' + Date.now());
      }
    });
  </script>
</body>
</html>
