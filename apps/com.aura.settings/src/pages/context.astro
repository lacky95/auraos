---
import '../styles/settings.css';

// SSR-read the current context entries + volumes from the OS.
const osBase = process.env['OS_API_BASE'] ?? 'http://127.0.0.1:3000';
type Kind = 'secret' | 'variable';
type Inject = 'env' | 'file';
interface ContextEntry { key: string; kind: Kind; inject: Inject[]; updatedAt: number; value: string | null }
interface VolumeEntry { name: string; mountPath: string; mode: 'rw' | 'ro'; createdAt: number }

let entries: ContextEntry[] = [];
let volumes: VolumeEntry[] = [];
try {
  const r = await fetch(`${osBase}/api/os/context`, { signal: AbortSignal.timeout(1500) });
  if (r.ok) entries = ((await r.json()) as { entries?: ContextEntry[] }).entries ?? [];
} catch { /* OS unreachable at SSR time — client will refetch */ }
try {
  const r = await fetch(`${osBase}/api/os/volumes`, { signal: AbortSignal.timeout(1500) });
  if (r.ok) volumes = ((await r.json()) as { volumes?: VolumeEntry[] }).volumes ?? [];
} catch { /* client will refetch */ }
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Settings · Context — AuraOS</title>
  <link rel="stylesheet" href="/api/os/theme.css" />
  <!-- is:global — rows are re-rendered client-side via innerHTML, and those
       elements don't carry Astro's scoped data-astro-cid attribute. Scoped
       styles would stop matching them. -->
  <style is:global>
    .ctx-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--aura-color-border, #333); margin-bottom: 16px; }
    .ctx-tab {
      background: none; border: none; border-bottom: 2px solid transparent; color: var(--aura-color-text-dim);
      font-size: 0.68rem; letter-spacing: 0.1em; padding: 8px 14px; cursor: pointer; text-transform: uppercase;
    }
    .ctx-tab.active { color: var(--aura-color-primary); border-bottom-color: var(--aura-color-primary); }
    .ctx-panel { display: none; }
    .ctx-panel.active { display: block; }
    .ctx-table { width: 100%; border-collapse: collapse; margin-bottom: 18px; }
    .ctx-table th, .ctx-table td {
      text-align: left; padding: 8px 10px; font-size: 0.72rem; letter-spacing: 0.04em;
      border-bottom: 1px solid var(--aura-color-border, #333); vertical-align: middle;
    }
    .ctx-table th { color: var(--aura-color-text-dim); font-weight: 600; }
    .ctx-key { font-family: monospace; }
    .ctx-val { font-family: monospace; word-break: break-all; }
    .ctx-val.secret { color: var(--aura-color-text-dim); letter-spacing: 0.2em; }
    .ctx-badge {
      display: inline-block; font-size: 0.56rem; letter-spacing: 0.1em; padding: 2px 6px;
      border: 1px solid var(--aura-color-border, #444); border-radius: 2px;
    }
    .ctx-badge.secret   { color: var(--aura-color-danger, #e55); }
    .ctx-badge.variable { color: var(--aura-color-success); }
    .ctx-badge.rw       { color: var(--aura-color-success); }
    .ctx-badge.ro       { color: var(--aura-color-text-dim); }
    .ctx-inject { color: var(--aura-color-text-dim); font-size: 0.6rem; letter-spacing: 0.08em; }
    .ctx-checks { display: flex; gap: 12px; align-items: center; }
    .ctx-checks label { display: inline-flex; align-items: center; gap: 4px; margin: 0; cursor: pointer; }
    .ctx-checks input { width: auto; }
    .ctx-empty { color: var(--aura-color-text-dim); font-size: 0.72rem; padding: 10px; }
    /* One styled class for BOTH delete buttons. Which table a button belongs to
       is expressed by its data-* hook (data-key / data-vol), never by a second
       class — a JS-only class silently has no rule and falls back to the UA's
       default button chrome. Style by class, select by data attribute. */
    .ctx-del {
      background: none; border: 1px solid var(--aura-color-border, #444);
      color: var(--aura-color-danger, #e55); cursor: pointer; font-size: 0.62rem;
      padding: 3px 8px; letter-spacing: 0.08em;
    }
    /* A row whose write is still in flight (data-pending set by markPending).
       Attribute selector on purpose: the flag is JS state, not a style class. */
    .ctx-table tr[data-pending] { opacity: 0.55; }
    .ctx-del:disabled { cursor: default; opacity: 0.6; }
    .ctx-form button:disabled { cursor: progress; opacity: 0.6; }
    .ctx-form { display: flex; gap: 8px; flex-wrap: wrap; align-items: flex-end; }
    .ctx-form label { display: block; font-size: 0.62rem; color: var(--aura-color-text-dim); margin-bottom: 4px; }
    /* Theme tokens only, no literal fallbacks: every one of these is defined by
       /api/os/theme.css, and a literal is what hid the bug this page had — a
       misspelt token (--aura-color-bg-elev, which never existed) silently used
       its dark fallback and stayed black under light themes. */
    .ctx-form input, .ctx-form select {
      background: var(--aura-color-surface); color: var(--aura-color-text);
      border: 1px solid var(--aura-color-border); padding: 6px 8px; font-size: 0.72rem;
      font-family: monospace;
    }
    /* Filled with the theme's primary; the label takes the page background so
       it stays legible whether primary is dark (light mode) or bright (dark). */
    .ctx-form button {
      background: var(--aura-color-primary); color: var(--aura-color-bg); border: none;
      padding: 7px 14px; font-size: 0.7rem; letter-spacing: 0.08em; cursor: pointer;
    }
    .ctx-hint { color: var(--aura-color-text-dim); font-size: 0.62rem; margin-top: 6px; }
    .ctx-dialog-backdrop {
      position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6);
      display: none; align-items: center; justify-content: center; z-index: 50;
    }
    .ctx-dialog-backdrop.open { display: flex; }
    .ctx-dialog {
      background: var(--aura-color-surface-2); border: 1px solid var(--aura-color-border);
      padding: 18px 20px; max-width: 340px;
    }
    .ctx-dialog p { font-size: 0.74rem; margin-bottom: 14px; letter-spacing: 0.03em; }
    .ctx-dialog-actions { display: flex; gap: 10px; justify-content: flex-end; }
    .ctx-dialog-actions button { padding: 6px 14px; font-size: 0.68rem; letter-spacing: 0.08em; cursor: pointer; }
    #ctx-dialog-cancel {
      background: none; border: 1px solid var(--aura-color-border); color: var(--aura-color-text);
    }
    #ctx-dialog-ok { background: var(--aura-color-primary); color: var(--aura-color-bg); border: none; }
  </style>
</head>
<body>
  <main class="settings-body">
    <div class="ctx-tabs">
      <button class="ctx-tab active" data-tab="vars">Var / Secrets</button>
      <button class="ctx-tab" data-tab="volumes">Volumes</button>
    </div>
    <!-- Status sits under the tabs, not at the page bottom: in a small tile
         the bottom is below the fold and a SAVING/ERROR line there is never seen. -->
    <p id="status" class="ctx-hint"></p>


    <!-- ── VAR / SECRETS ─────────────────────────────────────────────── -->
    <div class="ctx-panel active" id="panel-vars">
      <table class="ctx-table">
        <thead>
          <tr><th style="width:28%">KEY</th><th style="width:12%">TYPE</th><th style="width:26%">VALUE</th><th style="width:12%">INJECT</th><th style="width:12%">UPDATED</th><th></th></tr>
        </thead>
        <tbody id="ctx-rows">
          {entries.length === 0 && (
            <tr><td colspan="6" class="ctx-empty">No context entries yet. Add one below.</td></tr>
          )}
          {entries.map((e) => (
            <tr data-key={e.key}>
              <td class="ctx-key">{e.key}</td>
              <td><span class={`ctx-badge ${e.kind}`}>{e.kind === 'secret' ? 'SECRET' : 'VARIABLE'}</span></td>
              <td class={`ctx-val ${e.kind}`}>{e.kind === 'variable' ? e.value : '••••••••'}</td>
              <td class="ctx-inject">{e.inject.map((t) => t.toUpperCase()).join(' · ')}</td>
              <td>{e.updatedAt ? new Date(e.updatedAt).toLocaleString() : '—'}</td>
              <td><button class="ctx-del" data-key={e.key}>DELETE</button></td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="ctx-form">
        <div>
          <label for="ctx-kind">TYPE</label>
          <select id="ctx-kind">
            <option value="secret">Secret (masked)</option>
            <option value="variable">Variable (visible)</option>
          </select>
        </div>
        <div>
          <label for="ctx-key">KEY</label>
          <input id="ctx-key" type="text" placeholder="GITHUB_TOKEN" autocomplete="off" spellcheck="false" />
        </div>
        <div>
          <label for="ctx-value">VALUE</label>
          <input id="ctx-value" type="password" placeholder="secret value" autocomplete="off" spellcheck="false" />
        </div>
        <div>
          <label>INJECT AS</label>
          <div class="ctx-checks">
            <label><input type="checkbox" id="ctx-inject-env" checked /> Env var</label>
            <label><input type="checkbox" id="ctx-inject-file" checked /> File</label>
          </div>
        </div>
        <button id="ctx-add">SET</button>
      </div>
      <p class="ctx-hint">
        Injected into every app as <b>$KEY</b> and <b>/run/context/KEY</b>.
        File changes apply live; env changes on next app restart.
      </p>
    </div>

    <!-- ── VOLUMES ───────────────────────────────────────────────────── -->
    <div class="ctx-panel" id="panel-volumes">
      <table class="ctx-table">
        <thead>
          <tr><th style="width:24%">NAME</th><th style="width:34%">MOUNT PATH</th><th style="width:12%">MODE</th><th style="width:18%">CREATED</th><th></th></tr>
        </thead>
        <tbody id="vol-rows">
          {volumes.length === 0 && (
            <tr><td colspan="5" class="ctx-empty">No volumes yet. Create one below.</td></tr>
          )}
          {volumes.map((v) => (
            <tr data-name={v.name}>
              <td class="ctx-key">{v.name}</td>
              <td class="ctx-val">{v.mountPath}</td>
              <td><span class={`ctx-badge ${v.mode}`}>{v.mode.toUpperCase()}</span></td>
              <td>{v.createdAt ? new Date(v.createdAt).toLocaleString() : '—'}</td>
              <td><button class="ctx-del" data-vol={v.name}>DELETE</button></td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="ctx-form">
        <div>
          <label for="vol-name">NAME</label>
          <input id="vol-name" type="text" placeholder="shared" autocomplete="off" spellcheck="false" />
        </div>
        <div>
          <label for="vol-path">MOUNT PATH</label>
          <input id="vol-path" type="text" placeholder="/mnt/shared" autocomplete="off" spellcheck="false" />
        </div>
        <div>
          <label for="vol-mode">MODE</label>
          <select id="vol-mode">
            <option value="rw">Read-write</option>
            <option value="ro">Read-only</option>
          </select>
        </div>
        <button id="vol-add">CREATE</button>
      </div>
      <p class="ctx-hint">
        Mounted into <b>every app</b> at your chosen path — shared storage between apps.
        Applies on the app's next restart. RO is enforced for container apps.
      </p>
    </div>

  </main>

  <div id="ctx-dialog" class="ctx-dialog-backdrop">
    <div class="ctx-dialog">
      <p id="ctx-dialog-msg"></p>
      <div class="ctx-dialog-actions">
        <button id="ctx-dialog-cancel">CANCEL</button>
        <button id="ctx-dialog-ok">OVERRIDE</button>
      </div>
    </div>
  </div>

  <footer class="settings-foot">PROVIDER · /api/os/context · /api/os/volumes</footer>

  <script is:inline>
    const statusEl = document.getElementById('status');
    const kindEl = document.getElementById('ctx-kind');
    const valueEl = document.getElementById('ctx-value');
    const KEY_RE = /^[A-Z_][A-Z0-9_]*$/;
    const VOL_NAME_RE = /^[a-z0-9][a-z0-9_-]{0,62}$/;
    // How long a write may go unanswered before the page stops waiting on it
    // and re-reads the list instead (see writeJson).
    const WRITE_TIMEOUT_MS = 8000;
    // While a write is in flight, re-read the list this often; the row is
    // confirmed from the list as soon as the server shows it, whether or not
    // the write's own response ever arrives.
    const POLL_MS = 2000;

    function esc(s) {
      return String(s).replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    function setStatus(html, danger) {
      statusEl.innerHTML = danger
        ? `<b style="color: var(--aura-color-danger);">${html}</b>`
        : html;
    }
    function now() { return new Date().toLocaleTimeString(); }

    /**
     * Write with a hard deadline that does not depend on fetch honouring an
     * abort: the deadline is a plain timer raced against the request. On the
     * deadline the caller re-reads the list to learn what actually happened.
     * Resolves { ok, status, body }; throws an Error with `timedOut: true`
     * when the deadline passes, any other fetch error as-is.
     */
    async function writeJson(url, init) {
      const ctrl = new AbortController();
      let timer;
      const deadline = new Promise((_, reject) => {
        timer = setTimeout(() => {
          const e = new Error(`no response after ${WRITE_TIMEOUT_MS / 1000}s`);
          e.timedOut = true;
          reject(e);
          try { ctrl.abort(); } catch { /* ignore */ }
        }, WRITE_TIMEOUT_MS);
      });
      deadline.catch(() => undefined);   // handled by whoever loses the race
      try {
        const r = await Promise.race([fetch(url, { ...init, cache: 'no-store', signal: ctrl.signal }), deadline]);
        const body = await Promise.race([r.json().catch(() => null), deadline]);
        return { ok: r.ok, status: r.status, body };
      } catch (err) {
        if (err && !err.timedOut && err.name === 'AbortError') err.timedOut = true;
        throw err;
      } finally {
        clearTimeout(timer);
      }
    }

    /**
     * Poll `check()` every POLL_MS until it returns true or `stop()` is
     * called. Used alongside a write so the UI confirms from the list.
     */
    function pollUntil(check) {
      let stopped = false;
      let timer = null;
      const tick = async () => {
        if (stopped) return;
        let done = false;
        try { done = await check(); } catch { done = false; }
        if (stopped) return;
        if (done) { stopped = true; return; }
        timer = setTimeout(tick, POLL_MS);
      };
      timer = setTimeout(tick, POLL_MS);
      return () => { stopped = true; clearTimeout(timer); };
    }

    /** Mark a row as "write in flight": dimmed, its DELETE button inert. */
    function markPending(tr, on) {
      if (!tr) return;
      if (on) tr.dataset.pending = '1';
      else delete tr.dataset.pending;
      tr.querySelectorAll('.ctx-del').forEach((b) => { b.disabled = on; });
    }

    // ── Tabs ──────────────────────────────────────────────────────────
    document.querySelectorAll('.ctx-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.ctx-tab').forEach((b) => b.classList.toggle('active', b === btn));
        const tab = btn.dataset.tab;
        document.getElementById('panel-vars').classList.toggle('active', tab === 'vars');
        document.getElementById('panel-volumes').classList.toggle('active', tab === 'volumes');
      });
    });

    // ── Generic confirm dialog ────────────────────────────────────────
    function confirmDialog(msgHtml, okLabel) {
      return new Promise((resolve) => {
        const bd = document.getElementById('ctx-dialog');
        const okBtn = document.getElementById('ctx-dialog-ok');
        const cancelBtn = document.getElementById('ctx-dialog-cancel');
        document.getElementById('ctx-dialog-msg').innerHTML = msgHtml;
        okBtn.textContent = okLabel;
        bd.classList.add('open');
        const done = (val) => {
          bd.classList.remove('open');
          okBtn.removeEventListener('click', onOk);
          cancelBtn.removeEventListener('click', onCancel);
          resolve(val);
        };
        const onOk = () => done(true);
        const onCancel = () => done(false);
        okBtn.addEventListener('click', onOk);
        cancelBtn.addEventListener('click', onCancel);
        okBtn.focus();
      });
    }

    // ── Var / Secrets ─────────────────────────────────────────────────
    function syncValueField() {
      const secret = kindEl.value === 'secret';
      valueEl.type = secret ? 'password' : 'text';
      valueEl.placeholder = secret ? 'secret value' : 'visible value';
    }
    kindEl.addEventListener('change', syncValueField);
    syncValueField();

    function existingKeys() {
      return new Set(Array.from(document.querySelectorAll('#ctx-rows tr[data-key]')).map((tr) => tr.dataset.key));
    }
    function varRow(key) {
      return document.querySelector(`#ctx-rows tr[data-key="${CSS.escape(key)}"]`);
    }

    const CTX_EMPTY_ROW = '<tr><td colspan="6" class="ctx-empty">No context entries yet. Add one below.</td></tr>';

    function varRowHtml(e) {
      const badge = e.kind === 'secret' ? 'SECRET' : 'VARIABLE';
      const val = e.kind === 'variable' ? esc(e.value ?? '') : '••••••••';
      const inject = (e.inject || []).map((t) => t.toUpperCase()).join(' · ');
      return `
        <tr data-key="${esc(e.key)}">
          <td class="ctx-key">${esc(e.key)}</td>
          <td><span class="ctx-badge ${e.kind}">${badge}</span></td>
          <td class="ctx-val ${e.kind}">${val}</td>
          <td class="ctx-inject">${esc(inject)}</td>
          <td>${e.updatedAt ? new Date(e.updatedAt).toLocaleString() : '—'}</td>
          <td><button class="ctx-del" data-key="${esc(e.key)}">DELETE</button></td>
        </tr>`;
    }

    /**
     * Put one entry into the table without waiting for a re-list. Used both
     * for the optimistic row (before the write) and for the authoritative
     * one from the response or the list. Keeps the server's key-sorted order.
     */
    function upsertVarRow(e) {
      const tbody = document.getElementById('ctx-rows');
      const empty = tbody.querySelector('.ctx-empty');
      if (empty) empty.closest('tr').remove();
      const existing = varRow(e.key);
      if (existing) existing.outerHTML = varRowHtml(e);
      else {
        const after = Array.from(tbody.querySelectorAll('tr[data-key]'))
          .find((tr) => tr.dataset.key.localeCompare(e.key) > 0);
        if (after) after.insertAdjacentHTML('beforebegin', varRowHtml(e));
        else tbody.insertAdjacentHTML('beforeend', varRowHtml(e));
      }
    }

    function removeVarRow(key) {
      const tbody = document.getElementById('ctx-rows');
      const row = varRow(key);
      if (row) row.remove();
      // Restore the placeholder so the table never renders blank.
      if (!tbody.querySelector('tr[data-key]')) tbody.innerHTML = CTX_EMPTY_ROW;
    }

    /** Read the list; same deadline as a write so a hung read can't park the page. */
    async function fetchEntries() {
      const res = await writeJson('/api/os/context', { method: 'GET' });
      if (!res.ok) throw new Error(`GET /api/os/context → ${res.status}`);
      return (res.body && res.body.entries) || [];
    }

    function renderEntries(entries) {
      const tbody = document.getElementById('ctx-rows');
      tbody.innerHTML = entries.length ? entries.map(varRowHtml).join('') : CTX_EMPTY_ROW;
    }

    async function refresh() {
      renderEntries(await fetchEntries());
    }

    async function addVar() {
      const addBtn = document.getElementById('ctx-add');
      if (addBtn.disabled) return;   // a write is already in flight
      const key = document.getElementById('ctx-key').value.trim();
      const value = valueEl.value;
      const kind = kindEl.value;
      const inject = [];
      if (document.getElementById('ctx-inject-env').checked) inject.push('env');
      if (document.getElementById('ctx-inject-file').checked) inject.push('file');
      if (!KEY_RE.test(key)) { setStatus(`Invalid key — must be an env-var name (A–Z, 0–9, _), e.g. GITHUB_TOKEN`, true); return; }
      if (!value) { setStatus('Value must not be empty', true); return; }
      if (inject.length === 0) { setStatus('Select at least one inject target (Env var / File)', true); return; }
      if (existingKeys().has(key)) {
        const ok = await confirmDialog(`<b>${esc(key)}</b> already exists. Override its value and settings?`, 'OVERRIDE');
        if (!ok) { setStatus(`Cancelled — existing <b>${esc(key)}</b> kept`); return; }
      }

      // React to the click BEFORE the request: pending status, optimistic
      // row, button locked. The page must visibly change whether or not the
      // write's response ever comes back.
      const local = { key, kind, inject, updatedAt: Date.now(), value: kind === 'variable' ? value : null };
      const prev = varRow(key);
      const prevHtml = prev ? prev.outerHTML : null;
      const sentAt = Date.now();
      let settled = false;
      const revert = () => {
        const tr = varRow(key);
        if (!tr) return;
        if (prevHtml) tr.outerHTML = prevHtml;
        else removeVarRow(key);
      };
      const confirmed = (entry, how) => {
        if (settled) return;
        settled = true;
        upsertVarRow(entry || local);          // re-render clears pending
        document.getElementById('ctx-key').value = '';
        valueEl.value = '';
        addBtn.disabled = false;
        setStatus(`SAVED <b>${esc(key)}</b> (${kind} · ${inject.join('+')}) · ${now()}${how ? ` — ${how}` : ''}`);
      };
      addBtn.disabled = true;
      setStatus(`SAVING <b>${esc(key)}</b>…`);
      upsertVarRow(local);
      markPending(varRow(key), true);

      // Confirm from the list while the write is in flight. An entry newer
      // than our click proves the write landed even if its response is lost.
      const stopPoll = pollUntil(async () => {
        const entries = await fetchEntries();
        const hit = entries.find((e) => e.key === key && e.updatedAt >= sentAt - 1000);
        if (!hit) return false;
        confirmed(hit, 'confirmed by re-read');
        return true;
      });

      try {
        const res = await writeJson('/api/os/context', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key, value, kind, inject }),
        });
        stopPoll();
        if (settled) return;
        if (!res.ok) { revert(); setStatus(`ERROR — ${esc(res.body?.error ?? res.status)}`, true); return; }
        confirmed(res.body && res.body.key ? res.body : local, '');
        try { await refresh(); } catch (err) { console.warn('[context] entry list reconcile failed', err); }
      } catch (err) {
        stopPoll();
        if (settled) return;
        if (!err.timedOut) { revert(); setStatus(`ERROR — ${esc(err.message)}`, true); return; }
        // Deadline hit and the poll hasn't confirmed either: one last read.
        console.warn(`[context] POST /api/os/context ${key}: ${err.message} — re-reading the list`);
        try {
          const entries = await fetchEntries();
          const hit = entries.find((e) => e.key === key);
          if (hit) confirmed(hit, "confirmed by re-read; the write's response never reached this page");
          else { revert(); setStatus(`ERROR — <b>${esc(key)}</b> was not saved (${esc(err.message)})`, true); }
          if (hit) renderEntries(entries);
        } catch (err2) {
          revert();
          setStatus(`ERROR — ${esc(err.message)}, and the re-read failed too (${esc(err2.message)}). Reload to see the current state.`, true);
        }
      } finally {
        addBtn.disabled = false;
      }
    }

    async function delVar(key) {
      const tr = varRow(key);
      if (tr && tr.dataset.pending) return;   // already being written
      markPending(tr, true);
      setStatus(`DELETING <b>${esc(key)}</b>…`);
      let settled = false;
      const confirmed = (how) => {
        if (settled) return;
        settled = true;
        removeVarRow(key);
        setStatus(`DELETED <b>${esc(key)}</b> · ${now()}${how ? ` — ${how}` : ''}`);
      };
      const stopPoll = pollUntil(async () => {
        const entries = await fetchEntries();
        if (entries.some((e) => e.key === key)) return false;
        confirmed('confirmed by re-read');
        return true;
      });
      try {
        const res = await writeJson(`/api/os/context/${encodeURIComponent(key)}`, { method: 'DELETE' });
        stopPoll();
        if (settled) return;
        if (!res.ok) { markPending(varRow(key), false); setStatus(`ERROR — ${esc(res.body?.error ?? res.status)}`, true); return; }
        confirmed('');
        try { await refresh(); } catch (err) { console.warn('[context] entry list reconcile failed', err); }
      } catch (err) {
        stopPoll();
        if (settled) return;
        if (!err.timedOut) { markPending(varRow(key), false); setStatus(`ERROR — ${esc(err.message)}`, true); return; }
        console.warn(`[context] DELETE /api/os/context/${key}: ${err.message} — re-reading the list`);
        try {
          const entries = await fetchEntries();
          if (!entries.some((e) => e.key === key)) { confirmed("confirmed by re-read; the write's response never reached this page"); renderEntries(entries); }
          else { markPending(varRow(key), false); setStatus(`ERROR — <b>${esc(key)}</b> still exists (${esc(err.message)})`, true); }
        } catch (err2) {
          markPending(varRow(key), false);
          setStatus(`ERROR — ${esc(err.message)}, and the re-read failed too (${esc(err2.message)}). Reload to see the current state.`, true);
        }
      }
    }

    /**
     * Delegated once per table, so rows can be re-rendered or inserted
     * individually without rebinding (and without stacking a second listener
     * on rows that survived the update).
     */
    function bindRowDeletes() {
      document.getElementById('ctx-rows').addEventListener('click', (e) => {
        const btn = e.target.closest('.ctx-del[data-key]');
        if (btn && !btn.disabled) delVar(btn.dataset.key);
      });
      document.getElementById('vol-rows').addEventListener('click', (e) => {
        const btn = e.target.closest('.ctx-del[data-vol]');
        if (btn && !btn.disabled) delVol(btn.dataset.vol);
      });
    }

    // ── Volumes ───────────────────────────────────────────────────────
    const VOL_EMPTY_ROW = '<tr><td colspan="5" class="ctx-empty">No volumes yet. Create one below.</td></tr>';

    function volRow(name) {
      return document.querySelector(`#vol-rows tr[data-name="${CSS.escape(name)}"]`);
    }

    function volRowHtml(v) {
      return `
        <tr data-name="${esc(v.name)}">
          <td class="ctx-key">${esc(v.name)}</td>
          <td class="ctx-val">${esc(v.mountPath)}</td>
          <td><span class="ctx-badge ${v.mode}">${esc(String(v.mode).toUpperCase())}</span></td>
          <td>${v.createdAt ? new Date(v.createdAt).toLocaleString() : '—'}</td>
          <td><button class="ctx-del" data-vol="${esc(v.name)}">DELETE</button></td>
        </tr>`;
    }

    /** Same contract as upsertVarRow, for the volumes table. */
    function upsertVolRow(v) {
      const tbody = document.getElementById('vol-rows');
      const empty = tbody.querySelector('.ctx-empty');
      if (empty) empty.closest('tr').remove();
      const existing = volRow(v.name);
      if (existing) existing.outerHTML = volRowHtml(v);
      else {
        const after = Array.from(tbody.querySelectorAll('tr[data-name]'))
          .find((tr) => tr.dataset.name.localeCompare(v.name) > 0);
        if (after) after.insertAdjacentHTML('beforebegin', volRowHtml(v));
        else tbody.insertAdjacentHTML('beforeend', volRowHtml(v));
      }
    }

    function removeVolRow(name) {
      const tbody = document.getElementById('vol-rows');
      const row = volRow(name);
      if (row) row.remove();
      if (!tbody.querySelector('tr[data-name]')) tbody.innerHTML = VOL_EMPTY_ROW;
    }

    async function fetchVolumes() {
      const res = await writeJson('/api/os/volumes', { method: 'GET' });
      if (!res.ok) throw new Error(`GET /api/os/volumes → ${res.status}`);
      return (res.body && res.body.volumes) || [];
    }

    function renderVolumes(volumes) {
      const tbody = document.getElementById('vol-rows');
      tbody.innerHTML = volumes.length ? volumes.map(volRowHtml).join('') : VOL_EMPTY_ROW;
    }

    async function refreshVols() {
      renderVolumes(await fetchVolumes());
    }

    async function addVol() {
      const addBtn = document.getElementById('vol-add');
      if (addBtn.disabled) return;
      const name = document.getElementById('vol-name').value.trim();
      const mountPath = document.getElementById('vol-path').value.trim();
      const mode = document.getElementById('vol-mode').value;
      if (!VOL_NAME_RE.test(name)) { setStatus('Invalid name — lowercase letters/digits/-/_ , e.g. shared', true); return; }
      if (!mountPath.startsWith('/')) { setStatus('Mount path must be absolute (start with /), e.g. /mnt/shared', true); return; }

      const local = { name, mountPath, mode, createdAt: Date.now() };
      const prev = volRow(name);
      const prevHtml = prev ? prev.outerHTML : null;
      let settled = false;
      const revert = () => {
        const tr = volRow(name);
        if (!tr) return;
        if (prevHtml) tr.outerHTML = prevHtml;
        else removeVolRow(name);
      };
      const confirmed = (entry, how) => {
        if (settled) return;
        settled = true;
        upsertVolRow(entry || local);
        document.getElementById('vol-name').value = '';
        document.getElementById('vol-path').value = '';
        addBtn.disabled = false;
        setStatus(`CREATED volume <b>${esc(name)}</b> → ${esc(mountPath)} (${mode}) · restart apps to mount${how ? ` — ${how}` : ''}`);
      };
      addBtn.disabled = true;
      setStatus(`CREATING volume <b>${esc(name)}</b>…`);
      upsertVolRow(local);
      markPending(volRow(name), true);
      const stopPoll = pollUntil(async () => {
        const hit = (await fetchVolumes()).find((v) => v.name === name);
        if (!hit) return false;
        confirmed(hit, 'confirmed by re-read');
        return true;
      });
      try {
        const res = await writeJson('/api/os/volumes', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, mountPath, mode }),
        });
        stopPoll();
        if (settled) return;
        if (!res.ok) { revert(); setStatus(`ERROR — ${esc(res.body?.error ?? res.status)}`, true); return; }
        confirmed(res.body && res.body.name ? res.body : local, '');
        try { await refreshVols(); } catch (err) { console.warn('[context] volume list reconcile failed', err); }
      } catch (err) {
        stopPoll();
        if (settled) return;
        if (!err.timedOut) { revert(); setStatus(`ERROR — ${esc(err.message)}`, true); return; }
        console.warn(`[context] POST /api/os/volumes ${name}: ${err.message} — re-reading the list`);
        try {
          const volumes = await fetchVolumes();
          const hit = volumes.find((v) => v.name === name);
          if (hit) { confirmed(hit, "confirmed by re-read; the write's response never reached this page"); renderVolumes(volumes); }
          else { revert(); setStatus(`ERROR — volume <b>${esc(name)}</b> was not created (${esc(err.message)})`, true); }
        } catch (err2) {
          revert();
          setStatus(`ERROR — ${esc(err.message)}, and the re-read failed too (${esc(err2.message)}). Reload to see the current state.`, true);
        }
      } finally {
        addBtn.disabled = false;
      }
    }

    async function delVol(name) {
      const tr = volRow(name);
      if (tr && tr.dataset.pending) return;
      const ok = await confirmDialog(`Delete volume <b>${esc(name)}</b>? This removes its data and unmounts it from apps.`, 'DELETE');
      if (!ok) { setStatus(`Cancelled — volume <b>${esc(name)}</b> kept`); return; }
      markPending(volRow(name), true);
      setStatus(`DELETING volume <b>${esc(name)}</b>…`);
      let settled = false;
      const confirmed = (how) => {
        if (settled) return;
        settled = true;
        removeVolRow(name);
        setStatus(`DELETED volume <b>${esc(name)}</b> · ${now()}${how ? ` — ${how}` : ''}`);
      };
      const stopPoll = pollUntil(async () => {
        if ((await fetchVolumes()).some((v) => v.name === name)) return false;
        confirmed('confirmed by re-read');
        return true;
      });
      try {
        const res = await writeJson(`/api/os/volumes/${encodeURIComponent(name)}`, { method: 'DELETE' });
        stopPoll();
        if (settled) return;
        if (!res.ok) { markPending(volRow(name), false); setStatus(`ERROR — ${esc(res.body?.error ?? res.status)}`, true); return; }
        confirmed('');
        try { await refreshVols(); } catch (err) { console.warn('[context] volume list reconcile failed', err); }
      } catch (err) {
        stopPoll();
        if (settled) return;
        if (!err.timedOut) { markPending(volRow(name), false); setStatus(`ERROR — ${esc(err.message)}`, true); return; }
        console.warn(`[context] DELETE /api/os/volumes/${name}: ${err.message} — re-reading the list`);
        try {
          const volumes = await fetchVolumes();
          if (!volumes.some((v) => v.name === name)) { confirmed("confirmed by re-read; the write's response never reached this page"); renderVolumes(volumes); }
          else { markPending(volRow(name), false); setStatus(`ERROR — volume <b>${esc(name)}</b> still exists (${esc(err.message)})`, true); }
        } catch (err2) {
          markPending(volRow(name), false);
          setStatus(`ERROR — ${esc(err.message)}, and the re-read failed too (${esc(err2.message)}). Reload to see the current state.`, true);
        }
      }
    }

    // ── Wire up ───────────────────────────────────────────────────────
    document.getElementById('ctx-add').addEventListener('click', addVar);
    valueEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') addVar(); });
    document.getElementById('vol-add').addEventListener('click', addVol);
    document.getElementById('vol-path').addEventListener('keydown', (e) => { if (e.key === 'Enter') addVol(); });
    bindRowDeletes();
  </script>

  <script>
    import { OsClient } from '@aura/app-sdk';
    new OsClient().nav.installGridNav({
      selector: '.ctx-tab, #ctx-kind, #ctx-key, #ctx-value, #ctx-inject-env, #ctx-inject-file, #ctx-add, .ctx-del, #vol-name, #vol-path, #vol-mode, #vol-add',
    });
  </script>
</body>
</html>
