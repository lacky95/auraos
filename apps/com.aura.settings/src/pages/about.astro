---
import '../styles/settings.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Settings · About — AuraOS</title>
  <link rel="stylesheet" href="/api/os/theme.css" />
</head>
<body>
  <header class="settings-bar">
    <span class="name">⚙ SETTINGS</span>
    <span class="crumbs">› ABOUT</span>
  </header>
  <main class="settings-body" style="text-align: center; padding-top: 40px;">
    <h1 style="font-size: 2.6rem; color: var(--aura-color-primary); text-shadow: var(--aura-glow-primary); letter-spacing: 0.18em;">AURAOS</h1>
    <p style="margin-top: 12px; font-size: 0.8rem; color: var(--aura-color-secondary); letter-spacing: 0.16em; text-transform: uppercase;">A WEB OS WITH ANDROID DNA</p>
    <p style="margin-top: 22px; font-size: 0.7rem; color: var(--aura-color-text-dim); letter-spacing: 0.1em;">
      ASTRO 6 · NODE 22 · PROOT · TYPESCRIPT
    </p>
    <p style="margin-top: 30px; font-size: 0.7rem; color: var(--aura-color-text-dim);">
      INSTANCES · ACTIVITIES · CONTENT PROVIDERS · PROCESS MANAGER · THEME MANAGER
    </p>
  </main>
  <footer class="settings-foot">SETTINGS V0.1.0</footer>
</body>
</html>
