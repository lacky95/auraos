{
  "id": "com.aura.docs",
  "name": "Aura Docs",
  "version": "0.1.0",
  "description": "Aura Documentation",
  "icon": "DOC",
  "instanceMode": "single",
  "activityMode": "multi",
  "sandbox": "container",
  "runtime": "raw",
  "entrypoint": "entrypoint.sh",
  "autoStart": true,
  "backgroundService": true,
  "themeStrategy": "inherit",
  "proxy": {
    "rewriteHtml": "none",
    "preservePrefix": true,
    "injectMeta": true,
    "injectConsoleRelay": true,
    "injectKeyForwarder": true
  },
  "provides": [
    {
      "name": "docs",
      "kind": "mcp",
      "address": "/mcp",
      "version": "0.1.0",
      "description": "Aura documentation for agents: list_docs (every page), search_docs (find pages by words, with matching lines), get_doc (one page as Markdown). Read-only, no auth."
    }
  ],
  "tools": [
    "bash",
    "git",
    "claude",
    "node"
  ]
}
