---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  active?: 'browse' | 'installed' | 'install' | 'publish' | 'sources';
}

const { title = 'Nexus', active = 'browse' } = Astro.props;

const TABS: Array<{ id: NonNullable<Props['active']>; label: string; href: string }> = [
  { id: 'browse',    label: 'Browse',    href: '/' },
  { id: 'installed', label: 'Installed', href: '/installed' },
  { id: 'install',   label: 'Install',   href: '/install' },
  { id: 'publish',   label: 'Publish',   href: '/publish' },
  { id: 'sources',   label: 'Sources',   href: '/sources' },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Nexus</title>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <header class="nexus-bar">
      <a class="nexus-brand" href="/" aria-label="Nexus — browse">
        <span class="glyph">NEX</span>
        <span class="wordmark">NEXUS</span>
        <span class="subtitle">AuraOS app store</span>
      </a>
      <nav class="nexus-tabs" aria-label="Store">
        {TABS.map((tab) => (
          <a
            href={tab.href}
            class:list={['nexus-tab', { active: tab.id === active }]}
            aria-current={tab.id === active ? 'page' : undefined}
          >{tab.label}{tab.id === 'installed' && <span class="tab-badge" data-updates-badge hidden></span>}</a>
        ))}
      </nav>
    </header>
    <main class="nexus-main">
      <slot />
    </main>
    <script>
      import '../scripts/store';
    </script>

    <style is:global>
      :root {
        color-scheme: dark;
      }
      html, body {
        margin: 0;
        padding: 0;
        font-family: var(--aura-font-mono, 'IBM Plex Mono', ui-monospace, monospace);
        background: var(--aura-color-bg, #0a0a0a);
        color: var(--aura-color-text, #ccffcc);
        min-height: 100vh;
      }
      a { color: var(--aura-color-primary, #00ff41); text-decoration: none; }
      a:hover { text-shadow: 0 0 6px var(--aura-color-primary, #00ff41); }
      button {
        font-family: inherit;
        font-size: 0.85rem;
        background: transparent;
        color: var(--aura-color-primary);
        border: 1px solid var(--aura-color-border);
        padding: 6px 12px;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        transition: box-shadow 0.1s, border-color 0.1s;
      }
      button:hover { border-color: var(--aura-color-primary); box-shadow: 0 0 8px var(--aura-color-primary); }
      button[disabled] { opacity: 0.4; cursor: not-allowed; box-shadow: none; }
      input, textarea, select {
        font-family: inherit;
        background: var(--aura-color-surface);
        color: var(--aura-color-text);
        border: 1px solid var(--aura-color-border);
        padding: 6px 10px;
      }
      input:focus, textarea:focus, select:focus {
        outline: none;
        border-color: var(--aura-color-primary);
      }
      /* ── Top bar: brand + tabs. One row on wide screens; on narrow ones
       *   the tabs become a swipeable strip on their own row. ── */
      .nexus-bar {
        position: sticky; top: 0;
        background: var(--aura-color-surface);
        border-bottom: 1px solid var(--aura-color-border);
        padding: 8px 16px;
        display: flex; flex-wrap: wrap; align-items: center;
        column-gap: 24px; row-gap: 6px;
        z-index: 20;
      }
      .nexus-brand {
        display: flex; align-items: center; gap: 10px;
        font-size: 0.95rem; flex: 0 0 auto; min-width: 0;
        color: var(--aura-color-text);
      }
      .nexus-brand:hover { text-shadow: none; }
      .nexus-brand .glyph {
        color: var(--aura-color-primary); font-weight: 700; letter-spacing: 0.12em;
        border: 1px solid var(--aura-color-primary); padding: 2px 5px; font-size: 0.7rem;
      }
      .nexus-brand .wordmark { font-weight: 700; letter-spacing: 0.15em; }
      .nexus-brand .subtitle { color: var(--aura-color-text-dim); font-size: 0.7rem; letter-spacing: 0.06em; white-space: nowrap; }
      .nexus-tabs {
        display: flex; gap: 2px; flex: 1 1 auto; min-width: 0;
        overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
      }
      .nexus-tabs::-webkit-scrollbar { display: none; }
      .nexus-tab {
        position: relative;
        padding: 8px 12px;
        font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--aura-color-text-dim);
        border-bottom: 2px solid transparent;
        white-space: nowrap; flex-shrink: 0;
      }
      .nexus-tab:hover { color: var(--aura-color-text); text-shadow: none; }
      .nexus-tab.active { color: var(--aura-color-primary); border-bottom-color: var(--aura-color-primary); }
      .tab-badge {
        display: inline-block; margin-left: 6px; min-width: 16px; padding: 0 4px;
        font-size: 0.62rem; line-height: 16px; text-align: center; letter-spacing: 0;
        color: var(--aura-color-bg); background: var(--aura-color-warning, #e0a000);
      }
      .tab-badge[hidden] { display: none; }
      @media (max-width: 720px) {
        .nexus-brand .subtitle { display: none; }
        .nexus-bar { padding: 6px 10px 0; }
        .nexus-tabs { flex: 1 1 100%; }
        .nexus-tab { padding: 8px 10px; }
      }
      .nexus-main { padding: 20px 16px; max-width: 1100px; margin: 0 auto; }
      .nexus-card {
        border: 1px solid var(--aura-color-border);
        padding: 12px 14px;
        margin-bottom: 10px;
        background: var(--aura-color-surface);
      }
      .nexus-card-head {
        display: flex;
        flex-wrap: wrap;             /* action row drops below info when tight */
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      /* The first child of card-head is the info column (title + meta).
       * Letting it own a soft min of ~220px means the actions row gets
       * shoved onto its own line once info would have to squash narrower
       * than that — instead of crushing both columns into illegible strips. */
      .nexus-card-head > :first-child {
        flex: 1 1 220px;
        min-width: 0;
      }
      .nexus-card-title {
        font-weight: 600;
        color: var(--aura-color-text);
        letter-spacing: 0.05em;
        display: flex;
        flex-wrap: wrap;            /* badge + name + id wrap on narrow */
        align-items: center;
        gap: 6px;
        word-break: break-word;
      }
      .nexus-card-desc {
        color: var(--aura-color-text-dim);
        font-size: 0.8rem;
        margin-top: 4px;
        word-break: break-word;
      }
      .nexus-card-meta {
        color: var(--aura-color-text-dim);
        font-size: 0.7rem;
        margin-top: 8px;
        letter-spacing: 0.04em;
        word-break: break-all;      /* long refs / digests wrap mid-string */
      }
      /* Inline <code> in body text — keep long paths from forcing
       * horizontal scroll. */
      .nexus-main code { word-break: break-all; }
      .nexus-card-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        flex-shrink: 0;
      }
      /* When the info column above wraps the actions onto their own
       * line (`flex-basis: 100%`), expand the action buttons to fill
       * the row so they read as a full-width control bar instead of a
       * cluster on the right. */
      @media (max-width: 480px) {
        .nexus-card-actions { width: 100%; }
        .nexus-card-actions > button,
        .nexus-card-actions > a.nexus-tab {
          flex: 1 1 auto;
          text-align: center;
        }
      }
      .nexus-empty {
        text-align: center;
        color: var(--aura-color-text-dim);
        padding: 60px 16px;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
      }
      .nexus-section {
        margin: 16px 0;
      }
      /* ── Section header (SectionHeader.astro) — replaces the old `// LABEL`. ── */
      .sec-head {
        display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between;
        gap: 8px 16px; margin: 0 0 12px;
      }
      .sec-head-text { min-width: 0; }
      .sec-title {
        display: flex; align-items: center; gap: 10px;
        margin: 0; font-size: 0.95rem; font-weight: 600; letter-spacing: 0.04em;
        color: var(--aura-color-text);
      }
      .sec-title::before {
        content: ''; width: 3px; height: 1em; background: var(--aura-color-primary);
        box-shadow: 0 0 6px var(--aura-color-primary);
      }
      h3.sec-title { font-size: 0.82rem; }
      .sec-count {
        font-size: 0.68rem; font-weight: 400; padding: 1px 7px;
        color: var(--aura-color-text-dim); border: 1px solid var(--aura-color-border);
      }
      .sec-desc { margin: 4px 0 0 13px; font-size: 0.74rem; color: var(--aura-color-text-dim); }
      .sec-actions { display: flex; gap: 6px; align-items: center; }
      .btn-ghost, .btn-icon {
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase;
        padding: 6px 12px; min-height: 32px; box-sizing: border-box;
        color: var(--aura-color-text-dim); background: transparent;
        border: 1px solid var(--aura-color-border); cursor: pointer; white-space: nowrap;
      }
      .btn-ghost:hover, .btn-icon:hover { color: var(--aura-color-primary); border-color: var(--aura-color-primary); text-shadow: none; box-shadow: none; }
      .btn-icon { padding: 6px 10px; font-size: 0.9rem; letter-spacing: 0; }
      [hidden] { display: none !important; }
      .badge {
        display: inline-block;
        font-size: 0.65rem;
        letter-spacing: 0.06em;
        padding: 1px 6px;
        border: 1px solid var(--aura-color-border);
        color: var(--aura-color-text-dim);
        text-transform: uppercase;
      }
      .badge.primary {
        color: var(--aura-color-primary);
        border-color: var(--aura-color-primary);
      }
      .nexus-form { display: flex; flex-direction: column; gap: 10px; max-width: 640px; }
      .nexus-form label { font-size: 0.75rem; letter-spacing: 0.08em; color: var(--aura-color-text-dim); }
      /* Bare inputs inside .nexus-form fill the column width. */
      .nexus-form input,
      .nexus-form textarea,
      .nexus-form select {
        width: 100%;
        box-sizing: border-box;
      }

      /* Input + button row. The input keeps a soft min of 220px so it
       * never shrinks below usable; below that, the buttons after it
       * wrap onto their own line (full width on narrow screens). */
      .nexus-form-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .nexus-form-row > input  { flex: 1 1 220px; min-width: 0; }
      .nexus-form-row > button { flex: 0 0 auto; }
      @media (max-width: 480px) {
        .nexus-form-row > button { flex: 1 1 auto; }
      }

      /* Multi-input grid (publish page's tag/channel/branch row). Uses
       * `auto-fit + minmax(180px, 1fr)` so children break to a new row as
       * soon as 180px is more than half the available width. Each field
       * keeps a sensible minimum, the row collapses to single-column on
       * narrow screens automatically. */
      .nexus-form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 8px;
        align-items: stretch;       /* every cell takes the row's full height */
      }
      /* Each cell is a flex column: label at natural height on top, input
       * pushed to the bottom via `margin-top: auto`. Result: regardless of
       * which label wrapped onto two lines and which didn't, every input
       * in the row sits on a shared baseline. */
      .nexus-form-grid > div {
        min-width: 0;
        display: flex;
        flex-direction: column;
      }
      .nexus-form-grid > div > input,
      .nexus-form-grid > div > select {
        margin-top: auto;           /* float to bottom of the cell */
        width: 100%;
        box-sizing: border-box;
      }
      pre.nexus-log {
        background: var(--aura-color-bg);
        border: 1px solid var(--aura-color-border);
        padding: 10px;
        font-size: 0.75rem;
        white-space: pre-wrap;
        max-height: 40vh;
        overflow-y: auto;
      }
      .diff-add    { color: var(--aura-color-warning); }
      .diff-remove { color: var(--aura-color-text-dim); }
      .diff-info   { color: var(--aura-color-info, var(--aura-color-primary)); }
      /* ── permission approval ──────────────────────────────────────────
         Installing grants tools and permissions to code the user has not
         read. The OS computes the diff server-side already and the CLI
         shows it; this is the same information for the GUI, so a one-click
         install stops being a blind grant. */
      .perm-overlay {
        position: fixed; inset: 0; z-index: 100;
        display: flex; align-items: center; justify-content: center;
        padding: 20px;
        background: color-mix(in srgb, var(--aura-color-bg) 88%, transparent);
      }
      .perm-overlay[hidden] { display: none; }
      .perm-dialog {
        width: min(560px, 100%);
        max-height: 86vh; overflow-y: auto;
        background: var(--aura-color-surface);
        border: 1px solid var(--aura-color-primary);
        box-shadow: var(--aura-glow-primary);
        padding: 18px 20px;
      }
      .perm-title {
        margin: 0 0 4px; font-size: 0.95rem; letter-spacing: 0.06em;
        text-transform: uppercase; color: var(--aura-color-primary);
      }
      .perm-sub { margin: 0 0 14px; font-size: 0.78rem; color: var(--aura-color-text-dim); }
      .perm-group { margin-bottom: 12px; }
      .perm-group-label {
        font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase;
        color: var(--aura-color-text-dim); margin-bottom: 5px;
      }
      .perm-list { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
      .perm-item {
        font-size: 0.78rem; padding: 3px 8px;
        border: 1px solid var(--aura-color-border);
      }
      /* A tool that is effectively root on the host should not look like a
         tool that lets the app read a file. */
      .perm-item.is-danger {
        color: var(--aura-color-danger);
        border-color: var(--aura-color-danger);
      }
      .perm-warn {
        margin: 12px 0 0; padding: 9px 11px; font-size: 0.76rem; line-height: 1.5;
        color: var(--aura-color-danger);
        border: 1px solid var(--aura-color-danger);
      }
      .perm-none { font-size: 0.8rem; color: var(--aura-color-text-dim); }
      .perm-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 18px; }
      .perm-actions .perm-ok { color: var(--aura-color-bg); background: var(--aura-color-primary); border-color: var(--aura-color-primary); }
      .perm-actions .perm-ok:hover { box-shadow: var(--aura-glow-primary); }
      .perm-actions .perm-ok:disabled { opacity: 0.5; box-shadow: none; cursor: not-allowed; }
      /* ── identity choice ──────────────────────────────────────────────
         The store found an installed app with the same id or originId and
         will not decide for the user which one wins. */
      .id-text { margin: 0 0 12px; font-size: 0.82rem; line-height: 1.5; }
      .id-ids  { margin: 0 0 14px; font-size: 0.72rem; color: var(--aura-color-text-dim); line-height: 1.6; }
      .id-ids code { font-size: 0.72rem; }
      .id-choices { display: flex; flex-direction: column; gap: 6px; margin: 0; padding: 0; border: 0; }
      .id-choice {
        display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; align-items: start;
        padding: 8px 10px; border: 1px solid var(--aura-color-border); cursor: pointer;
      }
      .id-choice:has(input:checked) { border-color: var(--aura-color-primary); }
      .id-choice input { margin: 3px 0 0; grid-row: span 2; }
      .id-choice-label { font-size: 0.82rem; }
      .id-choice-desc  { font-size: 0.74rem; color: var(--aura-color-text-dim); }
      .id-newid { margin-top: 12px; display: flex; flex-direction: column; gap: 4px; font-size: 0.72rem;
        letter-spacing: 0.12em; text-transform: uppercase; color: var(--aura-color-text-dim); }
      .id-newid[hidden] { display: none; }
      .id-newid input { font: inherit; font-size: 0.85rem; letter-spacing: normal; text-transform: none;
        padding: 6px 8px; color: var(--aura-color-text); background: var(--aura-color-bg);
        border: 1px solid var(--aura-color-border); }
      .id-newid input[aria-invalid="true"] { border-color: var(--aura-color-danger); }
      .id-err { color: var(--aura-color-danger); text-transform: none; letter-spacing: normal; min-height: 1em; }
      /* ── Browse toolbar: search, status chips, sort, view, categories ── */
      .toolbar {
        position: sticky; top: var(--bar-h, 46px); z-index: 10;
        display: flex; flex-direction: column; gap: 8px;
        margin: -20px -16px 16px; padding: 12px 16px 10px;
        background: color-mix(in srgb, var(--aura-color-bg) 92%, transparent);
        backdrop-filter: blur(6px);
        border-bottom: 1px solid var(--aura-color-border);
      }
      .search {
        display: flex; align-items: center; gap: 8px;
        border: 1px solid var(--aura-color-border); background: var(--aura-color-surface);
        padding: 0 10px; min-height: 40px;
      }
      .search:focus-within { border-color: var(--aura-color-primary); box-shadow: 0 0 8px color-mix(in srgb, var(--aura-color-primary) 40%, transparent); }
      .search input { flex: 1; min-width: 0; border: 0; background: transparent; padding: 8px 0; font-size: 0.9rem; }
      .search input:focus { border: 0; }
      .search-icon { color: var(--aura-color-text-dim); font-size: 1.05rem; }
      .search-kbd {
        font: inherit; font-size: 0.65rem; color: var(--aura-color-text-dim);
        border: 1px solid var(--aura-color-border); padding: 0 5px;
      }
      @media (hover: none) { .search-kbd { display: none; } }
      .toolbar-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
      .toolbar-end { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
      .toolbar-end select { min-height: 32px; font-size: 0.75rem; }
      .chips { display: flex; flex-wrap: wrap; gap: 6px; }
      .chips-scroll { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
      .chips-scroll::-webkit-scrollbar { display: none; }
      .chip {
        display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0;
        min-height: 32px; padding: 4px 12px; font-size: 0.72rem; letter-spacing: 0.04em;
        text-transform: none; color: var(--aura-color-text-dim);
        border: 1px solid var(--aura-color-border); border-radius: 999px; background: transparent;
      }
      .chip [data-chip-count] { font-size: 0.65rem; opacity: 0.75; }
      .chip [data-chip-count]:empty { display: none; }
      .chip:hover { color: var(--aura-color-text); border-color: var(--aura-color-text-dim); box-shadow: none; }
      .chip.active {
        color: var(--aura-color-primary); border-color: var(--aura-color-primary);
        background: color-mix(in srgb, var(--aura-color-primary) 10%, transparent);
      }
      .chip.is-empty { opacity: 0.45; }
      .chip-update.active, .chip-update:not(.is-empty) [data-chip-count] { color: var(--aura-color-warning, #e0a000); }
      .view-toggle { display: inline-flex; }
      .view-toggle button {
        min-height: 32px; min-width: 36px; padding: 4px 8px; font-size: 0.95rem; letter-spacing: 0;
        color: var(--aura-color-text-dim);
      }
      .view-toggle button + button { border-left: 0; }
      .view-toggle button.active { color: var(--aura-color-primary); border-color: var(--aura-color-primary); }
      /* Phones: the toolbar scrolls away with the page (the header stays),
         each chip group is one swipeable row, and the controls share a row. */
      @media (max-width: 560px) {
        .toolbar { position: static; margin: -14px -12px 12px; padding: 10px 12px 8px; gap: 6px; }
        .toolbar-row { flex-direction: column; align-items: stretch; gap: 6px; }
        .toolbar .chips { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
        .toolbar .chips::-webkit-scrollbar { display: none; }
        .toolbar-end { flex-wrap: nowrap; width: 100%; min-width: 0; }
        .toolbar-end > * { flex: 0 0 auto; }
        .toolbar-end select { flex: 1 1 0; width: 1px; min-width: 0; text-overflow: ellipsis; }
        .nexus-main { padding: 14px 12px; }
      }
      .source-warn {
        border: 1px solid var(--aura-color-warning, #e0a000); color: var(--aura-color-warning, #e0a000);
        background: color-mix(in srgb, var(--aura-color-warning, #e0a000) 8%, transparent);
        padding: 8px 12px; margin-bottom: 12px; font-size: 0.72rem;
      }
      .source-warn summary { cursor: pointer; }
      .source-warn div { margin-top: 4px; word-break: break-word; }

      /* ── App list: grid tiles or list rows, same card markup ── */
      .app-list.view-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 10px; }
      .app-list.view-list { display: flex; flex-direction: column; gap: 6px; }
      .app-card {
        position: relative; display: flex; flex-direction: column; gap: 10px;
        padding: 12px; min-width: 0;
        background: var(--aura-color-surface); border: 1px solid var(--aura-color-border);
        transition: border-color 0.12s, box-shadow 0.12s;
      }
      .app-card:hover { border-color: color-mix(in srgb, var(--aura-color-primary) 55%, var(--aura-color-border)); }
      .app-card[hidden] { display: none; }
      .app-card-link { display: flex; gap: 12px; align-items: flex-start; color: inherit; min-width: 0; }
      .app-card-link:hover { text-shadow: none; }
      .app-card-link:hover .app-card-name { color: var(--aura-color-primary); }
      .app-glyph {
        flex: 0 0 auto; width: 44px; height: 44px; display: grid; place-items: center;
        font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em;
        color: var(--aura-color-primary); border: 1px solid var(--aura-color-primary);
        background: color-mix(in srgb, var(--aura-color-primary) 8%, transparent);
      }
      .app-card-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
      .app-card-name { font-weight: 600; letter-spacing: 0.03em; color: var(--aura-color-text); overflow-wrap: anywhere; }
      .app-card-id { font-size: 0.66rem; color: var(--aura-color-text-dim); overflow-wrap: anywhere; }
      .app-card-desc {
        margin-top: 4px; font-size: 0.76rem; line-height: 1.45; color: var(--aura-color-text-dim);
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      }
      .app-card-foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; margin-top: auto; }
      .app-card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; min-width: 0; }
      .app-card-meta .badge.cat { color: var(--aura-color-text-dim); }
      .app-card-status { flex-basis: 100%; font-size: 0.66rem; color: var(--aura-color-primary); }
      .app-card-status:empty { display: none; }
      .app-card-status.is-update { color: var(--aura-color-warning, #e0a000); }
      /* List rows: one line on wide screens. */
      .view-list .app-card { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 8px 12px; }
      .view-list .app-card-link { flex: 1 1 320px; align-items: center; }
      .view-list .app-glyph { width: 34px; height: 34px; font-size: 0.64rem; }
      .view-list .app-card-desc { -webkit-line-clamp: 1; margin-top: 0; }
      .view-list .app-card-foot { flex: 0 1 auto; margin-top: 0; align-items: center; }
      .view-list .ic-note { flex-basis: 100%; }
      @media (max-width: 560px) {
        .app-list.view-grid { grid-template-columns: 1fr; }
        .view-list .app-card-link { flex-basis: 100%; }
        .view-list .app-card-foot { flex-basis: 100%; }
        .view-list .app-card-desc { display: none; }
      }
      /* Featured: a swipeable strip. */
      .featured-strip {
        display: grid; grid-auto-flow: column; grid-auto-columns: minmax(260px, 1fr);
        gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 4px;
      }
      .featured-strip .app-card { scroll-snap-align: start; border-left: 3px solid var(--aura-color-primary); }
      @media (max-width: 560px) { .featured-strip { grid-auto-columns: 85%; } }

      /* ── Install control: main button + ▾ menu ── */
      .ic { display: inline-flex; flex: 0 0 auto; }
      .ic button {
        min-height: 34px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em;
        color: var(--aura-color-primary); border: 1px solid var(--aura-color-primary);
        background: color-mix(in srgb, var(--aura-color-primary) 8%, transparent);
      }
      .ic .ic-main { padding: 6px 14px; min-width: 84px; }
      .ic .ic-more { padding: 6px 8px; border-left-color: color-mix(in srgb, var(--aura-color-primary) 40%, transparent); }
      .ic .ic-main + .ic-more { margin-left: -1px; }
      .ic .ic-main.is-open { background: transparent; }
      .ic .ic-main.is-update, .ic[data-status="installed"] .ic-main.is-update + .ic-more {
        color: var(--aura-color-warning, #e0a000); border-color: var(--aura-color-warning, #e0a000);
        background: color-mix(in srgb, var(--aura-color-warning, #e0a000) 10%, transparent);
      }
      .ic[data-status="id-taken"] button { color: var(--aura-color-text-dim); border-color: var(--aura-color-border); background: transparent; }
      .ic-lg button { min-height: 40px; font-size: 0.8rem; }
      .ic-lg .ic-main { padding: 8px 20px; }
      .ic-note {
        font-size: 0.72rem; padding-top: 6px; border-top: 1px dashed var(--aura-color-border);
        color: var(--aura-color-text-dim); white-space: pre-wrap; overflow-wrap: anywhere;
      }
      .ic-note.ok { color: var(--aura-color-primary); }
      .ic-note.err { color: var(--aura-color-warning, #e0a000); }
      .ic-backdrop { position: fixed; inset: 0; z-index: 90; background: color-mix(in srgb, var(--aura-color-bg) 70%, transparent); }
      .ic-menu {
        position: fixed; z-index: 95; min-width: 240px; max-width: min(340px, calc(100vw - 16px));
        max-height: 70vh; overflow-y: auto;
        background: var(--aura-color-surface); border: 1px solid var(--aura-color-primary);
        box-shadow: var(--aura-glow-primary, 0 0 12px rgba(0,0,0,.4)); padding: 6px;
      }
      .ic-menu.is-sheet {
        left: 0; right: 0; bottom: 0; top: auto; max-width: none; width: 100%; box-sizing: border-box;
        border-width: 1px 0 0; padding: 10px 10px calc(10px + env(safe-area-inset-bottom));
        animation: sheet-in 0.16s ease-out;
      }
      @keyframes sheet-in { from { transform: translateY(100%); } to { transform: none; } }
      .ic-menu-title {
        padding: 6px 10px 8px; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--aura-color-text-dim); border-bottom: 1px solid var(--aura-color-border); margin-bottom: 4px;
      }
      .ic-item {
        display: flex; flex-direction: column; align-items: flex-start; gap: 2px; width: 100%;
        min-height: 40px; padding: 8px 10px; text-align: left; text-transform: none; letter-spacing: 0.02em;
        border: 1px solid transparent; color: var(--aura-color-text);
      }
      .ic-item:hover, .ic-item:focus-visible { border-color: var(--aura-color-primary); outline: none; box-shadow: none; color: var(--aura-color-primary); }
      .ic-item-label { font-size: 0.8rem; }
      .ic-item-desc { font-size: 0.68rem; color: var(--aura-color-text-dim); }
      .ic-item.danger, .ic-item.danger:hover { color: var(--aura-color-danger, #ff5555); }
      .ic-form-hint { margin: 6px 10px 10px; font-size: 0.72rem; color: var(--aura-color-text-dim); line-height: 1.45; }
      .ic-form { display: flex; flex-direction: column; gap: 4px; margin: 0 10px; font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--aura-color-text-dim); }
      .ic-form input { font-size: 0.85rem; letter-spacing: normal; text-transform: none; padding: 8px; }
      .ic-form-err { color: var(--aura-color-danger, #ff5555); text-transform: none; letter-spacing: normal; min-height: 1em; }
      .ic-form-row { display: flex; justify-content: flex-end; gap: 8px; margin: 10px; }
      .ic-form-row .ic-go { color: var(--aura-color-bg); background: var(--aura-color-primary); border-color: var(--aura-color-primary); }
      .ic-form-row .ic-go:disabled { opacity: 0.5; }

      /* Page transitions: a quick fade; none for reduced motion. */
      ::view-transition-old(root), ::view-transition-new(root) { animation-duration: 0.12s; }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
        .ic-menu.is-sheet { animation: none; }
      }
    </style>

    <!-- Permission approval. One dialog for every page that can install; the
         pages call `auraInstall()` rather than POSTing /api/nexus/install
         themselves, so none of them can skip the diff by accident. -->
    <div class="perm-overlay" data-perm-overlay hidden transition:persist="nexus-perm-dialog">
      <div class="perm-dialog" role="dialog" aria-modal="true" aria-labelledby="perm-title">
        <h2 class="perm-title" id="perm-title" data-perm-title>Review permissions</h2>
        <p class="perm-sub" data-perm-sub></p>
        <div data-perm-body></div>
        <div class="perm-actions">
          <button type="button" data-perm-cancel>Cancel</button>
          <button type="button" class="perm-ok" data-perm-ok>Install</button>
        </div>
      </div>
    </div>

    <!-- Identity choice: the app shares its id or originId with an installed
         app (scenarios A, B, D in core AppIdentity). Nothing is installed
         until the user picks what should happen. -->
    <div class="perm-overlay" data-id-overlay hidden transition:persist="nexus-id-dialog">
      <div class="perm-dialog" role="dialog" aria-modal="true" aria-labelledby="id-title">
        <h2 class="perm-title" id="id-title" data-id-title>Already installed</h2>
        <p class="id-text" data-id-text></p>
        <p class="id-ids" data-id-ids></p>
        <fieldset class="id-choices" data-id-choices></fieldset>
        <label class="id-newid" data-id-newid hidden>
          Local app id
          <input type="text" data-id-appid spellcheck="false" autocomplete="off" />
          <span class="id-err" data-id-err></span>
        </label>
        <div class="perm-actions">
          <button type="button" data-id-cancel>Cancel</button>
          <button type="button" class="perm-ok" data-id-ok>Continue</button>
        </div>
      </div>
    </div>

    <script is:inline>
      /* Install with informed consent.
       *
       * The server already computes a PermissionDiff and refuses to proceed
       * without approval unless `autoApprove` is passed — the CLI has always
       * honoured that. The GUI used to pass autoApprove:true on every install,
       * so a click granted every tool and permission an app declared without
       * ever naming them. `docker` in an app's tools[] is host root via the
       * socket; that is not something to hand over silently.
       *
       * Flow: install without autoApprove → if the app shares its id or
       * originId with an installed one, ask what should happen (identity
       * dialog) → if the server asks for approval, show the diff → each
       * answer is the same install again, carrying the decision.
       */
      (function () {
        // Runs again on every ClientRouter page swap; the dialogs are
        // persisted DOM, so wire them (and the globals) only once.
        if (window.__auraDialogs) return;
        var overlay = document.querySelector('[data-perm-overlay]');
        if (!overlay) return;
        window.__auraDialogs = true;
        var titleEl  = overlay.querySelector('[data-perm-title]');
        var subEl    = overlay.querySelector('[data-perm-sub]');
        var bodyEl   = overlay.querySelector('[data-perm-body]');
        var okBtn    = overlay.querySelector('[data-perm-ok]');
        var cancelBtn= overlay.querySelector('[data-perm-cancel]');
        var resolver = null;
        var opener   = null;

        /* Tools that are not really "a tool" — they hand over the host. Kept in
         * step with the store's own RISKY_TOOLS. */
        var DANGEROUS = { 'docker': 1, '*': 1 };

        function group(label, items, cls) {
          if (!items || !items.length) return null;
          var wrap = document.createElement('div');
          wrap.className = 'perm-group';
          var lab = document.createElement('div');
          lab.className = 'perm-group-label';
          lab.textContent = label;
          var ul = document.createElement('ul');
          ul.className = 'perm-list';
          items.forEach(function (t) {
            var li = document.createElement('li');
            li.className = 'perm-item ' + (cls || '') + (DANGEROUS[t] ? ' is-danger' : '');
            li.textContent = t;
            ul.appendChild(li);
          });
          wrap.appendChild(lab); wrap.appendChild(ul);
          return wrap;
        }

        function render(diff, name) {
          titleEl.textContent = (diff.versionFrom ? 'Update' : 'Install') + ' ' + (name || diff.appId);
          subEl.textContent = diff.versionFrom
            ? diff.appId + '  v' + diff.versionFrom + ' → v' + diff.versionTo
            : diff.appId + '  v' + diff.versionTo;

          bodyEl.textContent = '';
          var added = [
            group('Tools it will gain', diff.toolsAdded, 'diff-add'),
            group('Permissions it will gain', diff.permissionsAdded, 'diff-add'),
            group('New intent filters', diff.intentFiltersAdded, 'diff-info'),
            group('Tools it gives up', diff.toolsRemoved, 'diff-remove'),
            group('Permissions it gives up', diff.permissionsRemoved, 'diff-remove'),
          ].filter(Boolean);

          if (diff.dataProviderAdded) {
            var dp = document.createElement('div');
            dp.className = 'perm-group';
            var dl = document.createElement('div');
            dl.className = 'perm-group-label';
            dl.textContent = 'Data provider';
            var dv = document.createElement('div');
            dv.className = 'perm-item diff-add';
            dv.textContent = 'exposes data other apps can read';
            dp.appendChild(dl); dp.appendChild(dv);
            added.push(dp);
          }

          if (!added.length) {
            var none = document.createElement('p');
            none.className = 'perm-none';
            none.textContent = 'No new tools or permissions.';
            bodyEl.appendChild(none);
          } else {
            added.forEach(function (n) { bodyEl.appendChild(n); });
          }

          var risky = (diff.toolsAdded || []).filter(function (t) { return DANGEROUS[t]; });
          if (risky.length) {
            var w = document.createElement('p');
            w.className = 'perm-warn';
            w.textContent = risky.indexOf('docker') >= 0
              ? '⚠ `docker` grants control of the container runtime — effectively root on the host.'
              : '⚠ `*` grants every tool the OS can provide.';
            bodyEl.appendChild(w);
          }
        }

        function close(result) {
          overlay.hidden = true;
          if (opener && opener.focus) opener.focus();
          opener = null;
          var r = resolver; resolver = null;
          if (r) r(result);
        }
        okBtn.addEventListener('click', function () { close(true); });
        cancelBtn.addEventListener('click', function () { close(false); });
        overlay.addEventListener('click', function (ev) { if (ev.target === overlay) close(false); });
        document.addEventListener('keydown', function (ev) {
          if (overlay.hidden) return;
          if (ev.key === 'Escape') { ev.preventDefault(); close(false); }
        });

        function ask(diff, name) {
          render(diff, name);
          opener = document.activeElement;
          overlay.hidden = false;
          okBtn.focus();
          return new Promise(function (res) { resolver = res; });
        }

        // ─── Identity choice ───────────────────────────────────────────
        var idOverlay = document.querySelector('[data-id-overlay]');
        var idTitle   = idOverlay.querySelector('[data-id-title]');
        var idText    = idOverlay.querySelector('[data-id-text]');
        var idIds     = idOverlay.querySelector('[data-id-ids]');
        var idChoices = idOverlay.querySelector('[data-id-choices]');
        var idNew     = idOverlay.querySelector('[data-id-newid]');
        var idInput   = idOverlay.querySelector('[data-id-appid]');
        var idErr     = idOverlay.querySelector('[data-id-err]');
        var idOk      = idOverlay.querySelector('[data-id-ok]');
        var idCancel  = idOverlay.querySelector('[data-id-cancel]');
        var idResolver = null;
        var idOpener   = null;
        var APP_ID = /^[a-z][a-z0-9]*(\.[a-z][a-z0-9]*)+$/;

        function from(c) { return c.incoming.sourceName || c.incoming.ref; }

        /* What the store found, in one sentence, per conflict kind. */
        var TEXT = {
          'switch-source': function (c, name) {
            return name + ' is already installed' + (c.existing.sourceName ? ' from ' + c.existing.sourceName : ' (built or copied here)')
              + '. ' + from(c) + ' offers the same app.';
          },
          'id-taken': function (c, name) {
            return 'An app with the id ' + c.existing.appId + ' is already installed, and it is '
              + (c.existing.originId && c.incoming.originId ? 'a different app' : 'not known to be the same app')
              + '. The store will not replace it.';
          },
          'same-origin': function (c, name) {
            return name + ' (' + c.incoming.appId + ') is the same app as your installed ' + c.existing.appId + '.';
          },
        };
        var TITLE = { 'switch-source': 'Already installed', 'id-taken': 'Id already taken', 'same-origin': 'Same app, other id' };

        function label(action, c) {
          if (action === 'update-existing') return {
            label: 'Update ' + c.existing.appId,
            desc: c.kind === 'id-taken'
              ? 'Replace the installed app with ' + c.incoming.version + ' from ' + from(c) + '.'
              : 'Install ' + c.incoming.version + ' into it; it keeps its id and data and updates from ' + from(c) + ' from now on.',
          };
          if (action === 'install-as') return {
            label: 'Install under another id',
            desc: 'Keep ' + c.existing.appId + ' and install this app beside it.',
          };
          return {
            label: 'Install an independent copy',
            desc: 'A separate app with its own id and identity. It does not get updates from ' + from(c) + '.',
          };
        }

        function selected() {
          var r = idChoices.querySelector('input:checked');
          return r ? r.value : null;
        }
        function syncId() {
          var a = selected();
          var needsId = a === 'install-as' || a === 'install-copy';
          idNew.hidden = !needsId;
          var bad = needsId && !APP_ID.test(idInput.value.trim());
          idInput.setAttribute('aria-invalid', bad ? 'true' : 'false');
          idErr.textContent = bad ? 'reverse-domain id, e.g. com.example.app' : '';
          idOk.disabled = !a || bad;
        }

        function renderIdentity(c, name) {
          var n = name || c.incoming.name || c.incoming.appId;
          idTitle.textContent = TITLE[c.kind] || 'Already installed';
          idText.textContent = (TEXT[c.kind] || TEXT['id-taken'])(c, n);
          idIds.textContent = '';
          [['installed', c.existing.appId, c.existing.originId, c.existing.scope],
           ['offered', c.incoming.appId, c.incoming.originId, from(c)]].forEach(function (row) {
            var line = document.createElement('div');
            line.textContent = row[0] + ': ' + row[1] + ' · ' + row[3] + ' · origin ' + (row[2] || 'unknown');
            idIds.appendChild(line);
          });
          idChoices.textContent = '';
          c.choices.forEach(function (action, i) {
            var l = label(action, c);
            var wrap = document.createElement('label');
            wrap.className = 'id-choice';
            var input = document.createElement('input');
            input.type = 'radio'; input.name = 'id-choice'; input.value = action;
            if (i === 0) input.checked = true;
            input.addEventListener('change', syncId);
            var t = document.createElement('span'); t.className = 'id-choice-label'; t.textContent = l.label;
            var d = document.createElement('span'); d.className = 'id-choice-desc';  d.textContent = l.desc;
            wrap.appendChild(input); wrap.appendChild(t); wrap.appendChild(d);
            idChoices.appendChild(wrap);
          });
          idInput.value = c.suggestedAppId || '';
          syncId();
        }

        function closeIdentity(result) {
          idOverlay.hidden = true;
          if (idOpener && idOpener.focus) idOpener.focus();
          idOpener = null;
          var r = idResolver; idResolver = null;
          if (r) r(result);
        }
        idInput.addEventListener('input', syncId);
        idOk.addEventListener('click', function () {
          var action = selected();
          if (!action || idOk.disabled) return;
          var d = { action: action };
          if (action !== 'update-existing') d.appId = idInput.value.trim();
          closeIdentity(d);
        });
        idCancel.addEventListener('click', function () { closeIdentity(null); });
        idOverlay.addEventListener('click', function (ev) { if (ev.target === idOverlay) closeIdentity(null); });
        document.addEventListener('keydown', function (ev) {
          if (idOverlay.hidden) return;
          if (ev.key === 'Escape') { ev.preventDefault(); closeIdentity(null); }
          if (ev.key === 'Enter' && ev.target !== idCancel) { ev.preventDefault(); idOk.click(); }
        });

        /** Ask how to resolve an identity conflict. Resolves the decision or null. */
        function askIdentity(conflict, name) {
          renderIdentity(conflict, name);
          idOpener = document.activeElement;
          idOverlay.hidden = false;
          var first = idChoices.querySelector('input:checked');
          (first || idOk).focus();
          return new Promise(function (res) { idResolver = res; });
        }

        // ─── One flow for install + update ──────────────────────────────
        /* POST, then answer the store's questions in order — the app's
         * identity (A/B/D), then new permissions — each answer a re-POST with
         * the decision in the body, as the CLI does. */
        async function runInstall(url, base, opts, fallbackError) {
          // A choice made up front (Install as… / a fresh copy) rides along from
          // the first request; otherwise the store's question fills it in.
          var identity = opts.identity || null;
          var auto = false;
          for (var round = 0; round < 4; round++) {
            var body = Object.assign({}, base);
            if (auto) body.autoApprove = true;
            if (identity) body.identity = identity;
            var res = await fetch(url, {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            var json = await res.json().catch(function () { return {}; });
            if (json.ok) return json;
            if (json.needsIdentityChoice && json.conflict) {
              if (identity) return { error: 'the store asked about this app again' };
              identity = await askIdentity(json.conflict, opts.name);
              if (!identity) return { cancelled: true };
              if (opts.onApproved) opts.onApproved();
              continue;
            }
            if (json.needsApproval && json.diff && !auto) {
              var approved = await ask(json.diff, opts.name);
              if (!approved) return { cancelled: true };
              if (opts.onApproved) opts.onApproved();
              auto = true;
              continue;
            }
            return { error: json.error || (round === 0 ? fallbackError : '') || ('HTTP ' + res.status) };
          }
          return { error: 'too many questions from the store' };
        }

        /** Update an installed app, asking about its identity and new
         *  permissions when the server requires it. */
        window.auraUpdate = function (id, opts) {
          return runInstall('/api/nexus/update/' + encodeURIComponent(id), {}, opts || {}, 'nothing to update');
        };

        /** Install `ref`, asking about its identity and new permissions when
         *  the server requires it. Resolves { ok, record } | { cancelled: true } | { error }. */
        window.auraInstall = function (ref, opts) {
          opts = opts || {};
          var body = { ref: ref };
          if (opts.scope) body.scope = opts.scope;
          return runInstall('/api/nexus/install', body, opts, '');
        };
      })();
    </script>
  </body>
</html>
