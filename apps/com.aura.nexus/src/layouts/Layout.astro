---
interface Props {
  title?: string;
  active?: 'browse' | 'installed' | 'install' | 'publish';
}

const { title = 'Nexus', active = 'browse' } = Astro.props;

const TABS: Array<{ id: NonNullable<Props['active']>; label: string; href: string }> = [
  { id: 'browse',    label: 'BROWSE',    href: '/' },
  { id: 'installed', label: 'INSTALLED', href: '/installed' },
  { id: 'install',   label: 'INSTALL',   href: '/install' },
  { id: 'publish',   label: 'PUBLISH',   href: '/publish' },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Nexus</title>
  </head>
  <body>
    <header class="nexus-bar">
      <h1 class="nexus-title">
        <span class="glyph">NEX</span>
        <span class="wordmark">NEXUS</span>
        <span class="subtitle">// AuraOS app store</span>
      </h1>
      <nav class="nexus-tabs">
        {TABS.map((tab) => (
          <a
            href={tab.href}
            class:list={['nexus-tab', { active: tab.id === active }]}
          >{tab.label}</a>
        ))}
      </nav>
    </header>
    <main class="nexus-main">
      <slot />
    </main>

    <style is:global>
      :root {
        color-scheme: dark;
      }
      html, body {
        margin: 0;
        padding: 0;
        font-family: var(--aura-font-mono, 'IBM Plex Mono', ui-monospace, monospace);
        background: var(--aura-color-bg, #0a0a0a);
        color: var(--aura-color-text, #ccffcc);
        min-height: 100vh;
      }
      a { color: var(--aura-color-primary, #00ff41); text-decoration: none; }
      a:hover { text-shadow: 0 0 6px var(--aura-color-primary, #00ff41); }
      button {
        font-family: inherit;
        font-size: 0.85rem;
        background: transparent;
        color: var(--aura-color-primary);
        border: 1px solid var(--aura-color-border);
        padding: 6px 12px;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        transition: box-shadow 0.1s, border-color 0.1s;
      }
      button:hover { border-color: var(--aura-color-primary); box-shadow: 0 0 8px var(--aura-color-primary); }
      button[disabled] { opacity: 0.4; cursor: not-allowed; box-shadow: none; }
      input, textarea, select {
        font-family: inherit;
        background: var(--aura-color-surface);
        color: var(--aura-color-text);
        border: 1px solid var(--aura-color-border);
        padding: 6px 10px;
      }
      input:focus, textarea:focus, select:focus {
        outline: none;
        border-color: var(--aura-color-primary);
      }
      /* ── Responsive top bar + tab nav ───────────────────────────────────
       * Three regimes, controlled by the bar's container width — not the
       * viewport — so the same logic works inside the OS launcher, a
       * narrow tiling cell, or full-screen.
       *
       *   ≥ 720px  — title + subtitle on the left, all four tabs on the
       *              right, single row.
       *   ≥ 480px  — subtitle drops; tabs flow under the title on a
       *              second row, still all visible.
       *   < 480px  — tabs become a scroll-snap horizontal strip so the
       *              user can swipe through them without stacking into a
       *              tall vertical menu that eats half the iframe. */
      .nexus-bar {
        position: sticky; top: 0;
        background: var(--aura-color-surface);
        border-bottom: 1px solid var(--aura-color-border);
        padding: 10px 16px;
        display: flex;
        flex-wrap: wrap;            /* nav can drop below title on narrow */
        align-items: center;
        column-gap: 24px;
        row-gap: 8px;
        z-index: 10;
      }
      .nexus-title {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin: 0;
        font-size: 0.95rem;
        min-width: 0;                /* allows the title to shrink */
        flex: 0 0 auto;
      }
      .nexus-title .glyph {
        color: var(--aura-color-primary);
        font-weight: 700;
        letter-spacing: 0.12em;
        border: 1px solid var(--aura-color-primary);
        padding: 2px 5px;
        font-size: 0.7rem;
        flex-shrink: 0;
      }
      .nexus-title .wordmark {
        font-weight: 700;
        letter-spacing: 0.15em;
        color: var(--aura-color-text);
      }
      .nexus-title .subtitle {
        color: var(--aura-color-text-dim);
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        white-space: nowrap;
      }
      .nexus-tabs {
        display: flex;
        flex-wrap: wrap;             /* tabs line-break when there's no room */
        gap: 4px;
        flex: 1 1 auto;              /* takes remaining row when both fit */
        justify-content: flex-start;
        min-width: 0;
      }
      .nexus-tab {
        padding: 4px 10px;
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        color: var(--aura-color-text-dim);
        border: 1px solid transparent;
        white-space: nowrap;
        flex-shrink: 0;              /* tabs never squash */
      }
      .nexus-tab:hover { color: var(--aura-color-text); border-color: var(--aura-color-border); }
      .nexus-tab.active {
        color: var(--aura-color-primary);
        border-color: var(--aura-color-primary);
        background: color-mix(in srgb, var(--aura-color-primary) 8%, transparent);
      }

      /* Medium: drop the subtitle so the title chunk stays compact while
       * the tabs flow onto their second row neatly. */
      @media (max-width: 720px) {
        .nexus-title .subtitle { display: none; }
        .nexus-bar { column-gap: 16px; padding: 8px 12px; }
      }

      /* Tight: lock tabs into a balanced 2-up grid so they wrap as a
       * unit (2 + 2) instead of 3-on-top-and-PUBLISH-dangling-below.
       *
       * `flex: 1 1 calc(50% - 2px)` makes each tab basis half-row minus
       * half the gap (4px gap → 2px share each). All four reach for the
       * same width, so they break into rows of 2 cleanly. When the
       * container is so narrow that 50%-of-row is smaller than the
       * widest label ("INSTALLED") the basis floors out and they stack
       * 1-per-row instead. */
      @media (max-width: 480px) {
        .nexus-bar  { padding: 8px 10px; }
        .nexus-tabs { width: 100%; }      /* the tab grid owns its own row */
        .nexus-tab {
          flex: 1 1 calc(50% - 2px);
          text-align: center;
          padding: 6px 10px;
        }
      }
      /* Phone-narrow: stack one tab per row so the labels can breathe
       * even with the chunky letter-spacing. */
      @media (max-width: 360px) {
        .nexus-tab { flex: 1 1 100%; }
      }

      /* Extra-tight: drop the wordmark — glyph + tabs alone. */
      @media (max-width: 320px) {
        .nexus-title .wordmark { display: none; }
      }
      .nexus-main { padding: 20px 16px; max-width: 1100px; margin: 0 auto; }
      .nexus-card {
        border: 1px solid var(--aura-color-border);
        padding: 12px 14px;
        margin-bottom: 10px;
        background: var(--aura-color-surface);
      }
      .nexus-card-head {
        display: flex;
        flex-wrap: wrap;             /* action row drops below info when tight */
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      /* The first child of card-head is the info column (title + meta).
       * Letting it own a soft min of ~220px means the actions row gets
       * shoved onto its own line once info would have to squash narrower
       * than that — instead of crushing both columns into illegible strips. */
      .nexus-card-head > :first-child {
        flex: 1 1 220px;
        min-width: 0;
      }
      .nexus-card-title {
        font-weight: 600;
        color: var(--aura-color-text);
        letter-spacing: 0.05em;
        display: flex;
        flex-wrap: wrap;            /* badge + name + id wrap on narrow */
        align-items: center;
        gap: 6px;
        word-break: break-word;
      }
      .nexus-card-desc {
        color: var(--aura-color-text-dim);
        font-size: 0.8rem;
        margin-top: 4px;
        word-break: break-word;
      }
      .nexus-card-meta {
        color: var(--aura-color-text-dim);
        font-size: 0.7rem;
        margin-top: 8px;
        letter-spacing: 0.04em;
        word-break: break-all;      /* long refs / digests wrap mid-string */
      }
      /* Inline <code> in body text — keep long paths from forcing
       * horizontal scroll. */
      .nexus-main code { word-break: break-all; }
      .nexus-card-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        flex-shrink: 0;
      }
      /* When the info column above wraps the actions onto their own
       * line (`flex-basis: 100%`), expand the action buttons to fill
       * the row so they read as a full-width control bar instead of a
       * cluster on the right. */
      @media (max-width: 480px) {
        .nexus-card-actions { width: 100%; }
        .nexus-card-actions > button,
        .nexus-card-actions > a.nexus-tab {
          flex: 1 1 auto;
          text-align: center;
        }
      }
      .nexus-empty {
        text-align: center;
        color: var(--aura-color-text-dim);
        padding: 60px 16px;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
      }
      .nexus-section {
        margin: 16px 0;
      }
      .nexus-section h2 {
        font-size: 0.75rem;
        letter-spacing: 0.18em;
        color: var(--aura-color-text-dim);
        text-transform: uppercase;
        margin: 0 0 10px;
      }
      .badge {
        display: inline-block;
        font-size: 0.65rem;
        letter-spacing: 0.06em;
        padding: 1px 6px;
        border: 1px solid var(--aura-color-border);
        color: var(--aura-color-text-dim);
        text-transform: uppercase;
      }
      .badge.primary {
        color: var(--aura-color-primary);
        border-color: var(--aura-color-primary);
      }
      .nexus-form { display: flex; flex-direction: column; gap: 10px; max-width: 640px; }
      .nexus-form label { font-size: 0.75rem; letter-spacing: 0.08em; color: var(--aura-color-text-dim); }
      /* Bare inputs inside .nexus-form fill the column width. */
      .nexus-form input,
      .nexus-form textarea,
      .nexus-form select {
        width: 100%;
        box-sizing: border-box;
      }

      /* Input + button row. The input keeps a soft min of 220px so it
       * never shrinks below usable; below that, the buttons after it
       * wrap onto their own line (full width on narrow screens). */
      .nexus-form-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .nexus-form-row > input  { flex: 1 1 220px; min-width: 0; }
      .nexus-form-row > button { flex: 0 0 auto; }
      @media (max-width: 480px) {
        .nexus-form-row > button { flex: 1 1 auto; }
      }

      /* Multi-input grid (publish page's tag/channel/branch row). Uses
       * `auto-fit + minmax(180px, 1fr)` so children break to a new row as
       * soon as 180px is more than half the available width. Each field
       * keeps a sensible minimum, the row collapses to single-column on
       * narrow screens automatically. */
      .nexus-form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 8px;
        align-items: stretch;       /* every cell takes the row's full height */
      }
      /* Each cell is a flex column: label at natural height on top, input
       * pushed to the bottom via `margin-top: auto`. Result: regardless of
       * which label wrapped onto two lines and which didn't, every input
       * in the row sits on a shared baseline. */
      .nexus-form-grid > div {
        min-width: 0;
        display: flex;
        flex-direction: column;
      }
      .nexus-form-grid > div > input,
      .nexus-form-grid > div > select {
        margin-top: auto;           /* float to bottom of the cell */
        width: 100%;
        box-sizing: border-box;
      }
      pre.nexus-log {
        background: var(--aura-color-bg);
        border: 1px solid var(--aura-color-border);
        padding: 10px;
        font-size: 0.75rem;
        white-space: pre-wrap;
        max-height: 40vh;
        overflow-y: auto;
      }
      .diff-add    { color: var(--aura-color-warning); }
      .diff-remove { color: var(--aura-color-text-dim); }
      .diff-info   { color: var(--aura-color-info, var(--aura-color-primary)); }
    </style>
  </body>
</html>
