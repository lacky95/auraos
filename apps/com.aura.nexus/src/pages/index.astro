---
import Layout from '../layouts/Layout.astro';
import BrowseContent from '../components/BrowseContent.astro';
import CatalogSkeleton from '../components/CatalogSkeleton.astro';
import { shellGet } from '../lib/shellClient';
import type { Catalog } from '../lib/catalog';

// A cached catalog answers in milliseconds. Anything slower is the sources
// being fetched (can take a minute): paint now, scripts/catalog.ts loads it.
const FIRST_PAINT_MS = 250;

const refresh = new URL(Astro.request.url).searchParams.get('refresh') === '1';

let doc: Catalog | null = null;
try {
  doc = await shellGet<Catalog>(Astro.request, '/api/nexus', FIRST_PAINT_MS);
} catch { /* still loading or unreachable: the client takes over */ }
---
<Layout title="Browse" active="browse">
  <div class="catalog" data-catalog data-state={doc ? 'ready' : 'loading'} data-refresh-on-load={refresh ? '1' : undefined}>
    <div class="catalog-status" data-catalog-status role="status" hidden={!!doc}>
      <span class="catalog-spinner" aria-hidden="true"></span>
      <span data-catalog-msg>Loading apps…</span>
      <button type="button" class="btn-ghost" data-catalog-retry hidden>Try again</button>
    </div>
    <div data-catalog-content>
      {doc ? <BrowseContent doc={doc} /> : <CatalogSkeleton />}
    </div>
  </div>
  <script>
    import '../scripts/browse';
    import '../scripts/catalog';
  </script>
</Layout>
