---
import Layout from '../layouts/Layout.astro';
import AppCard from '../components/AppCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { shellGet } from '../lib/shellClient';
import { stateOf, type Catalog } from '../lib/catalog';

const url = new URL(Astro.request.url);
const refresh = url.searchParams.get('refresh') === '1';

let doc: Catalog;
try {
  doc = await shellGet<Catalog>(`/api/nexus${refresh ? '?refresh=1' : ''}`);
} catch {
  doc = { schema: 1, apps: [], featured: [], categories: [], sources: [] };
}

const apps = doc.apps;
const featured = apps.filter((a) => doc.featured.includes(a.id));
const degraded = (doc.sources ?? []).filter((s) => !s.ok);
// Only categories some app is in; label from the catalog's taxonomy.
const used = new Set(apps.flatMap((a) => a.categories ?? []));
const label = new Map(doc.categories.map((c) => [c.slug, c.label]));
const categories = [...used].sort().map((slug) => ({ slug, label: label.get(slug) ?? slug }));
const sources = [...new Set(apps.map((a) => a.sourceName).filter(Boolean))].sort() as string[];
const states = apps.map(stateOf);
const count = (pred: (i: number) => boolean) => apps.filter((_, i) => pred(i)).length;
const nInstalled = count((i) => states[i]!.status === 'installed' || states[i]!.status === 'installing');
const nUpdates = count((i) => states[i]!.updateAvailable);
const nAvailable = count((i) => states[i]!.status === 'available');
---
<Layout title="Browse" active="browse">
  {apps.length === 0 ? (
    <section class="nexus-section">
      <div class="nexus-empty">
        <p>No apps in the catalog yet.</p>
        <p>
          Publish one with <code>aura nexus app publish</code>, or add a source on the
          <a href="/sources">Sources</a> tab.
        </p>
        <p>You can still install by reference from the <a href="/install">Install</a> tab.</p>
        <p><a class="btn-ghost" href="/?refresh=1">↻ Refresh sources</a></p>
      </div>
    </section>
  ) : (
    <div class="browse" data-browse data-key="browse" data-default-view="grid">
      <div class="toolbar">
        <label class="search">
          <span class="search-icon" aria-hidden="true">⌕</span>
          <input data-q type="search" placeholder="Search apps" aria-label="Search apps" autocomplete="off" spellcheck="false" />
          <kbd class="search-kbd" aria-hidden="true">/</kbd>
        </label>
        <div class="toolbar-row">
          <div class="chips" data-chips="status" role="group" aria-label="Show">
            <button type="button" class="chip" data-chip="">All <span data-chip-count>{apps.length}</span></button>
            <button type="button" class="chip" data-chip="installed">Installed <span data-chip-count>{nInstalled}</span></button>
            <button type="button" class="chip chip-update" data-chip="update">Updates <span data-chip-count>{nUpdates}</span></button>
            <button type="button" class="chip" data-chip="available">Not installed <span data-chip-count>{nAvailable}</span></button>
          </div>
          <div class="toolbar-end">
            {sources.length > 1 && (
              <select data-filter="src" aria-label="Source">
                <option value="">All sources</option>
                {sources.map((s) => <option value={`src:${s}`}>{s}</option>)}
              </select>
            )}
            <select data-sort aria-label="Sort">
              <option value="default">Store order</option>
              <option value="name">Name</option>
              <option value="source">Source</option>
            </select>
            <div class="view-toggle" role="group" aria-label="View">
              <button type="button" data-view="grid" title="Grid view" aria-label="Grid view">▦</button>
              <button type="button" data-view="list" title="List view" aria-label="List view">☰</button>
            </div>
            <a class="btn-icon" href="/?refresh=1" data-refresh title="Re-fetch every source now" aria-label="Refresh sources">↻</a>
          </div>
        </div>
        {categories.length > 0 && (
          <div class="chips chips-scroll" data-chips="cat" role="group" aria-label="Category">
            <button type="button" class="chip" data-chip="">All categories</button>
            {categories.map((c) => (
              <button type="button" class="chip" data-chip={`cat:${c.slug}`}>{c.label} <span data-chip-count></span></button>
            ))}
          </div>
        )}
      </div>

      {degraded.length > 0 && (
        <details class="source-warn">
          <summary>⚠ {degraded.length} source{degraded.length > 1 ? 's' : ''} unavailable — showing the last known apps</summary>
          {degraded.map((s) => <div><b>{s.name}</b> ({s.kind}){s.error ? `: ${s.error}` : ''}</div>)}
        </details>
      )}

      {featured.length > 0 && (
        <section class="nexus-section" data-hide-when-filtered>
          <SectionHeader title="Featured" />
          <div class="featured-strip">
            {featured.map((e) => <AppCard entry={e} />)}
          </div>
        </section>
      )}

      <section class="nexus-section">
        <SectionHeader title="Apps" count={apps.length}>
          <button type="button" class="btn-ghost" data-reset hidden>Clear filters</button>
        </SectionHeader>
        <div class="app-list view-grid" data-list>
          {apps.map((e, i) => <AppCard entry={e} index={i} />)}
        </div>
        <div class="nexus-empty" data-noresults hidden>
          <p>No apps match.</p>
          <p><button type="button" class="btn-ghost" data-reset>Clear filters</button></p>
        </div>
      </section>
    </div>
  )}
  <script>
    import '../scripts/browse';
  </script>
</Layout>
