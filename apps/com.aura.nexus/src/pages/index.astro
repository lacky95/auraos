---
import Layout from '../layouts/Layout.astro';
import { shellGet } from '../lib/shellClient.ts';

interface IndexEntry {
  id:          string;
  name:        string;
  description?: string;
  icon?:       string;
  publisher?:  string;
  categories?: string[];
}

interface IndexDoc {
  schema:     number;
  apps:       IndexEntry[];
  featured:   string[];
  categories: Array<{ slug: string; label: string }>;
}

let doc: IndexDoc;
try {
  doc = await shellGet<IndexDoc>('/api/nexus');
} catch {
  doc = { schema: 1, apps: [], featured: [], categories: [] };
}

const featured = doc.apps.filter((a) => doc.featured.includes(a.id));
---
<Layout title="Browse" active="browse">
  <section class="nexus-section">
    <h2>// Featured</h2>
    {featured.length === 0 ? (
      <div class="nexus-empty">
        <p>The curated index is empty (or unreachable).</p>
        <p style="margin-top:8px">
          Use the <a href="/install">Install</a> tab to install from a Git URL,
          OCI ref, or local path.
        </p>
      </div>
    ) : (
      featured.map((e) => (
        <div class="nexus-card">
          <div class="nexus-card-head">
            <div>
              <div class="nexus-card-title">
                {e.icon && <span class="badge primary" style="margin-right:8px">{e.icon}</span>}
                {e.name} <span style="color:var(--aura-color-text-dim);font-weight:400">· {e.id}</span>
              </div>
              {e.description && <div class="nexus-card-desc">{e.description}</div>}
              <div class="nexus-card-meta">
                {e.publisher && <span>publisher: {e.publisher} </span>}
                {(e.categories ?? []).map((c) => <span class="badge" style="margin-left:6px">{c}</span>)}
              </div>
            </div>
            <div class="nexus-card-actions">
              <a class="nexus-tab" href={`/install?ref=${encodeURIComponent(e.id)}`}>INSTALL</a>
            </div>
          </div>
        </div>
      ))
    )}
  </section>

  {doc.categories.length > 0 && (
    <section class="nexus-section">
      <h2>// Categories</h2>
      <div style="display:flex;flex-wrap:wrap;gap:8px">
        {doc.categories.map((c) => (
          <a class="nexus-tab" href={`/?category=${c.slug}`}>{c.label}</a>
        ))}
      </div>
    </section>
  )}
</Layout>
