---
import Layout from '../layouts/Layout.astro';
import InstallControl from '../components/InstallControl.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StoreToolbar from '../components/StoreToolbar.astro';
import { shellGet } from '../lib/shellClient';
import type { Catalog, CatalogEntry, InstallState } from '../lib/catalog';

interface InstalledItem {
  manifest: { id: string; name: string; version: string; icon?: string; description?: string; originId?: string };
  record: {
    id: string; version: string;
    source: 'oci' | 'git' | 'index' | 'local';
    ref: string; digest: string; channel: string | null;
    installedAt: string; updatedAt: string;
    sourceName?: string; detached?: boolean; remoteId?: string;
  };
  isNexusInstalled: boolean;
  scope?: string;
}

let items: InstalledItem[] = [];
let catalog: CatalogEntry[] = [];
let error: string | null = null;
try {
  [items, catalog] = await Promise.all([
    shellGet<InstalledItem[]>('/api/nexus/installed'),
    shellGet<Catalog>('/api/nexus').then((c) => c.apps).catch(() => [] as CatalogEntry[]),
  ]);
} catch (err) {
  error = (err as Error).message;
}

// Each installed app's store entry (by id AND originId — the shell's
// InstallState says which local app an entry maps to), so it gets the same
// control and update signal as on Browse.
const byLocal = new Map<string, CatalogEntry>();
for (const e of catalog) {
  const st = e.install;
  if (!st || st.status !== 'installed' || !st.localAppId) continue;
  const prev = byLocal.get(st.localAppId);
  if (!prev || (!prev.install!.verified && st.verified)) byLocal.set(st.localAppId, e);
}

const rows = items
  .slice()
  .sort((a, b) => a.manifest.name.localeCompare(b.manifest.name))
  .map((it, index) => {
    const entry = byLocal.get(it.manifest.id);
    const kind = it.scope === 'system' ? 'system' : it.isNexusInstalled ? 'store' : 'local';
    const localState: InstallState = {
      status: 'installed', localAppId: it.manifest.id, scope: it.scope,
      installedVersion: it.manifest.version, updateAvailable: false,
      fromThisSource: it.isNexusInstalled, hasRecord: it.isNexusInstalled,
      canUninstall: it.isNexusInstalled && it.scope !== 'system',
      detached: !!it.record.detached, verified: true,
    };
    const update = !!entry?.install?.updateAvailable;
    return {
      it, entry, kind, index, update, localState,
      localUpdate: it.isNexusInstalled && it.record.source !== 'local' && it.scope !== 'system' && !it.record.detached,
      facets: [kind, update ? 'update' : ''].filter(Boolean).join(' '),
      search: [it.manifest.name, it.manifest.id, it.manifest.description, it.record.sourceName, entry?.publisher]
        .filter(Boolean).join(' ').toLowerCase(),
      glyph: (it.manifest.icon ?? it.manifest.name.charAt(0)).slice(0, 3).toUpperCase(),
      source: it.record.sourceName ?? (kind === 'store' ? it.record.source : kind),
    };
  });
const n = (k: string) => rows.filter((r) => r.facets.split(' ').includes(k)).length;
---
<Layout title="Installed" active="installed">
  {error && <div class="nexus-empty">Error: {error}</div>}
  {!error && rows.length === 0 && <div class="nexus-empty">No apps installed.</div>}
  {rows.length > 0 && (
    <div class="browse" data-browse data-key="installed" data-default-view="list">
      <StoreToolbar
        placeholder="Search installed apps"
        groups={[
          { key: 'show', label: 'Show', segmented: true, options: [
            { value: '', label: 'All', count: rows.length },
            { value: 'update', label: 'Updates', count: n('update'), tone: 'update' },
            { value: 'store', label: 'From the store', count: n('store') },
            { value: 'local', label: 'Built here', count: n('local') },
            { value: 'system', label: 'System', count: n('system') },
          ] },
        ]}
        sorts={[{ value: 'default', label: 'Name' }, { value: 'source', label: 'Source' }]}
      />

      <section class="nexus-section">
        <SectionHeader title="Installed apps" count={rows.length} desc="Store apps update here; apps built or copied on this machine are never removed from the store.">
          <button type="button" class="btn-ghost" data-reset hidden>Clear filters</button>
        </SectionHeader>
        <div class="app-list view-list" data-list>
          {rows.map((r) => (
            <article class="app-card" data-card data-facets={r.facets} data-search={r.search}
              data-name={r.it.manifest.name.toLowerCase()} data-source={r.source} data-index={r.index}>
              <a class="app-card-link" href={r.entry ? `/app?id=${encodeURIComponent(r.entry.id)}` : undefined}>
                <span class="app-glyph" aria-hidden="true">{r.glyph}</span>
                <span class="app-card-text">
                  <span class="app-card-name">{r.it.manifest.name}</span>
                  <span class="app-card-id">{r.it.manifest.id}</span>
                  {r.it.manifest.description && <span class="app-card-desc">{r.it.manifest.description}</span>}
                </span>
              </a>
              <div class="app-card-foot">
                <div class="app-card-meta">
                  <span class="badge">v{r.it.manifest.version}</span>
                  {r.kind === 'store' && <span class="badge" data-tip={r.it.record.ref}>{r.source}</span>}
                  {r.it.scope && r.it.scope !== 'system' && <span class="badge cat">{r.it.scope}</span>}
                  {r.it.record.channel && <span class="badge cat">{r.it.record.channel}</span>}
                  <span class="app-card-status" data-ic-status></span>
                </div>
                {r.entry
                  ? <InstallControl ref={r.entry.id} name={r.it.manifest.name} version={r.entry.version} state={r.entry.install!} />
                  : <InstallControl localOnly localUpdate={r.localUpdate} name={r.it.manifest.name} state={r.localState} />}
              </div>
              <div class="ic-note" data-ic-note hidden></div>
            </article>
          ))}
        </div>
        <div class="nexus-empty" data-noresults hidden>
          <p>No installed apps match.</p>
          <p><button type="button" class="btn-ghost" data-reset>Clear filters</button></p>
        </div>
      </section>
    </div>
  )}
  <script>
    import '../scripts/browse';
  </script>
</Layout>
