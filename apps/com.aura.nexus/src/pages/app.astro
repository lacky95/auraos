---
import Layout from '../layouts/Layout.astro';
import { shellGet } from '../lib/shellClient';

interface CatalogEntry {
  id:           string;
  name:         string;
  description?: string;
  icon?:        string;
  publisher?:   string;
  homepage?:    string;
  categories?:  string[];
  tags?:        string[];
  screenshots?: string[];
  version?:     string;
  longDescription?: string;
  license?:     string;
  /** What the app asks for — from the manifest an OCI release carries. */
  requires?: {
    sandbox?: string; componentType?: string;
    permissions: string[]; tools: string[];
    services: Array<{ name: string; image: string }>;
    provides: Array<{ name: string; kind: string }>;
    dependencies: Array<{ appId: string; required: boolean }>;
  };
  sourceName?:  string;
  sourceKind?:  string;
  installed?:   boolean;
  installedVersion?: string | null;
  installing?:  boolean;
  sources?:     { git?: { ref: string }; oci?: { ref: string } };
}
interface Catalog { apps: CatalogEntry[]; }

const url = new URL(Astro.request.url);
const id = url.searchParams.get('id') ?? '';

let entry: CatalogEntry | null = null;
if (id) {
  try {
    const doc = await shellGet<Catalog>('/api/nexus');
    entry = doc.apps.find((a) => a.id === id) ?? null;
  } catch { entry = null; }
}

// Derive display values in the frontmatter — keeps the template free of
// JSX-in-ternary expressions (which the Astro/esbuild parser trips on).
const pageTitle      = entry ? entry.name : 'App';
const glyph          = entry ? (entry.icon ?? entry.name.charAt(0).toUpperCase()) : '';
const installed      = !!entry?.installed;
// One state-driven button (a poller keeps it correct: install ↔ installing ↔ installed).
const btnState       = installed ? 'installed' : (entry?.installing ? 'installing' : 'install');
const btnLabel       = btnState === 'installed'
  ? `INSTALLED${entry?.installedVersion ? ` v${entry.installedVersion}` : ''} ✓`
  : btnState === 'installing' ? 'INSTALLING…' : 'INSTALL';
const btnDisabled    = btnState !== 'install';
const distRef        = entry?.sources?.oci?.ref ?? entry?.sources?.git?.ref ?? '—';
const distKind       = entry?.sources?.oci ? 'oci' : (entry?.sources?.git ? 'git' : '—');
const categoriesText = (entry?.categories ?? []).join(', ') || '—';
const tagsText       = (entry?.tags ?? []).join(', ') || '—';
const sourceText     = `${entry?.sourceName ?? '—'} · ${entry?.sourceKind ?? '—'}`;
const cats           = entry?.categories ?? [];
const shots          = entry?.screenshots ?? [];
const req            = entry?.requires;
const editable       = entry?.sourceKind === 'oci' && !!entry?.sourceName;
---
<Layout title={pageTitle} active="browse">
  <a href="/" class="btn-back"><span class="back-arrow">←</span> BROWSE</a>

  {!entry && (
    <div class="nexus-card" style="border-left:3px solid var(--aura-color-primary)">
      <div class="nexus-empty" style="padding:36px 16px">
        <p>App <code>{id}</code> not found in the catalog.</p>
      </div>
    </div>
  )}

  {entry && (
    <div class="nexus-card detail-panel">
      <div class="nexus-card-head">
        <div>
          <div class="nexus-card-title">
            <span class="badge primary" style="margin-right:8px">{glyph}</span>
            {entry.name}
            {entry.version && <span class="badge" style="margin-left:6px">v{entry.version}</span>}
            <span style="color:var(--aura-color-text-dim);font-weight:400">· {entry.id}</span>
          </div>
          <div class="nexus-card-meta">
            {entry.publisher && <span>{entry.publisher} · </span>}
            {entry.sourceName && <span class="badge" style="margin-right:6px">{sourceText}</span>}
            {cats.map((c) => <a class="badge" style="margin-right:6px" href={`/?category=${c}`}>{c}</a>)}
          </div>
        </div>
        <div class="nexus-card-actions">
          <button type="button" id="detail-install-btn" class="install-cta" data-ref={entry.id} data-name={entry.name} data-state={btnState} disabled={btnDisabled}>{btnLabel}</button>
        </div>
      </div>

      {entry.description && <p class="detail-desc">{entry.description}</p>}
      {entry.longDescription && <p class="detail-long">{entry.longDescription}</p>}

      <pre class="nexus-log" id="install-log" hidden></pre>

      <div class="panel-sec"><span class="panel-lbl">Details</span></div>
      <table class="kv">
        <tbody>
          <tr><td>publisher</td><td>{entry.publisher ?? '—'}</td></tr>
          <tr><td>version</td><td>{entry.version ?? '—'}</td></tr>
          <tr><td>license</td><td>{entry.license ?? '—'}</td></tr>
          <tr>
            <td>homepage</td>
            <td>
              {entry.homepage && <a href={entry.homepage} target="_blank" rel="noreferrer">{entry.homepage}</a>}
              {!entry.homepage && '—'}
            </td>
          </tr>
          <tr><td>categories</td><td>{categoriesText}</td></tr>
          <tr><td>tags</td><td>{tagsText}</td></tr>
          <tr><td>source</td><td>{sourceText}</td></tr>
          <tr><td>distribution</td><td><span class="badge" style="margin-right:6px">{distKind}</span><code>{distRef}</code></td></tr>
        </tbody>
      </table>

      {req && (
        <div>
          <div class="panel-sec"><span class="panel-lbl">What it needs</span></div>
          <table class="kv">
            <tbody>
              <tr><td>sandbox</td><td>{req.sandbox ?? '—'}{req.componentType ? ` · ${req.componentType}` : ''}</td></tr>
              <tr><td>permissions</td><td>{req.permissions.length ? req.permissions.map((p) => <span class="badge" style="margin:0 6px 4px 0">{p}</span>) : 'none'}</td></tr>
              <tr><td>tools</td><td>{req.tools.length ? req.tools.map((t) => <span class="badge" style="margin:0 6px 4px 0">{t}</span>) : 'none'}</td></tr>
              <tr><td>sidecars</td><td>{req.services.length ? req.services.map((sv) => <div><b>{sv.name}</b> <code>{sv.image}</code></div>) : 'none'}</td></tr>
              {req.provides.length > 0 && <tr><td>provides</td><td>{req.provides.map((pv) => <span class="badge" style="margin:0 6px 4px 0">{pv.kind ? `${pv.kind}: ` : ''}{pv.name}</span>)}</td></tr>}
              {req.dependencies.length > 0 && <tr><td>needs apps</td><td>{req.dependencies.map((d) => <div><code>{d.appId}</code>{d.required ? '' : ' (optional)'}</div>)}</td></tr>}
            </tbody>
          </table>
        </div>
      )}

      {shots.length > 0 && (
        <div>
          <div class="panel-sec"><span class="panel-lbl">Screenshots</span></div>
          <div class="detail-shots">
            {shots.map((src) => (<img src={src} alt="screenshot" loading="lazy" />))}
          </div>
        </div>
      )}

      {editable && (
        <div id="listing-editor" data-source={entry.sourceName} data-app={entry.id} hidden>
          <div class="panel-sec"><span class="panel-lbl">Edit listing</span></div>
          <p class="editor-hint">
            You can write to <code id="le-ref"></code>. Changes go live in the store
            right away — no new version. An empty field shows the release's value again.
          </p>
          <div class="nexus-form">
            <label for="le-desc">Short description</label>
            <input id="le-desc" type="text" maxlength="280" />
            <label for="le-long">Long description</label>
            <textarea id="le-long" rows="6" maxlength="4096"></textarea>
            <div class="nexus-form-grid">
              <div><label for="le-tags">Tags (comma separated)</label><input id="le-tags" type="text" /></div>
              <div><label for="le-publisher">Publisher</label><input id="le-publisher" type="text" maxlength="64" /></div>
            </div>
            <label for="le-homepage">Homepage</label>
            <input id="le-homepage" type="text" placeholder="https://" />
            <div class="nexus-form-row"><button type="button" id="le-save">SAVE TEXTS</button></div>
          </div>
          <div class="panel-sec"><span class="panel-lbl">Listing screenshots</span></div>
          <div id="le-shots" class="le-shots"></div>
          <div class="nexus-form-row" style="margin-top:8px">
            <input id="le-file" type="file" accept="image/png,image/jpeg,image/gif,image/webp" multiple />
            <input id="le-url" type="text" placeholder="…or an https:// image URL" style="flex:1" />
            <button type="button" id="le-add-url">ADD URL</button>
          </div>
          <pre class="nexus-log" id="le-log" hidden></pre>
        </div>
      )}
    </div>
  )}

  <script is:inline>
    const btn = document.getElementById('detail-install-btn');
    const log = document.getElementById('install-log');
    const show = (t, cls) => { if (!log) return; log.hidden = false; log.className = 'nexus-log' + (cls ? ' ' + cls : ''); log.textContent = t; };

    // Apply server truth to the button (also flips INSTALLED → INSTALL on an
    // uninstall performed elsewhere).
    function applyState(st) {
      if (!btn) return;
      if (Date.now() < (Number(btn.dataset.busyUntil) || 0)) return;   // brief optimistic window
      const ref = btn.getAttribute('data-ref');
      const installed = st.installed || {};
      const installing = new Set(st.installing || []);
      if (installed[ref] != null) {
        const txt = 'INSTALLED v' + installed[ref] + ' ✓';
        if (btn.dataset.state !== 'installed' || btn.textContent !== txt) { btn.dataset.state = 'installed'; btn.disabled = true; btn.textContent = txt; }
      } else if (installing.has(ref)) {
        if (btn.dataset.state !== 'installing') { btn.dataset.state = 'installing'; btn.disabled = true; btn.textContent = 'INSTALLING…'; }
      } else {
        if (btn.dataset.state !== 'install') { btn.dataset.state = 'install'; btn.disabled = false; btn.textContent = 'INSTALL'; }
      }
    }
    async function syncNow() {
      if (!btn) return;
      try { applyState(await (await fetch('/api/nexus/status', { cache: 'no-store' })).json()); } catch { /* transient */ }
    }

    if (btn) {
      const ref  = btn.getAttribute('data-ref');
      const name = btn.getAttribute('data-name') || ref;
      // A click starts the install; it is not consent to a permission list the
      // user never saw. auraInstall() (layout) shows the server-computed diff
      // and only proceeds once it is approved.
      const reset = () => {
        btn.dataset.busyUntil = '0'; btn.dataset.state = 'install';
        btn.disabled = false; btn.textContent = 'INSTALL';
      };
      btn.addEventListener('click', async () => {
        if (btn.dataset.state !== 'install' || btn.disabled) return;
        // No optimistic window until the dialog is answered — it would expire
        // while the user is still reading.
        btn.disabled = true; btn.textContent = 'REVIEWING…';
        show('checking what ' + ref + ' asks for…');
        try {
          const json = await window.auraInstall(ref, {
            name: name,
            onApproved: () => {
              btn.dataset.busyUntil = String(Date.now() + 6000);
              btn.dataset.state = 'installing'; btn.textContent = 'INSTALLING…';
              show('installing ' + ref + '…');
            },
          });
          if (json.cancelled) { show('cancelled — nothing was installed'); reset(); return; }
          if (!json.ok) { show('ERROR: ' + (json.error || 'install failed'), 'err'); reset(); return; }
          show('✓ installed ' + json.record.id + ' v' + json.record.version + ' — scope: ' + (json.record.scope || 'global'), 'ok');
          btn.dataset.busyUntil = '0';
          syncNow();
        } catch (err) {
          show('ERROR: ' + (err && err.message ? err.message : err), 'err');
          reset();
        }
      });
    }

    // ── Continuous, visible-only state sync ────────────────────────────────
    let pollTimer = null;
    function pollLoop() {
      pollTimer = null;
      if (!document.hidden) syncNow();
      pollTimer = setTimeout(pollLoop, 2500);
    }
    document.addEventListener('visibilitychange', () => { if (!document.hidden) syncNow(); });
    syncNow();
    pollLoop();
  </script>

  <script is:inline>
    // Edit listing — only for OCI sources this login may write to (the shell
    // probes push rights; read-only customer logins never see the editor).
    (function () {
      const root = document.getElementById('listing-editor');
      if (!root) return;
      const src = root.getAttribute('data-source');
      const app = root.getAttribute('data-app');
      const base = '/api/nexus/listing/' + encodeURIComponent(src) + '/' + encodeURIComponent(app);
      const $ = (id) => document.getElementById(id);
      const logEl = $('le-log');
      const say = (t, cls) => { logEl.hidden = false; logEl.className = 'nexus-log' + (cls ? ' ' + cls : ''); logEl.textContent = t; };
      const errText = (j, res) => 'ERROR: ' + (j && (j.detail || j.error) ? (j.detail || j.error) : res.status);
      let shots = [];

      function renderShots() {
        const box = $('le-shots');
        box.innerHTML = '';
        if (!shots.length) { box.textContent = 'no screenshots in the listing yet'; return; }
        shots.forEach((url, i) => {
          const d = document.createElement('div'); d.className = 'le-shot';
          const img = document.createElement('img'); img.src = url; img.alt = 'screenshot ' + (i + 1); img.loading = 'lazy';
          const btns = document.createElement('div'); btns.className = 'le-btns';
          const mk = (label, title, fn, disabled) => {
            const b = document.createElement('button'); b.type = 'button'; b.textContent = label; b.title = title;
            b.disabled = !!disabled; b.addEventListener('click', fn); btns.appendChild(b);
          };
          mk('←', 'move left', () => move(i, -1), i === 0);
          mk('→', 'move right', () => move(i, +1), i === shots.length - 1);
          mk('✕', 'remove', () => post({ action: 'remove', index: i + 1 }, 'removing…'));
          d.appendChild(img); d.appendChild(btns); box.appendChild(d);
        });
      }
      function move(i, delta) {
        const order = shots.map((_, k) => k + 1);
        const j = i + delta;
        [order[i], order[j]] = [order[j], order[i]];
        post({ action: 'reorder', order }, 'reordering…');
      }
      async function post(body, busy) {
        say(busy);
        try {
          const res = await fetch(base + '/screenshots', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
          });
          const j = await res.json();
          if (!res.ok || !j.ok) { say(errText(j, res), 'err'); return false; }
          shots = j.screenshots || [];
          renderShots();
          say(j.unchanged ? 'that image is already listed' : '✓ listing updated — reload the page to see it in the store view', 'ok');
          return true;
        } catch (e) { say('ERROR: ' + (e && e.message ? e.message : e), 'err'); return false; }
      }
      const readB64 = (file) => new Promise((resolve, reject) => {
        const r = new FileReader();
        r.onload = () => resolve(String(r.result));
        r.onerror = () => reject(r.error);
        r.readAsDataURL(file);
      });

      $('le-file').addEventListener('change', async (e) => {
        const files = Array.from(e.target.files || []);
        for (const f of files) {
          if (f.size > (root.dataset.maxBytes ? Number(root.dataset.maxBytes) : 2 * 1024 * 1024)) {
            say('ERROR: ' + f.name + ' is larger than the 2 MB limit', 'err'); continue;
          }
          const ok = await post({ action: 'add', data: await readB64(f) }, 'uploading ' + f.name + '…');
          if (!ok) break;
        }
        e.target.value = '';
      });
      $('le-add-url').addEventListener('click', async () => {
        const url = $('le-url').value.trim();
        if (!/^https:\/\//i.test(url)) { say('ERROR: enter an https:// URL', 'err'); return; }
        if (await post({ action: 'add', url }, 'adding…')) $('le-url').value = '';
      });
      $('le-save').addEventListener('click', async () => {
        const btn = $('le-save');
        const body = {
          description: $('le-desc').value,
          longDescription: $('le-long').value,
          tags: $('le-tags').value.split(',').map((t) => t.trim()).filter(Boolean),
          publisher: $('le-publisher').value,
          homepage: $('le-homepage').value,
        };
        btn.disabled = true; say('saving…');
        try {
          const res = await fetch(base, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          const j = await res.json();
          if (!res.ok || !j.ok) { say(errText(j, res), 'err'); return; }
          say('✓ saved — reloading…', 'ok');
          setTimeout(() => location.reload(), 700);
        } catch (e) { say('ERROR: ' + (e && e.message ? e.message : e), 'err'); }
        finally { btn.disabled = false; }
      });

      (async () => {
        try {
          const res = await fetch(base, { cache: 'no-store' });
          if (!res.ok) return;                       // not published there / no access: stay hidden
          const j = await res.json();
          if (!j.canWrite) return;
          const m = j.listing.meta || {}, rel = j.release || {};
          $('le-ref').textContent = j.ref;
          $('le-desc').value = m.description || '';         $('le-desc').placeholder = rel.description || '';
          $('le-long').value = m.longDescription || '';     $('le-long').placeholder = rel.longDescription || '';
          $('le-tags').value = (m.tags || []).join(', ');   $('le-tags').placeholder = (rel.tags || []).join(', ');
          $('le-publisher').value = m.publisher || '';      $('le-publisher').placeholder = rel.publisher || '';
          $('le-homepage').value = m.homepage || '';        $('le-homepage').placeholder = rel.homepage || 'https://';
          if (j.maxImageBytes) root.dataset.maxBytes = String(j.maxImageBytes);
          shots = j.listing.screenshots || [];
          renderShots();
          root.hidden = false;
        } catch { /* stay hidden */ }
      })();
    })();
  </script>

  <style is:global>
    /* Back button — clearly bordered ghost button. */
    .btn-back {
      display: inline-flex; align-items: center; gap: 7px;
      margin-bottom: 14px;
      padding: 7px 15px 7px 12px;
      font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--aura-color-text, #ccffcc);
      background: color-mix(in srgb, var(--aura-color-primary) 5%, transparent);
      border: 1px solid var(--aura-color-text-dim, #6a8a6a);
      transition: color .12s, border-color .12s, box-shadow .12s, background .12s;
    }
    .btn-back:hover {
      color: var(--aura-color-primary);
      border-color: var(--aura-color-primary);
      background: color-mix(in srgb, var(--aura-color-primary) 12%, transparent);
      box-shadow: 0 0 8px color-mix(in srgb, var(--aura-color-primary) 45%, transparent);
      text-shadow: none;
    }
    .btn-back .back-arrow { font-size: 0.9rem; line-height: 1; transition: transform .12s; }
    .btn-back:hover .back-arrow { transform: translateX(-3px); }

    /* One combined panel. */
    .detail-panel {
      border-left: 3px solid var(--aura-color-primary);
      padding: 16px 18px;
    }
    .detail-desc {
      margin: 12px 0 0; font-size: 0.82rem; line-height: 1.55;
      color: var(--aura-color-text); word-break: break-word;
    }

    /* Inline install feedback (shared .nexus-log + ok/err accents). */
    .nexus-log.ok  { border-color: var(--aura-color-primary); color: var(--aura-color-primary); }
    .nexus-log.err { border-color: var(--aura-color-warning, #e0a000); color: var(--aura-color-warning, #e0a000); }

    /* Internal section divider — keeps everything reading as one panel. */
    .panel-sec {
      display: flex; align-items: center;
      margin: 16px 0 8px;
      border-top: 1px solid var(--aura-color-border);
    }
    .panel-lbl {
      margin-top: -8px; padding-right: 10px;
      background: var(--aura-color-surface);
      font-size: 0.64rem; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--aura-color-primary);
    }

    .detail-long {
      margin: 10px 0 0; font-size: 0.78rem; line-height: 1.6; white-space: pre-wrap;
      color: var(--aura-color-text-dim); word-break: break-word;
    }
    .editor-hint { font-size: 0.72rem; color: var(--aura-color-text-dim); margin: 0 0 8px; }
    #listing-editor textarea { width: 100%; box-sizing: border-box; font-family: inherit; }
    .le-shots { display: flex; gap: 10px; flex-wrap: wrap; }
    .le-shot { display: flex; flex-direction: column; gap: 4px; align-items: center; }
    .le-shot img { max-height: 120px; max-width: 220px; border: 1px solid var(--aura-color-border); }
    .le-shot .le-btns { display: flex; gap: 4px; }
    .le-shot button { font-size: 0.62rem; padding: 2px 8px; cursor: pointer; }
    .detail-shots { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; }
    .detail-shots img { max-height: 180px; flex: 0 0 auto; border: 1px solid var(--aura-color-border); }

    table.kv { border-collapse: collapse; font-size: 0.76rem; width: 100%; max-width: 680px; }
    table.kv td { padding: 5px 10px; vertical-align: top; word-break: break-all; }
    table.kv td:first-child {
      color: var(--aura-color-text-dim); width: 120px;
      text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.64rem;
    }
    a.badge:hover { color: var(--aura-color-primary); border-color: var(--aura-color-primary); text-shadow: none; }

    .install-cta {
      color: var(--aura-color-primary);
      border: 1px solid var(--aura-color-primary);
      background: color-mix(in srgb, var(--aura-color-primary) 8%, transparent);
      font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      padding: 6px 14px; cursor: pointer; white-space: nowrap;
    }
    .install-cta:hover { box-shadow: 0 0 8px var(--aura-color-primary); }
    .install-cta[disabled] { opacity: 0.5; cursor: default; box-shadow: none; }
    /* Emphasised state when the button is asking for approval. */
    .install-cta.cta-approve {
      background: color-mix(in srgb, var(--aura-color-primary) 22%, transparent);
      box-shadow: 0 0 10px color-mix(in srgb, var(--aura-color-primary) 55%, transparent);
      animation: cta-pulse 1.4s ease-in-out infinite;
    }
    @keyframes cta-pulse { 0%,100% { box-shadow: 0 0 6px color-mix(in srgb, var(--aura-color-primary) 40%, transparent); } 50% { box-shadow: 0 0 14px var(--aura-color-primary); } }

    .approve-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .btn-ghost {
      color: var(--aura-color-text-dim, #6a8a6a);
      border: 1px solid var(--aura-color-text-dim, #6a8a6a);
      background: transparent;
      font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      padding: 6px 14px; cursor: pointer; white-space: nowrap;
    }
    .btn-ghost:hover { color: var(--aura-color-text); border-color: var(--aura-color-text); }
  </style>
</Layout>
