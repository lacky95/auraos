---
/**
 * One app in a store list. The same markup renders as a grid tile or a list
 * row (the list container's class decides). data-* carry what the
 * client-side search, filters and sort use (scripts/browse.ts); the status
 * line + InstallControl follow the app's InstallState (scripts/store.ts).
 */
import InstallControl from './InstallControl.astro';
import { facetsOf, searchTextOf, stateOf, type CatalogEntry } from '../lib/catalog';
interface Props { entry: CatalogEntry; index?: number }
const { entry: e, index = 0 } = Astro.props;
const st = stateOf(e);
const glyph = (e.icon ?? e.name.charAt(0)).slice(0, 3).toUpperCase();
const detailHref = `/app?id=${encodeURIComponent(e.id)}`;
---
<article
  class="app-card"
  data-card
  data-app-card={e.id}
  data-facets={facetsOf(e, st)}
  data-search={searchTextOf(e)}
  data-name={e.name.toLowerCase()}
  data-source={e.sourceName ?? ''}
  data-index={index}
>
  <a class="app-card-link" href={detailHref} aria-label={`${e.name} — details`}>
    <span class="app-glyph" aria-hidden="true">{glyph}</span>
    <span class="app-card-text">
      <span class="app-card-name">{e.name}</span>
      <span class="app-card-id">{e.id}</span>
      {e.description && <span class="app-card-desc">{e.description}</span>}
    </span>
  </a>
  <div class="app-card-foot">
    <div class="app-card-meta">
      {e.version && <span class="badge" data-ic-version>v{e.version}</span>}
      {e.sourceName && <span class="badge" title={e.sourceKind}>{e.sourceName}</span>}
      {(e.categories ?? []).slice(0, 2).map((c) => <span class="badge cat">{c}</span>)}
      <span class="app-card-status" data-ic-status></span>
    </div>
    <InstallControl ref={e.id} name={e.name} version={e.version} state={st} />
  </div>
  <div class="ic-note" data-ic-note hidden></div>
</article>
