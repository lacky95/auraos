{
  "name": "aura",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @aura/shell dev",
    "build": "pnpm --filter @aura/core build && pnpm --filter @aura/ui build && pnpm --filter @aura/app-sdk build && pnpm --filter @aura/shell build",
    "build:libs": "pnpm --filter @aura/core --filter @aura/kv-store --filter @aura/app-sdk --filter @aura/ui --filter @aura/cli build",
    "publish:local": "node ./os/publish-aura-packages.mjs",
    "publish:local:fresh": "pnpm build:libs && pnpm publish:local",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty",
      "sharp",
      "@img/sharp-libvips-linux-x64",
      "redis-memory-server"
    ]
  }
}
