---
import '@aura/ui/styles/scificn-bridge.css';
import '../styles/global.css';
import StatusBar from '../components/shell/StatusBar.astro';
import Dock from '../components/shell/Dock.astro';
import LauncherOverlay from '../components/shell/LauncherOverlay.astro';
import LockScreenOverlay from '../components/shell/LockScreenOverlay.astro';
import { ThemeManager } from '@aura/core';
import type { AppManifest, ColorMode } from '@aura/core';
import { defaultKv } from '@aura/kv-store';

interface Props {
  pinnedApps?: AppManifest[];
  /** Per-app enable/disable map. Threaded down to the Dock so its tiles can
   *  carry `data-enabled` for the live SSE-driven toggle. */
  enabledMap?: Record<string, boolean>;
}
const { pinnedApps = [], enabledMap = {} } = Astro.props;

// SSR theme load now goes through the OS KV (Redis) directly — no app
// dependency. `bootstrapKv()` ensures `os/theme` exists before this SSR
// runs; the try/catch is defence-in-depth.
let themeIdDark:     string    = ThemeManager.DEFAULT_THEME_ID_DARK;
let themeIdLight:    string    = ThemeManager.DEFAULT_THEME_ID_LIGHT;
let activeColorMode: ColorMode = ThemeManager.DEFAULT_COLOR_MODE;
{
  const kv = defaultKv();
  try {
    const theme = await kv.getValue<{
      themeIdDark?: string; themeIdLight?: string; colorMode?: ColorMode;
    }>('os', 'theme');
    if (theme?.themeIdDark)  themeIdDark     = theme.themeIdDark;
    if (theme?.themeIdLight) themeIdLight    = theme.themeIdLight;
    if (theme?.colorMode)    activeColorMode = theme.colorMode;
  } catch (err) {
    console.warn(`[OSLayout/SSR] theme fetch threw — falling back to defaults`, err instanceof Error ? err.message : err);
  } finally {
    await kv.close().catch(() => undefined);
  }
}
const { theme: activeTheme, resolvedMode } = ThemeManager.resolveActiveTheme(themeIdLight, themeIdDark, activeColorMode);
const activeThemeCss  = ThemeManager.toCss(themeIdLight, themeIdDark, activeColorMode);
const activeFramework = activeTheme.framework;
const activeThemeId   = activeTheme.id;
---
<html lang="en" data-aura-theme={activeThemeId} data-aura-color-mode={activeColorMode}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AuraOS</title>
  <!-- Design-framework + mode metadata. Apps in the shell read these the same
       way iframes read the proxy-injected versions, so the API is uniform. -->
  <meta name="aura-design-framework" content={activeFramework.id} />
  <meta name="aura-design-framework-version" content={activeFramework.version} />
  <meta name="aura-theme-id" content={activeThemeId} />
  <meta name="aura-theme-id-dark" content={themeIdDark} />
  <meta name="aura-theme-id-light" content={themeIdLight} />
  <meta name="aura-color-mode" content={activeColorMode} />
  <meta name="aura-resolved-mode" content={resolvedMode} />
  <style id="aura-theme" set:html={activeThemeCss}></style>

  <!--
    Console bridge: wraps console.*, captures uncaught errors + promise
    rejections, buffers entries, and broadcasts them via postMessage to every
    iframe. App iframes can either:
      • subscribe to 'aura.console' messages (the Console app does this), or
      • relay their OWN console output up via 'aura.console.relay' (injected
        into each iframe by the proxy — see /api/proxy/[id]/[...path].ts).
    Placed in <head> as inline so it captures from the very first frame.
  -->
  <script is:inline>
  (() => {
    const MAX = 1000;
    const buffer = [];
    const orig = {};
    ['log', 'info', 'warn', 'error', 'debug'].forEach((lvl) => {
      orig[lvl] = console[lvl].bind(console);
    });

    function formatArg(a) {
      if (a === null) return 'null';
      if (a === undefined) return 'undefined';
      if (typeof a === 'string') return a;
      if (typeof a === 'number' || typeof a === 'boolean') return String(a);
      if (a instanceof Error) return `${a.name}: ${a.message}${a.stack ? '\n' + a.stack : ''}`;
      try {
        const seen = new WeakSet();
        return JSON.stringify(a, (_k, v) => {
          if (typeof v === 'object' && v !== null) {
            if (seen.has(v)) return '[Circular]';
            seen.add(v);
          }
          if (typeof v === 'function') return `[Function ${v.name || 'anonymous'}]`;
          return v;
        }, 2) ?? String(a);
      } catch { try { return String(a); } catch { return '[unserializable]'; } }
    }

    // Console-app WebSocket for persistent file backing. The shell's own
    // Vite plugin proxies /api/proxy/<id>/<path> WS upgrades to the app's
    // port, so we don't need to know the console port — just speak the
    // proxy URL on whatever host the page came from.
    //
    // Connection state is gated by app lifecycle events received over the
    // shared socket.io channel (see the regular `<script>` block below
    // that subscribes to 'app:stateChanged' for com.aura.console). When
    // the console app is destroyed/crashed/stopped we stop retrying
    // entirely; when it comes back to 'resumed'/'started' we fire an
    // immediate reconnect. Without this gate, killing the console from
    // Process Manager left the shell hammering /api/proxy/com.aura.console/
    // ws forever, spamming "Firefox can't establish a connection" once
    // per backoff tick.
    const consoleWsUrl = `${location.protocol === 'https:' ? 'wss:' : 'ws:'}//${location.host}/api/proxy/com.aura.console/ws`;
    let consoleWs = null;
    let consoleWsBackoff = 1000;
    let consoleWsConnecting = false;
    let consoleWsRetryTimer = null;
    // 'unknown' on first load — we don't know whether console is running
    // until the first /api/apps fetch or 'app:stateChanged' event lands.
    // 'down'   stops the retry loop; future event flips it to 'up' and
    //          schedules an immediate reconnect.
    // 'up'     re-enables retry on close.
    let consoleAppState = 'unknown';
    const pendingForWs = [];

    function clearConsoleRetry() {
      if (consoleWsRetryTimer) { clearTimeout(consoleWsRetryTimer); consoleWsRetryTimer = null; }
    }
    function scheduleConsoleRetry() {
      if (consoleAppState === 'down') return;   // app gone; don't bother
      clearConsoleRetry();
      consoleWsRetryTimer = setTimeout(connectConsoleWs, consoleWsBackoff);
      consoleWsBackoff = Math.min(consoleWsBackoff * 2, 30000);
    }
    function connectConsoleWs() {
      consoleWsRetryTimer = null;
      if (consoleAppState === 'down') return;
      if (consoleWsConnecting || (consoleWs && consoleWs.readyState <= 1)) return;
      consoleWsConnecting = true;
      try { consoleWs = new WebSocket(consoleWsUrl); }
      catch { consoleWsConnecting = false; scheduleConsoleRetry(); return; }
      consoleWs.addEventListener('open', () => {
        consoleWsBackoff = 1000;
        consoleWsConnecting = false;
        while (pendingForWs.length && consoleWs.readyState === WebSocket.OPEN) {
          try { consoleWs.send(JSON.stringify(pendingForWs.shift())); } catch { break; }
        }
      });
      consoleWs.addEventListener('close', () => {
        consoleWs = null;
        consoleWsConnecting = false;
        scheduleConsoleRetry();
      });
      consoleWs.addEventListener('error', () => { /* close fires next */ });
    }

    function sendToConsoleWs(entry) {
      if (consoleWs && consoleWs.readyState === WebSocket.OPEN) {
        try { consoleWs.send(JSON.stringify(entry)); } catch { /* socket may have torn down */ }
      } else {
        if (pendingForWs.length < 200) pendingForWs.push(entry);
      }
    }

    // Exposed for the socket.io app-lifecycle listener (regular <script>
    // block below) — toggles whether the retry loop is allowed to fire.
    window.__auraConsoleBridge = {
      setRunning(running) {
        if (running) {
          if (consoleAppState === 'up') return;   // already retrying / connected
          consoleAppState = 'up';
          consoleWsBackoff = 1000;
          clearConsoleRetry();
          connectConsoleWs();
        } else {
          consoleAppState = 'down';
          clearConsoleRetry();
          if (consoleWs) { try { consoleWs.close(); } catch (_) {} consoleWs = null; }
        }
      },
    };

    // Probe initial state. If the console app isn't running at boot we
    // skip the first connect attempt entirely (no error in the console).
    // Falls back to an optimistic attempt if /api/apps is unreachable.
    fetch('/api/apps', { signal: AbortSignal.timeout(2000) })
      .then((r) => r.ok ? r.json() : null)
      .then((apps) => {
        if (!Array.isArray(apps)) { connectConsoleWs(); return; }
        const app = apps.find((a) => a?.manifest?.id === 'com.aura.console');
        const running = !!app?.instances?.some?.((i) => i.state === 'resumed' || i.state === 'started');
        window.__auraConsoleBridge.setRunning(running);
      })
      .catch(() => { connectConsoleWs(); /* unknown state, try once */ });

    // Dev-mode noise we explicitly skip persisting + relaying to iframes.
    // These messages fire constantly (every Vite restart, every HMR
    // disconnect, every React island mount) and drown out real signal in
    // the Console app. The original console.* still emits them so the
    // browser DevTools console shows everything for active debugging —
    // we just don't archive them.
    function isNoisyDev(args) {
      if (!args || args.length === 0) return false;
      const first = String(args[0] ?? '');
      if (first.startsWith('[vite] connect'))  return true;     // [vite] connecting / connected
      if (first.startsWith('[vite] disc'))     return true;     // [vite] disconnected
      if (first.startsWith('[vite] hot'))      return true;     // HMR update notifications
      if (first.includes('Download the React DevTools')) return true;
      if (first.includes('react-devtools'))    return true;
      return false;
    }

    function broadcast(entry) {
      if (isNoisyDev(entry.args)) return;
      buffer.push(entry);
      if (buffer.length > MAX) buffer.shift();
      const iframes = document.querySelectorAll('iframe');
      iframes.forEach((f) => { try { f.contentWindow && f.contentWindow.postMessage(entry, '*'); } catch (_) {} });
      sendToConsoleWs(entry);
    }

    function makeEntry(level, source, args) {
      return {
        type: 'aura.console',
        level,
        timestamp: Date.now(),
        source,
        args: Array.from(args).map(formatArg),
      };
    }

    ['log', 'info', 'warn', 'error', 'debug'].forEach((lvl) => {
      console[lvl] = function (...args) {
        orig[lvl](...args);
        broadcast(makeEntry(lvl, 'shell', args));
      };
    });

    window.addEventListener('error', (e) => {
      broadcast(makeEntry('error', 'shell', [
        `Uncaught ${e.message} at ${e.filename || '?'}:${e.lineno || 0}:${e.colno || 0}`,
      ]));
    });
    window.addEventListener('unhandledrejection', (e) => {
      const r = e.reason;
      const msg = r instanceof Error ? `${r.name}: ${r.message}${r.stack ? '\n' + r.stack : ''}` : String(r);
      broadcast(makeEntry('error', 'shell', [`Unhandled rejection: ${msg}`]));
    });

    // EventSource: browser surfaces 'connection interrupted' / network errors via
    // an 'error' event on the instance, not via console.*. Wrap the constructor
    // so those bubble into our console — EXCEPT for the OS-internal
    // `/api/apps/events` SSE, which self-heals via the connector's own 2s
    // retry. Logging every CLOSED on those endpoints just spams the bus
    // every time the dev server bounces.
    const NativeES = window.EventSource;
    const SELF_HEALING_SSE = /\/api\/apps\/events(\?|$)/;
    if (NativeES) {
      // Track every live instance so pagehide can close them cleanly.
      // Without this, Firefox surfaces "The connection to X was interrupted
      // while the page was loading" for every in-flight SSE on every reload
      // / nav — the browser aborts the request mid-response and reports it
      // as if it were a real failure. Closing them ourselves trips the
      // normal close path silently.
      const live = new Map();   // es → { url, id, t0 }
      let nextEsId = 1;
      const esLog = (lvl, ...args) => {
        // Honour the global AURA_LOG filter so this is silent by default.
        // Enable with localStorage.setItem('aura.log','sse-client') (or '*').
        let filter = '';
        try { filter = localStorage.getItem('aura.log') || ''; } catch (_) {}
        filter = filter || (window.__AURA_LOG__ || '');
        if (!filter) return;
        // Minimal namespace match — `sse-client` or wildcard.
        const ns = 'sse-client';
        let on = false;
        for (const part of filter.split(/[\s,]+/)) {
          if (!part) continue;
          const neg = part.startsWith('-');
          const body = neg ? part.slice(1) : part;
          const at = body.indexOf('@');
          const pat = at >= 0 ? body.slice(0, at) : body;
          const lvName = at >= 0 ? body.slice(at + 1) : 'debug';
          const lvOrder = { debug: 10, info: 20, log: 20, warn: 30, error: 40 };
          if (new RegExp('^' + pat.replace(/[.+?^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*') + '$').test(ns)) {
            const min = lvOrder[lvName] ?? 10;
            const cur = lvOrder[lvl]    ?? 10;
            if (cur < min) continue;
            if (neg) { on = false; break; }
            on = true;
          }
        }
        if (on) (console[lvl] || console.log).call(console, '[sse-client]', ...args);
      };
      const Wrapped = function (url, init) {
        const es = new NativeES(url, init);
        const id = nextEsId++;
        live.set(es, { url: String(url), id, t0: Date.now() });
        const isSelfHealing = SELF_HEALING_SSE.test(String(url));
        esLog('info', 'open', `#${id}`, String(url));
        es.addEventListener('open', () => esLog('debug', 'opened', `#${id}`, `+${Date.now() - live.get(es).t0}ms`));
        es.addEventListener('error', () => {
          const state = ['CONNECTING', 'OPEN', 'CLOSED'][es.readyState] || '?';
          esLog('warn', 'error', `#${id}`, `readyState=${state}`, String(url));
          if (isSelfHealing) return;
          broadcast(makeEntry('warn', 'shell', [`EventSource error: ${url} (readyState=${state})`]));
        });
        const origClose = es.close.bind(es);
        es.close = () => {
          const info = live.get(es);
          live.delete(es);
          if (info) esLog('info', 'close', `#${info.id}`, `dur=${Date.now() - info.t0}ms`);
          origClose();
        };
        return es;
      };
      Wrapped.prototype = NativeES.prototype;
      ['CONNECTING', 'OPEN', 'CLOSED'].forEach((k, i) => { Wrapped[k] = i; });
      window.EventSource = Wrapped;
      // Close every live SSE BEFORE the browser starts aborting in-flight
      // requests. pagehide fires too late — by then Firefox has already
      // logged "The connection to X was interrupted while the page was
      // loading" for every open stream. beforeunload runs at the very top
      // of the navigation lifecycle and we don't need to preventDefault,
      // so it imposes no "Are you sure you want to leave?" dialog cost.
      // pagehide stays as a safety net for Safari (which sometimes skips
      // beforeunload during bfcache freezes).
      const closeAll = (reason) => {
        const n = live.size;
        if (n) esLog('info', 'closeAll', reason, `n=${n}`);
        for (const es of live.keys()) { try { es.close(); } catch (_) {} }
        live.clear();
      };
      window.addEventListener('beforeunload', () => closeAll('beforeunload'));
      window.addEventListener('pagehide',     () => closeAll('pagehide'));
    }

    // fetch: capture network failures (DNS/connection) and non-2xx responses.
    // We don't log 2xx — that would flood the bus.
    const nativeFetch = window.fetch.bind(window);
    window.fetch = async function (input, init) {
      const url = typeof input === 'string' ? input : (input && input.url) || String(input);
      try {
        const res = await nativeFetch(input, init);
        if (!res.ok) {
          broadcast(makeEntry(res.status >= 500 ? 'error' : 'warn', 'shell',
            [`fetch ${(init && init.method) || 'GET'} ${url} → ${res.status} ${res.statusText}`]));
        }
        return res;
      } catch (err) {
        broadcast(makeEntry('error', 'shell',
          [`fetch ${(init && init.method) || 'GET'} ${url} failed: ${err && err.message || String(err)}`]));
        throw err;
      }
    };

    // XMLHttpRequest: same idea for legacy XHR consumers.
    const XHR = window.XMLHttpRequest;
    if (XHR) {
      const origOpen = XHR.prototype.open;
      const origSend = XHR.prototype.send;
      XHR.prototype.open = function (method, url) {
        this.__aura_method = method;
        this.__aura_url = url;
        return origOpen.apply(this, arguments);
      };
      XHR.prototype.send = function () {
        this.addEventListener('error', () => {
          broadcast(makeEntry('error', 'shell', [`xhr ${this.__aura_method} ${this.__aura_url} network error`]));
        });
        this.addEventListener('load', () => {
          if (this.status >= 400) {
            broadcast(makeEntry(this.status >= 500 ? 'error' : 'warn', 'shell',
              [`xhr ${this.__aura_method} ${this.__aura_url} → ${this.status}`]));
          }
        });
        return origSend.apply(this, arguments);
      };
    }

    window.addEventListener('message', (e) => {
      const d = e.data;
      if (!d || typeof d !== 'object') return;
      // Iframe forwarding its own console (proxy-injected relay script)
      if (d.type === 'aura.console.relay' && d.entry) {
        broadcast(d.entry);
        return;
      }
      // Console app asking for backlog on mount
      if (d.type === 'aura.console.requestBacklog') {
        try { e.source && e.source.postMessage({ type: 'aura.console.backlog', entries: buffer.slice() }, '*'); } catch (_) {}
      }
    });

    window.auraGetConsoleBuffer = () => buffer.slice();
    window.auraClearConsoleBuffer = () => { buffer.length = 0; };
  })();
  </script>
</head>
<body>
  <div id="os-root">
    <StatusBar />
    <main id="desktop">
      <slot />
    </main>
    <Dock apps={pinnedApps} enabledMap={enabledMap} />
  </div>
  <!--
    LauncherOverlay mounted at body root (not inside the dock) so its
    position:fixed isn't subject to any potential ancestor stacking context
    or overflow:auto clipping from #dock / #os-root.
  -->
  <LauncherOverlay />
  <!--
    LockScreenOverlay mounted last so its z-index 2000 sits above every
    other shell surface (launcher 1000, focus-view 50, dock, statusbar,
    app iframes). Activated via window.auraLockScreen() or the
    `aura.lockscreen.activate` key binding.
  -->
  <LockScreenOverlay />

  <!--
    Iframe identity guard: on every iframe load, read the <meta name="aura-app-id">
    the proxy injected and compare it to the appId the iframe was *supposed* to
    show (parsed from the iframe's own src `/api/proxy/<id>/...`). Mismatch
    means the proxy routed to the wrong upstream (or the upstream's identity
    middleware is stale) — replace the iframe with a visible error overlay
    instead of silently showing the wrong app's UI.

    This is the third independent identity check after:
      1. ProotRunner.waitHealthy   (spawn-time identity body match)
      2. Proxy X-Aura-App-Id header (per-request middleware verification)
  -->
  <script is:inline>
  (() => {
    function expectedAppFromSrc(src) {
      try {
        const u = new URL(src, location.href);
        const m = u.pathname.match(/^\/api\/proxy\/([^/]+)\//);
        if (!m) return null;
        // Strip optional -N instance suffix to compare against bare appId.
        return m[1].replace(/-\d+$/, '');
      } catch { return null; }
    }

    function showMismatchOverlay(frame, expected, got) {
      const parent = frame.parentElement;
      if (!parent) return;
      const overlay = document.createElement('div');
      overlay.setAttribute('data-aura-identity-error', '1');
      overlay.style.cssText = 'position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#1a0a0a;color:#ff5050;font-family:var(--aura-font-mono, monospace);font-size:0.8rem;text-align:center;padding:16px;letter-spacing:0.08em;gap:8px;';
      overlay.innerHTML = '<div style="font-size:1rem;">// IDENTITY MISMATCH</div>'
        + '<div>Expected app: <strong>' + expected + '</strong></div>'
        + '<div>Got: <strong>' + (got || '(none)') + '</strong></div>'
        + '<div style="color:#aa3030;">Iframe removed to prevent showing wrong content.</div>';
      frame.remove();
      if (getComputedStyle(parent).position === 'static') parent.style.position = 'relative';
      parent.appendChild(overlay);
    }

    function verifyFrame(frame) {
      if (frame.dataset.auraIdentityChecked === '1') return;
      const src = frame.getAttribute('src') || '';
      const expected = expectedAppFromSrc(src);
      if (!expected) return;
      let metaApp = null;
      try {
        const doc = frame.contentDocument;
        const meta = doc && doc.querySelector('meta[name="aura-app-id"]');
        metaApp = meta ? meta.getAttribute('content') : null;
      } catch {
        // cross-origin would throw — but same-origin proxy, so this only
        // happens for about:blank or transient navigation states. Skip.
        return;
      }
      if (!metaApp) return; // no meta injected yet (NOT READY splash, etc.) — let next load retry
      frame.dataset.auraIdentityChecked = '1';
      if (metaApp !== expected) {
        console.error('[AuraOS] Iframe identity mismatch — expected ' + expected + ', got ' + metaApp + '. Removing iframe.');
        showMismatchOverlay(frame, expected, metaApp);
      }
    }

    function hookFrame(frame) {
      if (frame.dataset.auraIdentityHooked === '1') return;
      frame.dataset.auraIdentityHooked = '1';
      frame.addEventListener('load', () => {
        delete frame.dataset.auraIdentityChecked;
        verifyFrame(frame);
      });
    }

    // Hook every existing iframe and any future iframe added to the DOM.
    document.querySelectorAll('iframe').forEach(hookFrame);
    const mo = new MutationObserver((muts) => {
      for (const m of muts) {
        for (const node of m.addedNodes) {
          if (node.nodeType !== 1) continue;
          const el = node;
          if (el.tagName === 'IFRAME') hookFrame(el);
          else el.querySelectorAll && el.querySelectorAll('iframe').forEach(hookFrame);
        }
      }
    });
    mo.observe(document.documentElement, { childList: true, subtree: true });
  })();
  </script>

  <script>
    // Theme/mode live updates flow through the shared OS event channel
    // (Socket.IO at /os-events) instead of a dedicated SSE connection.
    // Firefox's HTTP/1.1 connection cap was killing parallel SSEs;
    // socket.io lives on its own WS pool. See packages/shell/src/lib/
    // osEvents.ts and the sioPlugin in astro.config.mjs.
    import { osEvents as _osEvents } from '../lib/osEvents.ts';

    // Live-update CSS-Vars when the OS broadcasts a theme OR mode change.
    // Both events trigger a fresh /api/os/theme.css fetch (the endpoint
    // re-resolves the active palette server-side) + a postMessage relay so
    // iframes can refresh their <link href="/api/os/theme.css"> tags too.
    type ThemeEvt = {
      type: 'theme:changed';
      themeId?: string;          // active (resolved) theme id
      themeName?: string;
      themeIdDark?: string;
      themeIdLight?: string;
      colorMode?: 'light' | 'dark' | 'auto';
      resolvedMode?: 'light' | 'dark';
      activeTone?: 'light' | 'dark';
      framework?: { id: string; version: string };
    };
    type ModeEvt = {
      type: 'mode:changed';
      themeId?: string;          // active (resolved) theme id
      themeIdDark?: string;
      themeIdLight?: string;
      colorMode?: 'light' | 'dark' | 'auto';
      resolvedMode?: 'light' | 'dark';
      activeTone?: 'light' | 'dark';
      framework?: { id: string; version: string };
    };

    const onThemeEvent = async (ev: ThemeEvt | ModeEvt) => {
      console.log('[Theme] received', ev.type, ev);

      // Refresh the shell-side <style id="aura-theme"> block.
      try {
        const css = await (await fetch('/api/os/theme.css?t=' + Date.now())).text();
        const tag = document.getElementById('aura-theme');
        if (tag) tag.textContent = css;
      } catch (err) { console.error('[Theme] fetch failed', err); }

      // Mirror current mode/theme onto <html> data-attributes + meta tags so
      // non-CSS selectors and DOM-based reads stay in sync. Best-effort.
      const root = document.documentElement;
      // NOT `ThemeEvt & ModeEvt`: their `type` fields are different string
      // literals, so the intersection has `type: never` and TypeScript
      // collapses the whole thing to `never` — every field read off it then
      // errors. Both events carry the same payload fields, so the union the
      // parameter already has is exactly what we want.
      const m    = ev;
      const setMeta = (name: string, value: string | undefined) => {
        if (!value) return;
        const el = document.querySelector(`meta[name="${name}"]`);
        if (el) el.setAttribute('content', value);
      };
      if (m.themeId)        root.dataset['auraTheme']         = m.themeId;
      if (m.themeIdDark)    root.dataset['auraThemeDark']     = m.themeIdDark;
      if (m.themeIdLight)   root.dataset['auraThemeLight']    = m.themeIdLight;
      if (m.colorMode)      root.dataset['auraColorMode']     = m.colorMode;
      if (m.resolvedMode)   root.dataset['auraResolvedMode']  = m.resolvedMode;
      setMeta('aura-theme-id',        m.themeId);
      setMeta('aura-theme-id-dark',   m.themeIdDark);
      setMeta('aura-theme-id-light',  m.themeIdLight);
      setMeta('aura-color-mode',      m.colorMode);
      setMeta('aura-resolved-mode',   m.resolvedMode);

      // Relay to every iframe so apps with `themeStrategy: 'themed'` or
      // any in-app live-CSS link can refresh. Iframes typically bump their
      // <link href="/api/os/theme.css"> with a cache-bust on receipt.
      const payload = ev.type === 'theme:changed'
        ? {
            type:         'aura.theme.changed',
            themeId:      m.themeId,
            themeIdDark:  m.themeIdDark,
            themeIdLight: m.themeIdLight,
            colorMode:    m.colorMode,
            resolvedMode: m.resolvedMode,
            framework:    m.framework,
          }
        : {
            type:         'aura.mode.changed',
            themeId:      m.themeId,
            themeIdDark:  m.themeIdDark,
            themeIdLight: m.themeIdLight,
            colorMode:    m.colorMode,
            resolvedMode: m.resolvedMode,
          };
      document.querySelectorAll('iframe').forEach((f) => {
        try { f.contentWindow?.postMessage(payload, '*'); } catch {}
      });
    };

    _osEvents.subscribe(['theme:changed', 'mode:changed'], (ev) => onThemeEvent(ev as ThemeEvt | ModeEvt));

    // Console-bridge gating. The inline console-WS code at the top of this
    // file exposes `window.__auraConsoleBridge.setRunning(bool)`. Flip it
    // from app lifecycle events: when console is killed we stop hammering
    // the proxy; when it comes back up we reconnect immediately.
    _osEvents.subscribe('app:stateChanged', (ev: any) => {
      if (ev?.appId !== 'com.aura.console') return;
      const up   = ev.state === 'resumed' || ev.state === 'started';
      const down = ev.state === 'destroyed' || ev.state === 'error' || ev.state === 'stopped' || ev.state === 'crashed';
      if (!up && !down) return;
      (window as any).__auraConsoleBridge?.setRunning(up);
    });
    _osEvents.subscribe('app:crashed', (ev: any) => {
      if (ev?.appId !== 'com.aura.console') return;
      (window as any).__auraConsoleBridge?.setRunning(false);
    });
  </script>

  <!--
    KeyDispatcher boot. Pins the singleton on `window.auraKeyDispatcher`,
    loads the registry catalogue (`/api/os/keymap`) + the user overlay
    (`/api/kv/os/keymap`), installs a top-level keydown listener, and
    refreshes state on `kv:changed os/keymap` SSE events.

    The dispatcher's catalogue + state need to be ready before iframes mount
    so the first `aura.key.claim` broadcast carries the right combo list.
    `index.astro`'s renderLayout sends the claim list per iframe on load.
  -->
  <script>
    import { getKeyDispatcher } from '../lib/keyDispatcher.ts';
    import { osEvents as _kvOsEvents } from '../lib/osEvents.ts';
    // Subpath import — the bare `@aura/core` barrel pulls server-only deps
    // (chokidar, node:fs via AppManager) into the browser bundle.
    import type { KeyAction, OsKeymapState } from '@aura/core/keymap';

    type CatalogueResponse = { actions: KeyAction[] };

    const dispatcher = getKeyDispatcher();

    async function loadCatalogue(): Promise<void> {
      try {
        const res = await fetch('/api/os/keymap');
        if (!res.ok) return;
        const body = (await res.json()) as CatalogueResponse;
        if (Array.isArray(body.actions)) dispatcher.setActions(body.actions);
      } catch (err) {
        console.warn('[KeyDispatcher] failed to load catalogue', err);
      }
    }

    async function loadState(): Promise<void> {
      try {
        const res = await fetch('/api/kv/os/keymap');
        if (!res.ok) return;
        const body = (await res.json()) as { value?: OsKeymapState };
        if (body.value) dispatcher.setState(body.value);
      } catch (err) {
        console.warn('[KeyDispatcher] failed to load state', err);
      }
    }

    void (async () => {
      await Promise.all([loadCatalogue(), loadState()]);
    })();

    // OS-wide keydown listener. Iframes that own focus consume their own
    // keystrokes and only forward CLAIMED combos via postMessage (handled
    // in index.astro). This listener catches everything that bubbles up
    // to the shell itself — launcher overlay open, process-manager open,
    // status-bar focused, no iframe focused, etc.
    document.addEventListener('keydown', (e) => {
      const res = dispatcher.handleKeyEvent(e);
      if (res.fired) e.preventDefault();
    }, { capture: true });
    // Modifier keyup tracking: the dispatcher needs to know when the user
    // RELEASES a side-specific modifier so it doesn't think e.g. RShift is
    // still held when the next non-modifier press arrives.
    document.addEventListener('keyup', (e) => {
      dispatcher.handleModifierKeyUp(e);
      // Firefox-on-Linux ergonomic fix: lone-Alt keyup opens the browser's
      // window menu (File / Edit / View …), which steals focus. AltGr fires
      // the same activation on release — so typing AltGr+Q (= @ on a German
      // layout) inside the launcher search or any shell-native input pops
      // the menu. preventDefault on every Alt / AltGraph keyup blocks the
      // activation. No-op on Chromium.
      if (e.key === 'Alt' || e.key === 'AltGraph') e.preventDefault();
    }, { capture: true });
    // Blur reset: alt-tabbing away while holding Shift never delivers the
    // keyup. Clear all side flags on blur so the next focus starts clean.
    window.addEventListener('blur', () => dispatcher.resetModifierState());

    // Socket.IO-driven state refresh. The dispatcher rebroadcasts claim
    // lists automatically when state changes (see notifyClaims).
    _kvOsEvents.subscribe('kv:changed', (ev) => {
      const k = ev as { type: string; namespace?: string; key?: string };
      if (k.namespace !== 'os' || k.key !== 'keymap') return;
      void loadState();
    });
    // Surface the dispatcher in dev consoles for ad-hoc testing.
    console.debug('[KeyDispatcher] ready (mode =', dispatcher.getMode(), ')');
  </script>
</body>
</html>

<style>
  #os-root {
    display: grid;
    grid-template-rows: var(--aura-statusbar-height) 1fr var(--aura-dock-height);
    /* 100% (not 100vw/100vh) so #os-root sizes against its parent (body).
       The status-bar zoom rescales body inversely, and #os-root needs to
       follow body's actual computed size — otherwise it overflows the
       shrunken body at zoom > 1. */
    height: 100%;
    width: 100%;
    overflow: hidden;
    position: relative; /* anchor for fixed-style overlay bars in autohide mode */
  }

  #desktop {
    overflow: hidden;
    position: relative;
    background: var(--aura-color-bg);
  }

  /* (auto-hide rules moved to the <style is:global> block below) */
</style>

<!--
  Auto-hide bars mode. These rules need to be unscoped because the targets
  (#statusbar, #dock) live in sibling .astro components (StatusBar, Dock)
  and don't carry OSLayout's auto-injected `data-astro-cid-*` attribute.
  A scoped selector would silently miss them and nothing would animate.

  Toggle attributes (written by StatusBar's autohide script onto <body>):
    body[data-autohide-bars="on"]   — turns the mode on globally
    body[data-show-top="true"]      — reveals the status bar
    body[data-show-bottom="true"]   — reveals the dock
-->
<style is:global>
  /* Switch the grid off entirely in autohide mode — we don't want any
   * implicit-row sizing weirdness when #statusbar and #dock are pulled
   * out of flow. Plain block layout + #desktop at 100% gives the desktop
   * the full viewport, deterministically. */
  body[data-autohide-bars="on"] #os-root {
    display: block;
  }
  body[data-autohide-bars="on"] #desktop {
    height: 100%;
  }
  /* Animate top/bottom rather than `transform: translateY(...)` to avoid
   * creating a new containing block on the bars. The Dock currently mounts
   * <ProcessManager /> inside <nav id="dock">, and pm-panel is a
   * `position: fixed` descendant. If the dock has any transform set, the
   * pm-panel anchors to the dock's box instead of the viewport — when the
   * dock slides off, the panel slides with it. Animating top/bottom keeps
   * the bars containing-block-neutral so descendants like pm-panel stay
   * viewport-positioned. */
  body[data-autohide-bars="on"] #statusbar,
  body[data-autohide-bars="on"] #dock {
    position: fixed;
    left: 0;
    right: 0;
    /* Lower than #lo-panel / #pm-panel (z-index: 1000) so an open
     * launcher or process manager renders OVER the revealed bar —
     * Windows Start-menu / Action Center style. */
    z-index: 900;
    transition: top 0.18s ease-out, bottom 0.18s ease-out;
  }
  body[data-autohide-bars="on"] #statusbar {
    top: calc(-1 * var(--aura-statusbar-height));
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }
  body[data-autohide-bars="on"] #dock {
    bottom: calc(-1 * var(--aura-dock-height));
    box-shadow: 0 -4px 14px rgba(0, 0, 0, 0.35);
  }
  body[data-autohide-bars="on"][data-show-top="true"] #statusbar {
    top: 0;
  }
  body[data-autohide-bars="on"][data-show-bottom="true"] #dock {
    bottom: 0;
  }
  #autohide-btn[data-active="on"] {
    color: var(--aura-color-bg);
    background: var(--aura-color-primary);
    border-color: var(--aura-color-primary);
  }

  /* The [SHOW BARS] escape hatch on the empty-desktop overlay is hidden
     except when autohide is actually engaged. In normal mode the bars
     are visible by default and the button would be redundant. */
  [data-aura-empty] [data-aura-show-bars] { display: none; }
  body[data-autohide-bars="on"] [data-aura-empty] [data-aura-show-bars] { display: inline-block; }

  /* Slide-in panels (#lo-panel from LauncherOverlay, #pm-panel from
   * ProcessManager) anchor to `top: var(--aura-statusbar-height)` and
   * `bottom: var(--aura-dock-height)` in normal mode so they don't
   * overlap the bars. In autohide mode the bars are fixed overlays that
   * translate off-screen; we want the panels to span edge-to-edge so
   * there are no dead gaps at top + bottom. The revealed bars sit on
   * top via z-index when their hot zone fires — same as Windows-style
   * autohide where the open menu covers the taskbar slot. */
  body[data-autohide-bars="on"] #lo-panel,
  body[data-autohide-bars="on"] #pm-panel {
    top: 0 !important;
    bottom: 0 !important;
  }
  /* (Bars stay below panels — panels render on top of revealed bars,
   *  Windows-style. Z-index already set on the primary autohide rule
   *  above.) */
</style>
