---
/**
 * Limited IP mode: a full-width bar that can't be dismissed. When this
 * installation's App Hosts address answers, the desktop moves there on its own
 * after a short notice ("Stay on this address" keeps it here for this tab);
 * otherwise the bar shows the custom-domain guide. The same bar shows on an App Hosts address whose
 * App Host cookie this browser drops (WebKit on `os.aura.localhost`, D44),
 * with a link to the address that works there; that one never moves on its own.
 * Links keep this page's path, query and hash, so the sign-in there returns to it.
 * Decisions are in lib/desktop/setupBar.ts.
 */
---
<div id="aura-setup-bar" role="status" hidden>
  <strong id="aura-setup-bar-title">Limited IP mode.</strong>
  <span id="aura-setup-bar-text"></span>
  <a id="aura-setup-bar-link" hidden></a>
  <button type="button" id="aura-setup-bar-stay" hidden>Stay on this address</button>
</div>

<script>
  import { APP_FRAME_SANDBOX } from '../../lib/appFrame.ts';
  import {
    AUTO_SWITCH_SECONDS, SETUP_BAR_STAY_KEY, autoSwitchTarget, cookieProbeUrl, isWebKitBrowser, planCookieFallback,
    planSetupBar, probeAppHostAddress, probeAppHostCookie, settleSetupBar, shouldAutoSwitch, type SetupBarPlan,
  } from '../../lib/desktop/setupBar.ts';

  const bar = document.getElementById('aura-setup-bar');
  const title = document.getElementById('aura-setup-bar-title');
  const text = document.getElementById('aura-setup-bar-text');
  const link = document.getElementById('aura-setup-bar-link') as HTMLAnchorElement | null;
  const stayBtn = document.getElementById('aura-setup-bar-stay') as HTMLButtonElement | null;

  function stayRequested(): boolean {
    try { return sessionStorage.getItem(SETUP_BAR_STAY_KEY) === '1'; } catch { return false; }
  }

  /** The notice before the move, with a way to stay. Falls back to the plain bar. */
  function countdown(plan: Extract<SetupBarPlan, { kind: 'link' }>): void {
    paint(plan);
    if (!text || !stayBtn) return;
    const target = autoSwitchTarget(plan.href, location.search, location.hash);
    let left = AUTO_SWITCH_SECONDS;
    const tick = () => { text.textContent = `Apps open on this installation's app address. Switching in ${left} s…`; };
    tick();
    stayBtn.hidden = false;
    const timer = setInterval(() => {
      left -= 1;
      if (left > 0) { tick(); return; }
      clearInterval(timer);
      location.replace(target);
    }, 1000);
    stayBtn.addEventListener('click', () => {
      clearInterval(timer);
      try { sessionStorage.setItem(SETUP_BAR_STAY_KEY, '1'); } catch { /* the bar stays anyway */ }
      stayBtn.hidden = true;
      paint(plan);
    }, { once: true });
  }

  function paint(plan: SetupBarPlan): void {
    if (!bar || !title || !text || !link || !plan.show) return;
    const cookies = plan.reason === 'cookies';
    title.textContent = cookies ? 'Apps blocked in this browser.' : 'Limited IP mode.';
    if (plan.kind === 'link') {
      text.textContent = cookies
        ? "This browser doesn't keep app sign-ins on this address. Switch to this Aura installation's other app address; you sign in once more there."
        : "Apps can't open from an IP address. Switch to this Aura installation's app address.";
      link.href = autoSwitchTarget(plan.href, location.search, location.hash);
      link.textContent = `Open Aura with App Hosts: ${plan.address}`;
      link.hidden = false;
    } else {
      text.textContent = cookies
        ? "This browser doesn't keep app sign-ins on this address, and no other app address could be reached. Point a DNS name at this server and open Aura there. See Reaching AuraOS in Aura Docs."
        : "Apps can't open from this address, and no app address could be reached. Point a DNS name at this server and open Aura there. See App Hosts in Aura Docs.";
      link.removeAttribute('href');
      link.hidden = true;
    }
    bar.hidden = false;
    // Set only while the bar shows, so the desktop's layout is untouched otherwise.
    const root = document.getElementById('os-root');
    const sync = () => {
      if (!root) return;
      root.style.marginTop = `${bar.offsetHeight}px`;
      root.style.height = `calc(100% - ${bar.offsetHeight}px)`;
    };
    sync();
    if ('ResizeObserver' in window) new ResizeObserver(sync).observe(bar);
  }

  const input = {
    host: location.host,
    protocol: location.protocol,
    pathname: location.pathname,
    webkit: isWebKitBrowser(navigator.userAgent),
  };
  const show = (plan: SetupBarPlan) => {
    if (plan.show && plan.kind === 'link') {
      void probeAppHostAddress(plan.probeUrl).then((ok) => {
        const settled = settleSetupBar(plan, ok);
        if (settled.show && settled.kind === 'link' && shouldAutoSwitch(settled, stayRequested())) countdown(settled);
        else paint(settled);
      });
    } else {
      paint(plan);
    }
  };
  const cookieProbe = cookieProbeUrl(input);
  if (cookieProbe) {
    void probeAppHostCookie(cookieProbe, { sandbox: APP_FRAME_SANDBOX }).then((kept) => { if (!kept) show(planCookieFallback(input)); });
  } else {
    show(planSetupBar(input));
  }
</script>

<style is:global>
  /* Below the trusted dialogs (1900) and the auto-hide badge (1890). */
  #aura-setup-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1880;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    box-sizing: border-box;
    padding: 6px 12px;
    background: var(--aura-color-warning);
    color: var(--aura-color-bg);
    font-family: var(--aura-font-mono);
    font-size: 0.75rem;
  }
  #aura-setup-bar[hidden] { display: none; }
  #aura-setup-bar a { color: inherit; font-weight: 700; text-decoration: underline; overflow-wrap: anywhere; }
  #aura-setup-bar button {
    font: inherit; color: inherit; background: transparent; cursor: pointer;
    border: 1px solid currentColor; padding: 1px 8px;
  }
</style>
