  .bars-badge[data-edge="right"] ~ .bars-seg { width: var(--badge-thick); height: var(--seg-len); }
  .bars-badge[data-edge="top"] ~ .bars-seg,
  .bars-badge[data-edge="bottom"] ~ .bars-seg { width: var(--seg-len); height: var(--badge-thick); }
  .bars-badge[data-edge="left"]   ~ .bars-seg { left: 0;   border-left: none; }
  .bars-badge[data-edge="right"]  ~ .bars-seg { right: 0;  border-right: none; }
  .bars-badge[data-edge="top"]    ~ .bars-seg { top: 0;    border-top: none; }
  .bars-badge[data-edge="bottom"] ~ .bars-seg { bottom: 0; border-bottom: none; }
  :global(body[data-show-top="true"]) .bars-badge[data-edge="top"] ~ .bars-seg { top: var(--aura-statusbar-height); }
  :global(body[data-show-bottom="true"]) .bars-badge[data-edge="bottom"] ~ .bars-seg { bottom: var(--aura-dock-height); }

