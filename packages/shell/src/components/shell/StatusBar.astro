  .bars-badge[data-ok-place="opposite"][data-edge="right"]  ~ .bars-badge-ok { border-right: none; }
  .bars-badge[data-ok-place="opposite"][data-edge="top"]    ~ .bars-badge-ok { border-top: none; }
  .bars-badge[data-ok-place="opposite"][data-edge="bottom"] ~ .bars-badge-ok { border-bottom: none; }
  .bars-badge[data-ok-place="opposite"][data-edge="right"][data-ok-side="after"]   ~ .bars-badge-ok { border-bottom: 1px solid var(--aura-color-bg); border-radius: 8px 0 0 0; }
  .bars-badge[data-ok-place="opposite"][data-edge="right"][data-ok-side="before"]  ~ .bars-badge-ok { border-top: 1px solid var(--aura-color-bg);    border-radius: 0 0 0 8px; }
  .bars-badge[data-ok-place="opposite"][data-edge="left"][data-ok-side="after"]    ~ .bars-badge-ok { border-bottom: 1px solid var(--aura-color-bg); border-radius: 0 8px 0 0; }
  .bars-badge[data-ok-place="opposite"][data-edge="left"][data-ok-side="before"]   ~ .bars-badge-ok { border-top: 1px solid var(--aura-color-bg);    border-radius: 0 0 8px 0; }
  .bars-badge[data-ok-place="opposite"][data-edge="top"][data-ok-side="after"]     ~ .bars-badge-ok { border-right: 1px solid var(--aura-color-bg);  border-radius: 0 0 0 8px; }
  .bars-badge[data-ok-place="opposite"][data-edge="top"][data-ok-side="before"]    ~ .bars-badge-ok { border-left: 1px solid var(--aura-color-bg);   border-radius: 0 0 8px 0; }
  .bars-badge[data-ok-place="opposite"][data-edge="bottom"][data-ok-side="after"]  ~ .bars-badge-ok { border-right: 1px solid var(--aura-color-bg);  border-radius: 8px 0 0 0; }
  .bars-badge[data-ok-place="opposite"][data-edge="bottom"][data-ok-side="before"] ~ .bars-badge-ok { border-left: 1px solid var(--aura-color-bg);   border-radius: 0 8px 0 0; }
  .bars-badge[data-peek="true"][data-ok-place="opposite"][data-edge="right"][data-ok-side="after"]:not([data-dragging="true"])   { border-top-left-radius: 0; }
  .bars-badge[data-peek="true"][data-ok-place="opposite"][data-edge="right"][data-ok-side="before"]:not([data-dragging="true"])  { border-bottom-left-radius: 0; }
  .bars-badge[data-peek="true"][data-ok-place="opposite"][data-edge="left"][data-ok-side="after"]:not([data-dragging="true"])    { border-top-right-radius: 0; }
  .bars-badge[data-peek="true"][data-ok-place="opposite"][data-edge="left"][data-ok-side="before"]:not([data-dragging="true"])   { border-bottom-right-radius: 0; }
  .bars-badge[data-peek="true"][data-ok-place="opposite"][data-edge="top"][data-ok-side="after"]:not([data-dragging="true"])     { border-bottom-left-radius: 0; }
  .bars-badge[data-peek="true"][data-ok-place="opposite"][data-edge="top"][data-ok-side="before"]:not([data-dragging="true"])    { border-bottom-right-radius: 0; }
  .bars-badge[data-peek="true"][data-ok-place="opposite"][data-edge="bottom"][data-ok-side="after"]:not([data-dragging="true"])  { border-top-left-radius: 0; }
  .bars-badge[data-peek="true"][data-ok-place="opposite"][data-edge="bottom"][data-ok-side="before"]:not([data-dragging="true"]) { border-top-right-radius: 0; }
  @keyframes bars-badge-ok-pop {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  /* Peek countdown: a thin strip on the inner side that drains over the
     peek window (--bars-peek = barsPrefs.peekMs, set by applyBarsPrefs). */
  .bars-badge-timer {
    position: absolute;
    background: currentColor;
    pointer-events: none;
  }
  .bars-badge[data-edge="left"] .bars-badge-timer,
  .bars-badge[data-edge="right"] .bars-badge-timer {
    top: 0; bottom: 0; width: 2px;
    transform-origin: bottom;
    transform: scaleY(0);
  }
  .bars-badge[data-edge="top"] .bars-badge-timer,
  .bars-badge[data-edge="bottom"] .bars-badge-timer {
    left: 0; right: 0; height: 2px;
    transform-origin: left;
    transform: scaleX(0);
  }
  .bars-badge[data-edge="right"]  .bars-badge-timer { left: 0; }
  .bars-badge[data-edge="left"]   .bars-badge-timer { right: 0; }
  .bars-badge[data-edge="top"]    .bars-badge-timer { bottom: 0; }
  .bars-badge[data-edge="bottom"] .bars-badge-timer { top: 0; }
  .bars-badge[data-peek="true"][data-edge="left"] .bars-badge-timer,
  .bars-badge[data-peek="true"][data-edge="right"] .bars-badge-timer {
    animation: bars-badge-countdown-y var(--bars-peek, 6s) linear forwards;
  }
  .bars-badge[data-peek="true"][data-edge="top"] .bars-badge-timer,
  .bars-badge[data-peek="true"][data-edge="bottom"] .bars-badge-timer {
    animation: bars-badge-countdown-x var(--bars-peek, 6s) linear forwards;
  }
  .bars-badge[data-peek-paused="true"] .bars-badge-timer { animation: none !important; transform: none; }
  @keyframes bars-badge-countdown-y {
    from { transform: scaleY(1); }
    to   { transform: scaleY(0); }
  }
  @keyframes bars-badge-countdown-x {
    from { transform: scaleX(1); }
    to   { transform: scaleX(0); }
  }

  /* Dev-only "reload pending" chip: shown when auto-reload is off and a source
     change was suppressed. Attention-toned (warning color) + pulse so it's
     obvious a change is waiting. `hidden` by default; the script reveals it. */
  /* Small bar (everything folded, or the logo shrunk to its "A"): the chip
     keeps just its reload icon. */
  #statusbar:has(#ws-bundle[data-fold="all"]) .reload-pending-label,
  #statusbar[data-logo-hidden="true"] .reload-pending-label { display: none; }
  #statusbar:has(#ws-bundle[data-fold="all"]) .reload-pending-chip,
  #statusbar[data-logo-hidden="true"] .reload-pending-chip { padding: 0 5px; }
  .reload-pending-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 22px;
    padding: 0 8px;
    font-family: var(--aura-font-mono);
    font-size: var(--aura-font-size-xs);
    letter-spacing: 0.08em;
    color: var(--aura-color-bg);
    background: var(--aura-color-warning, #d8a657);
    border: 1px solid var(--aura-color-warning, #d8a657);
    cursor: pointer;
    animation: aura-reload-pending-pulse 1.6s ease-in-out infinite;
  }
  .reload-pending-chip[hidden] { display: none; }
  .reload-pending-chip:hover,
  .reload-pending-chip:focus-visible { box-shadow: var(--aura-glow-primary); outline: none; }
  @keyframes aura-reload-pending-pulse {
    0%, 100% { opacity: 0.78; }
    50%      { opacity: 1; }
  }

  /* Right-side status-bar buttons (fullscreen, etc.). Notifications live in the Dock (bottom bar). */
  .status-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: transparent;
    border: var(--aura-border);
    color: var(--aura-color-text-dim);
    cursor: pointer;
    font-family: var(--aura-font-mono);
    font-size: 0.85rem;
    line-height: 1;
    padding: 0;
    transition: color 0.1s, border-color 0.1s, box-shadow 0.1s;
  }
  .status-btn:hover,
  .status-btn:focus,
  .status-btn:focus-visible {
    color: var(--aura-color-primary);
    border-color: var(--aura-color-primary);
    box-shadow: var(--aura-glow-subtle);
    outline: none;
  }
  .status-btn:focus-visible {
    box-shadow: inset 0 0 0 2px var(--aura-color-primary), var(--aura-glow-subtle);
  }
  /* Same keyboard-focus ring for the workspace-pill buttons (they're not
     status-btn but live in the same chrome navigation chain). */
  #statusbar button:focus,
  #statusbar button:focus-visible {
    outline: none;
  }
  #statusbar button:focus-visible {
    box-shadow: inset 0 0 0 2px var(--aura-color-primary), var(--aura-glow-subtle);
  }
  /* Filled/active state when fullscreen is on */
  .status-btn[data-fs="on"] {
    color: var(--aura-color-bg);
    background: var(--aura-color-primary);
    border-color: var(--aura-color-primary);
  }
  .status-btn-icon { line-height: 1; }

  /* Zoom controls: 3 buttons sharing a border like a segmented control */
  .status-zoom {
    display: inline-flex;
    align-items: center;
    border: var(--aura-border);
  }
  .status-zoom .status-btn {
    border: none;
    width: 22px;
  }
  .status-zoom .status-btn + .status-btn {
    border-left: 1px solid var(--aura-color-border);
  }
  .status-zoom .status-btn:hover {
    background: color-mix(in srgb, var(--aura-color-primary) 14%, transparent);
    box-shadow: none;
  }
  /* Enlarge just the +/- stepper glyphs to 1.5x the status-btn size
     (0.85rem -> 1.275rem); the 22px button box is unchanged. */
  #zoom-out,
  #zoom-in {
    font-size: 1.275rem;
  }
  /* The middle "value" button is wider and shows %, never gets the icon font */
  .status-btn-text {
    width: auto !important;
    min-width: 44px;
    padding: 0 10px;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: var(--aura-color-text);
  }

  /* ── Workspace bundle ──
   * Priority-ordered responsive folding, driven by [data-fold] (set by JS
   * from the statusbar width):
   *
   *   [data-fold="none"]  everything inline (pills + chip + name); the ▦
   *                       collapse trigger is hidden.
   *   [data-fold="chip"]  the layout chip has been relocated into the dropdown
   *                       (`.ws-content`); pills + name stay inline, ▦ shows.
   *   [data-fold="all"]   pills + chip both relocated into the dropdown; only
   *                       the name field stays beside ▦.
   *
   * `.ws-content` is the dropdown HOST: empty at [data-fold="none"], it
   * receives the folded nodes and is shown as a popover when [data-open].
   * Always-on `position: relative` so the popover absolute-positions to the
   * bundle, not the document. */
  .ws-bundle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .ws-collapse-btn { display: none; }
  .ws-fold-nav { display: none; }
  /* ‹ n › as one segmented control, like the zoom buttons. Before the full
     fold the group is layout-transparent and ▦ keeps its own border. */
  .ws-fold-group { display: contents; }
  .ws-bundle[data-fold="all"] .ws-fold-group {
    display: inline-flex;
    align-items: center;
    border: var(--aura-border);
  }
  .ws-bundle[data-fold="all"] .ws-fold-group .status-btn { border: none; }
  .ws-bundle[data-fold="all"] .ws-fold-group .ws-fold-nav { width: 22px; }
  .ws-bundle[data-fold="all"] .ws-fold-group .status-btn + .status-btn { border-left: 1px solid var(--aura-color-border); }
  .ws-bundle[data-fold="all"] .ws-fold-group .status-btn:hover {
    background: color-mix(in srgb, var(--aura-color-primary) 14%, transparent);
    box-shadow: none;
  }
  .ws-bundle[data-fold="all"] .ws-fold-nav { display: inline-flex; align-items: center; justify-content: center; }
  .ws-fold-nav:disabled { opacity: 0.35; cursor: default; }
  /* The ▦ trigger appears as soon as anything has folded into the dropdown. */
  .ws-bundle[data-fold="chip"] .ws-collapse-btn,
  .ws-bundle[data-fold="all"]  .ws-collapse-btn { display: inline-flex; }
  /* Dropdown host is hidden until opened (it only holds folded controls). */
  .ws-content { display: none; }
  .ws-collapse-icon { line-height: 1; font-size: 0.9rem; }
  /* ‹ n ›: number in the zoom-percent style (.status-btn-text). */
  .ws-collapse-num { display: none; }
  .ws-bundle[data-fold="all"] .ws-collapse-icon { display: none; }
  .ws-bundle[data-fold="all"] .ws-collapse-num { display: inline; }
  .ws-bundle[data-fold="all"] .ws-collapse-btn {
    /* Fixed two-digit width, so 1 → 12 never shifts the arrows. */
    width: calc(2ch + 16px);
    min-width: 0;
    padding: 0;
    justify-content: center;
    font-variant-numeric: tabular-nums;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: var(--aura-color-text);
  }

  /* ── Workspace name field ──
   * Editable text input for the active workspace's name, the priority control
   * kept inline beside the pills. Sized to match the 22px chrome row; focus
   * adopts the same primary-toned ring as the other status-bar controls. */
  .ws-name-input {
    width: 120px;
    height: 22px;
    padding: 0 8px;
    background: transparent;
    border: var(--aura-border);
    color: var(--aura-color-text);
    font-family: var(--aura-font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    line-height: 1;
    transition: color 0.1s, border-color 0.1s, box-shadow 0.1s;
  }
  .ws-name-input::placeholder {
    color: var(--aura-color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ws-name-input:hover {
    border-color: var(--aura-color-primary);
  }
  .ws-name-input:focus,
  .ws-name-input:focus-visible {
    outline: none;
    color: var(--aura-color-primary);
    border-color: var(--aura-color-primary);
    box-shadow: inset 0 0 0 1px var(--aura-color-primary), var(--aura-glow-subtle);
  }
  .ws-name-input:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* Last-resort: when even the collapse button + name field won't fit, drop
   * the field too (button only). Set by fitWorkspaceUI() when space is tight. */
  .ws-bundle[data-name-hidden="true"] .ws-name-input { display: none; }
  /* The dropdown popover mounts only when opened (the ▦ trigger only exists
   * once something has folded, so [data-open] always implies folded content).
   * Popover anchor (right by default). The collapse-button click handler
   * measures available space below the trigger and flips `data-anchor`
   * to whichever side has room — so a bundle near the right edge opens
   * leftward, and one near the left edge opens rightward. */
  .ws-bundle[data-open="true"] .ws-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    position: absolute;
    top: calc(100% + 6px);
    z-index: 1100;
    padding: 8px;
    background: var(--aura-color-surface);
    border: var(--aura-border);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    min-width: 220px;
    /* As wide as its widest row, capped to the viewport. */
    width: max-content;
    max-width: min(400px, 90vw);
  }
  /* Two rows: pills (+ compact/+ when they fit), then the layout chip. */
  .ws-drop-row {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    max-width: 100%;
  }
  .ws-drop-row:empty { display: none; }
  /* Last resort on very narrow screens: the pills wrap instead of spilling
     out. Off while arrangeDropdown() measures the unwrapped width. */
  .ws-drop-row > .ws-pills { flex-wrap: wrap; row-gap: 6px; min-width: 0; }
  .ws-bundle[data-drop-measure="true"] .ws-drop-row > .ws-pills { flex-wrap: nowrap; }
  .ws-bundle[data-anchor="right"] .ws-content { right: 0; left: auto; }
  .ws-bundle[data-anchor="left"]  .ws-content { left: 0;  right: auto; }
  /* Center anchor — used when neither side fits in a narrow viewport.
   * Switches to `position: fixed` so the popover can escape the bundle's
   * containing block and centre relative to the viewport. Vertical stays
   * anchored to the trigger via `--ws-popover-top` (set in JS to
   * bundleEl.getBoundingClientRect().bottom + 6). */
  .ws-bundle[data-anchor="center"][data-open="true"] .ws-content {
    position: fixed;
    left: 50%;
    right: auto;
    top: var(--ws-popover-top, 64px);
    transform: translateX(-50%);
  }
  /* The collapse button gets a subtle highlight while the dropdown is open. */
  .ws-bundle[data-open="true"] .ws-collapse-btn {
    color: var(--aura-color-primary);
    border-color: var(--aura-color-primary);
  }

  /* ── Pill context menu ──
   * Right-click / long-press menu anchored under a numbered pill. Same chrome
   * as the launcher's `.lo-ctx` menu (LauncherOverlay.astro) — surface panel,
   * hard border, no radius, monospace uppercase rows.
   *
   * Positioned absolutely against whichever host currently holds `#ws-pills`
   * (`.ws-bundle` inline, `.ws-content` when folded) — both are positioned
   * elements, and openCtxMenu() re-parents the menu accordingly. Inline
   * `left`/`top` are written in LAYOUT px from `pill.offsetLeft/offsetTop`,
   * NOT client rects: the shell zooms via `body { transform: scale() }`, which
   * scales client rects but not CSS offsets.
   *
   * z-index sits above the `.ws-content` dropdown (1100) so it stays visible
   * when a folded pill is right-clicked inside it. */
  .ws-ctx {
    position: absolute;
    z-index: 1150;
    min-width: 176px;
    display: flex;
    flex-direction: column;
    padding: 4px;
    background: var(--aura-color-surface);
    border: var(--aura-border);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    font-family: var(--aura-font-mono);
    font-size: var(--aura-font-size-xs);
    text-transform: none;
  }
  .ws-ctx[hidden] { display: none; }
  /* Which pill this menu belongs to — "<name> · SLOT <n>". */
  .ws-ctx-title {
    padding: 4px 10px 6px;
    color: var(--aura-color-text-dim);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-bottom: var(--aura-border);
    margin-bottom: 4px;
  }

  .ws-ctx-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 10px;
    background: transparent;
    border: none;
    color: var(--aura-color-text);
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ws-ctx-item:hover,
  .ws-ctx-item:focus-visible {
    outline: none;
    background: color-mix(in srgb, var(--aura-color-primary) 14%, transparent);
    color: var(--aura-color-primary);
  }
  .ws-ctx-item:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
  }
  .ws-ctx-chev {
    color: var(--aura-color-text-dim);
    font-size: 0.7rem;
    transition: transform 0.1s;
  }
  /* Chevron rotates down while its panel is expanded. */
  .ws-ctx-item[aria-expanded="true"] .ws-ctx-chev { transform: rotate(90deg); }
  .ws-ctx-item[aria-expanded="true"] {
    color: var(--aura-color-primary);
  }
  /* Delete reads as destructive: secondary tone rather than primary. */
  .ws-ctx-danger:hover,
  .ws-ctx-danger:focus-visible,
  .ws-ctx-danger[aria-expanded="true"] {
    background: color-mix(in srgb, var(--aura-color-secondary) 14%, transparent);
    color: var(--aura-color-secondary);
  }

  /* Disclosure panel shared by Move / Rename / Delete-confirm. */
  .ws-ctx-panel {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 8px;
    background: color-mix(in srgb, var(--aura-color-primary) 6%, transparent);
  }
  .ws-ctx-panel[hidden] { display: none; }

  /* Stepper number field. Fixed width so ‹ / › don't shift as digits change. */
  .ws-ctx-slot,
  .ws-ctx-name {
    height: 22px;
    padding: 0 6px;
    background: transparent;
    border: var(--aura-border);
    color: var(--aura-color-text);
    font-family: var(--aura-font-mono);
    font-size: 0.7rem;
    line-height: 1;
    transition: color 0.1s, border-color 0.1s, box-shadow 0.1s;
  }
  .ws-ctx-slot { width: 44px; text-align: center; }
  .ws-ctx-name { flex: 1; min-width: 0; }
  .ws-ctx-slot:focus,
  .ws-ctx-slot:focus-visible,
  .ws-ctx-name:focus,
  .ws-ctx-name:focus-visible {
    outline: none;
    color: var(--aura-color-primary);
    border-color: var(--aura-color-primary);
    box-shadow: inset 0 0 0 1px var(--aura-color-primary), var(--aura-glow-subtle);
  }

  /* ‹ / › steppers and the OK / No buttons all borrow the `.ws-pill` metrics. */
  .ws-ctx-step,
  .ws-ctx-ok,
  .ws-ctx-cancel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 22px;
    padding: 0 8px;
    background: transparent;
    border: var(--aura-border);
    color: var(--aura-color-text-dim);
    cursor: pointer;
    font-family: var(--aura-font-mono);
    font-size: 0.7rem;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.1s, border-color 0.1s, background 0.1s;
  }
  .ws-ctx-step { font-size: 0.85rem; }
  .ws-ctx-step:hover,
  .ws-ctx-cancel:hover {
    color: var(--aura-color-primary);
    border-color: var(--aura-color-primary);
  }
  /* Disabled at a bound — same treatment as `.ws-pill[disabled]`. */
  .ws-ctx-step:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
  }
  /* OK is the commit affordance: filled, like the active pill. */
  .ws-ctx-ok {
    margin-left: auto;
    padding: 0 10px;
    color: var(--aura-color-bg);
    background: var(--aura-color-primary);
    border-color: var(--aura-color-primary);
    font-weight: 700;
  }
  .ws-ctx-ok:hover { box-shadow: var(--aura-glow-subtle); }
  .ws-ctx-ok-danger {
    background: var(--aura-color-secondary);
    border-color: var(--aura-color-secondary);
  }
  .ws-ctx-confirm-q {
    color: var(--aura-color-text-dim);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* "No" sits after the filled "Yes", which has `margin-left: auto`. */
  .ws-ctx-cancel { padding: 0 10px; }

  /* ── Layout chip ──
   * Distinguished from the generic status-btn-text by its three-part layout
   * (icon · name · cycle hint) and a slightly stronger border treatment.
   * The "↻" hint reveals on hover to telegraph that the chip cycles layouts. */
  /* Fixed-width chip so it doesn't jiggle as the user cycles through layout
   * names of different lengths (TILING/CASCADE/COLUMNS/FULLSCREEN/ROWS/
   * STACK). Width budget: icon (~12) + gap (6) + name slot (84) + gap (6)
   * + cycle slot (10) + 16px h-padding. Total ≈ 134px.
   *
   * The cycle hint uses visibility (not opacity-only) so its slot always
   * reserves space — the chip can't grow on hover. */
  .layout-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: 134px;
    height: 22px;
    padding: 0 8px;
    background: color-mix(in srgb, var(--aura-color-primary) 3%, transparent);
    border: var(--aura-border);
    color: var(--aura-color-text);
    cursor: pointer;
    font-family: var(--aura-font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    transition: color 0.1s, border-color 0.1s, background 0.1s;
  }
  .layout-chip:hover {
    color: var(--aura-color-primary);
    border-color: var(--aura-color-primary);
    background: color-mix(in srgb, var(--aura-color-primary) 10%, transparent);
  }
  .layout-chip-icon {
    flex-shrink: 0;
    color: var(--aura-color-primary);
    font-size: 0.85rem;
    line-height: 1;
  }
  .layout-chip-name {
    flex: 1;
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .layout-chip-cycle {
    flex-shrink: 0;
    width: 10px;
    text-align: right;
    color: var(--aura-color-text-dim);
    font-size: 0.7rem;
    visibility: hidden;
    transition: color 0.1s;
  }
  .layout-chip:hover .layout-chip-cycle {
    visibility: visible;
    color: var(--aura-color-primary);
  }

  /* The handwritten .sci-* dialog/section/row/slider/check/btn rules that
   * lived here moved to @aura/ui (vendored scificn primitives via shadcn).
   * The Viewport dialog above is now <ViewportSettingsDialog client:load />
   * — see ViewportSettingsDialog.tsx for the new component tree. */
</style>

<!-- ── Workspace switcher (global) ──
     The numbered pills + ‹/› chevrons + "+" button are rendered into
     `#ws-pills` via `pillsEl.innerHTML = ...` at runtime. Astro's default
     scoped <style> wouldn't match runtime-generated nodes (they don't carry
     the cid attribute), so this rule set has to live in an unscoped block.
     is:inline tells Astro to emit the CSS verbatim, no scoping. -->
