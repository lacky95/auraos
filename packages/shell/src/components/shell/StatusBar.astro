  .bars-badge[data-edge="right"][data-ok-side="before"] ~ .bars-badge-ok { border-bottom: 1px solid var(--aura-color-bg); }
  .bars-badge[data-edge="top"][data-ok-side="after"] ~ .bars-badge-ok,
