  .bars-badge[data-edge="left"][data-ok-side="after"]    ~ .bars-seg { border-radius: 0 0 8px 0; }
  .bars-badge[data-edge="left"][data-ok-side="before"]   ~ .bars-seg { border-radius: 0 8px 0 0; }
  .bars-badge[data-edge="top"][data-ok-side="after"]     ~ .bars-seg { border-radius: 0 0 8px 0; }
  .bars-badge[data-edge="top"][data-ok-side="before"]    ~ .bars-seg { border-radius: 0 0 0 8px; }
  .bars-badge[data-edge="bottom"][data-ok-side="after"]  ~ .bars-seg { border-radius: 0 8px 0 0; }
