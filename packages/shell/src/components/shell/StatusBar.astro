---
import ViewportSettingsDialog from './ViewportSettingsDialog.tsx';
import AboutDialog from './AboutDialog.tsx';
import { sharedKv } from '../../lib/sharedKv';
import Icon from '../ui/Icon.astro';

// SSR-resolve clock format + locale from the OS KV so the first paint matches
// the user's preference (no flash of the default 24h/en-GB clock on reload).
// Viewport profiles are NOT SSR-hydrated — they live in device localStorage
// (see lib/viewportClient), which the server can't read. The client script
// applies them on boot; expect ~1 frame of unzoomed paint on hard reload.
let initialClockFormat: '12h' | '24h' = '24h';
let initialLocale: string = 'en-GB';
// IANA zone from Settings → General; '' = the device's own zone.
let initialTimeZone: string = '';
{
  const kv = sharedKv();
  try {
    const [cf, lc, tz] = await Promise.all([
      kv.getValue<'12h' | '24h'>('os', 'clockFormat'),
      kv.getValue<string>('os', 'locale'),
      kv.getValue<string>('os', 'timeZone'),
    ]);
    if (cf === '12h' || cf === '24h') initialClockFormat = cf;
    if (typeof lc === 'string' && lc) initialLocale = lc;
    if (typeof tz === 'string') initialTimeZone = tz;
  } catch { /* fall back to defaults */ }
}
---
<header id="statusbar">
  <span id="os-about-btn" class="os-name" role="button" tabindex="0" aria-haspopup="dialog" title="About AuraOS" data-early-click="about">A<span class="os-name-rest">URA</span><span class="os-ver">OS</span></span>
  <div class="right">
    <!--
      Workspace switcher: a row of numbered pills (1..N) plus a [+] add-new
      button, followed by a chip showing the active workspace's layout
      strategy (clickable to cycle). Populated client-side from the
      workspaceClient — see the <script> block below.
    -->
    <!--
      Workspace bundle. Inline reading order is: name field → numbered pills
      (switcher) → layout chip. Children degrade in PRIORITY order as the bar
      narrows, driven by `data-fold` (none → chip → all) set by fitWorkspaceUI():
        • the numbered pills + ‹/› arrows and the name field are the priority
          controls and stay inline the longest;
        • the layout chip is the lowest-priority control — it folds into the
          dropdown FIRST so the number buttons keep their room;
        • only when even one pill won't fit do the pills fold in too, leaving
          the name field beside the ▦ button;
        • `data-name-hidden` drops the name only as a last resort.
      `#ws-content` is the dropdown popover HOST: fitWorkspaceUI relocates the
      folded nodes (chip, then pills) into it, and the ▦ trigger (#ws-collapse-
      btn) opens it. The pills/chip otherwise live inline as direct children.
    -->
    <div id="ws-bundle" class="ws-bundle" data-fold="none" data-name-hidden="false">
      <!--
        The name field leads the bundle (workspace name → switcher → layout
        chip). It stays beside the ▦ button when the pills + chip fold into the
        dropdown; it is only dropped (data-name-hidden) as a last resort when
        even button + field won't fit.
      -->
      <input
        id="ws-name-input"
        class="ws-name-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        maxlength="40"
        placeholder="Workspace"
        aria-label="Active workspace name"
        title="Rename the active workspace"
      />
      <!-- ‹ ▦ › — when everything has folded (data-fold="all") the arrows
           stay beside the ▦ button so the workspace can still be stepped
           without opening the dropdown. Same data-ws-action as the pill
           row's arrows (onPillClick). -->
      <div class="ws-fold-group" role="group" aria-label="Workspace">
      <button id="ws-fold-prev" type="button" class="status-btn ws-fold-nav" data-ws-action="prev"
              title="Previous workspace" aria-label="Previous workspace"><Icon name="chevron-left" /></button>
      <button
        id="ws-collapse-btn"
        type="button"
        class="status-btn ws-collapse-btn"
        title="Workspaces"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="ws-content"
      >
        <span class="ws-collapse-icon" aria-hidden="true"><Icon name="layout-grid" /></span>
        <!-- Fully folded (‹ n ›): the active workspace's number instead of ▦. -->
        <span class="ws-collapse-num" aria-hidden="true"></span>
      </button>
      <button id="ws-fold-next" type="button" class="status-btn ws-fold-nav" data-ws-action="next"
              title="Next workspace" aria-label="Next workspace"><Icon name="chevron-right" /></button>
      </div>
      <div id="ws-pills" class="ws-pills"></div>
      <!-- Compact + "+" — their own group so the dropdown can put them on the
           pill row or, when that row is too wide, beside the layout chip. -->
      <div id="ws-pill-actions" class="ws-pills ws-pill-actions"></div>
      <button id="ws-layout-chip" class="layout-chip" title="Cycle workspace layout" aria-label="Layout strategy">
        <span class="layout-chip-icon" aria-hidden="true"><Icon name="layout-grid" /></span>
        <span class="layout-chip-name">—</span>
        <span class="layout-chip-cycle" aria-hidden="true"><Icon name="rotate-cw" /></span>
      </button>
      <!-- Dropdown popover host: two rows, empty until fitWorkspaceUI()
           relocates the folded controls into them. Row 1: pills (+ compact
           and "+" when they fit); row 2: layout chip (+ compact and "+"
           otherwise) — see arrangeDropdown(). Absolutely positioned, so its
           DOM position here doesn't affect the inline bar layout. -->
      <div id="ws-content" class="ws-content" role="group" aria-label="Workspaces"><div id="ws-drop-row1" class="ws-drop-row"></div><div id="ws-drop-row2" class="ws-drop-row"></div></div>
      <!--
        Per-pill context menu (right-click / long-press on a numbered pill).
        Static markup so Astro's scoped <style> applies — the pills themselves
        are innerHTML-generated and need the is:inline block, this doesn't.

        It lives here as the LAST child of the bundle, but openCtxMenu()
        re-parents it to whichever element currently hosts `#ws-pills` (this
        bundle inline, or `#ws-content` when the pills have folded into the
        dropdown) so it can anchor to the clicked pill in both modes.

        Each row is a disclosure: clicking it expands the panel below it, and
        only one panel is open at a time. Delete deliberately hides behind a
        `Sure? [Yes] [No]` confirm — the menu can be opened by an accidental
        long-press, so a destructive action must not be one stray click away.
      -->
      <div id="ws-ctx" class="ws-ctx" role="menu" aria-label="Workspace actions" hidden>
        <div id="ws-ctx-title" class="ws-ctx-title"></div>

        <button class="ws-ctx-item" data-ws-ctx="move" type="button" role="menuitem"
                aria-haspopup="true" aria-expanded="false" aria-controls="ws-ctx-move-panel">
          <span>Move</span><span class="ws-ctx-chev" aria-hidden="true"><Icon name="chevron-right" /></span>
        </button>
        <div id="ws-ctx-move-panel" class="ws-ctx-panel" hidden>
          <button id="ws-ctx-dec" class="ws-ctx-step" data-ws-ctx="dec" type="button" aria-label="Previous slot"><Icon name="chevron-left" /></button>
          <input id="ws-ctx-slot" class="ws-ctx-slot" type="text" inputmode="numeric"
                 autocomplete="off" maxlength="3" aria-label="Target slot" />
          <button id="ws-ctx-inc" class="ws-ctx-step" data-ws-ctx="inc" type="button" aria-label="Next slot"><Icon name="chevron-right" /></button>
          <button class="ws-ctx-ok" data-ws-ctx="move-ok" type="button">OK</button>
        </div>

        <button class="ws-ctx-item" data-ws-ctx="rename" type="button" role="menuitem"
                aria-haspopup="true" aria-expanded="false" aria-controls="ws-ctx-rename-panel">
          <span>Rename</span><span class="ws-ctx-chev" aria-hidden="true"><Icon name="chevron-right" /></span>
        </button>
        <div id="ws-ctx-rename-panel" class="ws-ctx-panel" hidden>
          <input id="ws-ctx-name" class="ws-ctx-name" type="text" maxlength="40"
                 autocomplete="off" spellcheck="false" aria-label="Workspace name" />
          <button class="ws-ctx-ok" data-ws-ctx="rename-ok" type="button">OK</button>
        </div>

        <button id="ws-ctx-delete" class="ws-ctx-item ws-ctx-danger" data-ws-ctx="delete" type="button" role="menuitem"
                aria-haspopup="true" aria-expanded="false" aria-controls="ws-ctx-delete-panel">
          <span>Delete</span><span class="ws-ctx-chev" aria-hidden="true"><Icon name="chevron-right" /></span>
        </button>
        <div id="ws-ctx-delete-panel" class="ws-ctx-panel" hidden>
          <span class="ws-ctx-confirm-q">Sure?</span>
          <button class="ws-ctx-ok ws-ctx-ok-danger" data-ws-ctx="delete-yes" type="button">Yes</button>
          <button class="ws-ctx-cancel" data-ws-ctx="delete-no" type="button">No</button>
        </div>
      </div>
    </div>
    <button
      id="shell-reload-pending"
      type="button"
      class="reload-pending-chip"
      title="The shell changed while auto-reload is off — click to reload"
      aria-label="Reload the shell"
      hidden
    ><Icon name="rotate-cw" /><span class="reload-pending-label">RELOAD</span></button>
    <span id="clock" class="clock" data-clock-format={initialClockFormat} data-locale={initialLocale} data-time-zone={initialTimeZone}>--:--:--</span>
    <div class="status-zoom" role="group" aria-label="Page zoom">
      <button id="zoom-out"   type="button" class="status-btn" title="Zoom out (Ctrl -)">-</button>
      <button id="zoom-level" type="button" class="status-btn status-btn-text" title="Reset zoom to 100%">100%</button>
      <button id="zoom-in"    type="button" class="status-btn" title="Zoom in (Ctrl +)">+</button>
      <button id="settings-btn" type="button" class="status-btn" title="Settings" aria-haspopup="dialog" data-early-click="viewport">
        <span class="status-btn-icon" aria-hidden="true"><Icon name="settings" /></span>
      </button>
    </div>
    <button
      id="autohide-btn"
      type="button"
      class="status-btn"
      title="Auto-hide bars: desktop fills the screen; top/bottom bars reveal on edge-hover"
      aria-pressed="false"
    >
      <span id="autohide-icon" class="status-btn-icon" aria-hidden="true"><Icon name="unfold-vertical" /></span>
    </button>
    <button
      id="fullscreen-btn"
      type="button"
      class="status-btn"
      title="Toggle fullscreen (F11)"
      aria-pressed="false"
    >
      <span id="fullscreen-icon" class="status-btn-icon" aria-hidden="true"><Icon name="maximize" /></span>
    </button>
  </div>
</header>

<!--
  Edge badge for auto-hide mode (shown only while it's on, see OSLayout's
  global autohide rules). Joined to it along the edge: a ⌨ segment (toggles
  the virtual keyboard) and, while peeking, a ✓ segment on the badge's other
  side (or past ⌨ when there's no room there).
  Tap: peek both bars for barsPrefs.peekMs and pop the ✓; ✓ leaves auto-hide (bars permanent), another
  badge tap hides the bars right away. Hold 200 ms, then drag: slide it along the
  screen edge and over a corner onto the next one; it snaps to the nearest
  edge.
-->
<button
  id="bars-badge"
  type="button"
  class="bars-badge"
  title="Show bars (hold, then drag to move)"
  aria-label="Show bars"
  data-edge="right"
  data-ok-side="after"
  data-ok-place="opposite"
  data-peek="false"
>
  <span class="bars-badge-icon" aria-hidden="true"><Icon name="unfold-vertical" /></span>
  <span class="bars-badge-timer" aria-hidden="true"></span>
</button>
<button
  id="bars-badge-ok"
  type="button"
  class="bars-seg bars-badge-ok"
  title="Keep the bars shown (leave auto-hide)"
  aria-label="Keep bars shown"
>
  <span class="bars-badge-icon" aria-hidden="true"><Icon name="check" /></span>
</button>
<button
  id="bars-badge-kb"
  type="button"
  class="bars-seg bars-badge-kb"
  title="Virtual keyboard"
  aria-label="Virtual keyboard"
  aria-expanded="false"
  aria-controls="virtual-keyboard"
>
  <span class="bars-badge-icon" aria-hidden="true"><Icon name="keyboard" /></span>
</button>

<!--
  Viewport / settings dialog. Now a React island composed of scificn primitives
  via @aura/ui (Dialog, Tabs, Checkbox, Button). The vanilla `<dialog>` and
  ~200 lines of bespoke `.sci-*` markup it replaced lived here from the days
  before @aura/ui shipped.

  The gear button (`#settings-btn` above) dispatches an `aura.viewport.open`
  CustomEvent on click — the React component listens for that and flips its
  open state. State plumbing (zoom + margins) flows through the same
  `window.auraSetZoom` / `window.auraSetMargins` globals defined later in
  this file, so the dialog stays a pure UI layer.
-->
<!--
  Viewport profiles live in device localStorage — viewportClient.refresh()
  reads them on boot. No SSR hydration: the server can't see localStorage.
-->
<!-- Hydrated when the browser is idle, so React is not on the boot path; a
     click before that is kept (lib/openRequest.ts) and opens on mount. -->
<ViewportSettingsDialog client:idle={{ timeout: 3000 }} />
<AboutDialog client:idle={{ timeout: 3000 }} />

<script>
  import { markBarReady } from '../../lib/bootTimeline.ts';
  import { requestOpen } from '../../lib/openRequest.ts';
  import { claimEarlyClicks } from '../../lib/earlyClicks.ts';
  import * as workspaceClient from '../../lib/workspaceClient';
  import { registerDropTarget, WINDOW_DRAG_EVENT } from '../../lib/windowDrag';
  import * as viewportClient from '../../lib/viewportClient';
  import { queueViewportBroadcast } from '../../lib/viewportBroadcaster.ts';
  import { getKeyDispatcher } from '../../lib/keyDispatcher.ts';
  import { registerUiCommand, registerSnapshotPart } from '../../lib/uiCommands.ts';
  import { osEvents } from '../../lib/osEvents.ts';
  import { kbState } from '../../lib/keyboard/kbState.ts';
  import { installShellReloadGuard, installRebuildListener, RELOAD_PENDING_EVENT } from '../../lib/devReload';
  import { loadBarsPrefs, onBarsPrefs, AUTOHIDE_EVENT } from '../../lib/barsPrefs.ts';
  import { installClockCalendar } from './clockCalendar.ts';

  const keyDispatcher = getKeyDispatcher();

  // When the user turns OFF "auto-reload on source change" in the Viewport
  // dialog, a shell change reveals a "reload pending" chip instead of
  // reloading: in dev by vetoing Vite's full reload, in production on the
  // `shell:rebuilt` OS event of a self-rebuilding shell (lib/devReload.ts).
  installShellReloadGuard();
  installRebuildListener(osEvents);
  const reloadChip = document.getElementById('shell-reload-pending');
  if (reloadChip) {
    window.addEventListener(RELOAD_PENDING_EVENT, () => reloadChip.removeAttribute('hidden'));
    reloadChip.addEventListener('click', () => location.reload());
  }

  // Clock: format, locale and time zone come from `os/clockFormat`,
  // `os/locale` and `os/timeZone` KV entries, hydrated by SSR into `data-*`
  // attributes on #clock. The Settings → General page writes them; we
  // live-update via the shared socket.io channel without a page reload.
  // The zone matters because the device running this browser may not be
  // where the user is (a kiosk or WebView host on UTC): an empty value means
  // "the device's own zone". The lock-screen clock and the shell MCP's
  // get_datetime read the same attributes, so every clock agrees.
  function readClockPrefs() {
    const el = document.getElementById('clock');
    const fmt = (el?.dataset['clockFormat'] === '12h' ? '12h' : '24h') as '12h' | '24h';
    const loc = el?.dataset['locale'] || 'en-GB';
    const tz  = el?.dataset['timeZone'] || undefined;
    return { fmt, loc, tz };
  }
  function tick() {
    const el = document.getElementById('clock');
    if (!el) return;
    const { fmt, loc, tz } = readClockPrefs();
    try {
      el.textContent = new Date().toLocaleTimeString(loc, { hour12: fmt === '12h', timeZone: tz });
    } catch {
      // Bad locale or zone string from the user — fall back to en-GB in the
      // device zone so the clock still ticks instead of crashing the script.
      el.textContent = new Date().toLocaleTimeString('en-GB', { hour12: fmt === '12h' });
    }
  }
  tick();
  setInterval(tick, 1000);
  // Tap / click the clock: a month calendar drops down under it.
  installClockCalendar();

  // Live-refresh when Settings → General writes a new value. The Redis
  // KV PUT fires `kv:changed`, which arrives here over socket.io.
  osEvents.subscribe('kv:changed', (ev: any) => {
    if (ev?.namespace !== 'os') return;
    const el = document.getElementById('clock');
    if (!el) return;
    if (ev.key === 'clockFormat' && (ev.value === '12h' || ev.value === '24h')) {
      el.dataset['clockFormat'] = ev.value;
      tick();
    } else if (ev.key === 'locale' && typeof ev.value === 'string' && ev.value) {
      el.dataset['locale'] = ev.value;
      tick();
    } else if (ev.key === 'timeZone' && typeof ev.value === 'string') {
      el.dataset['timeZone'] = ev.value;   // '' ⇒ back to the device zone
      tick();
    }
  });

  // Fullscreen toggle. Browser fullscreen requires a user gesture, so this
  // only works from the click handler — not via auraToggleFullscreen() from
  // other code unless that code is itself in a user-initiated callback.
  const fsBtn  = document.getElementById('fullscreen-btn') as HTMLButtonElement | null;
  const fsIcon = document.getElementById('fullscreen-icon');

  // Lucide sprite refs — swapped via innerHTML on fullscreen change.
  const ICON_ENTER = '<svg class="aura-icon" aria-hidden="true"><use href="/api/os/icons.svg#lucide-maximize"/></svg>';
  const ICON_EXIT  = '<svg class="aura-icon" aria-hidden="true"><use href="/api/os/icons.svg#lucide-minimize"/></svg>';

  function syncState() {
    const isFs = !!document.fullscreenElement;
    if (fsBtn)  fsBtn.setAttribute('aria-pressed', isFs ? 'true' : 'false');
    if (fsBtn)  fsBtn.dataset['fs'] = isFs ? 'on' : 'off';
    if (fsBtn)  fsBtn.title = isFs ? 'Exit fullscreen (F11)' : 'Enter fullscreen (F11)';
    if (fsIcon) fsIcon.innerHTML = isFs ? ICON_EXIT : ICON_ENTER;
  }

  async function toggleFullscreen() {
    try {
      if (!document.fullscreenElement) {
        await document.documentElement.requestFullscreen();
      } else {
        await document.exitFullscreen();
      }
    } catch (err) {
      console.warn('[StatusBar] fullscreen toggle failed', err);
    }
  }

  fsBtn?.addEventListener('click', toggleFullscreen);
  // Stay in sync if the user exits via Esc or F11
  document.addEventListener('fullscreenchange', syncState);
  syncState();

  // Expose for other components (e.g. process manager) to call.
  (window as any).auraToggleFullscreen = toggleFullscreen;

  // ─── Auto-hide top/bottom bars ───────────────────────────────────────
  // When enabled, #os-root flips into single-row mode (desktop fills the
  // whole viewport) and #statusbar / #dock fixed-position on top with a
  // CSS transform that translates them off-edge. Moving the mouse into a
  // small "hot zone" along the top / bottom edge reveals the matching bar
  // for barsPrefs.hideDelayMs; the timer resets while the cursor remains in
  // the hot zone OR over the bar itself.
  const AUTOHIDE_KEY = 'aura.shell.autohide-bars';
  // Hide delay, edge strip, reveal delay, kept bars, badge: device prefs from the
  // viewport dialog's MENU BARS page (lib/barsPrefs), re-read live on change.
  let barsPrefs = loadBarsPrefs();
  // A kept bar stays shown in auto-hide mode (only the other one hides).
  const kept = (which: 'top' | 'bottom') => (which === 'top' ? barsPrefs.keepTop : barsPrefs.keepBottom);
  const autohideBtn = document.getElementById('autohide-btn') as HTMLButtonElement | null;
  // Mode + visibility attributes live on <body> so the selectors in
  // OSLayout don't depend on the exact DOM nesting (Astro island wrappers
  // can subtly break `#os-root > #statusbar` style direct-child selectors).
  const root        = document.body;
  let autohideEnabled = false;
  let topTimer:    ReturnType<typeof setTimeout> | null = null;
  let bottomTimer: ReturnType<typeof setTimeout> | null = null;

  // Keyboard-focus pin: while a button inside #statusbar / #dock is
  // focused, that bar stays revealed — no dwell-hide timer. Set/cleared
  // by the focusin/focusout listeners installed further down.
  let topPinned = false, bottomPinned = false;
  // External pins: floating surfaces OUTSIDE the bars that belong to a bar
  // (e.g. the notification list above the Dock) keep it revealed while open.
  // Keyed so several surfaces can pin independently.
  const extPins = { top: new Set<string>(), bottom: new Set<string>() };
  (window as any).auraPinBar = (which: 'top' | 'bottom', key: string, pinned: boolean) => {
    if (which !== 'top' && which !== 'bottom') return;
    const set = extPins[which];
    if (pinned) {
      set.add(key);
      if (which === 'top' && topTimer)       { clearTimeout(topTimer);    topTimer    = null; }
      if (which === 'bottom' && bottomTimer) { clearTimeout(bottomTimer); bottomTimer = null; }
      if (autohideEnabled) setBarVisible(which, true);
    } else if (set.delete(key) && autohideEnabled) {
      // Resume the normal dwell-hide from now — only for a bar that is up. A pin
      // that never got its bar shown (e.g. the free keyboard's Dock pin while the
      // Dock stays hidden) must not flash it on release.
      const shown = root?.dataset[which === 'top' ? 'showTop' : 'showBottom'] === 'true';
      if (shown || kept(which)) bumpReveal(which);
    }
  };

  // An open docked virtual keyboard takes the Dock's place at the bottom
  // edge (KeyboardOverlay), so while it's up the auto-hidden Dock stays
  // hidden: no hot-zone, hover or pin reveal. Only the edge badge's peek
  // brings it up — the keyboard then rides on top of it (KeyboardOverlay
  // CSS keys off data-show-bottom) and drops back when the peek ends.
  const kbs = kbState();
  const kbDocked = () => kbs.$open.get() && kbs.$mode.get() === 'docked';
  let badgePeeking = false;
  function setBarVisible(which: 'top' | 'bottom', visible: boolean) {
    if (!root) return;
    if (which === 'bottom' && visible && autohideEnabled && kbDocked() && !badgePeeking) visible = false;
    // Free (floating / attached) keyboard open: a hidden Dock stays hidden — just the
    // keyboard. The badge peek still brings it up; a Dock that is already up is left alone.
    if (which === 'bottom' && visible && autohideEnabled && kbs.$open.get() && !kbDocked() && !badgePeeking
        && root.dataset['showBottom'] !== 'true') visible = false;
    if (autohideEnabled && kept(which)) visible = true;
    root.dataset[which === 'top' ? 'showTop' : 'showBottom'] = visible ? 'true' : 'false';
  }
  function bumpReveal(which: 'top' | 'bottom') {
    setBarVisible(which, true);
    // Pinned bars never auto-hide. The pin is owned by the focus
    // listeners — when focus leaves the bar they call bumpReveal again
    // without the pin and the dwell timer is allowed to run.
    if (which === 'top' && (topPinned || extPins.top.size > 0 || barsPrefs.keepTop))       { if (topTimer)    { clearTimeout(topTimer);    topTimer    = null; } return; }
    if (which === 'bottom' && (bottomPinned || extPins.bottom.size > 0 || barsPrefs.keepBottom)) { if (bottomTimer) { clearTimeout(bottomTimer); bottomTimer = null; } return; }
    if (which === 'top') {
      if (topTimer) clearTimeout(topTimer);
      topTimer = setTimeout(() => setBarVisible('top', false), barsPrefs.hideDelayMs);
    } else {
      if (bottomTimer) clearTimeout(bottomTimer);
      bottomTimer = setTimeout(() => setBarVisible('bottom', false), barsPrefs.hideDelayMs);
    }
  }
  // Reveal delay: the pointer has to rest in the edge strip this long before a
  // hidden bar comes; leaving the strip first cancels it.
  let edgeWait: { which: 'top' | 'bottom'; timer: ReturnType<typeof setTimeout> } | null = null;
  const cancelEdgeWait = () => { if (edgeWait) { clearTimeout(edgeWait.timer); edgeWait = null; } };
  function onMouseMove(e: MouseEvent) {
    if (!autohideEnabled || !barsPrefs.edgeHover) return;
    // The edge badge can sit in a hot zone; hovering it must not pop a bar.
    if ((e.target as Element | null)?.closest?.('#bars-badge, .bars-seg')) { cancelEdgeWait(); return; }
    const h = window.innerHeight;
    const zone = barsPrefs.hotZonePx;
    const which = e.clientY <= zone ? 'top' : e.clientY >= h - zone ? 'bottom' : null;
    if (!which) { cancelEdgeWait(); return; }
    const shown = root?.dataset[which === 'top' ? 'showTop' : 'showBottom'] === 'true';
    if (shown || barsPrefs.revealDelayMs <= 0) { cancelEdgeWait(); bumpReveal(which); return; }
    if (edgeWait?.which === which) return;
    cancelEdgeWait();
    edgeWait = { which, timer: setTimeout(() => { edgeWait = null; if (autohideEnabled) bumpReveal(which); }, barsPrefs.revealDelayMs) };
  }
  // Floating panels that sit INSIDE a bar's DOM but not inside its strip
  // (the process manager is mounted in #dock). Hovering or focusing them is
  // not using the bar, so it must not reveal or pin it — they stay open on
  // their own while the bar hides.
  const DETACHED_PANELS = '#pm-panel';
  const inDetachedPanel = (t: EventTarget | null) =>
    !!(t as Element | null)?.closest?.(DETACHED_PANELS);
  // Hovering directly over a revealed bar keeps it open — re-bump on every
  // mousemove inside the bar's bounding box.
  function attachHoverPersist(barId: string, which: 'top' | 'bottom') {
    const bar = document.getElementById(barId);
    if (!bar) return;
    bar.addEventListener('mousemove', (e) => {
      if (autohideEnabled && !inDetachedPanel(e.target)) bumpReveal(which);
    });
    bar.addEventListener('mouseleave', () => {
      // Let the dwell timer fire normally; nothing to do here. (No special
      // mouseleave handling — the next time the cursor crosses a hot zone
      // the bar reappears.)
    });
  }
  attachHoverPersist('statusbar', 'top');
  attachHoverPersist('dock', 'bottom');

  // Keyboard-focus pin. Ctrl+Alt+Space lands focus on the dock launcher
  // button (see LauncherOverlay), and arrow keys move it between dock
  // and status-bar buttons. In autohide mode the bar would dwell-hide
  // even while the user is mid-navigation; pin the focused bar visible
  // until focus actually leaves it.
  function attachFocusPin(barId: string, which: 'top' | 'bottom') {
    const bar = document.getElementById(barId);
    if (!bar) return;
    bar.addEventListener('focusin', (e) => {
      if (inDetachedPanel(e.target)) return;
      if (which === 'top') topPinned = true; else bottomPinned = true;
      // Clear any pending hide timer immediately and force the bar visible.
      if (which === 'top'    && topTimer)    { clearTimeout(topTimer);    topTimer    = null; }
      if (which === 'bottom' && bottomTimer) { clearTimeout(bottomTimer); bottomTimer = null; }
      setBarVisible(which, true);
    });
    bar.addEventListener('focusout', (e) => {
      // Only unpin if focus moves to something OUTSIDE this bar — not
      // when the user just arrowed between two buttons of the same bar.
      if (inDetachedPanel(e.target)) return;   // never pinned (see focusin)
      const related = (e as FocusEvent).relatedTarget as Node | null;
      if (related && bar.contains(related) && !inDetachedPanel(related)) return;
      if (which === 'top') topPinned = false; else bottomPinned = false;
      // Resume the normal dwell-hide cadence from this moment — only if the
      // bar is still up. A bar already hidden (e.g. the badge peek ran out
      // while a dock button had focus) must not pop back on focus leaving.
      const shown = root?.dataset[which === 'top' ? 'showTop' : 'showBottom'] === 'true';
      if (autohideEnabled && shown) bumpReveal(which);
    });
  }
  attachFocusPin('statusbar', 'top');
  attachFocusPin('dock', 'bottom');

  // Edge badge: the touch-friendly way back to the bars (no hover on a
  // phone). A tap peeks both bars for barsPrefs.peekMs via an external pin and
  // pops the docked ✓ (badgeOk) — tapping that leaves auto-hide mode. Dragging slides it along
  // any edge (nearest edge wins, so it rounds corners); edge + position
  // (0..1) persist per device.
  type BadgeEdge = 'left' | 'right' | 'top' | 'bottom';
  const BADGE_EDGES: BadgeEdge[] = ['left', 'right', 'top', 'bottom'];
  const BADGE_HOLD_MS = 200;          // hold this long before the badge can be dragged
  const BADGE_SLOP_PX = 10;           // finger jitter allowed during the hold
  const BADGE_POS_KEY = 'aura.shell.bars-badge';
  const BADGE_PIN = 'bars-badge';
  const badge = document.getElementById('bars-badge') as HTMLButtonElement | null;
  const badgeOk = document.getElementById('bars-badge-ok') as HTMLButtonElement | null;
  const badgeKb = document.getElementById('bars-badge-kb') as HTMLButtonElement | null;
  let peekTimer: ReturnType<typeof setTimeout> | null = null;

  // ✓ goes on the badge's side opposite ⌨ when it fits there, else past ⌨.
  // Either way the badge itself stays put.
  function chooseOkPlace() {
    if (!badge || !badgeOk) return;
    const r = document.body.getBoundingClientRect();
    const br = badge.getBoundingClientRect();
    const vertical = badge.dataset['edge'] === 'left' || badge.dataset['edge'] === 'right';
    const scale = r.width / Math.max(1, document.body.offsetWidth);   // viewport zoom
    const okLen = (parseFloat(getComputedStyle(badgeOk).getPropertyValue('--ok-len')) || 36) * scale;
    const room = badge.dataset['okSide'] === 'after'
      ? (vertical ? br.top - r.top : br.left - r.left)        // ✓ before the badge
      : (vertical ? r.bottom - br.bottom : r.right - br.right); // ✓ after the badge
    badge.dataset['okPlace'] = room >= okLen ? 'opposite' : 'far';
  }
  function startBadgePeek() {
    if (peekTimer) clearTimeout(peekTimer);
    peekTimer = null;
    chooseOkPlace();
    badgePeeking = true;
    (window as any).auraPinBar('top', BADGE_PIN, true);
    (window as any).auraPinBar('bottom', BADGE_PIN, true);
    if (badge) badge.dataset['peek'] = 'true';
    // Tapped while a hold is already active (field focused, notifications
    // open): start paused.
    peekHolds.clear();
    if (fieldFocused()) peekHolds.add('field');
    if (notificationsOpen) peekHolds.add('notifications');
    if (peekHolds.size > 0) { peekPaused = true; if (badge) badge.dataset['peekPaused'] = 'true'; }
    else peekTimer = setTimeout(() => endBadgePeek(true), barsPrefs.peekMs);
  }
  // Using the top bar during a peek restarts it: a fresh barsPrefs.peekMs from
  // the last click/tap on any of its buttons (Enter/Space land here too).
  function restartBadgePeek() {
    if (!badgePeeking || peekPaused) return;
    if (peekTimer) clearTimeout(peekTimer);
    peekTimer = setTimeout(() => endBadgePeek(true), barsPrefs.peekMs);
    // Restart the countdown strip's CSS animation from full.
    const strip = badge?.querySelector<HTMLElement>('.bars-badge-timer');
    if (strip) { strip.style.animation = 'none'; void strip.offsetWidth; strip.style.animation = ''; }
  }
  const statusbarEl = document.getElementById('statusbar');
  statusbarEl?.addEventListener('click', (e) => {
    if ((e.target as Element | null)?.closest?.('button, [role="button"], a')) restartBadgePeek();
  }, true);
  // Peek holds: while any is active the peek doesn't count down (the strip
  // shows full); when the last one ends a fresh barsPrefs.peekMs starts.
  //   'field'         — a top-bar text field has focus (workspace name, the
  //                     context menu's slot / rename fields)
  //   'notifications' — the notification center is open
  const peekHolds = new Set<string>();
  let peekPaused = false;
  const TEXT_FIELD = 'input, textarea, [contenteditable=""], [contenteditable="true"]';
  const isTextField = (t: EventTarget | null) => !!(t as Element | null)?.closest?.(TEXT_FIELD);
  const fieldFocused = () => isTextField(document.activeElement) && !!statusbarEl?.contains(document.activeElement);
  let notificationsOpen = false;
  function setPeekHold(reason: string, on: boolean) {
    if (on) peekHolds.add(reason); else peekHolds.delete(reason);
    const paused = badgePeeking && peekHolds.size > 0;
    if (peekPaused === paused) return;
    peekPaused = paused;
    if (badge) badge.dataset['peekPaused'] = String(paused);
    if (paused) { if (peekTimer) { clearTimeout(peekTimer); peekTimer = null; } }
    else restartBadgePeek();
  }
  statusbarEl?.addEventListener('focusin', (e) => {
    if (isTextField(e.target)) setPeekHold('field', true);
  });
  statusbarEl?.addEventListener('focusout', (e) => {
    const next = (e as FocusEvent).relatedTarget as Element | null;
    if (next && statusbarEl.contains(next) && isTextField(next)) return;   // moved to another field
    setPeekHold('field', false);
  });
  document.addEventListener('aura:notifications.center', (e) => {
    notificationsOpen = !!(e as CustomEvent<{ open?: boolean }>).detail?.open;
    setPeekHold('notifications', notificationsOpen);
  });
  // hide=true (peek ran out): hide both bars NOW, whatever else holds them —
  // a focused dock button (launcher / process-manager toggles, and the
  // process manager itself lives inside #dock), hover, or another surface's
  // pin. Open panels are fixed-position and stay open; only the bars go.
  // The focus pins are dropped too, so the next reveal dwell-hides normally.
  // hide=false: just drop the pins (auto-hide is being turned off anyway).
  function endBadgePeek(hide: boolean) {
    if (peekTimer) { clearTimeout(peekTimer); peekTimer = null; }
    badgePeeking = false;
    peekPaused = false;
    peekHolds.clear();
    if (badge) badge.dataset['peekPaused'] = 'false';
    extPins.top.delete(BADGE_PIN);
    extPins.bottom.delete(BADGE_PIN);
    if (hide && autohideEnabled) {
      topPinned = false;
      bottomPinned = false;
      if (topTimer)    { clearTimeout(topTimer);    topTimer    = null; }
      if (bottomTimer) { clearTimeout(bottomTimer); bottomTimer = null; }
      setBarVisible('top', false);
      setBarVisible('bottom', false);
    }
    if (badge) badge.dataset['peek'] = 'false';
  }

  // The docked keyboard covers the bottom of the screen. The badge keeps its
  // spot and is lifted above the keyboard instead (data-kb-docked → CSS).
  function syncKbDocked() {
    const v = String(autohideEnabled && kbDocked());
    for (const el of [badge, badgeOk, badgeKb]) if (el) el.dataset['kbDocked'] = v;
  }
  {
    const onKb = () => {
      if (autohideEnabled && kbDocked() && !badgePeeking) setBarVisible('bottom', false);
      syncKbDocked();
    };
    kbs.$open.listen(onKb);
    kbs.$mode.listen(onKb);
  }

  function placeBadge(edge: BadgeEdge, pos: number) {
    if (!badge) return;
    badge.dataset['edge'] = edge;
    const p = String(Math.min(1, Math.max(0, pos)));
    badge.style.setProperty('--badge-pos', p);
    // The segments (⌨, ✓) dock via `.bars-badge ~ .bars-seg` off the same value.
    badgeOk?.style.setProperty('--badge-pos', p);
    badgeKb?.style.setProperty('--badge-pos', p);
    // Segments go on the side of the badge with more room along the edge.
    badge.dataset['okSide'] = Number(p) > 0.5 ? 'before' : 'after';
  }
  try {
    const saved = JSON.parse(localStorage.getItem(BADGE_POS_KEY) || 'null');
    if (saved && BADGE_EDGES.includes(saved.edge) && typeof saved.pos === 'number') {
      placeBadge(saved.edge, saved.pos);
    }
  } catch {}

  if (badge) {
    // Long-press to move: the press must be held BADGE_HOLD_MS (within
    // BADGE_SLOP_PX of where it started) before drag mode arms; moving
    // earlier cancels the press, so a quick tap or a swipe never moves it.
    let drag: { id: number; x0: number; y0: number; armed: boolean; cancelled: boolean } | null = null;
    let holdTimer: ReturnType<typeof setTimeout> | null = null;
    // A long-press/drag release is followed by a click — on the badge, or on
    // whatever is under the finger (⌨/✓ segment, a window) depending on the
    // browser's touch handling. Swallow that one click, wherever it lands.
    let swallowClickUntil = 0;
    window.addEventListener('click', (e) => {
      if (!swallowClickUntil) return;
      const live = performance.now() < swallowClickUntil;
      swallowClickUntil = 0;
      if (live) { e.preventDefault(); e.stopImmediatePropagation(); }
    }, true);
    const clearHold = () => { if (holdTimer) { clearTimeout(holdTimer); holdTimer = null; } };
    badge.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      clearHold();
      swallowClickUntil = 0;
      const d = { id: e.pointerId, x0: e.clientX, y0: e.clientY, armed: false, cancelled: false };
      drag = d;
      badge.setPointerCapture(e.pointerId);
      holdTimer = setTimeout(() => {
        holdTimer = null;
        if (drag !== d || d.cancelled) return;
        d.armed = true;
        badge.dataset['dragging'] = 'true';
        try { navigator.vibrate?.(15); } catch {}
      }, BADGE_HOLD_MS);
    });
    badge.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id || drag.cancelled) return;
      if (!drag.armed) {
        if (Math.hypot(e.clientX - drag.x0, e.clientY - drag.y0) > BADGE_SLOP_PX) {
          drag.cancelled = true;   // moved before the hold armed: not a tap, not a drag
          clearHold();
        }
        return;
      }
      // Body may be scaled/offset by the viewport zoom + margins; measure in
      // its (screen-space) rect so the badge tracks the finger exactly.
      const r = document.body.getBoundingClientRect();
      const br = badge.getBoundingClientRect();
      const len = Math.max(br.width, br.height);   // long side, either orientation
      const x = e.clientX - r.left, y = e.clientY - r.top;
      const dist: Record<BadgeEdge, number> = { left: x, right: r.width - x, top: y, bottom: r.height - y };
      const edge = BADGE_EDGES.reduce((a, b) => (dist[b] < dist[a] ? b : a));
      const pos = edge === 'left' || edge === 'right'
        ? (y - len / 2) / Math.max(1, r.height - len)
        : (x - len / 2) / Math.max(1, r.width - len);
      placeBadge(edge, pos);
    });
    const endDrag = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      clearHold();
      if (drag.armed || drag.cancelled) swallowClickUntil = performance.now() + 600;
      if (drag.armed) {
        badge.dataset['dragging'] = 'false';
        chooseOkPlace();   // a peek may still be running: re-dock ✓ at the new spot
        try {
          localStorage.setItem(BADGE_POS_KEY, JSON.stringify({
            edge: badge.dataset['edge'],
            pos: Number(badge.style.getPropertyValue('--badge-pos')) || 0,
          }));
        } catch {}
      }
      drag = null;
    };
    badge.addEventListener('pointerup', endDrag);
    badge.addEventListener('pointercancel', endDrag);
    // No long-press context menu / callout on touch.
    badge.addEventListener('contextmenu', (e) => e.preventDefault());
    badge.addEventListener('click', () => {
      if (!autohideEnabled) return;
      if (badgePeeking) endBadgePeek(true);   // tap while peeking: hide right away
      else startBadgePeek();
    });
  }
  badgeOk?.addEventListener('click', () => { if (autohideEnabled) applyAutohide(false); });
  // ⌨ segment: same toggle as the Dock's keyboard button. mousedown is
  // prevented so the tap never steals focus from the field being typed in.
  if (badgeKb) {
    const kb = kbState();
    badgeKb.addEventListener('mousedown', (e) => e.preventDefault());
    badgeKb.addEventListener('click', () => kb.$open.set(!kb.$open.get()));
    kb.$open.subscribe((open) => badgeKb.setAttribute('aria-expanded', String(open)));
  }

  function applyAutohide(next: boolean, persist = true) {
    autohideEnabled = next;
    syncKbDocked();
    if (root) root.dataset['autohideBars'] = next ? 'on' : 'off';
    if (autohideBtn) {
      autohideBtn.setAttribute('aria-pressed', next ? 'true' : 'false');
      autohideBtn.dataset['active'] = next ? 'on' : 'off';
    }
    if (next) {
      // Reveal both bars briefly so the toggle is visible feedback.
      bumpReveal('top');
      bumpReveal('bottom');
    } else {
      endBadgePeek(/*hide*/ false);
      setBarVisible('top', false);
      setBarVisible('bottom', false);
      if (topTimer)    { clearTimeout(topTimer);    topTimer    = null; }
      if (bottomTimer) { clearTimeout(bottomTimer); bottomTimer = null; }
    }
    if (persist) {
      try { localStorage.setItem(AUTOHIDE_KEY, next ? '1' : '0'); } catch {}
    }
    window.dispatchEvent(new CustomEvent(AUTOHIDE_EVENT, { detail: { on: next } }));
  }
  // Restore persisted preference.
  try {
    if (localStorage.getItem(AUTOHIDE_KEY) === '1') applyAutohide(true, /*persist*/ false);
  } catch {}
  autohideBtn?.addEventListener('click', () => applyAutohide(!autohideEnabled));
  document.addEventListener('mousemove', onMouseMove);
  (window as any).auraToggleAutohideBars = () => applyAutohide(!autohideEnabled);
  (window as any).auraSetAutohideBars = (on: boolean) => { if (!!on !== autohideEnabled) applyAutohide(!!on); };

  // MENU BARS prefs → <body> attributes for OSLayout's CSS (kept bars, badge,
  // countdown length), and live re-apply: a kept bar shows now, a bar that is
  // up restarts its dwell with the new delay.
  function applyBarsPrefs() {
    root.dataset['keepTop'] = String(barsPrefs.keepTop);
    root.dataset['keepBottom'] = String(barsPrefs.keepBottom);
    root.dataset['barsBadge'] = barsPrefs.showBadge ? 'on' : 'off';
    root.style.setProperty('--bars-peek', `${barsPrefs.peekMs}ms`);
    cancelEdgeWait();
    if (!autohideEnabled) return;
    for (const which of ['top', 'bottom'] as const) {
      const shown = root.dataset[which === 'top' ? 'showTop' : 'showBottom'] === 'true';
      if (kept(which) || shown) bumpReveal(which);
    }
  }
  applyBarsPrefs();
  onBarsPrefs((p) => { barsPrefs = p; applyBarsPrefs(); });

  // ---- Viewport (zoom + screen-edge margins) --------------------------
  // We can't drive the browser's real zoom from JS, so we fake it via
  //   body { transform: scale(Z); width: (100vw - mL - mR)/Z; height: ditto }
  // and offset body with top/left for the margins. transform creates a new
  // containing block for position:fixed children (LauncherOverlay,
  // ProcessManager), so they scale + offset with the body cleanly.
  //
  // The three zoom values + margins are NOT persisted here — they belong to
  // the active VIEWPORT PROFILE in device localStorage. This script owns only
  // the apply primitives (window.auraSet*); lib/viewportClient owns the
  // persistence, profile CRUD, and cross-tab sync. See the refresh/init call
  // after the globals below.
  const ZOOM_MIN  = 0.5;
  const ZOOM_MAX  = 4.0;
  const ZOOM_STEP = 0.1;
  const MARGIN_MAX = 400;

  type Margins = { top: number; right: number; bottom: number; left: number };

  const zoomOutBtn   = document.getElementById('zoom-out')   as HTMLButtonElement | null;
  const zoomInBtn    = document.getElementById('zoom-in')    as HTMLButtonElement | null;
  const zoomLevelBtn = document.getElementById('zoom-level') as HTMLButtonElement | null;

  let currentZoomValue: number = 1;   // M — main zoom (everything)
  let shellZoomValue:   number = 1;   // S — OS chrome multiplier
  let appZoomValue:     number = 1;   // A — app-content multiplier
  let margins: Margins = { top: 0, right: 0, bottom: 0, left: 0 };

  function clampZoom(z: number) {
    return Math.max(ZOOM_MIN, Math.min(ZOOM_MAX, Math.round(z * 100) / 100));
  }
  function clampMargin(v: number) {
    return Math.max(0, Math.min(MARGIN_MAX, Math.round(v)));
  }

  // The single source of truth for body sizing. Called whenever any of the
  // three zooms OR the margins change. When the body ends up at defaults, all
  // inline styles are stripped so it falls back to its CSS.
  //
  // Three composable zoom factors:
  //   • main  (M) — scales EVERYTHING (chrome + app content). The status-bar
  //                 −/＋ buttons drive this one.
  //   • shell (S) — extra multiplier on the OS chrome only (status bar, dock,
  //                 launcher, window frames + buttons, desktop spacing).
  //   • app   (A) — extra multiplier on app content (every iframe).
  //
  // We can only transform `body`, so the split is done with two scales:
  //   body is scaled by  M·S       → all chrome lands at M·S
  //   each app iframe is counter-scaled by  A/S  (via --aura-iframe-scale; the
  //   global rule in index.astro applies it) → net app content = M·S·(A/S) =
  //   M·A, independent of the shell zoom. All three default to 1, where this
  //   collapses to the original single-zoom behaviour.
  function applyViewport() {
    const body = document.body;
    const m = margins;
    const bodyScale   = currentZoomValue * shellZoomValue; // chrome + desktop
    const iframeScale = appZoomValue / shellZoomValue;     // → net app = M·A
    const marginsZero = m.top === 0 && m.right === 0 && m.bottom === 0 && m.left === 0;
    const bodyIsDefault = bodyScale === 1 && marginsZero;

    document.documentElement.style.setProperty('--aura-shell-zoom', String(bodyScale));
    document.documentElement.style.setProperty('--aura-iframe-scale', String(iframeScale));
    document.documentElement.style.background = bodyIsDefault ? '' : '#000';

    if (bodyIsDefault) {
      body.style.removeProperty('position');
      body.style.removeProperty('top');
      body.style.removeProperty('left');
      body.style.removeProperty('width');
      body.style.removeProperty('height');
      body.style.removeProperty('transform');
      body.style.removeProperty('transform-origin');
    } else {
      body.style.position        = 'fixed';
      body.style.top             = `${m.top}px`;
      body.style.left            = `${m.left}px`;
      body.style.width           = `calc((100vw - ${m.left + m.right}px) / ${bodyScale})`;
      body.style.height          = `calc((100vh - ${m.top + m.bottom}px) / ${bodyScale})`;
      body.style.transformOrigin = 'top left';
      body.style.transform       = `scale(${bodyScale})`;
    }

    // The status-bar % readout always reflects the MAIN zoom.
    if (zoomLevelBtn) zoomLevelBtn.textContent = `${Math.round(currentZoomValue * 100)}%`;

    // Tell app iframes the viewport scale changed. The body `transform:
    // scale()` above is paint-only, so a child's ResizeObserver never
    // fires — without this message an app (e.g. the terminal) keeps its
    // old character grid. The shared broadcaster reads the --aura-shell-zoom
    // / --aura-iframe-scale vars we just set above and measures each iframe's
    // box itself, so we only pass the reason.
    queueViewportBroadcast('zoom');

    // Zoom + margins change the bar's available LAYOUT width (body is scaled
    // and width-compensated by `bodyScale`), so the workspace switcher must
    // re-fit to the new space. The ResizeObserver on #statusbar also catches
    // this, but calling directly closes any RO-timing gap and makes the
    // dependency on the active viewport/zoom profile explicit.
    queueFit();
  }

  // Apply primitives — pure (no persistence). viewportClient calls these to
  // push the active profile onto the live shell; persistence to localStorage
  // is the client's job.
  function setZoom(z: number) {
    currentZoomValue = clampZoom(z);
    applyViewport();
  }
  function setShellZoom(z: number) {
    shellZoomValue = clampZoom(z);
    applyViewport();
  }
  function setAppZoom(z: number) {
    appZoomValue = clampZoom(z);
    applyViewport();
  }
  function setMargins(next: Partial<Margins>) {
    if (next.top    !== undefined) margins.top    = clampMargin(next.top);
    if (next.right  !== undefined) margins.right  = clampMargin(next.right);
    if (next.bottom !== undefined) margins.bottom = clampMargin(next.bottom);
    if (next.left   !== undefined) margins.left   = clampMargin(next.left);
    applyViewport();
  }

  (window as any).auraSetZoom      = setZoom;
  (window as any).auraSetShellZoom = setShellZoom;
  (window as any).auraSetAppZoom   = setAppZoom;
  (window as any).auraSetMargins   = setMargins;

  // The status-bar −/＋/% buttons edit the MAIN zoom of the ACTIVE profile.
  // They go through viewportClient so the change persists to localStorage and
  // echoes to every other tab via the `storage` event; viewportClient calls
  // back into the apply primitives above for the instant visual.
  zoomOutBtn?.addEventListener('click',   () => viewportClient.patchActive({ zoom: currentZoomValue - ZOOM_STEP }));
  zoomInBtn?.addEventListener('click',    () => viewportClient.patchActive({ zoom: currentZoomValue + ZOOM_STEP }));
  zoomLevelBtn?.addEventListener('click', () => viewportClient.patchActive({ zoom: 1 }));

  // Load viewport profiles from device localStorage, then apply the active
  // profile + wire the cross-tab `storage` sync. refresh() is synchronous
  // under the hood (just a localStorage read) but kept async for the dialog.
  void viewportClient.refresh().finally(() => viewportClient.init());

  // ---- Settings dialog -------------------------------------------------
  // The Viewport / settings dialog is a React island now (see
  // <ViewportSettingsDialog client:load /> above). We just dispatch a
  // custom event on the gear-button click; the React component listens for
  // 'aura.viewport.open' and flips its own open state. All form plumbing
  // (zoom + margins) flows through window.auraSetZoom / window.auraSetMargins
  // exposed above — the React side reads localStorage on each open to seed
  // its initial state.
  const settingsBtn = document.getElementById('settings-btn') as HTMLButtonElement | null;
  function openSettings()  { requestOpen('aura.viewport.open'); }
  settingsBtn?.addEventListener('click', openSettings);
  (window as any).auraOpenSettings = openSettings;
  claimEarlyClicks('viewport', openSettings);

  // ---- About dialog ----------------------------------------------------
  // The AURAOS logo opens the About panel (React island <AboutDialog/> above),
  // same event-dispatch pattern as the gear button. Keyboard-accessible since
  // the logo is role="button" tabindex="0".
  const aboutBtn = document.getElementById('os-about-btn');
  function openAbout() { requestOpen('aura.about.open'); }
  aboutBtn?.addEventListener('click', openAbout);
  aboutBtn?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openAbout(); }
  });
  claimEarlyClicks('about', openAbout);

  // ---- Workspace switcher ----------------------------------------------
  // Pill row + layout chip wired against workspaceClient (which the
  // desktop page also uses, so we share the same module-scoped cache).
  //
  // Click pill   → setActive(id)
  // Click [+]    → createWorkspace()
  // Click chip   → cycle the active workspace's layoutId across all
  //                strategies registered in @aura/core's LayoutStrategyRegistry.
  // Ctrl+1..9    → activate workspace #N (1-indexed)
  // Ctrl+Shift+N → create + activate a new workspace
  const pillsEl     = document.getElementById('ws-pills')        as HTMLElement       | null;
  const nameInput   = document.getElementById('ws-name-input')   as HTMLInputElement  | null;
  const layoutChip  = document.getElementById('ws-layout-chip')  as HTMLButtonElement | null;
  const bundleEl    = document.getElementById('ws-bundle')       as HTMLElement       | null;
  const popoverEl   = document.getElementById('ws-content')      as HTMLElement       | null;
  const collapseBtn = document.getElementById('ws-collapse-btn') as HTMLButtonElement | null;
  const foldPrevBtn = document.getElementById('ws-fold-prev') as HTMLButtonElement | null;
  const collapseNumEl = collapseBtn?.querySelector<HTMLElement>('.ws-collapse-num') ?? null;
  const foldNextBtn = document.getElementById('ws-fold-next') as HTMLButtonElement | null;
  const actionsEl   = document.getElementById('ws-pill-actions') as HTMLElement       | null;
  const dropRow1El  = document.getElementById('ws-drop-row1')    as HTMLElement       | null;
  const dropRow2El  = document.getElementById('ws-drop-row2')    as HTMLElement       | null;
  const statusBar   = document.getElementById('statusbar')       as HTMLElement       | null;
  const rightEl     = statusBar?.querySelector('.right')         as HTMLElement       | null;
  const osNameEl    = statusBar?.querySelector('.os-name')       as HTMLElement       | null;

  // Per-pill context menu (see the `#ws-ctx` markup above).
  const ctxEl        = document.getElementById('ws-ctx')               as HTMLElement       | null;
  const ctxTitleEl   = document.getElementById('ws-ctx-title')         as HTMLElement       | null;
  const ctxMovePanel = document.getElementById('ws-ctx-move-panel')    as HTMLElement       | null;
  const ctxRenPanel  = document.getElementById('ws-ctx-rename-panel')  as HTMLElement       | null;
  const ctxDelPanel  = document.getElementById('ws-ctx-delete-panel')  as HTMLElement       | null;
  const ctxSlotInput = document.getElementById('ws-ctx-slot')          as HTMLInputElement  | null;
  const ctxNameInput = document.getElementById('ws-ctx-name')          as HTMLInputElement  | null;
  const ctxDecBtn    = document.getElementById('ws-ctx-dec')           as HTMLButtonElement | null;
  const ctxIncBtn    = document.getElementById('ws-ctx-inc')           as HTMLButtonElement | null;
  const ctxDelBtn    = document.getElementById('ws-ctx-delete')        as HTMLButtonElement | null;

  // ── Responsive collapse ───────────────────────────────────────────────
  // The workspace switcher degrades gracefully as the bar narrows (narrow
  // viewport / heavy zoom / lots of workspaces):
  //
  // Controls degrade in PRIORITY order — the numbered pills + ‹/› arrows are
  // the controls we fight hardest to keep on screen:
  //
  //   1. `data-fold="chip"` — the lowest-priority control, the layout chip,
  //      folds into the dropdown FIRST, so dropping it (not a pill) is the
  //      first response to overflow and the number buttons keep their room;
  //   2. shrink the number of numbered pills shown inline, 4 → 3 → 2 → 1
  //      (the dynamic `pillWindow`; `‹/›` pagination keeps every workspace
  //      reachable as the window tightens);
  //   3. `data-fold="all"` — when even a SINGLE pill won't fit, the pills fold
  //      into the dropdown too (it now hosts pills + chip), but the name field
  //      stays beside the ▦ button so the active workspace name stays visible;
  //   4. shrink the AURAOS logo to its "A" (`data-logo-hidden` on #statusbar;
  //      it still opens About) — the workspace name matters more than branding;
  //   5. hide the clock (`data-clock-hidden`), also below the name;
  //   6. last resort, if button + name field still won't fit, drop the name
  //      field too (`data-name-hidden`) and show only the icon button.
  //
  // Overflow is measured in LAYOUT pixels, which is what makes this honest
  // about the active viewport/zoom profile:
  //
  //   • The shell fakes zoom with `body { transform: scale(bodyScale);
  //     width: calc((100vw − margins) / bodyScale) }`. `transform` is paint
  //     only — it does NOT change layout — but the width compensation DOES.
  //     So `#statusbar.clientWidth` is the bar's real layout width and already
  //     reflects zoom + margins (zoom IN → smaller layout width).
  //   • The pills/clock/chip are sized in fixed CSS px, so their `offsetWidth`
  //     stays constant in that same layout space.
  //   → zoom in shrinks the available width while the controls keep their px
  //     footprint, so they overflow and we shed pills. Exactly the ask.
  //
  // We compare the right-hand group's intrinsic width against the space left
  // after the OS name, instead of `#statusbar.scrollWidth`. A `space-between`
  // flex container does NOT reliably grow scrollWidth when an inner item's
  // fixed-width children overflow a shrunk box, so the old scrollWidth check
  // silently read "no overflow" under zoom. `.right` is pinned `flex-shrink: 0`
  // (see CSS), so `rightEl.offsetWidth` is its true intrinsic width here.
  const SAFETY_GAP_PX = 8;  // keep a little air between the OS name and the controls
  function rightOverflowing(): boolean {
    if (!statusBar || !rightEl) return false;
    const cs = getComputedStyle(statusBar);
    const padX = parseFloat(cs.paddingLeft || '0') + parseFloat(cs.paddingRight || '0');
    const available = statusBar.clientWidth - padX - (osNameEl?.offsetWidth ?? 0) - SAFETY_GAP_PX;
    return rightEl.offsetWidth > available;
  }

  // Coalesce refits to one per frame — ResizeObserver fires in bursts during a
  // drag, and each refit re-renders the pill row a few times.
  let fitQueued = false;
  function queueFit() {
    if (fitQueued) return;
    fitQueued = true;
    requestAnimationFrame(() => { fitQueued = false; fitWorkspaceUI(); });
  }
  if (statusBar && typeof ResizeObserver !== 'undefined') {
    new ResizeObserver(queueFit).observe(statusBar);
  }

  // Place the workspace dropdown horizontally centered in the viewport,
  // vertically pinned just below the trigger button.
  function pickAnchor() {
    if (!bundleEl) return;
    // The dropdown (only shown once something has folded) always centers
    // horizontally in the viewport — the ▦ trigger sits in different places
    // on the bar depending on layout/screen size, and the center placement is
    // predictable for the user regardless.
    // Vertical stays pinned just below the trigger via `--ws-popover-top`.
    const rect = bundleEl.getBoundingClientRect();
    bundleEl.style.setProperty('--ws-popover-top', `${rect.bottom + 6}px`);
    bundleEl.dataset['anchor'] = 'center';
  }

  // Collapse-button toggle. Once anything has folded (data-fold ≠ none) the
  // ▦ trigger is shown; clicking it flips [data-open], which reveals the
  // dropdown host `.ws-content` (with its folded controls) as an absolute-
  // positioned popover. The click-outside listener below dismisses it on any
  // click outside the bundle (including selecting a workspace from inside).
  collapseBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!bundleEl) return;
    const next = bundleEl.dataset['open'] !== 'true';
    if (next) pickAnchor();   // re-measure on every open so a resize between
                              // toggles still picks the right side
    bundleEl.dataset['open'] = String(next);
    collapseBtn.setAttribute('aria-expanded', String(next));
    if (next) arrangeDropdown();
  });
  // Window drag & drop (lib/windowDrag.ts): dropping a window on a numbered
  // pill moves it to that workspace. Pills are re-rendered constantly, so the
  // target resolves by `data-ws-id` from the element under the pointer.
  registerDropTarget({
    id: 'workspace-pill',
    resolve(el, src) {
      const pill = el.closest<HTMLElement>('.ws-pill[data-ws-id]');
      const wsId = pill?.dataset['wsId'];
      if (!pill || !wsId) return null;
      if (workspaceClient.findOwner(src.viewId)?.id === wsId) return null;
      return { el: pill, data: wsId };
    },
    drop(src, data) {
      return workspaceClient.addMemberToWorkspace(data as string, src.viewId);
    },
  });
  // Folded bar (small screens): the pills live in the dropdown, so it opens
  // as soon as a window drag starts — the pills are drop targets for the whole
  // drag — and closes when the drag ends (dropped or cancelled).
  window.addEventListener(WINDOW_DRAG_EVENT, (e) => {
    if (!bundleEl) return;
    const active = (e as CustomEvent<{ active: boolean }>).detail?.active === true;
    if (active) {
      if (bundleEl.dataset['fold'] !== 'all') return;
      pickAnchor();
      bundleEl.dataset['open'] = 'true';
      collapseBtn?.setAttribute('aria-expanded', 'true');
      arrangeDropdown();
    } else if (bundleEl.dataset['open'] === 'true') {
      bundleEl.dataset['open'] = 'false';
      collapseBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  // Re-pick anchor if the viewport changes while the popover is open
  // (responsive resize, zoom changes, etc.).
  window.addEventListener('resize', () => {
    if (bundleEl?.dataset['open'] === 'true') { pickAnchor(); arrangeDropdown(); }
  });
  // Close-on-outside-click. `composedPath()` is captured at dispatch time
  // so it survives DOM mutations during the click handler chain. We need
  // that because pill-click → setActive → renderPills replaces the pill's
  // HTML synchronously; by the time this document-level handler runs,
  // `e.target` (the original pill button) is no longer in the DOM, and
  // `bundleEl.contains(target)` would return false → mistakenly close the
  // popover. composedPath().includes(bundleEl) tests the original path.
  document.addEventListener('click', (e) => {
    if (!bundleEl || bundleEl.dataset['open'] !== 'true') return;
    const path = typeof e.composedPath === 'function' ? e.composedPath() : [];
    if (path.includes(bundleEl)) return;
    // Fallback for older browsers without composedPath: do the cheap check.
    if (path.length === 0 && bundleEl.contains(e.target as Node)) return;
    bundleEl.dataset['open'] = 'false';
    collapseBtn?.setAttribute('aria-expanded', 'false');
  });

  // Ordered list of registered strategy ids. Falls back to the v1 seeded
  // set if the inventory endpoint isn't reachable (e.g. Settings down).
  // Fallback for when /api/os/layouts hasn't answered yet. Icon names are
  // Lucide ids from the OS sprite — matches what the endpoint resolves them to
  // (packages/shell/src/pages/api/os/layouts.ts GLYPH_TO_LUCIDE).
  let availableLayouts: Array<{ id: string; name: string; icon?: string }> =
    [{ id: 'tiling', name: 'Tiling', icon: 'layout-grid' },
     { id: 'fullscreen', name: 'Fullscreen', icon: 'square' },
     { id: 'stack', name: 'Free Window', icon: 'layout-template' }];
  // Retry on the boot-race 404: Settings autoStarts in parallel with the
  // shell's first paint, so this fetch can land before the providers are
  // registered. Five short tries cover the ~3s cold-start window.
  (async () => {
    for (let i = 0; i < 5; i++) {
      try {
        const r = await fetch('/api/os/layouts');
        if (r.ok) {
          const list = await r.json() as typeof availableLayouts;
          if (Array.isArray(list) && list.length > 0) {
            availableLayouts = list;
            const cached = workspaceClient.getCached();
            if (cached) renderLayoutChip(cached);  // pick up the icon list once it arrives
          }
          return;
        }
        if (r.status !== 404) return;
      } catch { return; }
      await new Promise((r) => setTimeout(r, 400));
    }
  })();

  // Pagination: show at most `pillWindow` numbered pills at once. When the
  // user has more workspaces than fit, render `< >` arrows that step the
  // selection one workspace at a time. The window auto-shifts so whichever
  // pill is currently "selected" stays visible.
  //
  // `pillWindow` is dynamic: it starts at MAX and `fitWorkspaceUI()` shrinks it
  // toward MIN (1) as the bar runs out of room, so the switcher reduces the
  // number of workspaces shown instead of overflowing the bar.
  const MAX_PILL_WINDOW = 4;   // most numbered pills shown inline at full width
  const MIN_PILL_WINDOW = 1;   // last resort before collapsing into the dropdown
  let pillWindow = MAX_PILL_WINDOW;
  let pillOffset = 0;

  // Debounced step: `<` / `>` clicks update the visually-selected pill
  // immediately so the user gets instant feedback, but defer the real
  // setActive() call by SCRUB_DELAY_MS. Tapping the chevrons several times
  // in a row only swaps the layout once (to the final destination). A
  // number-pill or `+` click cancels any pending step and fires instantly.
  const SCRUB_DELAY_MS = 300;
  let pendingActiveId: string | null = null;
  let pendingTimer: ReturnType<typeof setTimeout> | null = null;

  function clearPending() {
    if (pendingTimer) { clearTimeout(pendingTimer); pendingTimer = null; }
    pendingActiveId = null;
  }

  function scheduleScrubCommit() {
    if (pendingTimer) clearTimeout(pendingTimer);
    pendingTimer = setTimeout(() => {
      const target = pendingActiveId;
      pendingActiveId = null;
      pendingTimer = null;
      if (target) {
        workspaceClient.setActive(target).catch((err) => console.warn('[StatusBar] setActive failed', err));
      }
    }, SCRUB_DELAY_MS);
  }

  function clampOffset(total: number): number {
    const max = Math.max(0, total - pillWindow);
    return Math.min(Math.max(0, pillOffset), max);
  }

  // The pill-row chevrons are inlined (like COMPACT_ICON below):
  // an external `<use href="/api/os/icons.svg#…">` stays blank until the sprite
  // has loaded, and at desktop boot that request queues behind the proxied app
  // windows and event streams (HTTP/1.1, ~6 connections) — the arrows showed up
  // seconds after the numbered pills.
  const svgIcon = (paths: string) => `<svg class="aura-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
  const CHEVRON_LEFT_ICON  = svgIcon('<path d="m15 18-6-6 6-6"/>');
  const CHEVRON_RIGHT_ICON = svgIcon('<path d="m9 18 6-6-6-6"/>');

  // Lucide `fold-horizontal`, inlined: it is not in the curated sprite (which
  // comes from @aura/core's built dist), and inlining keeps currentColor.
  const COMPACT_ICON = '<svg class="aura-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h6"/><path d="M22 12h-6"/><path d="M12 2v2"/><path d="M12 8v2"/><path d="M12 14v2"/><path d="M12 20v2"/><path d="m19 9-3 3 3 3"/><path d="m5 15 3-3-3-3"/></svg>';

  function renderPills(state: workspaceClient.WorkspaceState) {
    if (!pillsEl) return;
    const total = state.workspaces.length;
    const paginated = total > pillWindow;

    // Effective active = the pending scrub target (if any), else the
    // committed active. Both highlighting and window auto-shift use this so
    // the user sees their click reflected even before the debounced commit
    // fires.
    const effectiveActiveId = pendingActiveId ?? state.activeWorkspaceId;
    const activeIdx = state.workspaces.findIndex((w) => w.id === effectiveActiveId);
    if (paginated && activeIdx >= 0) {
      if (activeIdx < pillOffset) pillOffset = activeIdx;
      else if (activeIdx >= pillOffset + pillWindow) pillOffset = activeIdx - pillWindow + 1;
    }
    pillOffset = clampOffset(total);

    const start = paginated ? pillOffset : 0;
    const end   = paginated ? Math.min(total, pillOffset + pillWindow) : total;

    // Disable chevrons when at the absolute first / last workspace.
    const atFirst = activeIdx <= 0;
    const atLast  = activeIdx === -1 || activeIdx >= total - 1;
    const prev = paginated
      ? `<button class="ws-pill ws-pill-nav" data-ws-action="prev" ${atFirst ? 'disabled' : ''} title="Previous workspace">${CHEVRON_LEFT_ICON}</button>`
      : '';
    const next = paginated
      ? `<button class="ws-pill ws-pill-nav" data-ws-action="next" ${atLast ? 'disabled' : ''} title="Next workspace">${CHEVRON_RIGHT_ICON}</button>`
      : '';

    const numbered = state.workspaces.slice(start, end).map((w, i) => {
      const slot = start + i + 1;
      const active = w.id === effectiveActiveId;
      const pending = pendingActiveId === w.id;
      return `<button class="ws-pill" data-ws-id="${w.id}" data-active="${active}" ${pending ? 'data-pending="true"' : ''} title="${escapeAttr(w.name)} (${w.members.length} window${w.members.length === 1 ? '' : 's'})">${slot}</button>`;
    }).join('');

    // Compact: drop empty workspaces + renumber default `WS <n>` names.
    // Disabled when it would change nothing.
    const compact = `<button class="ws-pill ws-pill-compact" data-ws-action="compact" ${workspaceClient.canCompact(state) ? '' : 'disabled'} title="Compact workspaces (remove empty ones, renumber WS names)">${COMPACT_ICON}</button>`;
    const add = `<button class="ws-pill ws-pill-add" data-ws-action="new" title="New workspace (Ctrl+Shift+N)">+</button>`;
    pillsEl.innerHTML = prev + numbered + next;
    // Fully folded, the ▦ button shows the (pending or committed) active number.
    if (collapseNumEl) collapseNumEl.textContent = activeIdx >= 0 ? String(activeIdx + 1) : '–';
    // The folded-bar arrows step through ALL workspaces (no window there).
    if (foldPrevBtn) foldPrevBtn.disabled = total < 2 || activeIdx <= 0;
    if (foldNextBtn) foldNextBtn.disabled = total < 2 || activeIdx === -1 || activeIdx >= total - 1;
    if (actionsEl) actionsEl.innerHTML = compact + add;
    arrangeDropdown();   // pill count may have changed the row width
  }

  // Relocate the pills + layout chip between their inline home (as direct
  // children of `.ws-bundle`, after the name field + ▦ button) and the dropdown
  // popover host (`#ws-content`), per the requested fold level. The inline
  // reading order is name → ▦ → pills → chip, and `#ws-content` is the LAST
  // child of the bundle, so relocating a node inline = `insertBefore(node,
  // popoverEl)` (drops it just before the popover host, after ▦). `insertBefore`
  // MOVES an existing node, so these calls are idempotent and the controls keep
  // their event listeners (delegation on `#ws-pills`, click on the chip).
  //
  //   'none' → pills + chip inline (name, then pills, then chip)
  //   'chip' → chip in the dropdown; name + pills still inline
  //   'all'  → pills + chip both in the dropdown (pills first); name inline
  function setFold(fold: 'none' | 'chip' | 'all'): void {
    if (!bundleEl || !popoverEl) return;
    bundleEl.dataset['fold'] = fold;
    if (fold === 'none') {
      // Inline, in order: pills, compact/+, chip (all before the popover host).
      if (pillsEl)    bundleEl.insertBefore(pillsEl, popoverEl);
      if (actionsEl)  bundleEl.insertBefore(actionsEl, popoverEl);
      if (layoutChip) bundleEl.insertBefore(layoutChip, popoverEl);
    } else if (fold === 'chip') {
      if (pillsEl)    bundleEl.insertBefore(pillsEl, popoverEl);
      if (actionsEl)  bundleEl.insertBefore(actionsEl, popoverEl);
      if (layoutChip) dropRow2El?.appendChild(layoutChip);
    } else {
      // 'all' — pills on row 1, chip on row 2; arrangeDropdown() places
      // compact/+ on whichever row they fit.
      if (pillsEl)    dropRow1El?.appendChild(pillsEl);
      if (layoutChip) dropRow2El?.appendChild(layoutChip);
      arrangeDropdown();
    }
  }

  // Folded dropdown ('all'): compact + "+" go on the pill row when it has the
  // room, else onto row 2 after the layout chip. Only measurable while the
  // dropdown is shown, so it re-runs on open, on resize and after renderPills.
  function arrangeDropdown(): void {
    if (!bundleEl || !actionsEl || !dropRow1El || !dropRow2El) return;
    if (bundleEl.dataset['fold'] !== 'all') return;
    dropRow1El.appendChild(actionsEl);
    if (bundleEl.dataset['open'] !== 'true') return;
    // Measure the unwrapped row 1 against the popover's capped width.
    bundleEl.dataset['dropMeasure'] = 'true';
    const overflows = dropRow1El.scrollWidth > dropRow1El.clientWidth + 1;
    delete bundleEl.dataset['dropMeasure'];
    if (overflows) dropRow2El.appendChild(actionsEl);
  }

  // Size the workspace switcher to the available bar width, degrading in
  // priority order (see the "Responsive collapse" note above): drop the layout
  // chip first, then shrink the numbered pills MAX → MIN, then fold the pills
  // into the dropdown too (name stays beside the button), and only as a last
  // resort drop the name field. Safe to call on every resize and state change.
  //
  // Every path through the fit re-runs `renderPills()`, which replaces the pill
  // DOM wholesale — so an open context menu has to be re-anchored (or closed,
  // if its pill scrolled out of the window) afterwards. The wrapper guarantees
  // that happens on all three exits of the tier cascade below.
  function fitWorkspaceUI(): void {
    fitWorkspaceUITiers();
    reanchorCtxMenu();
  }

  function fitWorkspaceUITiers(): void {
    if (!statusBar || !bundleEl) return;
    const state = workspaceClient.getCached();

    // Tier 0: everything inline at full pill count. Overflow is measured in
    // LAYOUT pixels (the popover is out of flow and never "overflows").
    setFold('none');
    bundleEl.dataset['nameHidden'] = 'false';
    statusBar.dataset['logoHidden'] = 'false';
    statusBar.dataset['clockHidden'] = 'false';
    pillWindow = MAX_PILL_WINDOW;
    if (state) renderPills(state);
    if (!rightOverflowing()) {
      bundleEl.dataset['open'] = 'false';
      collapseBtn?.setAttribute('aria-expanded', 'false');
      return;
    }

    // Tier 1: fold the chip into the dropdown FIRST (lowest priority), so the
    // number buttons keep their room, then shrink the pills one at a time.
    setFold('chip');
    pillWindow = MAX_PILL_WINDOW;
    if (state) renderPills(state);
    while (pillWindow > MIN_PILL_WINDOW && rightOverflowing()) {
      pillWindow -= 1;
      if (state) renderPills(state);
    }
    if (!rightOverflowing()) {
      bundleEl.dataset['open'] = 'false';
      collapseBtn?.setAttribute('aria-expanded', 'false');
      return;
    }

    // Tier 2: even a single pill won't fit → fold the pills into the dropdown
    // too (it now hosts pills + chip). Keep the name field beside the ▦ button.
    // The popover has its own width, so restore the full window for it.
    setFold('all');
    pillWindow = MAX_PILL_WINDOW;
    if (state) renderPills(state);

    // Tier 3: the workspace name outranks branding — shrink the AURAOS logo
    // to its "A" before touching the name field. rightOverflowing() reads the
    // logo's offsetWidth, which then is just the "A", so the freed space counts.
    if (!rightOverflowing()) return;
    statusBar.dataset['logoHidden'] = 'true';

    // Tier 4: the clock is also less important than the workspace name.
    if (!rightOverflowing()) return;
    statusBar.dataset['clockHidden'] = 'true';

    // Tier 5 (last resort): if button + name field still overflow (very narrow
    // bar / heavy zoom), drop the name field too and show just the ▦ button.
    bundleEl.dataset['nameHidden'] = rightOverflowing() ? 'true' : 'false';
  }

  // The `icon` field from /api/os/layouts is a Lucide id — resolved once by
  // the endpoint (packages/shell/src/pages/api/os/layouts.ts) so every
  // consumer (this chip, Settings → Workspaces, Settings → Layouts) renders
  // the same glyph for a strategy. Guarded against odd names with a strict
  // kebab-case allowlist so a bogus `icon` can't inject HTML.
  function layoutIconSvg(name: string): string {
    const safe = /^[a-z0-9-]+$/.test(name) ? name : 'layout-template';
    return `<svg class="aura-icon" aria-hidden="true"><use href="/api/os/icons.svg#lucide-${safe}"/></svg>`;
  }

  function renderLayoutChip(state: workspaceClient.WorkspaceState) {
    if (!layoutChip) return;
    const iconEl = layoutChip.querySelector<HTMLElement>('.layout-chip-icon');
    const nameEl = layoutChip.querySelector<HTMLElement>('.layout-chip-name');
    const active = state.workspaces.find((w) => w.id === state.activeWorkspaceId);
    if (!active) {
      if (iconEl) iconEl.innerHTML = layoutIconSvg('layout-grid');
      if (nameEl) nameEl.textContent = '—';
      return;
    }
    const meta = availableLayouts.find((m) => m.id === active.layoutId);
    const icon = meta?.icon ?? 'layout-grid';
    const name = (meta?.name ?? active.layoutId).split('/')[0]!.trim().toUpperCase();
    if (iconEl) iconEl.innerHTML = layoutIconSvg(icon);
    if (nameEl) nameEl.textContent = name;
    layoutChip.title = `Layout: ${meta?.name ?? active.layoutId} — click to cycle`;
  }

  // The active workspace's name lives in an editable field beside the pills.
  // `renderNameField` keeps it in sync with the workspace state, but must NOT
  // clobber the user's in-progress edit — so it skips re-writing the value
  // while the field is focused AND still bound to the same workspace. If the
  // active workspace changed underneath the cursor (e.g. a Ctrl+Digit switch
  // fired while typing), we re-sync to the newly-active workspace's name.
  let nameFieldBoundId: string | null = null;
  function renderNameField(state: workspaceClient.WorkspaceState) {
    if (!nameInput) return;
    const active = state.workspaces.find((w) => w.id === state.activeWorkspaceId);
    const activeId = active?.id ?? null;
    if (document.activeElement === nameInput && activeId === nameFieldBoundId) return;
    nameFieldBoundId = activeId;
    nameInput.value = active?.name ?? '';
    nameInput.disabled = !active;
  }

  // Live rename. Each keystroke patches the active workspace's name through
  // the debounced writer (optimistic local update + coalesced PUT), so the
  // pills' tooltips and the Settings page track the edit without a reload.
  // Empty input is allowed mid-edit but never persisted — blur restores the
  // stored name if the field was left blank.
  nameInput?.addEventListener('input', () => {
    const state = workspaceClient.getCached();
    if (!state) return;
    const name = nameInput.value;
    if (name.trim().length === 0) return;
    workspaceClient.patchWorkspaceDebounced(state.activeWorkspaceId, { name });
  });
  nameInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      nameInput.blur();
    } else if (e.key === 'Escape') {
      e.preventDefault();
      const active = workspaceClient.getCached()?.workspaces
        .find((w) => w.id === nameFieldBoundId);
      nameInput.value = active?.name ?? '';
      nameInput.blur();
    }
  });
  // Finalize on blur: trim the value (restoring the stored name if the user
  // left it blank), then push the final value through the debounced writer so
  // it both supersedes any pending mid-edit patch and persists the trimmed
  // result.
  nameInput?.addEventListener('blur', () => {
    const state = workspaceClient.getCached();
    if (!state) return;
    const active = state.workspaces.find((w) => w.id === state.activeWorkspaceId);
    if (!active) return;
    const trimmed = nameInput.value.trim();
    const finalName = trimmed.length > 0 ? trimmed : active.name;
    nameInput.value = finalName;
    if (finalName !== active.name) {
      workspaceClient.patchWorkspaceDebounced(active.id, { name: finalName });
    }
  });

  function escapeAttr(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }

  // Hydrate from the SSR JSON if the desktop already injected it; otherwise
  // pull straight from the provider. Either way the singleton ends up
  // populated and the subscriber below fires.
  (async () => {
    try {
      const node = document.getElementById('aura-initial-workspaces');
      if (node?.textContent) {
        workspaceClient.hydrate(JSON.parse(node.textContent) as workspaceClient.WorkspaceState);
      } else if (!workspaceClient.getCached()) {
        await workspaceClient.refresh();
      }
    } catch (err) {
      console.warn('[StatusBar] failed to hydrate workspace state', err);
    }
  })();

  workspaceClient.subscribe((state) => {
    // Render the fixed-width neighbours (name field + layout chip) first so the
    // pill fit measures against their final widths, then fit/render the pills.
    renderNameField(state);
    renderLayoutChip(state);
    fitWorkspaceUI();
  });

  const onPillClick = (e: MouseEvent) => {
    // A long-press already opened the context menu for this pill; the click
    // that follows pointerup must not also switch workspace. stopPropagation
    // additionally keeps the document-level dismiss handlers from closing the
    // menu we just opened (and from collapsing the ▦ dropdown around it).
    if (suppressNextPillClick) {
      suppressNextPillClick = false;
      e.stopPropagation();
      return;
    }
    const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-ws-id], [data-ws-action]');
    if (!btn || btn.disabled) return;
    const action = btn.dataset['wsAction'];

    // `+` create — cancel any pending scrub commit, then fire.
    if (action === 'new') {
      clearPending();
      workspaceClient.createWorkspace().catch((err) => console.warn('[StatusBar] createWorkspace failed', err));
      return;
    }

    // Compact — cancel any pending scrub (its target may be removed), then fire.
    if (action === 'compact') {
      clearPending();
      workspaceClient.compactWorkspaces().catch((err) => console.warn('[StatusBar] compactWorkspaces failed', err));
      return;
    }

    // `‹` / `›` — step the SELECTED workspace by one. Highlight flips
    // immediately; the actual setActive() call is debounced by
    // SCRUB_DELAY_MS so rapid taps only commit the final destination.
    if (action === 'prev' || action === 'next') {
      const state = workspaceClient.getCached();
      if (!state) return;
      const total = state.workspaces.length;
      if (total === 0) return;
      const currentId = pendingActiveId ?? state.activeWorkspaceId;
      const currentIdx = state.workspaces.findIndex((w) => w.id === currentId);
      if (currentIdx < 0) return;
      const nextIdx = action === 'prev'
        ? Math.max(0, currentIdx - 1)
        : Math.min(total - 1, currentIdx + 1);
      if (nextIdx === currentIdx) return; // already at the end
      pendingActiveId = state.workspaces[nextIdx]!.id;
      scheduleScrubCommit();
      renderPills(state);
      return;
    }

    // Number-pill click — instant. Cancel any pending scrub first.
    const id = btn.dataset['wsId'];
    if (id) {
      clearPending();
      workspaceClient.setActive(id).catch((err) => console.warn('[StatusBar] setActive failed', err));
    }
  };
  pillsEl?.addEventListener('click', onPillClick);
  actionsEl?.addEventListener('click', onPillClick);
  foldPrevBtn?.addEventListener('click', onPillClick);
  foldNextBtn?.addEventListener('click', onPillClick);

  // ---- Per-pill context menu ------------------------------------------
  // Right-click or long-press a numbered pill → a menu with Move / Rename /
  // Delete. Each row is a disclosure that expands a panel in place; only one
  // panel is open at a time.
  //
  // Move is the interesting one: a bounded `‹ N ›  OK` stepper pre-filled with
  // the pill's current slot. Committing splices the workspace to that position
  // (see workspaceClient.moveWorkspace) — everything from the target slot
  // onwards shifts up one. `activeWorkspaceId` is untouched, so the workspace
  // you're on stays the one you're on; it just renumbers.
  //
  // We track the target by ID only, never by element: `renderPills()` replaces
  // the entire pill row on every state change, so any element reference we
  // held would be stale within a frame.
  let ctxWsId: string | null = null;
  let ctxPanel: 'move' | 'rename' | 'delete' | null = null;
  const LONGPRESS_MS = 500;
  const LONGPRESS_SLOP_PX = 8;

  function clamp(n: number, lo: number, hi: number): number {
    return Math.min(Math.max(n, lo), hi);
  }
  /** Total workspaces = the highest selectable slot (there is no configured max). */
  function ctxTotal(): number {
    return workspaceClient.getCached()?.workspaces.length ?? 0;
  }
  /** 1-based slot of the workspace the menu is bound to, or 0 if it's gone. */
  function ctxSlot(): number {
    const state = workspaceClient.getCached();
    if (!state || !ctxWsId) return 0;
    return state.workspaces.findIndex((w) => w.id === ctxWsId) + 1;
  }
  function ctxPill(): HTMLElement | null {
    if (!pillsEl || !ctxWsId) return null;
    return pillsEl.querySelector<HTMLElement>(`.ws-pill[data-ws-id="${CSS.escape(ctxWsId)}"]`);
  }

  /** Expand one disclosure panel (or none) and sync the rows' aria-expanded. */
  function openCtxPanel(which: 'move' | 'rename' | 'delete' | null): void {
    if (!ctxEl) return;
    ctxPanel = which;
    if (ctxMovePanel) ctxMovePanel.hidden = which !== 'move';
    if (ctxRenPanel)  ctxRenPanel.hidden  = which !== 'rename';
    if (ctxDelPanel)  ctxDelPanel.hidden  = which !== 'delete';
    ctxEl.querySelectorAll<HTMLElement>('.ws-ctx-item[aria-haspopup]').forEach((row) => {
      row.setAttribute('aria-expanded', String(row.dataset['wsCtx'] === which));
    });
    if (which === 'move' && ctxSlotInput) {
      ctxSlotInput.value = String(ctxSlot());
      syncStepBounds();
      ctxSlotInput.focus();
      ctxSlotInput.select();
    }
    if (which === 'rename' && ctxNameInput) {
      const state = workspaceClient.getCached();
      ctxNameInput.value = state?.workspaces.find((w) => w.id === ctxWsId)?.name ?? '';
      ctxNameInput.focus();
      ctxNameInput.select();
    }
    // Panels change the menu's height/width — re-run the overflow correction.
    positionCtxMenu();
  }

  /** Disable ‹ at slot 1 and › at the last slot. */
  function syncStepBounds(): void {
    const n = Number(ctxSlotInput?.value);
    if (ctxDecBtn) ctxDecBtn.disabled = !Number.isFinite(n) || n <= 1;
    if (ctxIncBtn) ctxIncBtn.disabled = !Number.isFinite(n) || n >= ctxTotal();
  }

  /**
   * Anchor the menu under its pill.
   *
   * `#ws-pills` is relocated between the bundle (inline) and `#ws-content`
   * (the ▦ dropdown) by setFold(), so the menu has to follow it — both hosts
   * are positioned elements, and `.ws-pills` itself is not, which makes
   * `pill.offsetParent` the host in either mode.
   *
   * Offsets, not client rects: the shell zooms via `body { transform: scale() }`,
   * which scales getBoundingClientRect() output but leaves CSS `left`/`top` in
   * unscaled layout px. Mixing the two would misplace the menu at any zoom
   * other than 100%.
   */
  function positionCtxMenu(): boolean {
    if (!ctxEl || !pillsEl) return false;
    const pill = ctxPill();
    const host = pillsEl.parentElement;
    if (!pill || !host) return false;
    if (ctxEl.parentElement !== host) host.appendChild(ctxEl);

    const left = pill.offsetLeft;
    ctxEl.style.left = `${left}px`;
    ctxEl.style.top  = `${pill.offsetTop + pill.offsetHeight + 4}px`;

    // Nudge back inside the viewport if the menu hangs off the right edge.
    // The overflow is measured in client px, so divide by the current body
    // scale to convert it into the layout px that `left` speaks.
    const rect = ctxEl.getBoundingClientRect();
    const overflow = rect.right - (window.innerWidth - 6);
    if (overflow > 0) {
      const scale = ctxEl.offsetWidth > 0 ? rect.width / ctxEl.offsetWidth : 1;
      ctxEl.style.left = `${left - overflow / (scale || 1)}px`;
    }
    return true;
  }

  function openCtxMenu(wsId: string): void {
    if (!ctxEl) return;
    const state = workspaceClient.getCached();
    const ws = state?.workspaces.find((w) => w.id === wsId);
    if (!state || !ws) return;
    ctxWsId = wsId;
    if (ctxTitleEl) ctxTitleEl.textContent = `${ws.name} · Slot ${ctxSlot()}`;
    // deleteWorkspace() refuses to remove the last workspace — reflect that in
    // the UI rather than letting the user confirm a no-op.
    if (ctxDelBtn) ctxDelBtn.disabled = state.workspaces.length <= 1;
    ctxEl.hidden = false;
    openCtxPanel(null);
    if (!positionCtxMenu()) closeCtxMenu();
  }

  function closeCtxMenu(refocusPill = false): void {
    if (!ctxEl || ctxEl.hidden) return;
    const pill = refocusPill ? ctxPill() : null;
    ctxEl.hidden = true;
    openCtxPanel(null);
    ctxWsId = null;
    pill?.focus();
  }

  /**
   * Called at the end of every fitWorkspaceUI() pass — i.e. after every
   * `renderPills()` — because the pill the menu points at has just been
   * replaced by a fresh node (or dropped from the paginated window, or
   * deleted). Re-anchor to the new node, or give up and close.
   */
  function reanchorCtxMenu(): void {
    if (!ctxEl || ctxEl.hidden) return;
    if (!positionCtxMenu()) { closeCtxMenu(); return; }
    const state = workspaceClient.getCached();
    const ws = state?.workspaces.find((w) => w.id === ctxWsId);
    if (ctxTitleEl && ws) ctxTitleEl.textContent = `${ws.name} · Slot ${ctxSlot()}`;
    if (ctxDelBtn && state) ctxDelBtn.disabled = state.workspaces.length <= 1;
  }

  // ── Triggers ──
  // Right-click a numbered pill. The `+` and ‹/› buttons have no data-ws-id,
  // so they fall through to the bundle-level suppressor below.
  pillsEl?.addEventListener('contextmenu', (e) => {
    const pill = (e.target as HTMLElement | null)?.closest<HTMLElement>('.ws-pill[data-ws-id]');
    const id = pill?.dataset['wsId'];
    if (!id) return;
    e.preventDefault();
    e.stopPropagation();
    openCtxMenu(id);
  });
  // Right-clicking anywhere else in the switcher shouldn't pop the browser's
  // native menu inside our chrome (same guard the launcher uses on its panel).
  bundleEl?.addEventListener('contextmenu', (e) => {
    if ((e.target as HTMLElement | null)?.closest('#ws-ctx')) return;  // let inputs keep their menu
    e.preventDefault();
    closeCtxMenu();
  });

  // Long-press (touch / pen / mouse-hold) — the touch equivalent of right-click.
  // On fire we flag the pointerup's click so it doesn't ALSO switch workspace.
  let longPressTimer: ReturnType<typeof setTimeout> | null = null;
  let longPressOrigin: { x: number; y: number } | null = null;
  let suppressNextPillClick = false;

  function cancelLongPress(): void {
    if (longPressTimer) { clearTimeout(longPressTimer); longPressTimer = null; }
    longPressOrigin = null;
  }

  pillsEl?.addEventListener('pointerdown', (e) => {
    // A click that never arrived (touch cancel, focus loss) must not swallow
    // the next real one — reset on every fresh press.
    suppressNextPillClick = false;
    cancelLongPress();
    if (e.button !== 0) return;
    const pill = (e.target as HTMLElement | null)?.closest<HTMLElement>('.ws-pill[data-ws-id]');
    const id = pill?.dataset['wsId'];
    if (!id) return;
    longPressOrigin = { x: e.clientX, y: e.clientY };
    longPressTimer = setTimeout(() => {
      longPressTimer = null;
      longPressOrigin = null;
      suppressNextPillClick = true;
      openCtxMenu(id);
    }, LONGPRESS_MS);
  });
  pillsEl?.addEventListener('pointermove', (e) => {
    if (!longPressOrigin) return;
    const dx = e.clientX - longPressOrigin.x;
    const dy = e.clientY - longPressOrigin.y;
    if (Math.hypot(dx, dy) > LONGPRESS_SLOP_PX) cancelLongPress();  // it's a drag/scroll
  });
  for (const ev of ['pointerup', 'pointercancel', 'pointerleave'] as const) {
    pillsEl?.addEventListener(ev, cancelLongPress);
  }

  // Keyboard equivalent — the pills are real <button>s and the bar already has
  // arrow-key navigation, so Shift+F10 / the Menu key should work on them too.
  pillsEl?.addEventListener('keydown', (e) => {
    if (e.key !== 'ContextMenu' && !(e.key === 'F10' && e.shiftKey)) return;
    const pill = (e.target as HTMLElement | null)?.closest<HTMLElement>('.ws-pill[data-ws-id]');
    const id = pill?.dataset['wsId'];
    if (!id) return;
    e.preventDefault();
    openCtxMenu(id);
  });

  // ── Menu actions ──
  ctxEl?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-ws-ctx]');
    if (!btn || btn.disabled) return;
    const action = btn.dataset['wsCtx'];
    const id = ctxWsId;
    if (!id) return;

    switch (action) {
      // Disclosure rows toggle their panel.
      case 'move':
      case 'rename':
      case 'delete':
        openCtxPanel(ctxPanel === action ? null : action);
        return;

      case 'dec':
      case 'inc': {
        if (!ctxSlotInput) return;
        const cur = Number(ctxSlotInput.value);
        const base = Number.isFinite(cur) && cur > 0 ? cur : ctxSlot();
        ctxSlotInput.value = String(clamp(base + (action === 'inc' ? 1 : -1), 1, ctxTotal()));
        syncStepBounds();
        return;
      }

      case 'move-ok':
        commitMove();
        return;

      case 'rename-ok':
        commitRename();
        closeCtxMenu();
        return;

      case 'delete-no':
        openCtxPanel(null);
        return;

      case 'delete-yes':
        closeCtxMenu();
        workspaceClient.deleteWorkspace(id)
          .catch((err) => console.warn('[StatusBar] deleteWorkspace failed', err));
        return;
    }
  });

  function commitMove(): void {
    if (!ctxSlotInput || !ctxWsId) return;
    const id = ctxWsId;
    const slot = normalizeSlotInput();
    closeCtxMenu();
    workspaceClient.moveWorkspace(id, slot - 1)
      .catch((err) => console.warn('[StatusBar] moveWorkspace failed', err));
  }

  function commitRename(): void {
    if (!ctxNameInput || !ctxWsId) return;
    const state = workspaceClient.getCached();
    const ws = state?.workspaces.find((w) => w.id === ctxWsId);
    if (!ws) return;
    // Blank is allowed mid-edit but never persisted — same contract as the
    // inline #ws-name-input blur handler.
    const trimmed = ctxNameInput.value.trim();
    if (!trimmed || trimmed === ws.name) return;
    workspaceClient.patchWorkspaceDebounced(ws.id, { name: trimmed });
  }

  /**
   * Clamp the typed slot into [1, total] and write it back to the field.
   * Runs on blur ("type 99 with 6 workspaces → snaps to 6 when you click
   * away"), and again on commit so an OK click that didn't blur the field
   * first can't push an out-of-range index.
   */
  function normalizeSlotInput(): number {
    const total = ctxTotal();
    const current = ctxSlot() || 1;
    if (!ctxSlotInput) return current;
    const parsed = parseInt(ctxSlotInput.value, 10);
    const slot = Number.isFinite(parsed) ? clamp(parsed, 1, Math.max(1, total)) : current;
    ctxSlotInput.value = String(slot);
    syncStepBounds();
    return slot;
  }

  // Digits only, but don't fight the user mid-edit: an empty field is fine
  // while typing and resolves on blur.
  ctxSlotInput?.addEventListener('input', () => {
    const digits = ctxSlotInput.value.replace(/\D+/g, '');
    if (digits !== ctxSlotInput.value) ctxSlotInput.value = digits;
    syncStepBounds();
  });
  ctxSlotInput?.addEventListener('blur', () => { normalizeSlotInput(); });
  ctxSlotInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter')  { e.preventDefault(); commitMove(); }
    if (e.key === 'Escape') { e.preventDefault(); closeCtxMenu(true); }
  });
  ctxNameInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter')  { e.preventDefault(); commitRename(); closeCtxMenu(); }
    if (e.key === 'Escape') { e.preventDefault(); closeCtxMenu(true); }
  });

  // ── Dismissal ──
  // composedPath() rather than contains(e.target): pill clicks re-render
  // `#ws-pills` synchronously, so by the time this runs the original target
  // may already be detached (see the identical note on the ▦ popover handler).
  document.addEventListener('click', (e) => {
    if (!ctxEl || ctxEl.hidden) return;
    const path = typeof e.composedPath === 'function' ? e.composedPath() : [];
    if (path.includes(ctxEl)) return;
    if (path.length === 0 && ctxEl.contains(e.target as Node)) return;
    closeCtxMenu();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && ctxEl && !ctxEl.hidden) {
      e.stopPropagation();
      closeCtxMenu(true);
    }
  }, true);

  layoutChip?.addEventListener('click', () => {
    const state = workspaceClient.getCached();
    if (!state) return;
    const active = state.workspaces.find((w) => w.id === state.activeWorkspaceId);
    if (!active) return;
    const ids = availableLayouts.map((m) => m.id);
    const idx = ids.indexOf(active.layoutId);
    const next = ids[(idx + 1) % ids.length] ?? ids[0]!;
    workspaceClient.patchWorkspace(active.id, { layoutId: next })
      .catch((err) => console.warn('[StatusBar] patchWorkspace failed', err));
  });

  // Keyboard shortcuts → KeyDispatcher. The dispatcher resolves
  // the bound combo per action (default OR user override), so we just
  // register what each action DOES; the combo is the user's prerogative.
  // Ctrl+1..9 → activate workspace at slot. Ctrl+Shift+N → new workspace.
  // Ctrl+Shift+ArrowRight / Ctrl+Shift+ArrowLeft → cycle workspaces.
  {
    const switchToSlot = (n: number) => {
      const state = workspaceClient.getCached();
      const target = state?.workspaces[n - 1];
      if (!target) return;
      workspaceClient.setActive(target.id).catch(() => undefined);
    };
    for (let i = 1; i <= 9; i++) {
      keyDispatcher.bind(`aura.workspace.switch-${i}`, () => { switchToSlot(i); });
    }
    keyDispatcher.bind('aura.workspace.new', () => {
      workspaceClient.createWorkspace().catch(() => undefined);
    });
    keyDispatcher.bind('aura.workspace.cycle-next', () => cycleWorkspace(+1));
    keyDispatcher.bind('aura.workspace.cycle-prev', () => cycleWorkspace(-1));
    // Lock-screen blackout — the overlay's script registers
    // window.auraLockScreen on body-script load; the action is a registry
    // entry so users can rebind it from Settings → Keyboard.
    keyDispatcher.bind('aura.lockscreen.activate', () => {
      (window as any).auraLockScreen?.();
    });
  }

  function cycleWorkspace(dir: 1 | -1): void {
    const state = workspaceClient.getCached();
    if (!state || state.workspaces.length === 0) return;
    const i = state.workspaces.findIndex((w) => w.id === state.activeWorkspaceId);
    const n = state.workspaces.length;
    const next = state.workspaces[((i < 0 ? 0 : i) + dir + n) % n];
    if (next) workspaceClient.setActive(next.id).catch(() => undefined);
  }

  // ── Shell UI commands (see ../../lib/uiCommands.ts) — what this bar owns:
  // the main zoom, browser fullscreen, a workspace's layout, the layout list.
  registerUiCommand('setZoom', ({ percent, step, reset }) => {
    const before = currentZoomValue;
    let target: number;
    if (reset === true)                     target = 1;
    // `step` is in ZOOM_STEP units and may be several: "zoom in twice" is 2.
    else if (typeof step === 'number')      target = currentZoomValue + step * ZOOM_STEP;
    else if (typeof percent === 'number')   target = percent / 100;
    else throw new Error('setZoom needs percent, step or reset');
    // Through viewportClient, like the −/＋ buttons: persists + syncs tabs.
    viewportClient.patchActive({ zoom: target });
    // `from` lets the caller see a request that hit the 50–400 % limit and
    // moved nothing, rather than reporting a zoom that never happened.
    return { percent: Math.round(clampZoom(target) * 100), from: Math.round(before * 100) };
  });
  registerUiCommand('fullscreen', async ({ mode }) => {
    const want = mode === 'toggle' ? !document.fullscreenElement : mode === 'on';
    if (want && !document.fullscreenElement) {
      try { await document.documentElement.requestFullscreen(); }
      catch {
        // Browsers only grant fullscreen from a user gesture; a command that
        // arrived over the network is not one. Say so instead of failing quietly.
        throw new Error('the browser refused to enter fullscreen: it only allows that from a user gesture — ask the user to press F11 or click the ⛶ button');
      }
    } else if (!want && document.fullscreenElement) {
      await document.exitFullscreen();
    }
    return { fullscreen: !!document.fullscreenElement };
  });
  registerUiCommand('switchLayout', async ({ workspaceId, layoutId }) => {
    const wsId = String(workspaceId ?? '');
    const id = String(layoutId ?? '');
    if (!availableLayouts.some((m) => m.id === id)) throw new Error(`unknown layout "${id}"`);
    await workspaceClient.patchWorkspace(wsId, { layoutId: id });
    return { workspaceId: wsId, layoutId: id };
  });
  registerSnapshotPart('statusBar', () => ({
    zoom: {
      percent: Math.round(currentZoomValue * 100),
      shellPercent: Math.round(shellZoomValue * 100),
      appPercent: Math.round(appZoomValue * 100),
      min: ZOOM_MIN * 100, max: ZOOM_MAX * 100, step: ZOOM_STEP * 100,
    },
    fullscreen: !!document.fullscreenElement,
    layouts: availableLayouts,
  }));

  // Viewport profiles live in THIS browser's localStorage, so the daemon can
  // only reach them through here. setActive ignores an unknown id, so the
  // handler checks first and says so instead of reporting a switch.
  const viewportState = async () => viewportClient.getCached() ?? await viewportClient.refresh();
  registerUiCommand('getViewportInfo', async () => {
    const s = await viewportState();
    const p = s.profiles.find((x) => x.id === s.activeProfileId) ?? s.profiles[0]!;
    return {
      active: {
        id: p.id, name: p.name,
        zoomPercent: Math.round(p.zoom * 100),
        shellZoomPercent: Math.round(p.shellZoom * 100),
        appZoomPercent: Math.round(p.appZoom * 100),
        margins: p.margins,
        themeIdLight: p.themeIdLight, themeIdDark: p.themeIdDark,
      },
      profiles: s.profiles.map((x) => ({ id: x.id, name: x.name })),
    };
  });
  registerUiCommand('setViewport', async ({ id }) => {
    const s = await viewportState();
    const to = s.profiles.find((x) => x.id === id);
    if (!to) throw new Error(`no viewport profile with id "${String(id)}"`);
    const from = s.profiles.find((x) => x.id === s.activeProfileId) ?? null;
    viewportClient.setActive(to.id);
    return { from: from ? { id: from.id, name: from.name } : null, to: { id: to.id, name: to.name } };
  });
  registerSnapshotPart('viewport', () => {
    const s = viewportClient.getCached();
    return { activeProfile: viewportClient.activeProfile()?.name ?? null, profileCount: s?.profiles.length ?? 0 };
  });

  // ─── Chrome arrow-key navigation ───────────────────────────────────────
  // Mirror of the Dock handler — same rules but inverted:
  //   • ArrowLeft / ArrowRight — prev/next button in this bar.
  //   • ArrowDown              — jump to dock, button closest by X.
  //   • ArrowUp                — no-op (already at the top).
  const statusbar = document.getElementById('statusbar') as HTMLElement | null;
  function sbFocusables(container: HTMLElement): HTMLButtonElement[] {
    return Array.from(container.querySelectorAll<HTMLButtonElement>('button'))
      .filter((b) => !b.disabled && b.offsetParent !== null)
      // Same aria-hidden filter the dock uses — keeps any future
      // off-screen popover (workspace dropdown, viewport-settings dialog
      // chrome, etc.) from leaking buttons into the arrow-nav cycle.
      .filter((b) => !b.closest('[aria-hidden="true"]'));
  }
  function sbClosestByX(target: HTMLElement, candidates: HTMLButtonElement[]): HTMLButtonElement | null {
    if (candidates.length === 0) return null;
    const r = target.getBoundingClientRect();
    const cx = r.left + r.width / 2;
    let best: HTMLButtonElement | null = null;
    let bestD = Infinity;
    for (const c of candidates) {
      const cr = c.getBoundingClientRect();
      const d = Math.abs(cx - (cr.left + cr.width / 2));
      if (d < bestD) { bestD = d; best = c; }
    }
    return best;
  }
  statusbar?.addEventListener('keydown', (e) => {
    // Same Nav-mode gate the dock applies — in window-selection mode the
    // arrow keys belong to the OS window navigator. Without this, an
    // ArrowLeft/Right pressed while the chip is focused would walk to the
    // adjacent status-bar button INSTEAD of (or in addition to) moving
    // the window highlight.
    if (keyDispatcher.getMode() === 'nav') return;
    const current = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!current || !statusbar.contains(current)) return;
    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
      const list = sbFocusables(statusbar);
      const idx  = list.indexOf(current);
      const next = list[idx + (e.key === 'ArrowLeft' ? -1 : 1)];
      if (next) { next.focus(); e.preventDefault(); e.stopPropagation(); }
      return;
    }
    if (e.key === 'ArrowDown') {
      const dock = document.getElementById('dock');
      if (!dock) return;
      const pick = sbClosestByX(current, sbFocusables(dock));
      if (pick) { pick.focus(); e.preventDefault(); e.stopPropagation(); }
    }
  });

  // Boot stage 2: this bar's triggers work from here on.
  markBarReady('statusbar');
</script>

<style>
  #statusbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    height: var(--aura-statusbar-height);
    background: var(--aura-color-surface);
    border-bottom: var(--aura-border);
    font-size: var(--aura-font-size-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    user-select: none;
  }

  .os-name {
    color: var(--aura-color-primary);
    font-weight: bold;
    text-shadow: var(--aura-glow-primary);
    /* Never shrink: if the bar's children are allowed to flex-shrink, an
       overflowing bar quietly compresses their boxes (content spills INSIDE
       each item) instead of growing #statusbar.scrollWidth — and the
       responsive pill-fit logic, which keys off real overflow, never trips.
       Pinning shrink to 0 makes an over-full bar overflow for real so
       fitWorkspaceUI() can measure it and drop workspace pills. */
