  .bars-badge[data-edge="right"][data-ok-side="before"]  { border-top-left-radius: 0; }
  .bars-badge[data-edge="left"][data-ok-side="after"]    { border-bottom-right-radius: 0; }
  .bars-badge[data-edge="left"][data-ok-side="before"]   { border-top-right-radius: 0; }
  .bars-badge[data-edge="top"][data-ok-side="after"]     { border-bottom-right-radius: 0; }
  .bars-badge[data-edge="top"][data-ok-side="before"]    { border-bottom-left-radius: 0; }
  .bars-badge[data-edge="bottom"][data-ok-side="after"]  { border-top-right-radius: 0; }
  .bars-badge[data-edge="bottom"][data-ok-side="before"] { border-top-left-radius: 0; }
  .bars-badge[data-edge="right"][data-ok-side="after"]   ~ .bars-seg { border-radius: 0 0 0 8px; }
