  .bars-badge[data-ok-side="after"]  ~ .bars-badge-ok { --seg-off: calc(var(--badge-len) + var(--kb-len)); }
  .bars-badge[data-ok-side="after"][data-ok-place="opposite"]  ~ .bars-badge-ok { --seg-off: calc(-1 * var(--ok-len)); }
  .bars-badge[data-ok-side="before"][data-ok-place="opposite"] ~ .bars-badge-ok { --seg-off: var(--badge-len); }
  .bars-badge[data-ok-side="before"] ~ .bars-badge-kb { --seg-off: calc(-1 * var(--kb-len)); }
  .bars-badge[data-ok-side="before"] ~ .bars-badge-ok { --seg-off: calc(-1 * (var(--kb-len) + var(--ok-len))); }
  .bars-badge[data-edge="left"] ~ .bars-seg,
  .bars-badge[data-edge="right"] ~ .bars-seg {
