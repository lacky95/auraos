  .bars-badge[data-edge="right"][data-ok-side="before"] ~ .bars-badge-kb { border-bottom: none; }
  .bars-badge[data-edge="top"][data-ok-side="after"] ~ .bars-badge-kb,
  .bars-badge[data-edge="bottom"][data-ok-side="after"] ~ .bars-badge-kb { border-left: none; }
  .bars-badge[data-edge="top"][data-ok-side="before"] ~ .bars-badge-kb,
  .bars-badge[data-edge="bottom"][data-ok-side="before"] ~ .bars-badge-kb { border-right: none; }
  .bars-badge[data-edge="left"][data-ok-side="after"] ~ .bars-badge-ok,
  .bars-badge[data-edge="right"][data-ok-side="after"] ~ .bars-badge-ok { border-top: 1px solid var(--aura-color-bg); }
