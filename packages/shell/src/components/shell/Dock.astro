---
import type { AppManifest } from '@aura/core';
import ProcessManager from './ProcessManager.astro';

interface Props {
  apps: AppManifest[];
  /** `{ appId → enabled }`. Disabled tiles are hidden via CSS and live-flipped
   *  through the SSE handler at the end of this file. */
  enabledMap?: Record<string, boolean>;
}
const { apps, enabledMap = {} } = Astro.props;
---
<nav id="dock">
  <!--
    Keyboard-nav entry point. Ctrl+Alt+Space focuses this button so the
    user can arrow-walk the chrome from a stable anchor. Visually a thin
    "half-width" pill before the main app launcher — narrow on purpose so
    it doesn't fight the launcher for prominence.
  -->
  <button
    id="dock-nav-entry"
    type="button"
    class="nav-entry-btn"
    aria-label="Lock screen"
    title="Lock screen (tap) · Window selection (Enter) · Ctrl+Alt+Space focuses this">
    <span class="nav-entry-icon" aria-hidden="true">◐</span>
  </button>
  <button
    id="dock-launcher-btn"
    type="button"
    class="launcher-btn"
    title="All Apps">
    <span class="grid-icon">⣿</span>
  </button>
  <ProcessManager />
  <div class="separator"></div>
  <div id="dock-items" class="dock-items">
    {apps.map(app => {
      const glyph = (app.icon ?? app.name.charAt(0)).toUpperCase();
      const enabled = enabledMap[app.id] !== false;
      return (
        <button
          class="dock-item"
          data-app-id={app.id}
          data-enabled={String(enabled)}
          title={app.name}
          onclick={`window.auraLaunchApp('${app.id}')`}
        >
          <span class="app-initial" data-len={glyph.length}>{glyph}</span>
          <span class="app-label">{app.name}</span>
        </button>
      );
    })}
  </div>

  <!--
    Overflow button + dropup popup. Hidden by default; shown by the
    ResizeObserver in the script below when the dock is too narrow to
    fit every tile. The dropup opens UP (since the dock is at the
    bottom) and lists the tiles that didn't fit. When the dock is so
    narrow that only one tile would be visible (or zero), every tile
    collapses into the dropup so the layout never lands on a single
    awkward visible tile.
  -->
  <button
    id="dock-overflow-btn"
    type="button"
    class="dock-overflow-btn"
    title="More apps"
    aria-haspopup="menu"
    aria-expanded="false"
    hidden
  >
    <span class="dock-overflow-icon" aria-hidden="true">⋯</span>
  </button>
  <div id="dock-overflow-menu" class="dock-overflow-menu" role="menu" hidden></div>
</nav>

<style is:global>
  /* All selectors are either id-anchored (#dock), dock-* prefixed, or
     nested under a specific parent — because dock-item tiles are rebuilt
     via document.createElement in the MRU/install SSE handler and those
     elements don't carry Astro's data-astro-cid-* scope attribute, so a
     scoped style block would leave them unstyled. Same rationale as the
     is:global block in ProcessManager.astro. */
  #dock {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0 16px;
    height: var(--aura-dock-height);
    background: var(--aura-color-surface);
    border-top: var(--aura-border);
    /* Responsive overflow: when there isn't room for every pinned-app tile
       the JS `fitDockItems()` at the end of this file hides them from the
       right edge inward (data-hidden="true"). `overflow: hidden` is the
       safety net for the half-frame before that fit pass runs — we never
       want a scrollbar in the dock. */
    overflow: hidden;
  }

  .nav-entry-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Half the launcher-btn width (44 / 2). Same height so the dock row
       stays visually aligned. */
    width: 22px;
    height: 44px;
    color: var(--aura-color-text-dim);
    font-size: 0.9rem;
    border: var(--aura-border);
    background: transparent;
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
    transition: box-shadow 0.1s, color 0.1s;
  }
  .nav-entry-btn:hover {
    color: var(--aura-color-primary);
    box-shadow: var(--aura-glow-primary);
    outline: none;
  }
  /* Loud focus indicator — the chip is only 22 px wide, so the default
     thin focus ring was easy to miss when Ctrl+Alt+Space landed focus
     here. Bright background fill + inset primary border + outer glow
     makes the focus state unmistakable. */
  .nav-entry-btn:focus,
  .nav-entry-btn:focus-visible {
    color: var(--aura-color-bg);
    background: var(--aura-color-primary);
    box-shadow: inset 0 0 0 2px var(--aura-color-primary), 0 0 12px var(--aura-color-primary);
    outline: none;
  }
  /* Window-selection mode telegraph. `data-mode="active"` is flipped from
     `pages/index.astro`'s `onModeChange` hook whenever the keyDispatcher
     enters Nav mode. Distinct from the plain focus state (filled
     background + static glow): in active mode the chip is UNFILLED
     (transparent background, primary-toned glyph) but has a pulsing
     outer glow, so it reads as "the mode is live elsewhere — focus is
     on a window, not on the chip itself".

     Active rule comes after `:focus`/`:focus-visible` in source order so
     it wins the cascade when the chip is both focused AND active (which
     is the normal case — Ctrl+Alt+Space focuses the chip, then Enter
     enters the mode without moving focus). */
  .nav-entry-btn[data-mode="active"] {
    color: var(--aura-color-primary);
    background: transparent;
    animation: aura-chip-active-pulse 1.4s ease-in-out infinite;
  }
  @keyframes aura-chip-active-pulse {
    0%, 100% { box-shadow: 0 0  4px var(--aura-color-primary); }
    50%      { box-shadow: 0 0 18px var(--aura-color-primary); }
  }
  .nav-entry-icon { line-height: 1; }

  .launcher-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--aura-color-primary);
    font-size: 1.2rem;
    border: var(--aura-border);
    background: transparent;
    cursor: pointer;
    text-decoration: none;
    flex-shrink: 0;
    transition: box-shadow 0.1s;
  }
  .launcher-btn:hover,
  .launcher-btn:focus,
  .launcher-btn:focus-visible { box-shadow: var(--aura-glow-primary); outline: none; }
  .launcher-btn:focus-visible {
    box-shadow: inset 0 0 0 2px var(--aura-color-primary), var(--aura-glow-primary);
  }

  #dock .separator {
    width: 1px;
    height: 32px;
    background: var(--aura-color-border);
    margin: 0 8px;
    flex-shrink: 0;
  }

  .dock-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 4px 14px;
    background: transparent;
    border: var(--aura-border);
    color: var(--aura-color-text);
    cursor: pointer;
    font-family: var(--aura-font-mono);
    font-size: var(--aura-font-size-xs);
    min-width: 56px;
    transition: box-shadow 0.1s;
  }
  .dock-item:hover,
  .dock-item:focus,
  .dock-item:focus-visible {
    box-shadow: var(--aura-glow-primary); color: var(--aura-color-primary); outline: none;
  }
  .dock-item:focus-visible {
    box-shadow: inset 0 0 0 2px var(--aura-color-primary), var(--aura-glow-primary);
  }
  /* Disabled apps disappear from the dock (Android-style "hide on disable").
     The data-enabled attr is set at SSR + flipped live by the SSE handler
     at the end of this file. */
  .dock-item[data-enabled="false"] { display: none; }
  /* Responsive trimming. Tiles that don't fit the dock width are flagged
     `data-hidden="true"` by `fitDockItems()` (bottom of this file) and
     hidden via CSS. We hide from the rightmost pinned tile inwards so
     the most-recently-used apps stay visible. */
  .dock-item[data-hidden="true"] { display: none; }

  .dock-item .app-initial {
    /* Uniform size across 1/2/3-char glyphs; sized to fit "SET" in the dock tile. */
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--aura-color-primary);
    font-weight: 500;
  }

  .dock-item .app-label {
    font-size: var(--aura-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 56px;
  }

  /* ── Dock items container ──
   * Wrapper around the pinned-app tiles. Sits between the separator and
   * the overflow button. Must NOT have `overflow: hidden` or `min-width: 0`
   * — those let the wrapper silently clip its children, hiding the very
   * overflow that `fitDockItems` needs to detect. We rely on `#dock`'s own
   * `overflow: hidden` to clip the visual overflow during the brief frame
   * before the JS pass hides the rightmost tiles. */
  .dock-items {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  /* ── Overflow trigger ── */
  .dock-overflow-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 44px;
    color: var(--aura-color-text-dim);
    font-size: 1rem;
    border: var(--aura-border);
    background: transparent;
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
    transition: box-shadow 0.1s, color 0.1s;
  }
  .dock-overflow-btn:hover,
  .dock-overflow-btn:focus,
  .dock-overflow-btn:focus-visible {
    color: var(--aura-color-primary);
    box-shadow: var(--aura-glow-primary);
    outline: none;
  }
  .dock-overflow-btn[aria-expanded="true"] {
    color: var(--aura-color-bg);
    background: var(--aura-color-primary);
    border-color: var(--aura-color-primary);
  }
  .dock-overflow-icon { line-height: 1; font-size: 1.2rem; letter-spacing: 0.1em; }

  /* ── Dropup menu ── */
  /* Positioned ABOVE the dock (the dock is fixed at the bottom of the
   * viewport). Anchored to the right edge of the dock so it pops up from
   * where the overflow button sits, matching macOS / Windows taskbar
   * overflow popovers. */
  .dock-overflow-menu {
    position: fixed;
    right: 16px;                /* matches dock horizontal padding */
    bottom: calc(var(--aura-dock-height) + 6px);
    z-index: 1050;
    min-width: 220px;
    max-width: min(360px, 90vw);
    max-height: 60vh;
    overflow-y: auto;
    background: var(--aura-color-surface);
    border: var(--aura-border);
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.45);
    padding: 4px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .dock-overflow-menu[hidden] { display: none; }

  .dock-overflow-item {
    display: grid;
    grid-template-columns: 28px 1fr;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--aura-color-text);
    cursor: pointer;
    font-family: var(--aura-font-mono);
    text-align: left;
    transition: background 0.1s, color 0.1s, border-color 0.1s;
  }
  .dock-overflow-item:hover,
  .dock-overflow-item:focus,
  .dock-overflow-item:focus-visible {
    background: color-mix(in srgb, var(--aura-color-primary) 14%, transparent);
    color: var(--aura-color-primary);
    border-color: var(--aura-color-primary);
    outline: none;
  }
  .dock-overflow-glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 24px;
    border: 1px solid var(--aura-color-border);
    color: var(--aura-color-primary);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    font-weight: 500;
  }
  .dock-overflow-name {
    font-size: var(--aura-font-size-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script>
  import { getKeyDispatcher } from '../../lib/keyDispatcher.ts';
  const keyDispatcher = getKeyDispatcher();

  // Inline `onclick="window.auraToggleLauncher()"` runs at click time, but it
  // fails silently if `auraToggleLauncher` isn't defined yet — and inline
  // event handlers can be hard to debug. Bind via addEventListener instead.
  const btn = document.getElementById('dock-launcher-btn');
  btn?.addEventListener('click', () => {
    const toggle = (window as any).auraToggleLauncher;
    if (typeof toggle === 'function') toggle();
    else console.warn('[Dock] auraToggleLauncher not available — LauncherOverlay missing?');
  });

  // ─── Window-selection mode trigger ─────────────────────────────────────
  // The `◐` chip is keyboard-only by design: pressing Enter (or Space)
  // while it's focused dispatches a custom event the shell-level handler
  // in `pages/index.astro` listens for. That handler toggles dispatcher
  // mode → 'nav', which highlights the first visible window. A mouse
  // click on the chip is deliberately a no-op for now (the user wants to
  // reserve the click affordance for later use).
  //
  // We bind on the button itself rather than the dock container so the
  // existing dock arrow-key navigation (ArrowLeft/Right walks the chrome)
  // keeps working unchanged — Enter is the only key we claim here.
  const navEntry = document.getElementById('dock-nav-entry');
  navEntry?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    // Bail on modifier combos. The chip's "press to enter window-select
    // mode" affordance is plain Enter or plain Space only — any combo
    // like Ctrl+Alt+Space is an OS shortcut owned by the dispatcher.
    if (e.ctrlKey || e.altKey || e.metaKey || e.shiftKey) return;
    // Bail if the OS dispatcher (capture phase, in OSLayout.astro) already
    // handled this keystroke — it calls preventDefault when it fires. The
    // canonical scenario: user is in nav mode, chip still has focus, user
    // presses Enter. The dispatcher's `aura.nav.enter` runs first
    // (focuses the highlighted iframe + flips to app mode); without this
    // check, this bubble-phase handler would then dispatch the toggle
    // event, which would flip back into nav mode and reset the highlight
    // to the first window. End result before the fix: Enter required two
    // presses, and the first one always re-anchored the selection.
    if (e.defaultPrevented) return;
    e.preventDefault();
    e.stopPropagation();
    document.dispatchEvent(new CustomEvent('aura:window-select.toggle'));
  });

  // Mouse / touch click on the chip triggers the lock screen — this uses the
  // click affordance the keydown handler above deliberately left free (it
  // preventDefaults plain Enter/Space, so keyboard activation never
  // synthesises a click here; window-select stays keyboard-only). Direct
  // in-window call: the LockScreenOverlay defines `auraLockScreen` on this
  // same top window, so there's no cross-frame messaging to fail.
  navEntry?.addEventListener('click', () => {
    const lock = (window as any).auraLockScreen;
    if (typeof lock === 'function') lock();
    else console.warn('[Dock] auraLockScreen not available — LockScreenOverlay missing?');
  });

  // ─── Chrome arrow-key navigation ───────────────────────────────────────
  // Bottom dock <-> top status bar focus chain. The keydown handler is
  // bound on the dock container itself; bubbling reaches us no matter
  // which button is currently focused. Movement rules:
  //   • ArrowLeft / ArrowRight — prev/next focusable button in this bar.
  //   • ArrowUp                — jump to the status bar; pick the button
  //                              whose horizontal centre is closest to
  //                              the current button's centre.
  //   • ArrowDown              — no-op (already at the bottom).
  //   • Enter / Space          — native button click (handled by browser).
  const dockNav = document.getElementById('dock') as HTMLElement | null;
  function focusables(container: HTMLElement): HTMLButtonElement[] {
    return Array.from(container.querySelectorAll<HTMLButtonElement>('button'))
      // offsetParent excludes display:none ancestors. Disabled buttons get
      // skipped explicitly so the workspace-pill "prev/next" disabled
      // buttons don't trap focus.
      .filter((b) => !b.disabled && b.offsetParent !== null)
      // Skip anything inside an `aria-hidden="true"` ancestor — the
      // ProcessManager panel is technically rendered inside #dock but
      // slid off-screen via transform (display:block, offsetParent !=
      // null), so without this filter ArrowRight from the PM toggle
      // would dive into the panel's invisible filter/view/close buttons.
      .filter((b) => !b.closest('[aria-hidden="true"]'));
  }
  function closestByX(target: HTMLElement, candidates: HTMLButtonElement[]): HTMLButtonElement | null {
    if (candidates.length === 0) return null;
    const r = target.getBoundingClientRect();
    const cx = r.left + r.width / 2;
    let best: HTMLButtonElement | null = null;
    let bestD = Infinity;
    for (const c of candidates) {
      const cr = c.getBoundingClientRect();
      const d = Math.abs(cx - (cr.left + cr.width / 2));
      if (d < bestD) { bestD = d; best = c; }
    }
    return best;
  }
  dockNav?.addEventListener('keydown', (e) => {
    // In Nav (window-selection) mode the arrow keys belong to the OS
    // window navigator — they move the highlight between app slots, not
    // between dock buttons. The dispatcher fires in the capture phase
    // and runs first, but this bubble-phase handler would still fire
    // after it and shove dock focus around. Bail when nav mode is on.
    if (keyDispatcher.getMode() === 'nav') return;
    const current = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!current || !dockNav.contains(current)) return;
    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
      const list = focusables(dockNav);
      const idx  = list.indexOf(current);
      const next = list[idx + (e.key === 'ArrowLeft' ? -1 : 1)];
      if (next) { next.focus(); e.preventDefault(); e.stopPropagation(); }
      return;
    }
    if (e.key === 'ArrowUp') {
      const bar = document.getElementById('statusbar');
      if (!bar) return;
      const pick = closestByX(current, focusables(bar));
      if (pick) { pick.focus(); e.preventDefault(); e.stopPropagation(); }
    }
  });

  // Live enable/disable updates over socket.io (same channel the desktop
  // uses for app:* / activity:* / workspaces:* changes). When the user
  // toggles an app in Settings → Apps or via `aura app enable/disable`,
  // flip data-enabled on the matching dock tile — CSS handles the show/hide.
  const dock = document.getElementById('dock') as HTMLElement | null;
  if (dock) {
    import('../../lib/osEvents.ts').then(({ osEvents }) => {
      osEvents.subscribe('app:enabledChanged', (ev: any) => {
        if (typeof ev?.appId !== 'string' || typeof ev?.enabled !== 'boolean') return;
        const tile = dock.querySelector<HTMLElement>(`.dock-item[data-app-id="${CSS.escape(ev.appId)}"]`);
        if (tile) tile.dataset['enabled'] = String(ev.enabled);
      });

      // MRU re-ordering. /api/apps/<id>/start writes a timestamp to
      // os/app-mru on every successful launch and emits app:mruChanged via
      // the OS event bus → sioPlugin → this handler. Two cases:
      //   1. The launched app's tile is already in the dock → just move it
      //      to the front (cheap DOM move, no fetch, no rebuild).
      //   2. The launched app wasn't in the top-5 → it should be now;
      //      re-fetch /api/apps + the live mru map and rebuild the tile
      //      list so the newcomer appears + the oldest gets dropped.
      osEvents.subscribe('app:mruChanged', async (ev: any) => {
        if (typeof ev?.appId !== 'string') return;
        const itemsWrap = document.getElementById('dock-items');
        if (!itemsWrap) return;
        const existing = itemsWrap.querySelector<HTMLElement>(`.dock-item[data-app-id="${CSS.escape(ev.appId)}"]`);
        if (existing) {
          // Fast path: already in the dock — just promote to first inside #dock-items.
          const first = itemsWrap.firstElementChild;
          if (existing !== first) itemsWrap.insertBefore(existing, first);
          return;
        }
        // Slow path: newcomer. Fetch the canonical list + mru map and
        // rebuild every tile inside #dock-items.
        try {
          const [appsRes, mruRes] = await Promise.all([
            fetch('/api/apps'),
            fetch('/api/admin/apps/mru'),
          ]);
          if (!appsRes.ok || !mruRes.ok) return;
          const apps = await appsRes.json() as Array<{
            manifest: { id: string; name: string; icon?: string; componentType?: 'activity' | 'service' };
            enabled: boolean;
          }>;
          const mru = (await mruRes.json()).mru as Record<string, number>;
          const top5 = apps
            .filter((a) => a.enabled !== false)
            // Services have no UI and shouldn't squat a dock slot. Mirrors
            // the SSR pinned-apps filter in pages/index.astro.
            .filter((a) => a.manifest.componentType !== 'service')
            .sort((a, b) => {
              const am = mru[a.manifest.id] ?? 0;
              const bm = mru[b.manifest.id] ?? 0;
              if (am !== bm) return bm - am;
              return a.manifest.name.localeCompare(b.manifest.name);
            })
            .slice(0, 5);
          itemsWrap.replaceChildren();
          const frag = document.createDocumentFragment();
          for (const a of top5) {
            const m = a.manifest;
            const glyph = (m.icon ?? m.name.charAt(0)).toUpperCase();
            const btn = document.createElement('button');
            btn.className = 'dock-item';
            btn.dataset['appId']   = m.id;
            btn.dataset['enabled'] = String(a.enabled);
            btn.title = m.name;
            btn.onclick = () => (window as any).auraLaunchApp?.(m.id);
            btn.innerHTML = `<span class="app-initial" data-len="${glyph.length}">${glyph}</span><span class="app-label">${m.name.replace(/[<>&]/g, '')}</span>`;
            frag.appendChild(btn);
          }
          itemsWrap.appendChild(frag);
        } catch { /* network blip — next launch retries */ }
      });
    });
  }

  // ─── Responsive trimming ────────────────────────────────────────────────
  // The dock is `overflow: hidden`, so anything past the right edge would be
  // clipped silently. Instead, hide whole pinned-app tiles from the right
  // inward (most-recent stays visible) until everything fits.
  //
  // Re-run on:
  //   • viewport resize (ResizeObserver on #dock)
  //   • MRU rebuild / enable-disable flips (MutationObserver on #dock —
  //     children added/removed, or data-enabled attribute changes).
  //
  // ProcessManager's slide-in panel is absolutely positioned, so it doesn't
  // contribute to dock width — we only need to react to the small #pm-toggle
  // button, which is fixed-size. No PM observer needed.
  const dockFit = document.getElementById('dock') as HTMLElement | null;
  if (dockFit) {
    const overflowBtn  = document.getElementById('dock-overflow-btn')  as HTMLButtonElement | null;
    const overflowMenu = document.getElementById('dock-overflow-menu') as HTMLDivElement    | null;

    /** Build the dropup menu DOM from the array of overflowed tiles. Each
     *  entry mirrors the dock-item glyph + name so the menu reads as a
     *  vertical version of the dock. Clicking a row launches the app and
     *  closes the menu. */
    function populateOverflowMenu(overflow: HTMLElement[]) {
      if (!overflowMenu) return;
      overflowMenu.innerHTML = overflow.map((el) => {
        const id    = el.dataset['appId'] ?? '';
        const name  = el.title || id;
        const glyph = el.querySelector<HTMLElement>('.app-initial')?.textContent ?? '?';
        const escId  = id.replace(/"/g, '&quot;');
        const escNm  = name.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
        const escGl  = (glyph || '').replace(/&/g, '&amp;').replace(/</g, '&lt;');
        return `<button type="button" class="dock-overflow-item" role="menuitem" data-app-id="${escId}" title="${escNm}">
          <span class="dock-overflow-glyph" data-len="${glyph.length}">${escGl}</span>
          <span class="dock-overflow-name">${escNm}</span>
        </button>`;
      }).join('');
    }

    function setOverflowOpen(open: boolean) {
      if (!overflowBtn || !overflowMenu) return;
      overflowMenu.hidden = !open;
      overflowBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    /** Single-tile threshold: below this many tiles fitting, collapse ALL
     *  remaining tiles into the dropup so the layout doesn't land on a
     *  single awkward visible tile. */
    const MIN_VISIBLE_TILES = 2;

    const fitDockItems = () => {
      const items = Array.from(dockFit.querySelectorAll<HTMLElement>('.dock-items > .dock-item'));
      // Reset state first so we measure natural width on every pass.
      for (const el of items) delete el.dataset['hidden'];
      if (overflowBtn) overflowBtn.hidden = true;

      // Disabled tiles stay hidden by the data-enabled rule.
      const visible = items.filter((el) => el.dataset['enabled'] !== 'false');

      // 1) Trim from the right while overflowing.
      let trimIdx = visible.length;
      while (trimIdx > 0 && dockFit.scrollWidth > dockFit.clientWidth + 1) {
        // First overflow → reveal the overflow button so subsequent
        // measurements account for its width.
        if (overflowBtn && overflowBtn.hidden) {
          overflowBtn.hidden = false;
        }
        trimIdx -= 1;
        visible[trimIdx].dataset['hidden'] = 'true';
      }

      // 2) Sub-threshold rule: if fewer than MIN_VISIBLE_TILES are still
      //    visible (but there ARE pinned tiles), collapse the rest into
      //    the overflow menu too. Avoids the "single lonely tile" state.
      const remainingVisible = trimIdx;
      const someOverflow = remainingVisible < visible.length;
      if (someOverflow && remainingVisible > 0 && remainingVisible < MIN_VISIBLE_TILES) {
        for (let j = 0; j < remainingVisible; j++) {
          visible[j].dataset['hidden'] = 'true';
        }
        trimIdx = 0;
      }

      // 3) Populate the overflow menu with everything that's hidden.
      const overflowed = visible.slice(trimIdx);
      if (overflowed.length > 0) {
        if (overflowBtn) overflowBtn.hidden = false;
        populateOverflowMenu(overflowed);
      } else {
        if (overflowBtn) overflowBtn.hidden = true;
        setOverflowOpen(false);
      }
    };

    // ── Overflow popup interaction ────────────────────────────────────
    overflowBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = overflowMenu?.hidden === false;
      setOverflowOpen(!isOpen);
    });
    overflowMenu?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-app-id]');
      const id = btn?.dataset['appId'];
      if (!id) return;
      setOverflowOpen(false);
      (window as any).auraLaunchApp?.(id);
    });
    // Close on outside click (uses composedPath to survive DOM mutations
    // from launching an app).
    document.addEventListener('click', (e) => {
      if (overflowMenu?.hidden) return;
      const path = typeof e.composedPath === 'function' ? e.composedPath() : [];
      if (overflowBtn  && path.includes(overflowBtn))  return;
      if (overflowMenu && path.includes(overflowMenu)) return;
      setOverflowOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overflowMenu?.hidden === false) {
        setOverflowOpen(false);
      }
    });

    // Schedule on the next frame: layout isn't finalised at script-eval
    // time, especially with the SSR fonts still loading.
    requestAnimationFrame(fitDockItems);

    const ro = new ResizeObserver(fitDockItems);
    ro.observe(dockFit);

    // Watch the wrapper directly. MRU rebuilds replace its children, and
    // SSE-driven data-enabled flips toggle attributes on the tile children
    // (subtree:true so the attribute mutations are caught one level down).
    const itemsWrap = document.getElementById('dock-items');
    if (itemsWrap) {
      const mo = new MutationObserver(fitDockItems);
      mo.observe(itemsWrap, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['data-enabled'],
      });
    }
  }
</script>
