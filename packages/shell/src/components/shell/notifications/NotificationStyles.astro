---
/**
 * Global styles for every notification surface (cards in the list, the
 * phone sheet and the pop-ups). `is:global` because the cards are built at
 * runtime by NotificationCard.ts and carry no Astro scope attribute.
 * House style: square corners, 1px borders, mono font, theme tokens only.
 */
---
<style is:global>
  .aura-sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .aura-ntf svg.aura-icon,
  .notif-center svg.aura-icon {
    width: 1em; height: 1em; flex-shrink: 0;
    stroke: currentColor; fill: none; stroke-width: 2;
    stroke-linecap: round; stroke-linejoin: round;
    vertical-align: -0.125em;
  }

  /* ── Card ─────────────────────────────────────────────────────────── */
  .aura-ntf {
    --ntf-accent: var(--aura-color-border);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 10px 10px 12px;
    background: var(--aura-color-surface);
    color: var(--aura-color-text);
    border: 1px solid var(--aura-color-border);
    border-left: 3px solid var(--ntf-accent);
    font-family: var(--aura-font-mono);
    font-size: var(--aura-font-size-xs, 0.75rem);
    line-height: 1.45;
    text-align: left;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .aura-ntf[data-priority="high"]   { --ntf-accent: var(--aura-color-warning); }
  .aura-ntf[data-priority="urgent"] { --ntf-accent: var(--aura-color-danger); }
  .aura-ntf[data-priority="low"]    { --ntf-accent: color-mix(in srgb, var(--aura-color-border) 60%, transparent); }
  .aura-ntf[data-unseen="true"] {
    background: color-mix(in srgb, var(--aura-color-primary) 8%, var(--aura-color-surface));
    border-color: color-mix(in srgb, var(--aura-color-primary) 55%, var(--aura-color-border));
    border-left-color: var(--ntf-accent);
  }
  .aura-ntf[data-unseen="true"][data-priority="medium"],
  .aura-ntf[data-unseen="true"][data-priority="low"] { --ntf-accent: var(--aura-color-primary); }
  .aura-ntf:focus { outline: none; }
  .aura-ntf:focus-visible { box-shadow: inset 0 0 0 1px var(--aura-color-primary), var(--aura-glow-primary); }
  .aura-ntf[aria-busy="true"] { opacity: 0.7; }

  .aura-ntf-head { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .aura-ntf-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; flex-shrink: 0;
    border: 1px solid var(--aura-color-border);
    color: var(--aura-color-primary);
    font-size: 0.7rem; letter-spacing: 0.04em; font-weight: 500;
    overflow: hidden;
  }
  .aura-ntf-icon img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .aura-ntf-icon svg.aura-icon { width: 16px; height: 16px; }
  .aura-ntf-meta {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px;
    min-width: 0; flex: 1;
    color: var(--aura-color-text-dim);
    text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.68rem;
  }
  .aura-ntf-sender { color: var(--aura-color-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .aura-ntf-sender-detail { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-transform: none; letter-spacing: 0; }
  .aura-ntf-time { white-space: nowrap; }
  .aura-ntf-tags { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
  .aura-ntf-tag {
    padding: 0 4px;
    border: 1px solid var(--aura-color-border);
    color: var(--aura-color-text-dim);
    font-size: 0.62rem; letter-spacing: 0.06em; text-transform: uppercase;
    line-height: 1.5;
  }
  .aura-ntf-tag[data-tag="unverified"] { color: var(--aura-color-warning); border-color: color-mix(in srgb, var(--aura-color-warning) 60%, transparent); }
  .aura-ntf-tag[data-tag="high"]   { color: var(--aura-color-warning); border-color: var(--aura-color-warning); }
  .aura-ntf-tag[data-tag="urgent"] { color: var(--aura-color-bg); background: var(--aura-color-danger); border-color: var(--aura-color-danger); }
  .aura-ntf-tag[data-tag="pinned"], .aura-ntf-tag[data-tag="question"] { color: var(--aura-color-primary); border-color: color-mix(in srgb, var(--aura-color-primary) 60%, transparent); }
  .aura-ntf-unseen-dot { width: 7px; height: 7px; background: var(--aura-color-primary); box-shadow: var(--aura-glow-primary); }

  .aura-ntf-icon-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; flex-shrink: 0; padding: 0;
    background: transparent; color: var(--aura-color-text-dim);
    border: 1px solid transparent; cursor: pointer; font: inherit;
  }
  .aura-ntf-icon-btn:hover, .aura-ntf-icon-btn:focus-visible {
    color: var(--aura-color-primary); border-color: var(--aura-color-primary); outline: none;
  }

  .aura-ntf-title {
    margin: 0; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.02em;
    color: var(--aura-color-text);
  }
  .aura-ntf-text { margin: 0; color: var(--aura-color-text); white-space: pre-wrap; }
  .aura-ntf[data-mode="toast"] .aura-ntf-text {
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .aura-ntf-link { color: var(--aura-color-primary); text-decoration: underline; text-underline-offset: 2px; }
  .aura-ntf-link:focus-visible { outline: 1px solid var(--aura-color-primary); outline-offset: 1px; }
  .aura-ntf-image {
    display: block; max-width: 100%; max-height: 180px; object-fit: contain;
    border: 1px solid var(--aura-color-border); background: var(--aura-color-bg);
  }

  /* ── Controls: the shared aura-ctl family (phase 4) ──────────────────────
     One look for every surface: list, pop-ups, window / floating dialogues,
     desktop decisions, phone sheet and full view. Native inputs restyled
     (appearance:none) so keyboard + screen readers keep working. Theme
     tokens only; square corners, 1px borders. Spacing scale 4 / 6 / 8 / 12. */
  .aura-ntf-body { display: flex; flex-direction: column; gap: 12px; }
  .aura-ntf-body[hidden] { display: none; }
  .aura-ntf-title, .aura-ntf-text, .aura-ctl-input, .aura-ctl-choice-text {
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  .aura-ntf-title { font-size: 0.9rem; line-height: 1.3; }
  .aura-ntf-text { font-size: 0.82rem; line-height: 1.45; }

  .aura-ctl-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .aura-ctl-label {
    color: var(--aura-color-text-dim); font-family: var(--aura-font-mono);
    text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.68rem; line-height: 1.3;
  }
  .aura-ctl-req { color: var(--aura-color-danger); }
  .aura-ctl-input {
    display: block; width: 100%; box-sizing: border-box; min-height: 32px;
    padding: 6px 8px; margin: 0;
    background: var(--aura-color-bg); color: var(--aura-color-text);
    border: 1px solid var(--aura-color-border); border-radius: 0;
    font-size: 0.85rem; line-height: 1.4;
    transition: border-color 0.12s, box-shadow 0.12s;
  }
  textarea.aura-ctl-input { resize: none; min-height: 64px; max-height: 220px; overflow-y: auto; }
  .aura-ctl-input::placeholder { color: var(--aura-color-text-dim); opacity: 1; }
  .aura-ctl-input:hover:not(:disabled) { border-color: color-mix(in srgb, var(--aura-color-primary) 55%, var(--aura-color-border)); }
  .aura-ctl-input:focus { outline: none; border-color: var(--aura-color-primary); box-shadow: var(--aura-glow-primary); }
  .aura-ctl-input[aria-invalid="true"] { border-color: var(--aura-color-danger); box-shadow: var(--aura-glow-danger); }
  .aura-ctl-input:disabled { opacity: 0.5; cursor: not-allowed; }
  .aura-ctl-field-foot { display: flex; justify-content: space-between; gap: 8px; min-height: 0; }
  .aura-ctl-field-foot:has(> :not([hidden])) { min-height: 1em; }
  .aura-ctl-error { margin: 0; color: var(--aura-color-danger); font-size: 0.72rem; }
  .aura-ctl-error[hidden], .aura-ctl-count[hidden] { display: none; }
  .aura-ctl-count { margin-left: auto; color: var(--aura-color-text-dim); font-family: var(--aura-font-mono); font-size: 0.66rem; font-variant-numeric: tabular-nums; }

  /* Select (dropdown) + combobox (searchable), phase 6 — ChoiceField.ts.
     The trigger / text box look like .aura-ctl-input; the list is a fixed
     popup at body level (never clipped by a slot, sheet or dialogue). */
  .aura-ctl-select {
    display: flex; align-items: center; gap: 8px; width: 100%; box-sizing: border-box; min-height: 32px;
    padding: 6px 8px; margin: 0; text-align: left; cursor: pointer;
    background: var(--aura-color-bg); color: var(--aura-color-text);
    border: 1px solid var(--aura-color-border); border-radius: 0;
    font: inherit; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; font-size: 0.85rem; line-height: 1.4;
    transition: border-color 0.12s, box-shadow 0.12s;
  }
  .aura-ctl-select-value { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .aura-ctl-select[data-empty="true"] .aura-ctl-select-value { color: var(--aura-color-text-dim); }
  .aura-ctl-select-chev, .aura-ctl-combo-toggle::before {
    flex: none; width: 7px; height: 7px; margin: 0 2px 3px;
    border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg); color: var(--aura-color-text-dim); transition: transform 0.12s;
  }
  .aura-ctl-select[aria-expanded="true"] .aura-ctl-select-chev,
  .aura-ctl-combo-toggle[aria-expanded="true"]::before { transform: rotate(-135deg); margin-bottom: -3px; }
  .aura-ctl-select:hover:not(:disabled) { border-color: color-mix(in srgb, var(--aura-color-primary) 55%, var(--aura-color-border)); }
  .aura-ctl-select:focus-visible, .aura-ctl-select[aria-expanded="true"] { outline: none; border-color: var(--aura-color-primary); box-shadow: var(--aura-glow-primary); }
  .aura-ctl-select[aria-invalid="true"] { border-color: var(--aura-color-danger); box-shadow: var(--aura-glow-danger); }
  .aura-ctl-select:disabled { opacity: 0.5; cursor: not-allowed; }
  .aura-ctl-combo { position: relative; display: flex; }
  .aura-ctl-combo-input { padding-right: 30px; }
  .aura-ctl-combo-toggle {
    position: absolute; top: 1px; right: 1px; bottom: 1px; width: 28px; padding: 0; margin: 0;
    display: flex; align-items: center; justify-content: center; cursor: pointer;
    background: transparent; border: 0; border-left: 1px solid var(--aura-color-border); border-radius: 0; color: var(--aura-color-text-dim);
  }
  .aura-ctl-combo-toggle::before { content: ''; display: block; }
  .aura-ctl-combo-toggle:hover { color: var(--aura-color-primary); }
  .aura-ctl-listbox {
    position: fixed; z-index: 2000; box-sizing: border-box; margin: 0; padding: 2px 0; list-style: none;
    overflow-y: auto; overscroll-behavior: contain;
    background: var(--aura-color-surface); color: var(--aura-color-text);
    border: 1px solid var(--aura-color-primary); border-radius: 0; box-shadow: var(--aura-glow-subtle);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; font-size: 0.85rem;
  }
  .aura-ctl-option {
    display: flex; align-items: center; gap: 8px; min-height: 30px; padding: 4px 10px 4px 22px;
    cursor: pointer; position: relative; line-height: 1.3; user-select: none;
  }
  .aura-ctl-option-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .aura-ctl-option[aria-selected="true"] { color: var(--aura-color-primary); font-weight: 600; }
  .aura-ctl-option[aria-selected="true"]::before {
    content: ''; position: absolute; left: 8px; top: 50%; width: 4px; height: 8px; margin-top: -6px;
    border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg);
  }
  .aura-ctl-option[data-active="true"] { background: color-mix(in srgb, var(--aura-color-primary) 16%, transparent); outline: 1px solid var(--aura-color-primary); outline-offset: -1px; }
  .aura-ctl-option[data-custom="true"] { font-style: italic; color: var(--aura-color-text-dim); }
  .aura-ctl-listbox-empty { padding: 6px 10px; color: var(--aura-color-text-dim); font-size: 0.8rem; }
  @media (pointer: coarse), (max-width: 640px) {
    .aura-ctl-option { min-height: 40px; }
    .aura-ctl-select, .aura-ctl-combo-input { min-height: 40px; }
    .aura-ctl-combo-toggle { width: 40px; }
    .aura-ctl-combo-input { padding-right: 44px; }
  }
  @media (prefers-reduced-motion: reduce) { .aura-ctl-select-chev, .aura-ctl-combo-toggle::before { transition: none; } }

  /* Groups */
  .aura-ctl-group { margin: 0; padding: 0; border: 0; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .aura-ctl-group > legend:not(.aura-sr-only) { padding: 0; margin: 0 0 6px; float: left; width: 100%; }
  .aura-ctl-group > legend + * { clear: both; }
  .aura-ctl-choices { display: flex; flex-direction: column; gap: 2px; }
  .aura-ctl-group[data-style="segmented"] .aura-ctl-choices { flex-direction: row; flex-wrap: wrap; gap: 0; }

  /* Checkbox rows (multiple choice): the whole row is the label. */
  .aura-ctl-choice {
    display: flex; align-items: center; gap: 8px; min-height: 30px; padding: 2px 6px; margin: 0 -6px;
    cursor: pointer; color: var(--aura-color-text);
  }
  .aura-ctl-choice:hover { background: color-mix(in srgb, var(--aura-color-primary) 8%, transparent); }
  .aura-ctl-choice-text { font-size: 0.84rem; line-height: 1.3; }
  /* Radio / checkbox lists (phase 6 display): label + optional description. */
  .aura-ctl-choice-body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .aura-ctl-choice-desc { color: var(--aura-color-text-dim); font-size: 0.74rem; line-height: 1.3; }
  .aura-ctl-group:is([data-style="radio"], [data-style="list"]) .aura-ctl-choice:has(.aura-ctl-choice-desc) { align-items: flex-start; padding-top: 5px; padding-bottom: 5px; }
  .aura-ctl-group:is([data-style="radio"], [data-style="list"]) .aura-ctl-choice:has(.aura-ctl-choice-desc) :is(.aura-ctl-radio, .aura-ctl-check) { margin-top: 1px; }
  .aura-ctl-group[data-style="radio"] .aura-ctl-choice-text,
  .aura-ctl-group[data-style="list"] .aura-ctl-choice:has(.aura-ctl-choice-desc) .aura-ctl-choice-text { font-weight: 550; }
  .aura-ctl-group[data-style="radio"] .aura-ctl-choice:has(.aura-ctl-radio:checked) { background: color-mix(in srgb, var(--aura-color-primary) 10%, transparent); }
  .aura-ctl-group[data-style="radio"] .aura-ctl-choice:has(.aura-ctl-radio:checked) .aura-ctl-choice-text { color: var(--aura-color-primary); }
  .aura-ctl-choice:has(:disabled) { cursor: not-allowed; opacity: 0.6; }
  .aura-ctl-choice:has(:disabled):hover { background: transparent; }
  @media (pointer: coarse), (max-width: 640px) { .aura-ctl-group:is([data-style="radio"], [data-style="list"]) .aura-ctl-choice { min-height: 40px; } }
  .aura-ctl-check, .aura-ctl-radio {
    appearance: none; -webkit-appearance: none; margin: 0; flex-shrink: 0;
    width: 16px; height: 16px; position: relative; cursor: pointer;
    background: var(--aura-color-bg); border: 1px solid var(--aura-color-text-dim);
    transition: background-color 0.12s, border-color 0.12s, box-shadow 0.12s;
  }
  .aura-ctl-radio { border-radius: 50%; }
  .aura-ctl-check:checked { background: var(--aura-color-primary); border-color: var(--aura-color-primary); }
  .aura-ctl-check:checked::after {
    content: ''; position: absolute; left: 4px; top: 1px; width: 5px; height: 9px;
    border: solid var(--aura-color-bg); border-width: 0 2px 2px 0; transform: rotate(45deg);
  }
  .aura-ctl-radio:checked { border-color: var(--aura-color-primary); }
  .aura-ctl-radio:checked::after {
    content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--aura-color-primary);
  }
  .aura-ctl-choice:hover .aura-ctl-check:not(:checked):not(:disabled),
  .aura-ctl-choice:hover .aura-ctl-radio:not(:checked):not(:disabled) { border-color: var(--aura-color-primary); }
  .aura-ctl-check:focus-visible, .aura-ctl-radio:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--aura-color-bg), var(--aura-glow-primary); border-color: var(--aura-color-primary); }
  .aura-ctl-check:disabled, .aura-ctl-radio:disabled { opacity: 0.45; cursor: not-allowed; }
  .aura-ctl-group[aria-invalid="true"] .aura-ctl-check, .aura-ctl-group[aria-invalid="true"] .aura-ctl-radio { border-color: var(--aura-color-danger); }

  /* Segmented control (single choice ≤ 4): square chips, the chosen one filled. */
  .aura-ctl-seg {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    min-height: 30px; padding: 4px 12px; cursor: pointer; flex: 1 1 auto;
    border: 1px solid var(--aura-color-border); margin: 0 -1px -1px 0;
    background: transparent; color: var(--aura-color-text);
    transition: background-color 0.12s, color 0.12s, box-shadow 0.12s;
  }
  .aura-ctl-seg .aura-ctl-radio { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; margin: 0; border: 0; border-radius: 0; cursor: pointer; }
  .aura-ctl-seg .aura-ctl-radio::after { content: none; }
  .aura-ctl-seg .aura-ctl-choice-text { position: relative; pointer-events: none; text-align: center; }
  .aura-ctl-seg:hover { background: color-mix(in srgb, var(--aura-color-primary) 10%, transparent); border-color: color-mix(in srgb, var(--aura-color-primary) 55%, var(--aura-color-border)); z-index: 1; }
  .aura-ctl-seg:has(.aura-ctl-radio:checked) { background: var(--aura-color-primary); color: var(--aura-color-bg); border-color: var(--aura-color-primary); z-index: 2; }
  .aura-ctl-seg:has(.aura-ctl-radio:focus-visible) { box-shadow: var(--aura-glow-primary); border-color: var(--aura-color-primary); z-index: 3; }
  .aura-ctl-seg:has(.aura-ctl-radio:disabled) { opacity: 0.45; cursor: not-allowed; }

  /* Progress */
  .aura-ntf-progress { display: flex; flex-direction: column; gap: 4px; }
  .aura-ntf-progress-row { display: flex; justify-content: space-between; gap: 8px; color: var(--aura-color-text-dim); font-size: 0.7rem; }
  .aura-ntf-progress-label { font-family: var(--aura-font-mono); text-transform: uppercase; letter-spacing: 0.05em; }
  .aura-ntf-progress-pct { font-family: var(--aura-font-mono); font-variant-numeric: tabular-nums; color: var(--aura-color-text); }
  .aura-ntf-progress-track { position: relative; height: 6px; border: 1px solid var(--aura-color-border); background: var(--aura-color-bg); overflow: hidden; }
  .aura-ntf-progress-fill { height: 100%; background: var(--aura-color-primary); box-shadow: var(--aura-glow-subtle); transition: width 0.35s ease-out; }
  .aura-ntf-progress[data-indeterminate="true"] .aura-ntf-progress-fill {
    width: 100%;
    background: repeating-linear-gradient(-45deg,
      var(--aura-color-primary) 0 8px,
      color-mix(in srgb, var(--aura-color-primary) 35%, transparent) 8px 16px);
    background-size: 22.6px 22.6px;
    animation: aura-ntf-stripe 0.8s linear infinite;
  }
  @keyframes aura-ntf-stripe { to { background-position: 22.6px 0; } }
  @media (prefers-reduced-motion: reduce) {
    .aura-ntf-progress[data-indeterminate="true"] .aura-ntf-progress-fill { animation: none; }
    .aura-ntf-progress-fill { transition: none; }
  }

  /* Buttons: primary filled, secondary outlined, tertiary text-only. */
  .aura-ctl-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
  .aura-ctl-btn {
    position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    min-height: 32px; padding: 6px 14px; cursor: pointer;
    font: inherit; font-family: var(--aura-font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em;
    border: 1px solid var(--aura-color-border); border-radius: 0;
    background: transparent; color: var(--aura-color-text);
    transition: background-color 0.12s, border-color 0.12s, box-shadow 0.12s, transform 0.05s;
  }
  .aura-ctl-btn[data-variant="secondary"] { border-color: color-mix(in srgb, var(--aura-color-primary) 60%, var(--aura-color-border)); color: var(--aura-color-primary); }
  .aura-ctl-btn[data-variant="primary"] { background: var(--aura-color-primary); border-color: var(--aura-color-primary); color: var(--aura-color-bg); font-weight: 600; }
  .aura-ctl-btn[data-variant="tertiary"] { border-color: transparent; color: var(--aura-color-text-dim); text-decoration: underline; text-underline-offset: 3px; padding-inline: 6px; }
  .aura-ctl-btn:hover:not(:disabled) { border-color: var(--aura-color-primary); box-shadow: var(--aura-glow-primary); }
  .aura-ctl-btn[data-variant="secondary"]:hover:not(:disabled) { background: color-mix(in srgb, var(--aura-color-primary) 10%, transparent); }
  .aura-ctl-btn[data-variant="tertiary"]:hover:not(:disabled) { color: var(--aura-color-primary); box-shadow: none; border-color: transparent; }
  .aura-ctl-btn:active:not(:disabled) { transform: translateY(1px); }
  .aura-ctl-btn:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--aura-color-bg), var(--aura-glow-primary); border-color: var(--aura-color-primary); }
  .aura-ctl-btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .aura-ctl-btn[data-loading="true"] { opacity: 1; cursor: progress; }
  .aura-ctl-btn[data-loading="true"] .aura-ctl-btn-label { visibility: hidden; }
  .aura-ctl-btn[data-loading="true"]::after {
    content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 12px; margin: -7px 0 0 -7px;
    border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%;
    animation: aura-ctl-spin 0.7s linear infinite;
  }
  @keyframes aura-ctl-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .aura-ctl-btn[data-loading="true"]::after { animation-duration: 2s; } }
  /* While one action is in flight, no second submit. */
  .aura-ntf[aria-busy="true"] .aura-ctl-btn { pointer-events: none; }
  .aura-ctl-btn svg.aura-icon { width: 0.95em; height: 0.95em; }

