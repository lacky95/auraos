  .aura-dlg-appbar-att { font-family: var(--aura-font-mono); font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.06em; padding: 1px 4px; border: 1px solid var(--aura-color-border); }
  .aura-dlg-appbar-att[data-verified="false"] { color: var(--aura-color-warning); border-color: var(--aura-color-warning); }
