---
/**
 * NotificationDialogs — mounts the dialogue layer (phase 4): dialogues over
 * their own window (WindowDialog), floating / phone sheet / full view
 * (FloatingDialog) and AuraOS desktop decisions (DesktopDecision). Placement
 * rules: lib/notifications/dialogs.ts; DOM wiring: DialogLayer.ts.
 * Renders nothing itself — every node is created at runtime.
 */
import NotificationStyles from './NotificationStyles.astro';
---
<NotificationStyles />
<script>
  import { mountDialogLayer } from './DialogLayer.ts';

  const dispose = mountDialogLayer();
  if (import.meta.hot) import.meta.hot.dispose(dispose);
  document.addEventListener('aura:notifications.teardown', dispose, { once: true });
</script>
