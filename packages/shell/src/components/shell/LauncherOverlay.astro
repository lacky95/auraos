---
/**
 * Slide-in launcher panel. Lives inside the running shell page (not a separate
 * route), so opening it does NOT tear down other in-page state like the
 * ProcessManager panel or live SSE connections. Clicking an app delegates to
 * `window.auraLaunchApp` (defined on the home page) which spawns the instance
 * with the boot-skeleton flow and updates the layout in place.
 */
import type { AppManifest } from '@aura/core';
import { getAppManager } from '@aura/core';

// SSR EVERY installed app (incl. disabled) so live enable/disable toggles
// can flip visibility without a server round-trip — the script block at the
// bottom listens for `app:enabledChanged` on the OS event bus and just
// flips data-enabled on the matching tile. CSS hides `[data-enabled=false]`.
const mgr = getAppManager();
// Services are headless components with no UI surface. Their launcher tile
// would only ever produce the SERVICE-HAS-NO-UI placeholder when clicked,
// so we hide them from the grid entirely. Start/stop is done from Process
// Manager (or the CLI). Activity-only apps that bundle a service still
// show up here — only the `componentType: 'service'` apps are filtered.
const apps: AppManifest[] = mgr.getManifests().filter((m) => m.componentType !== 'service');
const enabledMap: Record<string, boolean> = mgr.getEnabledState();
---
<aside id="lo-panel" class="lo-panel" aria-hidden="true">
  <header class="lo-header">
    <span class="lo-title">▦ LAUNCH APP</span>
    <button id="lo-close" class="lo-close" title="Close launcher (Esc)">✕</button>
  </header>
  <input id="lo-search" class="lo-search" type="text" placeholder="SEARCH APPS..." autocomplete="off" />
  <div id="lo-grid" class="lo-grid">
    {apps.map(app => {
      const glyph = (app.icon ?? app.name.charAt(0)).toUpperCase();
      const enabled = enabledMap[app.id] !== false;
      return (
        <button class="lo-app" data-app-id={app.id} data-enabled={String(enabled)} title={app.name}>
          <span class="lo-app-initial" data-len={glyph.length}>{glyph}</span>
          <span class="lo-app-name">{app.name}</span>
          <span class="lo-app-id">{app.id}</span>
        </button>
      );
    })}
  </div>

  <!--
    Right-click context menu. Positioned with inline top/left on each open
    and hidden by default. The submenu (workspace picker) is populated from
    the live workspaceClient cache the moment the user hovers/clicks the
    parent item, so it always reflects current workspace names.
  -->
  <div id="lo-ctx" class="lo-ctx" role="menu" hidden>
    <button class="lo-ctx-item" data-action="open" role="menuitem">Open</button>
    <div class="lo-ctx-submenu-wrap">
      <button class="lo-ctx-item lo-ctx-has-sub" data-action="open-in-ws" role="menuitem" aria-haspopup="true" aria-expanded="false">
        <span>Open in workspace</span>
        <span class="lo-ctx-chev">▸</span>
      </button>
      <div id="lo-ctx-submenu" class="lo-ctx-submenu" role="menu" hidden></div>
    </div>
  </div>
</aside>

<style is:global>
  /* All selectors are lo-* prefixed; global to dodge any Astro scoping edge
     cases (and to keep the panel visible even if rendered via fragments). */
  /* Anchors + chrome mirror the Process Manager's panel
   * (#pm-panel, see ProcessManager.astro) so both side panels behave
   * identically — same top/bottom inset, same z-index, same drop
   * shadow. The OSLayout autohide-mode override flips top/bottom to 0
   * for both panels uniformly. */
  .lo-panel {
    position: fixed;
    top: var(--aura-statusbar-height);
    left: 0;
    bottom: var(--aura-dock-height);
    width: 420px;
    max-width: 92%;  /* % not vw — body is scaled by the shell zoom */
    background: var(--aura-color-surface);
    border-right: var(--aura-border);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.15s ease-out;
    box-shadow: 8px 0 32px rgba(0, 0, 0, 0.4);
  }
  .lo-panel[aria-hidden="false"] { transform: translateX(0); }

  .lo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    height: 36px;
    background: var(--aura-color-surface-2);
    border-bottom: var(--aura-border);
    flex-shrink: 0;
  }
  .lo-title {
    font-size: var(--aura-font-size-sm);
    color: var(--aura-color-primary);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .lo-close {
    background: transparent;
    border: var(--aura-border);
    color: var(--aura-color-text-dim);
    cursor: pointer;
    font-family: var(--aura-font-mono);
    font-size: var(--aura-font-size-xs);
    padding: 2px 10px;
  }
  .lo-close:hover,
  .lo-close:focus,
  .lo-close:focus-visible {
    color: var(--aura-color-danger);
    box-shadow: var(--aura-glow-danger);
    outline: none;
  }
  .lo-close:focus-visible {
    box-shadow: inset 0 0 0 2px var(--aura-color-danger), var(--aura-glow-danger);
  }

  .lo-search {
    margin: 10px 12px;
    background: var(--aura-color-surface-2);
    border: var(--aura-border);
    color: var(--aura-color-text);
    font-family: var(--aura-font-mono);
    font-size: var(--aura-font-size-sm);
    padding: 8px 12px;
    outline: none;
    flex-shrink: 0;
    transition: box-shadow 0.1s;
  }
  .lo-search:focus { box-shadow: var(--aura-glow-primary); border-color: var(--aura-color-primary); }
  .lo-search::placeholder { color: var(--aura-color-text-dim); }

  .lo-grid {
    flex: 1;
    overflow-y: auto;
    padding: 0 12px 12px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 6px;
    align-content: start;
  }

  .lo-app {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 10px 6px;
    background: transparent;
    border: var(--aura-border);
    color: var(--aura-color-text);
    cursor: pointer;
    font-family: var(--aura-font-mono);
    transition: box-shadow 0.1s, color 0.1s;
    text-align: center;
    min-width: 0;
  }
  .lo-app:hover,
  .lo-app:focus,
  .lo-app:focus-visible {
    box-shadow: var(--aura-glow-primary);
    color: var(--aura-color-primary);
    outline: none;
  }
  /* Keyboard focus has a stronger ring so it's distinguishable from hover. */
  .lo-app:focus-visible {
    box-shadow: inset 0 0 0 2px var(--aura-color-primary), var(--aura-glow-primary);
  }
  .lo-app[hidden] { display: none; }
  /* Disabled apps stay out of the launcher entirely (matches Android's
     "hide on disable" semantics the user picked). Flipped live via the
     `app:enabledChanged` SSE handler at the bottom of this file. */
  .lo-app[data-enabled="false"] { display: none; }

  .lo-app-initial {
    /* Uniform size across 1/2/3-char glyphs; sized to fit "SET" in the overlay tile. */
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--aura-color-primary);
    line-height: 1;
    font-weight: 500;
  }
  .lo-app-name {
    font-size: var(--aura-font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .lo-app-id {
    font-size: 0.55rem;
    color: var(--aura-color-text-dim);
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  /* ── Right-click context menu ──
   * Positioned with inline top/left set by the contextmenu handler. The
   * submenu opens to the right of its parent row (or to the left when
   * there's not enough room — handled in JS). Submenu items are workspace
   * targets, populated live from workspaceClient.getCached(). */
  .lo-ctx {
    position: absolute;
    z-index: 1200;
    min-width: 180px;
    background: var(--aura-color-surface);
    border: var(--aura-border);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    padding: 4px;
    display: flex;
    flex-direction: column;
    font-family: var(--aura-font-mono);
    font-size: var(--aura-font-size-xs);
  }
  .lo-ctx[hidden] { display: none; }
  .lo-ctx-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 10px;
    background: transparent;
    border: none;
    color: var(--aura-color-text);
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .lo-ctx-item:hover {
    background: color-mix(in srgb, var(--aura-color-primary) 14%, transparent);
    color: var(--aura-color-primary);
  }
  .lo-ctx-chev {
    color: var(--aura-color-text-dim);
    font-size: 0.7rem;
  }
  .lo-ctx-submenu-wrap { position: relative; }
  .lo-ctx-submenu {
    position: absolute;
    top: 0;
    left: 100%;
    margin-left: 2px;
    min-width: 200px;
    background: var(--aura-color-surface);
    border: var(--aura-border);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    padding: 4px;
    display: flex;
    flex-direction: column;
    z-index: 1201;
    max-height: 320px;
    overflow-y: auto;
  }
  .lo-ctx-submenu[data-flip="left"] {
    left: auto;
    right: 100%;
    margin-left: 0;
    margin-right: 2px;
  }
  .lo-ctx-submenu[hidden] { display: none; }
  .lo-ctx-ws {
    display: grid;
    grid-template-columns: 24px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 5px 10px;
    background: transparent;
    border: none;
    color: var(--aura-color-text);
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: 0.06em;
  }
  .lo-ctx-ws:hover {
    background: color-mix(in srgb, var(--aura-color-primary) 14%, transparent);
    color: var(--aura-color-primary);
  }
  .lo-ctx-ws-slot {
    color: var(--aura-color-primary);
    font-weight: 700;
  }
  .lo-ctx-ws[data-active="true"] .lo-ctx-active-mark {
    color: var(--aura-color-primary);
  }
  .lo-ctx-active-mark { color: transparent; font-size: 0.7rem; }
  .lo-ctx-ws-name {
    text-transform: uppercase;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<script>
  import { getKeyDispatcher } from '../../lib/keyDispatcher.ts';
  const keyDispatcher = getKeyDispatcher();

  const panel  = document.getElementById('lo-panel') as HTMLElement;
  const close  = document.getElementById('lo-close')  as HTMLButtonElement;
  const search = document.getElementById('lo-search') as HTMLInputElement;
  const grid   = document.getElementById('lo-grid')   as HTMLElement;

  function openPanel() {
    panel.setAttribute('aria-hidden', 'false');
    search.value = '';
    grid.querySelectorAll<HTMLElement>('.lo-app').forEach(el => el.hidden = false);
    // defer focus until the slide-in starts, so the focus ring doesn't trigger
    // a layout shift mid-animation
    requestAnimationFrame(() => search.focus());
  }
  function closePanel() { panel.setAttribute('aria-hidden', 'true'); }
  // Variant used when the close came from the user dismissing the panel
  // (✕ button, Esc) — returns keyboard focus to the dock's chrome-nav
  // anchor so arrows continue from a stable spot. Launching an app uses
  // the plain `closePanel()` so the iframe can claim focus instead.
  function closePanelAndReturnFocus() {
    closePanel();
    (document.getElementById('dock-nav-entry')
      ?? document.getElementById('dock-launcher-btn'))?.focus();
  }

  (window as any).auraToggleLauncher = () => {
    if (panel.getAttribute('aria-hidden') === 'false') closePanel(); else openPanel();
  };
  (window as any).auraOpenLauncher  = openPanel;
  (window as any).auraCloseLauncher = closePanel;

  close.addEventListener('click', closePanelAndReturnFocus);

  // Dispatcher: Ctrl+Alt+Space (default) and Ctrl+Alt+C (alt) drop
  // keyboard focus on the FIRST item of the bottom bar — the narrow `◐`
  // chip just before the launcher. From there ArrowRight walks the dock
  // (launcher → PM → app tiles), ArrowUp jumps to the status bar, and
  // Enter activates window-selection mode (handled in Dock.astro).
  //
  // The combo is the universal "back out to the bar" key — whatever modal
  // state is on (launcher panel OR window-selection nav mode), drop it
  // and land focus on the chip so the user has a predictable anchor.
  const focusBarStart = () => {
    if (panel.getAttribute('aria-hidden') === 'false') closePanel();
    // Window-selection mode exit: if the dispatcher is currently in Nav
    // mode (entered via the chip + Enter, or via aura.nav.home), drop
    // back to App mode so the highlight clears. The chrome chip itself
    // then gets focused below, giving the user the same end state as
    // Esc or click-outside.
    if (keyDispatcher.getMode() === 'nav') keyDispatcher.setMode('app');
    const first = (document.getElementById('dock-nav-entry')
      ?? document.getElementById('dock-launcher-btn')) as HTMLButtonElement | null;
    first?.focus();
  };
  keyDispatcher.bind('aura.launcher.toggle',     focusBarStart);
  keyDispatcher.bind('aura.launcher.toggle-alt', focusBarStart);

  // Esc-to-close is a panel-local concern, not an OS action — kept as a
  // plain DOM listener so it only consumes the keystroke while the
  // launcher is open. Doesn't fight with `aura.nav.back`.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel.getAttribute('aria-hidden') === 'false') {
      e.preventDefault();
      // Esc closes the context menu first if it's open; otherwise the panel.
      if (!ctxMenu.hidden) { closeCtxMenu(); return; }
      closePanelAndReturnFocus();
    }
  });

  // ─── Right-click context menu ──────────────────────────────────────────
  // Two entries:
  //   • Open                — same as a plain click
  //   • Open in workspace ▸ — submenu listing every workspace; clicking one
  //                           switches to that workspace AND launches there.
  //
  // The submenu is rebuilt on every open from workspaceClient.getCached() so
  // it always reflects the user's current workspace list (incl. renames).
  const ctxMenu    = document.getElementById('lo-ctx')          as HTMLElement;
  const ctxSubmenu = document.getElementById('lo-ctx-submenu')  as HTMLElement;
  const ctxOpenInWs = ctxMenu.querySelector<HTMLButtonElement>('[data-action="open-in-ws"]')!;
  let ctxAppId: string | null = null;

  function openCtxMenu(appId: string, x: number, y: number) {
    ctxAppId = appId;
    ctxMenu.hidden = false;
    ctxMenu.style.left = `${x}px`;
    ctxMenu.style.top  = `${y}px`;
    // Position adjust if it would overflow the panel's right/bottom edge.
    requestAnimationFrame(() => {
      const r = ctxMenu.getBoundingClientRect();
      const p = panel.getBoundingClientRect();
      if (r.right > p.right - 4)  ctxMenu.style.left = `${x - (r.right - (p.right - 4))}px`;
      if (r.bottom > p.bottom - 4) ctxMenu.style.top = `${y - (r.bottom - (p.bottom - 4))}px`;
    });
    // Reset submenu visibility — open closed by default; user clicks/hovers
    // the parent row to expand.
    ctxSubmenu.hidden = true;
    ctxOpenInWs.setAttribute('aria-expanded', 'false');
  }
  function closeCtxMenu() {
    ctxMenu.hidden = true;
    ctxSubmenu.hidden = true;
    ctxOpenInWs.setAttribute('aria-expanded', 'false');
    ctxAppId = null;
  }

  // Build the workspace submenu on demand. Each row shows the slot number,
  // the workspace name, and a "●" marker on the currently active one.
  async function showWorkspaceSubmenu() {
    const wsClient = await import('../../lib/workspaceClient.ts');
    const state = wsClient.getCached() ?? (await wsClient.refresh().catch(() => null));
    if (!state) return;
    const rows = state.workspaces.map((w, i) => {
      const active = w.id === state.activeWorkspaceId;
      return `<button type="button" class="lo-ctx-ws" role="menuitem"
                      data-ws-id="${w.id}" data-active="${active}"
                      title="Launch in ${escapeAttr(w.name)}">
        <span class="lo-ctx-ws-slot">${i + 1}</span>
        <span class="lo-ctx-ws-name">${escapeHtml(w.name)}</span>
        <span class="lo-ctx-active-mark" aria-hidden="true">●</span>
      </button>`;
    }).join('');
    ctxSubmenu.innerHTML = rows;
    ctxSubmenu.hidden = false;
    ctxOpenInWs.setAttribute('aria-expanded', 'true');

    // Edge flip: if the submenu would overflow the panel's right edge, flip
    // it to the parent's left side instead.
    requestAnimationFrame(() => {
      const r = ctxSubmenu.getBoundingClientRect();
      const p = panel.getBoundingClientRect();
      ctxSubmenu.dataset['flip'] = r.right > p.right - 4 ? 'left' : '';
    });
  }
  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  function escapeAttr(s: string): string {
    return escapeHtml(s).replace(/"/g, '&quot;');
  }

  // Right-click on a tile → open menu. Use clientX/Y relative to the panel
  // (the panel is fixed-positioned, and the context menu is absolutely-
  // positioned inside it, so panel-local coords land in the right spot).
  grid.addEventListener('contextmenu', (e) => {
    const tile = (e.target as HTMLElement).closest<HTMLElement>('.lo-app');
    if (!tile) return;
    e.preventDefault();
    const appId = tile.dataset['appId'];
    if (!appId) return;
    const p = panel.getBoundingClientRect();
    openCtxMenu(appId, e.clientX - p.left, e.clientY - p.top);
  });

  // "Open" entry: same path as a left click on the tile.
  // "Open in workspace ▸" entry: build + reveal the submenu.
  ctxMenu.addEventListener('click', (e) => {
    const item = (e.target as HTMLElement).closest<HTMLElement>('[data-action]');
    if (!item) return;
    const action = item.dataset['action'];
    if (action === 'open') {
      const id = ctxAppId;
      closeCtxMenu();
      if (id) (window as any).auraLaunchApp?.(id);
      closePanel();
      return;
    }
    if (action === 'open-in-ws') {
      void showWorkspaceSubmenu();
      return;
    }
  });

  // Workspace-target click inside the submenu.
  ctxSubmenu.addEventListener('click', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLElement>('.lo-ctx-ws');
    const wsId = row?.dataset['wsId'];
    if (!wsId || !ctxAppId) return;
    const appId = ctxAppId;
    closeCtxMenu();
    (window as any).auraLaunchApp?.(appId, { workspaceId: wsId });
    closePanel();
  });

  // Click anywhere outside the menu (including a different tile) dismisses.
  panel.addEventListener('click', (e) => {
    if (ctxMenu.hidden) return;
    if (ctxMenu.contains(e.target as Node)) return;
    closeCtxMenu();
  });
  // Suppress the browser's native context menu on rest of the panel so
  // right-clicking outside a tile doesn't show the OS menu inside our chrome.
  panel.addEventListener('contextmenu', (e) => {
    if ((e.target as HTMLElement).closest('.lo-app')) return; // tile handler runs
    e.preventDefault();
    closeCtxMenu();
  });

  search.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    grid.querySelectorAll<HTMLElement>('.lo-app').forEach(el => {
      const name = el.querySelector('.lo-app-name')?.textContent?.toLowerCase() ?? '';
      const id   = el.dataset['appId']?.toLowerCase() ?? '';
      el.hidden = q !== '' && !name.includes(q) && !id.includes(q);
    });
    // If the user was on a tile that just got filtered out, leave focus on
    // the search field — they're mid-typing. Don't auto-jump back into the
    // grid; that would steal their cursor.
    const focused = document.activeElement as HTMLElement | null;
    if (focused && focused.classList.contains('lo-app') && focused.hidden) {
      search.focus();
    }
  });

  grid.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-app-id]');
    const appId = btn?.dataset['appId'];
    if (!appId) return;
    const launch = (window as any).auraLaunchApp;
    if (typeof launch === 'function') {
      launch(appId);
      closePanel();
    } else {
      // Fallback for pages that don't define the rich in-place launcher
      // (e.g. standalone routes). POST the start, then go home.
      void fetch(`/api/apps/${appId}/start`, { method: 'POST' }).finally(() => {
        window.location.href = '/';
      });
    }
  });

  // ─── Keyboard navigation ───────────────────────────────────────────────
  // Search input + grid form a single composer:
  //   • Type to filter, ArrowDown / Enter inside the search field moves
  //     focus down to the first visible app (then arrow + Enter to pick).
  //     `Enter` doesn't directly launch — it's the "commit search, start
  //     navigating" gesture; the user can still launch from the search
  //     field via Ctrl+Enter.
  //   • Inside the grid: Arrow keys move focus geometrically (Left/Right
  //     within a row, Up/Down across rows). Enter on a focused tile
  //     fires its native click (the browser does this for us via
  //     <button> semantics).
  //   • ArrowUp from the first row returns focus to the search input.
  function visibleTiles(): HTMLElement[] {
    return Array.from(grid.querySelectorAll<HTMLElement>('.lo-app'))
      .filter((el) => !el.hidden && el.dataset['enabled'] !== 'false');
  }
  function focusFirstTile(): boolean {
    const t = visibleTiles()[0];
    if (!t) return false;
    t.focus();
    return true;
  }
  // Geometric next-tile-in-direction. Uses bounding rects so the user's
  // actual visual layout is what we navigate, not a hardcoded column count
  // (the grid is `auto-fill, minmax(96px, 1fr)` so columns vary by panel
  // width). For Left/Right we prefer same-row neighbours; for Up/Down we
  // pick the nearest tile on the prev/next row, biased to similar X.
  function nextTile(current: HTMLElement, dir: 'up' | 'down' | 'left' | 'right'): HTMLElement | null {
    const tiles = visibleTiles();
    if (tiles.length === 0) return null;
    const cur = current.getBoundingClientRect();
    const cx  = cur.left + cur.width  / 2;
    const cy  = cur.top  + cur.height / 2;
    // Row tolerance: half the tile height. Anything whose center Y is
    // within that of the current tile is "same row".
    const rowTol = cur.height / 2;
    let best: HTMLElement | null = null;
    let bestCost = Infinity;
    for (const t of tiles) {
      if (t === current) continue;
      const r = t.getBoundingClientRect();
      const tx = r.left + r.width  / 2;
      const ty = r.top  + r.height / 2;
      const dx = tx - cx;
      const dy = ty - cy;
      let cost = Infinity;
      if (dir === 'left'  && dx < 0 && Math.abs(dy) <= rowTol)  cost = -dx + Math.abs(dy) * 4;
      if (dir === 'right' && dx > 0 && Math.abs(dy) <= rowTol)  cost =  dx + Math.abs(dy) * 4;
      if (dir === 'up'    && dy < -rowTol)                       cost = -dy + Math.abs(dx) * 2;
      if (dir === 'down'  && dy >  rowTol)                       cost =  dy + Math.abs(dx) * 2;
      if (cost < bestCost) { bestCost = cost; best = t; }
    }
    return best;
  }

  // Vertical focus chain (top → bottom): close button → search → first tile.
  // The two non-grid stops are the close button (header) and the search
  // input (under the header); ArrowUp/Down on either jumps along the chain
  // so a user can reach Close without taking their hands off the arrows.
  //
  //   • Search:  ArrowDown → first tile.  ArrowUp → close button.  Enter → first tile.
  //   • Close:   ArrowDown → search input.  ArrowUp → no-op (top of chain).
  //   • Grid:    ArrowUp from top row → search input.  (See grid handler.)
  search.addEventListener('keydown', (e) => {
    // Ctrl+Enter: skip the focus step and launch the first match directly.
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
      const first = visibleTiles()[0];
      const appId = first?.dataset['appId'];
      if (!appId) return;
      const launch = (window as any).auraLaunchApp;
      if (typeof launch === 'function') { launch(appId); closePanel(); }
      e.preventDefault(); e.stopPropagation();
      return;
    }
    if (e.key === 'Enter' || e.key === 'ArrowDown') {
      if (focusFirstTile()) { e.preventDefault(); e.stopPropagation(); }
      return;
    }
    if (e.key === 'ArrowUp') {
      close.focus();
      e.preventDefault(); e.stopPropagation();
    }
  });
  // Close button: ArrowDown drops back into the search field, Enter (native
  // button click) actually closes the panel.
  close.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      search.focus(); search.select();
      e.preventDefault(); e.stopPropagation();
    }
  });

  // Grid-level keydown: arrow keys move geometric focus; Enter falls
  // through to native button click; ArrowUp from the top row returns
  // to the search input.
  grid.addEventListener('keydown', (e) => {
    const current = (e.target as HTMLElement).closest<HTMLElement>('.lo-app');
    if (!current) return;
    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight' || e.key === 'ArrowUp' || e.key === 'ArrowDown') {
      const dirMap: Record<string, 'left' | 'right' | 'up' | 'down'> = {
        ArrowLeft: 'left', ArrowRight: 'right', ArrowUp: 'up', ArrowDown: 'down',
      };
      const next = nextTile(current, dirMap[e.key]!);
      if (next) { next.focus(); e.preventDefault(); e.stopPropagation(); }
      else if (e.key === 'ArrowUp') {
        // Top row, going further up → back to the search field.
        search.focus();
        search.select();
        e.preventDefault(); e.stopPropagation();
      }
    }
  });

  // ─── Live enable/disable + install/remove updates ─────────────────────────
  // Two cases the launcher reacts to:
  //   • app:enabledChanged — flip data-enabled on the tile in place (CSS does
  //     the rest). No re-fetch needed since the tile already exists in SSR
  //     (we ship every installed app, not just enabled ones).
  //   • app:installed / app:removed — re-fetch /api/apps and rebuild the
  //     grid. Cheap (~5 KB), simpler than reasoning about insertion order.
  // Transport is socket.io via osEvents (same channel the desktop already
  // uses for app:* / activity:* / workspaces:* updates).
  import('../../lib/osEvents.ts').then(({ osEvents }) => {
    osEvents.subscribe(['app:enabledChanged', 'app:installed', 'app:removed'], (ev: any) => {
      if (ev.type === 'app:enabledChanged' && typeof ev.appId === 'string' && typeof ev.enabled === 'boolean') {
        const tile = grid.querySelector<HTMLElement>(`.lo-app[data-app-id="${CSS.escape(ev.appId)}"]`);
        if (tile) tile.dataset['enabled'] = String(ev.enabled);
        return;
      }
      if (ev.type === 'app:installed' || ev.type === 'app:removed') {
        void rebuildGrid();
      }
    });
  });

  /**
   * Reload the launcher tiles from /api/apps. Only used on install/remove
   * (the much rarer event) — enable/disable just flips an attribute above.
   */
  async function rebuildGrid(): Promise<void> {
    try {
      const r = await fetch('/api/apps');
      if (!r.ok) return;
      const apps = (await r.json() as Array<{
        manifest: { id: string; name: string; icon?: string; componentType?: 'activity' | 'service' };
        enabled: boolean;
      }>)
        // Services are headless — see the SSR filter at the top of this
        // file for the rationale.
        .filter((a) => a.manifest.componentType !== 'service');
      // Sort by name to match the SSR ordering (alphabetical via Object key
      // iteration order; getManifests doesn't guarantee, but that's close).
      apps.sort((a, b) => a.manifest.name.localeCompare(b.manifest.name));
      grid.innerHTML = apps.map((a) => {
        const m = a.manifest;
        const glyph = (m.icon ?? m.name.charAt(0)).toUpperCase();
        const safeId   = m.id.replace(/[<>&"']/g, '');
        const safeName = m.name.replace(/[<>&]/g, '');
        return `<button class="lo-app" data-app-id="${safeId}" data-enabled="${a.enabled}" title="${safeName}">
          <span class="lo-app-initial" data-len="${glyph.length}">${glyph}</span>
          <span class="lo-app-name">${safeName}</span>
          <span class="lo-app-id">${safeId}</span>
        </button>`;
      }).join('');
    } catch {
      /* network blip — leave the current grid alone, the next SSE event triggers a retry */
    }
  }
</script>
