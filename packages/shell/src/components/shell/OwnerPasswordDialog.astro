---
/**
 * The shell's one owner dialog. A password is typed only here, in the shell's
 * own document, never into an app's page on its App Host. Three modes:
 *
 *   password  Settings → Users & Identities asks with
 *             `aura.account.password.request` (change the password)
 *   policy    `aura.account.policy.request {policy}` (confirm a policy change)
 *             Both get back only `{ok, error?}`; the shell posts to its own
 *             `/api/auth/*` routes with the owner's login cookie.
 *   approval  an owner approval (5.10): an install, an Aura Context write, an
 *             app's `osClient.user.confirm` (D49). They arrive from the
 *             server's pending list (a Terminal agent, the CLI) or from an App
 *             Host window (`aura.approval.request`, `aura.user.confirm.request`)
 *             naming an approval of its own app. The text is the server's
 *             display; the requester's words only as a labelled reason.
 *             Approve wakes after APPROVE_DELAY_MS, `fresh` asks for the
 *             password (over HTTP with a small note; when the owner
 *             requires HTTPS, not there at all: `aura approve <id>`, D63),
 *             Escape denies, and "Deny and block" stops the app asking. An app gets back only the outcome (dialogClient.ts).
 *             A `credential.store` (D56, `osClient.credentials.request`,
 *             `aura secret ask`) also asks for the secret itself: it is typed
 *             only here and posted with Approve straight to the owner's
 *             vault; the requester gets back a handle, never the value.
 *
 * The policy change shown is computed here, from the shell's own read of the
 * current policy and its own check of the requested one, never from the
 * requester's wording. A native modal `<dialog>` sits in the browser's top
 * layer, above every z-index and the auto-hide badge, and makes the rest of
 * the desktop inert like the SystemModal, in front of an open SystemModal
 * (which waits behind it); it steps aside while the screen is locked. The behaviour, keyboard included, is lib/approvals/ownerDialog.ts.
 * The global reset's `margin: 0` would pin a dialog to the top left, so it
 * centres itself and scrolls inside when the screen is short.
 */
---
<dialog id="aura-owner-password" role="dialog" aria-modal="true" aria-labelledby="aura-owner-password-title" aria-describedby="aura-owner-password-intro">
  <form id="aura-owner-password-form">
    <div id="aura-owner-password-title"></div>
    <p id="aura-owner-password-intro"></p>
    <section id="aura-owner-password-risk" hidden aria-labelledby="aura-owner-password-risk-title">
      <div id="aura-owner-password-risk-title">HIGH RISK</div>
      <ul id="aura-owner-password-risk-list"></ul>
    </section>
    <ul id="aura-owner-password-changes" hidden></ul>
    <p id="aura-owner-password-reason" hidden>
      <span class="aura-owner-password-reason-label">In the app's own words (not checked by AuraOS):</span>
      <span id="aura-owner-password-reason-text"></span>
    </p>
    <label id="aura-owner-password-current-label"><span id="aura-owner-password-current-caption">Current password</span>
      <span id="aura-owner-password-current-note" hidden></span>
      <input id="aura-owner-password-current" type="password" autocomplete="current-password" spellcheck="false" />
    </label>
    <label id="aura-owner-password-secret-label" hidden><span id="aura-owner-password-secret-caption">Secret</span>
      <input id="aura-owner-password-secret" type="password" autocomplete="off" spellcheck="false" />
    </label>
    <p id="aura-owner-password-secret-notice" hidden></p>
    <div id="aura-owner-password-new-fields">
      <label>New password
        <input id="aura-owner-password-next" type="password" autocomplete="new-password" spellcheck="false" />
      </label>
      <label>Repeat new password
        <input id="aura-owner-password-confirm" type="password" autocomplete="new-password" spellcheck="false" />
      </label>
      <p id="aura-owner-password-hint"></p>
    </div>
    <p id="aura-owner-password-error" role="alert" hidden></p>
    <div class="aura-owner-password-actions">
      <button type="button" id="aura-owner-password-block" hidden>DENY AND BLOCK THIS APP</button>
      <button type="button" id="aura-owner-password-cancel">CANCEL</button>
      <button type="submit" id="aura-owner-password-submit">SAVE</button>
    </div>
  </form>
</dialog>

<script>
  import { initOwnerDialog } from '../../lib/approvals/ownerDialog.ts';
  initOwnerDialog();
</script>

<style is:global>
  #aura-owner-password {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(460px, calc(100vw - 32px));
    height: fit-content;
    max-height: calc(100vh - 32px);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    overscroll-behavior: contain;
    box-sizing: border-box;
    padding: 16px;
    background: var(--aura-color-surface);
    color: var(--aura-color-text);
    border: 1px solid var(--aura-color-warning);
    font-family: var(--aura-font-mono);
    font-size: 0.8rem;
  }
  #aura-owner-password::backdrop { background: color-mix(in srgb, var(--aura-color-bg) 88%, transparent); }
  #aura-owner-password-title { color: var(--aura-color-warning); font-weight: 700; letter-spacing: 0.08em; }
  #aura-owner-password label { display: block; margin-top: 8px; }
  #aura-owner-password [hidden] { display: none; }
  #aura-owner-password input {
    width: 100%;
    box-sizing: border-box;
    margin-top: 2px;
    padding: 6px 8px;
    background: var(--aura-color-bg);
    color: var(--aura-color-text);
    border: var(--aura-border);
    font: inherit;
  }
  #aura-owner-password-changes { margin: 8px 0; padding-left: 18px; color: var(--aura-color-primary); }
  /* The server's high-risk review (lib/approvals/display.ts installRisks): first, and unmistakable. */
  #aura-owner-password-risk { margin: 8px 0; padding: 6px 8px; border: 1px solid var(--aura-color-danger, #ff4a4a); }
  #aura-owner-password-risk-title { color: var(--aura-color-danger, #ff4a4a); font-weight: 700; letter-spacing: 0.08em; }
  #aura-owner-password-risk-list { margin: 4px 0 0; padding-left: 18px; }
  #aura-owner-password-risk-list li { overflow-wrap: anywhere; margin-top: 4px; }
  .aura-owner-password-risk-item { display: block; color: var(--aura-color-danger, #ff4a4a); font-weight: 700; }
  .aura-owner-password-risk-why { display: block; opacity: 0.85; }
  #aura-owner-password-hint { color: var(--aura-color-text-muted, inherit); opacity: 0.8; }
  #aura-owner-password-reason { margin: 8px 0; padding: 6px 8px; border-left: 2px solid var(--aura-color-warning); }
  .aura-owner-password-reason-label { display: block; opacity: 0.75; font-size: 0.72rem; }
  #aura-owner-password-reason-text { white-space: pre-wrap; overflow-wrap: anywhere; }
  #aura-owner-password-changes li { overflow-wrap: anywhere; }
  #aura-owner-password-error { color: var(--aura-color-danger, #ff4a4a); }
  #aura-owner-password-secret-notice { margin: 4px 0 0; color: var(--aura-color-warning); font-size: 0.8rem; }
  #aura-owner-password-current-note { opacity: 0.75; font-size: 0.72rem; }
  .aura-owner-password-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; margin-top: 12px; }
  #aura-owner-password-block { margin-right: auto; color: var(--aura-color-danger, #ff4a4a); }
  .aura-owner-password-actions button {
    padding: 4px 12px;
    background: transparent;
    color: var(--aura-color-primary);
    border: var(--aura-border);
    font: inherit;
    cursor: pointer;
  }
  .aura-owner-password-actions button:disabled { opacity: 0.5; cursor: default; }
  #aura-owner-password:focus { outline: none; }
  #aura-owner-password :is(button, input):focus {
    outline: 2px solid var(--aura-color-primary);
    outline-offset: 2px;
  }
</style>
