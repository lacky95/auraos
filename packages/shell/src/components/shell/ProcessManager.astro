---
/**
 * Slide-in panel listing every running app instance with controls:
 *   FOCUS — promote to fullscreen focus mode (above the layout)
 *   STOP  — graceful lifecycle stop (onPause → onStop → onDestroy → SIGTERM)
 *   KILL  — immediate SIGKILL, no hooks
 *
 * The panel is empty in SSR — populated client-side from /api/apps and refreshed
 * via the SSE stream from /api/apps/events.
 */
---
<button id="pm-toggle" class="pm-toggle" title="Process Manager (running apps)" aria-expanded="false" aria-controls="pm-panel">
  <span class="pm-toggle-icon">▦</span>
</button>

<aside id="pm-panel" class="pm-panel" aria-hidden="true">
  <header class="pm-header">
    <div class="pm-header-title">
      <span class="pm-icon">▦</span>
      <div class="pm-filter-group" role="group" aria-label="Section filter">
        <button type="button" class="pm-filter-btn" data-filter="apps"     data-active="true"  title="Show user apps (foreground processes)">
          <span class="pm-filter-label">APPS</span>
          <span class="pm-filter-count" id="pm-filter-count-apps">0</span>
        </button>
        <button type="button" class="pm-filter-btn" data-filter="services" data-active="false" title="Show headless services (background)">
          <span class="pm-filter-label">SVC</span>
          <span class="pm-filter-count" id="pm-filter-count-services">0</span>
        </button>
      </div>
    </div>
    <div class="pm-header-actions">
      <div class="pm-view-toggle" role="group" aria-label="View mode">
        <button type="button" class="pm-view-btn" data-view="cards" data-active="true" title="Card view">▦</button>
        <button type="button" class="pm-view-btn" data-view="list"  data-active="false" title="List view">☰</button>
      </div>
      <button id="pm-close" class="pm-close" title="Close (Esc)">✕</button>
    </div>
  </header>
  <ul id="pm-list" class="pm-list">
    <li class="pm-empty">
      <div class="pm-empty-icon">○</div>
      <div class="pm-empty-text">NO ACTIVE PROCESSES</div>
      <div class="pm-empty-hint">// LAUNCH AN APP TO BEGIN</div>
    </li>
  </ul>
  <footer class="pm-footer">
    <span id="pm-count" class="pm-stats">0 INST · 0 ACT</span>
    <button id="pm-refresh" class="pm-foot-btn" title="Reload list">↻ REFRESH</button>
  </footer>
</aside>

<style is:global>
  /* All selectors below are pm-* prefixed. We need `is:global` because the
     cards are built via innerHTML in the script — those elements don't get
     Astro's auto-injected `data-astro-cid-*` scope attribute, so a scoped
     style block would leave them unstyled. */
  /* ============ Toggle button (sits in the status bar) ============ */
  .pm-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--aura-color-secondary);
    background: transparent;
    border: var(--aura-border);
    cursor: pointer;
    flex-shrink: 0;
    font-family: var(--aura-font-mono);
    font-size: 1.2rem;
    transition: box-shadow 0.1s, color 0.1s;
    position: relative;
  }
  .pm-toggle:hover { box-shadow: var(--aura-glow-secondary); color: var(--aura-color-primary); }
  .pm-toggle[data-has-instances="true"]::after {
    content: '';
    position: absolute;
    top: 4px;
    right: 4px;
    width: 6px;
    height: 6px;
    background: var(--aura-color-primary);
    box-shadow: var(--aura-glow-primary);
    border-radius: 50%;
    animation: pm-pulse 1.6s ease-in-out infinite;
  }
  .pm-toggle-icon { line-height: 1; }

  /* ============ Panel shell ============ */
  .pm-panel {
    position: fixed;
    top: var(--aura-statusbar-height);
    right: 0;
    bottom: var(--aura-dock-height);
    width: 420px;
    max-width: 92%;  /* % not vw — body is scaled by the shell zoom */
    background: var(--aura-color-surface);
    border-left: var(--aura-border);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    /* `visibility: hidden` (not just the off-screen transform) is what pulls
       the closed panel out of the TAB ORDER and the accessibility tree — a
       translated element is still focusable, so without this, Tab from the
       dock could land on the invisible FOCUS/STOP/KILL buttons. The 0.15s
       visibility delay on the CLOSED state keeps the panel visible through
       the slide-out animation, then flips it hidden once the transform has
       finished; opening makes it visible immediately (no delay). */
    visibility: hidden;
    transition: transform 0.15s ease-out, visibility 0s linear 0.15s;
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.4);
    will-change: transform;
  }
  .pm-panel[aria-hidden="false"] {
    transform: translateX(0);
    visibility: visible;
    transition: transform 0.15s ease-out, visibility 0s;
  }

  .pm-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    height: 40px;
    background: var(--aura-color-surface-2);
    border-bottom: var(--aura-border);
    flex-shrink: 0;
  }
  .pm-header-title { display: flex; align-items: center; gap: 8px; }
  .pm-icon { color: var(--aura-color-primary); font-size: 1rem; line-height: 1; }
  .pm-title {
    font-size: var(--aura-font-size-sm);
    color: var(--aura-color-primary);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 500;
  }
  .pm-close {
    background: transparent;
    border: var(--aura-border);
    color: var(--aura-color-text-dim);
    cursor: pointer;
    font-family: var(--aura-font-mono);
    font-size: var(--aura-font-size-xs);
    padding: 3px 10px;
    transition: color 0.1s, box-shadow 0.1s;
  }
  .pm-close:hover { color: var(--aura-color-danger); box-shadow: var(--aura-glow-danger); }

  /* ============ List + cards ============ */
  .pm-list {
    flex: 1;
    overflow-y: auto;
    list-style: none;
    margin: 0;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Section header — separates APPS from SERVICES in the panel list. */
  .pm-section-head {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 6px 2px;
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--aura-color-text-dim);
    border-bottom: 1px dashed var(--aura-color-border);
    margin-top: 4px;
  }
  .pm-section-head:first-child { margin-top: 0; }
  .pm-section-count {
    color: var(--aura-color-secondary);
    font-weight: bold;
  }

  /* Empty state */
  .pm-empty {
    list-style: none;
    margin: auto 0;
    padding: 32px 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--aura-color-text-dim);
  }
  .pm-empty-icon {
    font-size: 3rem;
    line-height: 1;
    color: var(--aura-color-border);
    animation: pm-pulse 2s ease-in-out infinite;
  }
  .pm-empty-text {
    font-size: var(--aura-font-size-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--aura-color-text);
  }
  .pm-empty-hint {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--aura-color-text-dim);
  }

  /* Instance card */
  .pm-card {
    list-style: none;
    background: var(--aura-color-surface-2);
    border: 1px solid var(--aura-color-border);
    display: flex;
    flex-direction: column;
    transition: border-color 0.1s, box-shadow 0.1s;
  }
  .pm-card:hover {
    border-color: color-mix(in srgb, var(--aura-color-primary) 60%, var(--aura-color-border));
    box-shadow: var(--aura-glow-subtle);
  }

  .pm-card-head {
    display: grid;
    grid-template-columns: 36px 1fr auto;
    gap: 10px;
    align-items: center;
    padding: 10px;
  }
  .pm-card-initial {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--aura-font-mono);
    /* Uniform size across 1/2/3-char glyphs; sized to fit "SET" in the 36×36 card initial. */
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    font-weight: 700;
    color: var(--aura-color-primary);
    border: 1px solid var(--aura-color-primary);
    background: color-mix(in srgb, var(--aura-color-primary) 12%, transparent);
    text-transform: uppercase;
    line-height: 1;
    flex-shrink: 0;
  }
  .pm-card-title { min-width: 0; }
  .pm-card-name {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--aura-font-size-sm);
    color: var(--aura-color-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pm-card-meta {
    margin-top: 3px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 0.6rem;
    color: var(--aura-color-text-dim);
    letter-spacing: 0.04em;
  }
  .pm-card-meta span::before { content: attr(data-label); color: var(--aura-color-border); margin-right: 4px; }

  /* State chip */
  .pm-state-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    border: 1px solid currentColor;
  }
  .pm-state-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  /* Running / resumed */
  .pm-state-chip[data-state="resumed"] {
    color: var(--aura-color-primary);
    background: color-mix(in srgb, var(--aura-color-primary) 14%, transparent);
  }
  .pm-state-chip[data-state="resumed"] .pm-state-dot {
    box-shadow: 0 0 6px currentColor;
    animation: pm-pulse 1.6s ease-in-out infinite;
  }
  /* Paused */
  .pm-state-chip[data-state="paused"],
  .pm-state-chip[data-state="pausing"] {
    color: var(--aura-color-secondary);
    background: color-mix(in srgb, var(--aura-color-secondary) 14%, transparent);
  }
  /* Booting (any pre-resumed lifecycle state) */
  .pm-state-chip[data-state="creating"],
  .pm-state-chip[data-state="created"],
  .pm-state-chip[data-state="starting"],
  .pm-state-chip[data-state="started"],
  .pm-state-chip[data-state="resuming"] {
    color: var(--aura-color-text-dim);
    background: var(--aura-color-bg);
  }
  .pm-state-chip[data-state="creating"] .pm-state-dot,
  .pm-state-chip[data-state="created"] .pm-state-dot,
  .pm-state-chip[data-state="starting"] .pm-state-dot,
  .pm-state-chip[data-state="started"] .pm-state-dot,
  .pm-state-chip[data-state="resuming"] .pm-state-dot {
    animation: pm-pulse 0.8s ease-in-out infinite;
  }
  /* Shutting down */
  .pm-state-chip[data-state="stopping"],
  .pm-state-chip[data-state="stopped"],
  .pm-state-chip[data-state="destroying"],
  .pm-state-chip[data-state="destroyed"] {
    color: var(--aura-color-text-dim);
    background: var(--aura-color-bg);
    opacity: 0.7;
  }
  /* Error */
  .pm-state-chip[data-state="error"],
  .pm-state-chip[data-state="crashed"] {
    color: var(--aura-color-danger);
    background: color-mix(in srgb, var(--aura-color-danger) 14%, transparent);
  }

  .pm-bg-badge {
    font-size: 0.5rem;
    color: var(--aura-color-secondary);
    border: 1px solid var(--aura-color-secondary);
    padding: 1px 4px;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  /* Activities nested inside the card */
  .pm-activities {
    border-top: 1px dashed var(--aura-color-border);
    padding: 8px 10px;
  }
  .pm-activities-head {
    font-size: 0.55rem;
    color: var(--aura-color-text-dim);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .pm-activities-head::before {
    content: '';
    flex: 0 0 10px;
    height: 1px;
    background: var(--aura-color-border);
  }
  .pm-activity-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pm-activity {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px;
    padding: 6px 8px;
    background: var(--aura-color-bg);
    border: 1px solid var(--aura-color-border);
    align-items: center;
    transition: border-color 0.1s;
  }
  .pm-activity:hover { border-color: var(--aura-color-secondary); }
  .pm-activity-info { min-width: 0; }
  .pm-activity-title {
    font-size: 0.72rem;
    color: var(--aura-color-secondary);
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pm-activity-id {
    margin-top: 2px;
    font-size: 0.55rem;
    color: var(--aura-color-text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pm-activity-actions { display: flex; gap: 3px; }

  /* Action buttons (card-level + activity-level icon buttons) */
  .pm-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 8px 10px;
    border-top: 1px dashed var(--aura-color-border);
  }
  .pm-action-btn {
    background: transparent;
    border: 1px solid var(--aura-color-border);
    color: var(--aura-color-text-dim);
    font-family: var(--aura-font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    padding: 5px 12px;
    cursor: pointer;
    text-transform: uppercase;
    transition: color 0.1s, border-color 0.1s, box-shadow 0.1s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .pm-action-btn:hover {
    color: var(--aura-color-primary);
    border-color: var(--aura-color-primary);
    box-shadow: var(--aura-glow-subtle);
  }
  .pm-action-btn[data-variant="warn"]:hover {
    color: var(--aura-color-secondary);
    border-color: var(--aura-color-secondary);
    box-shadow: var(--aura-glow-secondary);
  }
  .pm-action-btn[data-variant="danger"]:hover {
    color: var(--aura-color-danger);
    border-color: var(--aura-color-danger);
    box-shadow: var(--aura-glow-danger);
  }
  .pm-action-btn[disabled] { opacity: 0.4; cursor: wait; }
  .pm-action-btn-spacer { flex: 1; }
  /* Keyboard-focus ring across every button in the PM panel so the
     arrow-nav target is visible. Same inset-ring pattern the dock /
     statusbar use; tinted to match each button's hover variant. */
  #pm-panel button:focus,
  #pm-panel button:focus-visible { outline: none; }
  #pm-panel button:focus-visible {
    box-shadow: inset 0 0 0 2px var(--aura-color-primary), var(--aura-glow-subtle);
    color: var(--aura-color-primary);
    border-color: var(--aura-color-primary);
  }
  #pm-panel .pm-action-btn[data-variant="warn"]:focus-visible {
    box-shadow: inset 0 0 0 2px var(--aura-color-secondary), var(--aura-glow-secondary);
    color: var(--aura-color-secondary);
    border-color: var(--aura-color-secondary);
  }
  #pm-panel .pm-action-btn[data-variant="danger"]:focus-visible {
    box-shadow: inset 0 0 0 2px var(--aura-color-danger), var(--aura-glow-danger);
    color: var(--aura-color-danger);
    border-color: var(--aura-color-danger);
  }
  #pm-panel #pm-close:focus-visible {
    box-shadow: inset 0 0 0 2px var(--aura-color-danger), var(--aura-glow-danger);
    color: var(--aura-color-danger);
  }

  .pm-icon-btn {
    width: 24px;
    height: 24px;
    padding: 0;
    font-size: 0.7rem;
    line-height: 1;
    justify-content: center;
  }

  /* Footer */
  .pm-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 12px;
    height: 32px;
    border-top: var(--aura-border);
    background: var(--aura-color-surface-2);
    flex-shrink: 0;
  }
  .pm-stats {
    font-size: 0.6rem;
    color: var(--aura-color-text-dim);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pm-foot-btn {
    background: transparent;
    border: var(--aura-border);
    color: var(--aura-color-text-dim);
    font-family: var(--aura-font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    padding: 3px 12px;
    cursor: pointer;
    text-transform: uppercase;
    transition: color 0.1s, box-shadow 0.1s;
  }
  .pm-foot-btn:hover { color: var(--aura-color-primary); box-shadow: var(--aura-glow-subtle); }

  @keyframes pm-pulse {
    0%, 100% { opacity: 1;   }
    50%      { opacity: 0.35; }
  }

  /* ============ Section filter pills (header) ============ */
  /* PROC / SVC toggles. Active = primary, inactive = dim border-only. Each
   * pill carries its own count badge so the user sees at a glance whether
   * a section has anything before toggling it on. */
  .pm-filter-group {
    display: inline-flex;
    border: var(--aura-border);
  }
  .pm-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 12px;
    background: transparent;
    border: none;
    color: var(--aura-color-text-dim);
    font-family: var(--aura-font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.1s, background 0.1s;
    line-height: 1;
  }
  .pm-filter-btn + .pm-filter-btn { border-left: 1px solid var(--aura-color-border); }
  .pm-filter-btn:hover { color: var(--aura-color-primary); }
  .pm-filter-btn[data-active="true"] {
    color: var(--aura-color-bg);
    background: var(--aura-color-primary);
  }
  .pm-filter-btn[data-active="true"] .pm-filter-count { color: var(--aura-color-bg); }
  .pm-filter-count {
    min-width: 14px;
    text-align: center;
    padding: 1px 4px;
    background: color-mix(in srgb, currentColor 18%, transparent);
    color: var(--aura-color-text);
    font-weight: 600;
    font-size: 0.58rem;
  }

  /* ============ View-mode toggle (header) ============ */
  .pm-header-actions { display: flex; align-items: center; gap: 8px; }
  .pm-view-toggle {
    display: inline-flex;
    border: var(--aura-border);
  }
  .pm-view-btn {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--aura-color-text-dim);
    font-family: var(--aura-font-mono);
    font-size: 0.85rem;
    cursor: pointer;
    transition: color 0.1s, background 0.1s;
    padding: 0;
    line-height: 1;
  }
  .pm-view-btn + .pm-view-btn { border-left: 1px solid var(--aura-color-border); }
  .pm-view-btn:hover { color: var(--aura-color-primary); }
  .pm-view-btn[data-active="true"] {
    color: var(--aura-color-bg);
    background: var(--aura-color-primary);
  }

  /* ============ List view (dense, ps-like rows) ============ */
  .pm-list[data-view="list"] {
    padding: 0;
    gap: 0;
  }
  .pm-listrow {
    list-style: none;
    display: grid;
    grid-template-columns: 16px 1fr auto;
    gap: 8px;
    align-items: center;
    padding: 6px 10px;
    border-bottom: 1px solid var(--aura-color-border);
    transition: background 0.1s;
  }
  .pm-listrow:hover { background: var(--aura-color-surface-2); }

  .pm-listrow-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--aura-color-text-dim);
    justify-self: center;
  }
  .pm-listrow[data-state="resumed"] .pm-listrow-dot {
    background: var(--aura-color-primary);
    box-shadow: 0 0 6px var(--aura-color-primary);
    animation: pm-pulse 1.6s ease-in-out infinite;
  }
  .pm-listrow[data-state="paused"]   .pm-listrow-dot,
  .pm-listrow[data-state="pausing"]  .pm-listrow-dot { background: var(--aura-color-secondary); }
  .pm-listrow[data-state="error"]    .pm-listrow-dot,
  .pm-listrow[data-state="crashed"]  .pm-listrow-dot { background: var(--aura-color-danger); }
  .pm-listrow[data-state="creating"]  .pm-listrow-dot,
  .pm-listrow[data-state="created"]   .pm-listrow-dot,
  .pm-listrow[data-state="starting"]  .pm-listrow-dot,
  .pm-listrow[data-state="started"]   .pm-listrow-dot,
  .pm-listrow[data-state="resuming"]  .pm-listrow-dot { animation: pm-pulse 0.8s ease-in-out infinite; }

  .pm-listrow-info { min-width: 0; }
  .pm-listrow-line1 {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    color: var(--aura-color-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pm-listrow-state-label {
    font-size: 0.55rem;
    color: var(--aura-color-text-dim);
    letter-spacing: 0.1em;
    padding-left: 6px;
    border-left: 1px solid var(--aura-color-border);
  }
  .pm-listrow[data-state="error"]   .pm-listrow-state-label,
  .pm-listrow[data-state="crashed"] .pm-listrow-state-label { color: var(--aura-color-danger); }

  .pm-listrow-line2 {
    margin-top: 2px;
    font-size: 0.55rem;
    color: var(--aura-color-text-dim);
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: flex;
    gap: 10px;
  }

  .pm-listrow-actions {
    display: flex;
    gap: 2px;
  }
  .pm-listrow-actions .pm-action-btn {
    padding: 0;
    width: 22px;
    height: 22px;
    font-size: 0.7rem;
    justify-content: center;
    line-height: 1;
  }

  /* Activity sub-row in list view: indented, no dot, muted */
  .pm-listrow-act {
    grid-template-columns: 16px 1fr auto;
    padding: 4px 10px 4px 32px;
    background: rgba(0, 0, 0, 0.18);
  }
  .pm-listrow-act:hover { background: var(--aura-color-surface-2); }
  .pm-listrow-arrow {
    color: var(--aura-color-text-dim);
    font-size: 0.8rem;
    line-height: 1;
    justify-self: center;
  }
  .pm-listrow-act .pm-listrow-line1 {
    color: var(--aura-color-secondary);
    text-transform: none;
    letter-spacing: 0.04em;
    font-size: 0.65rem;
  }

  /* Cards view is the default; this rule pins it explicitly so toggling
     back from list re-applies the card spacing without a full re-render. */
  .pm-list[data-view="cards"] {
    padding: 10px;
    gap: 10px;
  }
</style>

<script>
  import { getKeyDispatcher } from '../../lib/keyDispatcher.ts';
  import { osEvents } from '../../lib/osEvents.ts';
  const keyDispatcher = getKeyDispatcher();

  interface InstanceListItem {
    instanceId: string;
    appId: string;
    state: string;
    pid: number | null;
    port: number | null;
    /** True for AppManager warm-pool members; not shown in this panel. */
    inPool?: boolean;
  }
  interface ActivityListItem {
    activityId: string;
    parentInstanceId: string;
    appId: string;
    path: string;
    title?: string;
  }
  interface ManifestLite {
    id: string;
    name: string;
    activityMode: 'none' | 'multi';
    backgroundService: boolean;
    themeStrategy?: 'inherit' | 'themed' | 'override';
    /** 'activity' (default) or 'service' — services render under their own header. */
    componentType?: 'activity' | 'service';
  }

  const toggleBtn   = document.getElementById('pm-toggle') as HTMLButtonElement;
  const panel       = document.getElementById('pm-panel') as HTMLElement;

  // Reparent the slide-in panel to <body> so it's a top-level
  // position:fixed element — same setup as LauncherOverlay's #lo-panel.
  // The panel is declared inside <ProcessManager /> for source-locality
  // (toggle + panel + script live together), but rendered nested inside
  // <nav id="dock">. The dock has `overflow: hidden` (responsive-trim
  // safety net) and the desktop body carries a `transform: scale(z)` in
  // zoom mode — together that combination makes pm-panel's slide-in
  // animation ripple into the surrounding layout instead of just
  // overlaying. Mounting at body root matches the launcher's working
  // structure: the fixed panel anchors to body cleanly and the
  // background stays still.
  if (panel && panel.parentNode !== document.body) {
    document.body.appendChild(panel);
  }
  const closeBtn    = document.getElementById('pm-close') as HTMLButtonElement;
  const list        = document.getElementById('pm-list') as HTMLUListElement;
  const count       = document.getElementById('pm-count') as HTMLElement;
  const refresh     = document.getElementById('pm-refresh') as HTMLButtonElement;
  const viewBtns    = document.querySelectorAll<HTMLButtonElement>('.pm-view-btn');
  const filterBtns  = document.querySelectorAll<HTMLButtonElement>('.pm-filter-btn');
  // Lazy-getters: the panel HTML may not have been parsed yet at module
  // init time (Vite SSR + island hydration ordering), and a cached null
  // would persist forever. Re-query each refresh so a late-mounted node
  // is still found.
  const filterCount = {
    get apps()     { return document.getElementById('pm-filter-count-apps'); },
    get services() { return document.getElementById('pm-filter-count-services'); },
  };

  let manifests = new Map<string, ManifestLite>();

  // Cache the last fetched payload so toggling the view doesn't trigger a
  // fresh /api/apps fetch.
  let lastInstances:  InstanceListItem[] = [];
  let lastActivities: ActivityListItem[] = [];

  type ViewMode = 'cards' | 'list';
  const VIEW_STORAGE_KEY = 'aura.pm.viewMode';
  let viewMode: ViewMode = (() => {
    try {
      const saved = localStorage.getItem(VIEW_STORAGE_KEY);
      return saved === 'list' ? 'list' : 'cards';
    } catch { return 'cards'; }
  })();
  list.dataset['view'] = viewMode;
  viewBtns.forEach(b => {
    b.dataset['active'] = (b.dataset['view'] === viewMode) ? 'true' : 'false';
  });

  function setViewMode(mode: ViewMode) {
    if (mode === viewMode) return;
    viewMode = mode;
    list.dataset['view'] = mode;
    viewBtns.forEach(b => {
      b.dataset['active'] = (b.dataset['view'] === mode) ? 'true' : 'false';
    });
    try { localStorage.setItem(VIEW_STORAGE_KEY, mode); } catch {}
    render(lastInstances, lastActivities);
  }

  viewBtns.forEach(b => {
    b.addEventListener('click', () => setViewMode(b.dataset['view'] as ViewMode));
  });

  // Section filters (PROC / SVC). Default: apps visible, services hidden —
  // services are background plumbing the user rarely needs to see.
  type FilterKey = 'apps' | 'services';
  const FILTER_STORAGE_KEY = 'aura.pm.filters';
  const filters: Record<FilterKey, boolean> = (() => {
    try {
      const saved = JSON.parse(localStorage.getItem(FILTER_STORAGE_KEY) ?? '');
      if (saved && typeof saved.apps === 'boolean' && typeof saved.services === 'boolean') return saved;
    } catch {}
    return { apps: true, services: false };
  })();
  function applyFilterButtonState() {
    filterBtns.forEach(b => {
      const key = b.dataset['filter'] as FilterKey;
      b.dataset['active'] = filters[key] ? 'true' : 'false';
    });
  }
  applyFilterButtonState();
  filterBtns.forEach(b => {
    b.addEventListener('click', () => {
      const key = b.dataset['filter'] as FilterKey;
      filters[key] = !filters[key];
      applyFilterButtonState();
      try { localStorage.setItem(FILTER_STORAGE_KEY, JSON.stringify(filters)); } catch {}
      render(lastInstances, lastActivities);
    });
  });

  async function openPanel(): Promise<void> {
    panel.setAttribute('aria-hidden', 'false');
    toggleBtn.setAttribute('aria-expanded', 'true');
    await refreshList();
    // Land focus on a useful starting point so arrows immediately work.
    // Prefer the first instance's FOCUS action (the user typically opens
    // the PM to act on a process); fall back to the close button so the
    // panel still has a focused element when the list is empty.
    const firstAction = panel.querySelector<HTMLButtonElement>('.pm-card [data-action="focus"], .pm-listrow [data-action="focus"]');
    if (firstAction) firstAction.focus({ preventScroll: true });
    else closeBtn.focus({ preventScroll: true });
  }
  function closePanel() {
    panel.setAttribute('aria-hidden', 'true');
    toggleBtn.setAttribute('aria-expanded', 'false');
  }
  // Variant used when the close came from the user dismissing the panel
  // (✕ button, Esc) — returns keyboard focus to the dock's chrome-nav
  // anchor so arrows can continue from a stable spot. Action paths
  // (FOCUS, etc.) call plain `closePanel()` so the targeted iframe can
  // claim focus instead.
  function closePanelAndReturnFocus() {
    closePanel();
    (document.getElementById('dock-nav-entry')
      ?? document.getElementById('dock-launcher-btn'))?.focus();
  }

  toggleBtn.addEventListener('click', () => {
    if (panel.getAttribute('aria-hidden') === 'false') closePanel();
    else openPanel();
  });
  closeBtn.addEventListener('click', closePanelAndReturnFocus);
  refresh.addEventListener('click', refreshList);

  // Toggle via dispatcher (default combo: Ctrl+Alt+M, remappable in Settings).
  keyDispatcher.bind('aura.processmanager.toggle', () => {
    if (panel.getAttribute('aria-hidden') === 'false') closePanel();
    else openPanel();
  });

  // Panel-local Esc-to-close stays as a plain DOM listener — it's a
  // contextual behavior of the open panel, not an OS action. Only consumes
  // the keystroke while the panel is visible, so it doesn't compete with
  // the dispatcher's `aura.nav.back` (which keeps Android-style semantics
  // for the focused app/nav).
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel.getAttribute('aria-hidden') === 'false') {
      e.preventDefault();
      closePanelAndReturnFocus();
    }
  });

  // ─── Row-aware arrow navigation ───────────────────────────────────────
  // The panel is a 2D grid of buttons: a header row (filter / view-toggle /
  // close), one row per process (its action buttons), an extra row per
  // activity (focus / close-activity), and a footer row (refresh).
  // ArrowUp/Down moves between rows preserving X position (closest centre),
  // ArrowLeft/Right walks the buttons within the focused row.
  function pmFocusables(): HTMLButtonElement[] {
    return Array.from(panel.querySelectorAll<HTMLButtonElement>('button'))
      .filter((b) => !b.disabled && b.offsetParent !== null)
      .filter((b) => !b.closest('[aria-hidden="true"]'));
  }
  type Cell = { btn: HTMLButtonElement; rect: DOMRect };
  type Row  = { y: number; cells: Cell[] };
  function pmGroupRows(buttons: HTMLButtonElement[]): Row[] {
    const cells: Cell[] = buttons.map((b) => ({ btn: b, rect: b.getBoundingClientRect() }));
    cells.sort((a, b) => a.rect.top - b.rect.top || a.rect.left - b.rect.left);
    const rows: Row[] = [];
    for (const c of cells) {
      const last = rows[rows.length - 1];
      // Same row if vertical centres overlap within half the button height.
      const tol = Math.max(c.rect.height, last?.cells[0]?.rect.height ?? 0) * 0.6;
      const lastY = last ? last.cells[0]!.rect.top : -Infinity;
      if (last && Math.abs(lastY - c.rect.top) <= tol) last.cells.push(c);
      else rows.push({ y: c.rect.top, cells: [c] });
    }
    for (const r of rows) r.cells.sort((a, b) => a.rect.left - b.rect.left);
    return rows;
  }
  function pmClosestCol(currentRect: DOMRect, row: Row): HTMLButtonElement | null {
    const cx = currentRect.left + currentRect.width / 2;
    let best: HTMLButtonElement | null = null;
    let bestD = Infinity;
    for (const c of row.cells) {
      const ccx = c.rect.left + c.rect.width / 2;
      const d = Math.abs(cx - ccx);
      if (d < bestD) { bestD = d; best = c.btn; }
    }
    return best;
  }
  panel.addEventListener('keydown', (e) => {
    if (panel.getAttribute('aria-hidden') === 'true') return;
    const current = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!current || !panel.contains(current)) return;
    if (!(e.key === 'ArrowUp' || e.key === 'ArrowDown' || e.key === 'ArrowLeft' || e.key === 'ArrowRight')) return;
    const rows = pmGroupRows(pmFocusables());
    let rowIdx = -1, colIdx = -1;
    for (let i = 0; i < rows.length; i++) {
      const j = rows[i]!.cells.findIndex((c) => c.btn === current);
      if (j >= 0) { rowIdx = i; colIdx = j; break; }
    }
    if (rowIdx < 0) return;
    let target: HTMLButtonElement | null = null;
    if (e.key === 'ArrowLeft')  target = rows[rowIdx]!.cells[colIdx - 1]?.btn ?? null;
    else if (e.key === 'ArrowRight') target = rows[rowIdx]!.cells[colIdx + 1]?.btn ?? null;
    else {
      const dir = e.key === 'ArrowUp' ? -1 : 1;
      const nextRow = rows[rowIdx + dir];
      if (nextRow) target = pmClosestCol(current.getBoundingClientRect(), nextRow);
    }
    if (target) {
      target.focus();
      target.scrollIntoView({ block: 'nearest' });
      e.preventDefault();
      e.stopPropagation();
    }
  });

  async function refreshList() {
    try {
      const res = await fetch('/api/apps');
      const apps = await res.json() as Array<{
        manifest: ManifestLite;
        instances: InstanceListItem[];
        activities: ActivityListItem[];
      }>;
      manifests = new Map(apps.map(a => [a.manifest.id, a.manifest]));
      // Filter out warm-pool members — they aren't user-owned and shouldn't
      // appear as processes in the manager. The /api/admin/reap-orphans
      // endpoint still surfaces them for diagnostics.
      lastInstances  = apps.flatMap(a => a.instances).filter(i => !i.inPool);
      lastActivities = apps.flatMap(a => a.activities);
      render(lastInstances, lastActivities);
    } catch (err) {
      console.error('[ProcessManager] refresh failed', err);
    }
  }

  // Map verbose lifecycle states to a short 3-4 char chip label
  function stateLabel(state: string): string {
    switch (state) {
      case 'resumed':    return 'RUN';
      case 'paused':     return 'PSE';
      case 'pausing':    return 'PSE';
      case 'creating':   return 'BOOT';
      case 'created':    return 'BOOT';
      case 'starting':   return 'BOOT';
      case 'started':    return 'BOOT';
      case 'resuming':   return 'BOOT';
      case 'stopping':   return 'STOP';
      case 'stopped':    return 'STOP';
      case 'destroying': return 'TERM';
      case 'destroyed':  return 'OFF';
      case 'error':      return 'ERR';
      case 'crashed':    return 'ERR';
      default:           return state.toUpperCase().slice(0, 4);
    }
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    } as Record<string, string>)[c]!);
  }

  /** Dispatcher: updates header counters + the empty state, then delegates
   *  to the active view's renderer.
   */
  // Capture the keyboard-focused button BEFORE re-rendering the list so
  // we can restore focus to "the same thing or the next-closest thing"
  // after innerHTML is replaced. Without this, killing a process via
  // Enter on KILL drops focus to <body>, breaking the arrow-nav chain.
  type FocusSnap = {
    instanceId: string | null;
    activityId: string | null;
    action:     string | null;
    rowIndex:   number;       // position of the row in the rendered list
  };
  function snapshotFocus(): FocusSnap | null {
    const active = document.activeElement as HTMLElement | null;
    if (!active || !panel.contains(active)) return null;
    const btn = active.closest<HTMLButtonElement>('button');
    if (!btn) return null;
    const action  = btn.dataset['action'] ?? null;
    // Possible row classes:
    //   .pm-card                 — card-view instance row
    //   .pm-listrow              — list-view instance row (may also have
    //                              .pm-listrow-act = an activity row)
    //   .pm-activity             — card-view activity sub-row (nested
    //                              under its parent .pm-card)
    const row = btn.closest<HTMLElement>('.pm-card, .pm-listrow, .pm-activity');
    const isActivity = !!row && (
      row.classList.contains('pm-activity') ||
      row.classList.contains('pm-listrow-act') ||
      row.hasAttribute('data-activity-id')
    );
    const actId = isActivity ? (row!.dataset['activityId'] ?? null) : null;
    // Instance id: direct attr on the row, OR ancestor with one (activity
    // sub-row nested under a card), OR `data-parent-id` (list-view
    // activity rows are flat siblings, not nested).
    const instId =
      row?.dataset['instanceId'] ??
      row?.closest<HTMLElement>('[data-instance-id]')?.dataset['instanceId'] ??
      row?.dataset['parentId'] ??
      null;
    // Index among all the panel's process rows (cards + listrows) so we
    // can fall back to the "same slot" when the original row is gone.
    const allRows = Array.from(panel.querySelectorAll<HTMLElement>('.pm-card, .pm-listrow'));
    const idxRow  = row?.closest<HTMLElement>('.pm-card, .pm-listrow') ?? null;
    const rowIndex = idxRow ? allRows.indexOf(idxRow) : -1;
    return { instanceId: instId, activityId: actId, action, rowIndex };
  }
  function restoreFocus(snap: FocusSnap | null): void {
    if (!snap) return;
    if (panel.getAttribute('aria-hidden') === 'true') return;
    // 1) Same activity + same action.
    if (snap.activityId && snap.action) {
      const t = panel.querySelector<HTMLButtonElement>(
        `[data-activity-id="${cssEsc(snap.activityId)}"] [data-action="${cssEsc(snap.action)}"]`,
      );
      if (t) { t.focus(); return; }
    }
    // 2) Same instance + same action.
    if (snap.instanceId && snap.action) {
      const t = panel.querySelector<HTMLButtonElement>(
        `[data-instance-id="${cssEsc(snap.instanceId)}"] [data-action="${cssEsc(snap.action)}"]`,
      );
      if (t) { t.focus(); return; }
    }
    // 3) Same instance, any action (prefer focus → first available).
    if (snap.instanceId) {
      const t = panel.querySelector<HTMLButtonElement>(
        `[data-instance-id="${cssEsc(snap.instanceId)}"] [data-action]`,
      );
      if (t) { t.focus(); return; }
    }
    // 4) Slot fallback: take the row at the same index in the new list
    //    (or the last row if there are fewer rows now). Restores the
    //    "killed row gone, focus the row that took its place" feel.
    const allRows = Array.from(panel.querySelectorAll<HTMLElement>('.pm-card, .pm-listrow'));
    if (allRows.length > 0) {
      const target = allRows[Math.min(snap.rowIndex, allRows.length - 1)] ?? allRows[0]!;
      const action = target.querySelector<HTMLButtonElement>(
        `[data-action="${cssEsc(snap.action ?? 'focus')}"]`,
      ) ?? target.querySelector<HTMLButtonElement>('[data-action="focus"]')
        ?? target.querySelector<HTMLButtonElement>('button');
      if (action) { action.focus(); return; }
    }
    // 5) Nothing left in the list — focus the close button so arrow nav
    //    still has somewhere to live.
    closeBtn?.focus();
  }
  function cssEsc(s: string): string {
    return (window as any).CSS?.escape ? CSS.escape(s) : s.replace(/[^a-zA-Z0-9_-]/g, '\\$&');
  }

  function render(instances: InstanceListItem[], activities: ActivityListItem[]) {
    const snap = snapshotFocus();
    const totalInst = instances.length;
    const totalAct  = activities.length;

    // Split into apps + services so the panel can group them under separate
    // headers. Services are headless background processes — they don't take
    // a `+ ACTIVITY` action, and visually distinguishing them keeps the user
    // from thinking they're stuck in an unusable BOOT state.
    const isService = (i: InstanceListItem) => manifests.get(i.appId)?.componentType === 'service';
    const appInstances     = instances.filter(i => !isService(i));
    const serviceInstances = instances.filter(isService);

    // Pill counts: always reflect totals on disk, not what's currently
    // rendered, so the user sees `SVC 2` even when SVC is toggled off.
    // Defensive null-check: the script runs once at module init and caches
    // these elements, but in some startup orderings (or after a Vite HMR
    // re-import where the panel hasn't re-rendered yet) the cached nodes
    // can be null. Without the guard, `refresh()` throws and the whole
    // ProcessManager is wedged.
    if (filterCount.apps)     filterCount.apps.textContent     = String(appInstances.length);
    if (filterCount.services) filterCount.services.textContent = String(serviceInstances.length);

    // Footer + toggle-button dot use the *visible* set so a hidden section's
    // running services don't make the badge pulse.
    const visibleApps     = filters.apps     ? appInstances     : [];
    const visibleServices = filters.services ? serviceInstances : [];
    const visibleCount    = visibleApps.length + visibleServices.length;
    count.textContent = `${visibleCount} INST · ${totalAct} ACT`;
    toggleBtn.dataset['hasInstances'] = totalInst > 0 ? 'true' : 'false';

    if (visibleCount === 0) {
      const allHidden = totalInst > 0 && !filters.apps && !filters.services;
      list.innerHTML = `
        <li class="pm-empty">
          <div class="pm-empty-icon">○</div>
          <div class="pm-empty-text">${allHidden ? 'ALL SECTIONS HIDDEN' : 'NO ACTIVE PROCESSES'}</div>
          <div class="pm-empty-hint">${allHidden ? '// ENABLE APPS OR SVC ABOVE' : '// LAUNCH AN APP TO BEGIN'}</div>
        </li>`;
      restoreFocus(snap);
      return;
    }

    const actByInstance = new Map<string, ActivityListItem[]>();
    for (const a of activities) {
      const arr = actByInstance.get(a.parentInstanceId) ?? [];
      arr.push(a);
      actByInstance.set(a.parentInstanceId, arr);
    }

    if (viewMode === 'list') renderList(visibleApps, visibleServices, actByInstance);
    else                     renderCards(visibleApps, visibleServices, actByInstance);
    restoreFocus(snap);
  }

  function renderSectionHeader(label: string, count: number): string {
    return `<li class="pm-section-head"><span>${label}</span><span class="pm-section-count">${count}</span></li>`;
  }

  function renderCards(appInstances: InstanceListItem[], serviceInstances: InstanceListItem[], actByInstance: Map<string, ActivityListItem[]>) {
    const cardForInstance = (inst: InstanceListItem) => {
      const manifest = manifests.get(inst.appId);
      const name = manifest?.name ?? inst.appId;
      const supportsActivities = manifest?.activityMode === 'multi';
      const isBg = manifest?.backgroundService === true;
      const acts = actByInstance.get(inst.instanceId) ?? [];
      const initial = (manifest?.icon ?? name.charAt(0)).toUpperCase();
      const initialLen = initial.length;

      const activitiesBlock = acts.length === 0 ? '' : `
        <div class="pm-activities">
          <div class="pm-activities-head">ACTIVITIES · ${acts.length}</div>
          <ul class="pm-activity-list">
            ${acts.map(act => {
              const label = act.title ?? `↳ ${act.activityId.split('#').pop()}`;
              const sub = `${escapeHtml(act.activityId)}${act.path && act.path !== '/' ? ` · ${escapeHtml(act.path)}` : ''}`;
              return `
                <li class="pm-activity" data-activity-id="${escapeHtml(act.activityId)}" data-parent-id="${escapeHtml(inst.instanceId)}">
                  <div class="pm-activity-info">
                    <div class="pm-activity-title">${escapeHtml(label)}</div>
                    <div class="pm-activity-id">${sub}</div>
                  </div>
                  <div class="pm-activity-actions">
                    <button class="pm-action-btn pm-icon-btn" data-action="focus-activity" title="Focus this activity">◉</button>
                    <button class="pm-action-btn pm-icon-btn" data-action="close-activity" data-variant="warn" title="Close this activity">✕</button>
                  </div>
                </li>`;
            }).join('')}
          </ul>
        </div>`;

      const metaParts: string[] = [
        `<span data-label="ID">${escapeHtml(inst.instanceId)}</span>`,
      ];
      if (inst.pid !== null)  metaParts.push(`<span data-label="PID">${inst.pid}</span>`);
      if (inst.port !== null) metaParts.push(`<span data-label="PORT">${inst.port}</span>`);

      return `
        <li class="pm-card" data-instance-id="${escapeHtml(inst.instanceId)}">
          <div class="pm-card-head">
            <div class="pm-card-initial" data-len="${initialLen}">${escapeHtml(initial)}</div>
            <div class="pm-card-title">
              <div class="pm-card-name">
                <span>${escapeHtml(name)}</span>
                ${isBg ? '<span class="pm-bg-badge" title="Background service">BG</span>' : ''}
              </div>
              <div class="pm-card-meta">${metaParts.join('')}</div>
            </div>
            <div class="pm-state-chip" data-state="${escapeHtml(inst.state)}" title="${escapeHtml(inst.state)}">
              <span class="pm-state-dot"></span>
              <span>${stateLabel(inst.state)}</span>
            </div>
          </div>
          ${activitiesBlock}
          <div class="pm-card-actions">
            <button class="pm-action-btn" data-action="focus" title="Open in fullscreen focus mode">◉ FOCUS</button>
            ${supportsActivities ? '<button class="pm-action-btn" data-action="new-activity" title="Open a new activity on this instance">+ ACTIVITY</button>' : ''}
            <span class="pm-action-btn-spacer"></span>
            <button class="pm-action-btn" data-action="app-close" data-variant="warn" title="Standard close — runs full lifecycle: onPause → onStop → onDestroy → SIGTERM">■ STOP</button>
            <button class="pm-action-btn" data-action="task-kill" data-variant="danger" title="Force kill — immediate SIGKILL, no lifecycle hooks (only if app hangs)">⨂ KILL</button>
          </div>
        </li>`;
    };
    const sections: string[] = [];
    if (appInstances.length > 0) {
      sections.push(renderSectionHeader('APPS', appInstances.length));
      sections.push(appInstances.map(cardForInstance).join(''));
    }
    if (serviceInstances.length > 0) {
      sections.push(renderSectionHeader('SERVICES', serviceInstances.length));
      sections.push(serviceInstances.map(cardForInstance).join(''));
    }
    list.innerHTML = sections.join('');
  }

  /** Dense, ps-like list view: one row per instance, indented activity rows
   *  beneath their parent. Action labels collapse to icon-only buttons.
   */
  function renderList(appInstances: InstanceListItem[], serviceInstances: InstanceListItem[], actByInstance: Map<string, ActivityListItem[]>) {
    const rowForInstance = (inst: InstanceListItem) => {
      const manifest = manifests.get(inst.appId);
      const name = manifest?.name ?? inst.appId;
      const supportsActivities = manifest?.activityMode === 'multi';
      const isBg = manifest?.backgroundService === true;
      const acts = actByInstance.get(inst.instanceId) ?? [];

      const metaParts: string[] = [`<span>${escapeHtml(inst.instanceId)}</span>`];
      if (inst.pid  !== null) metaParts.push(`<span>PID ${inst.pid}</span>`);
      if (inst.port !== null) metaParts.push(`<span>:${inst.port}</span>`);

      const instRow = `
        <li class="pm-listrow" data-instance-id="${escapeHtml(inst.instanceId)}" data-state="${escapeHtml(inst.state)}">
          <span class="pm-listrow-dot" title="${escapeHtml(inst.state)}"></span>
          <div class="pm-listrow-info">
            <div class="pm-listrow-line1">
              <span>${escapeHtml(name)}</span>
              ${isBg ? '<span class="pm-bg-badge" title="Background service">BG</span>' : ''}
              <span class="pm-listrow-state-label">${stateLabel(inst.state)}</span>
            </div>
            <div class="pm-listrow-line2">${metaParts.join('')}</div>
          </div>
          <div class="pm-listrow-actions">
            <button class="pm-action-btn pm-icon-btn" data-action="focus"        title="Focus">◉</button>
            ${supportsActivities ? '<button class="pm-action-btn pm-icon-btn" data-action="new-activity" title="+ Activity">+</button>' : ''}
            <button class="pm-action-btn pm-icon-btn" data-action="app-close"   data-variant="warn"   title="Stop (graceful)">■</button>
            <button class="pm-action-btn pm-icon-btn" data-action="task-kill"   data-variant="danger" title="Kill (SIGKILL)">⨂</button>
          </div>
        </li>`;

      const actRows = acts.map(act => {
        const label = act.title ?? act.activityId.split('#').pop() ?? act.activityId;
        const sub = `${escapeHtml(act.activityId)}${act.path && act.path !== '/' ? ` · ${escapeHtml(act.path)}` : ''}`;
        return `
          <li class="pm-listrow pm-listrow-act" data-activity-id="${escapeHtml(act.activityId)}" data-parent-id="${escapeHtml(inst.instanceId)}">
            <span class="pm-listrow-arrow">↳</span>
            <div class="pm-listrow-info">
              <div class="pm-listrow-line1">${escapeHtml(label)}</div>
              <div class="pm-listrow-line2">${sub}</div>
            </div>
            <div class="pm-listrow-actions">
              <button class="pm-action-btn pm-icon-btn" data-action="focus-activity" title="Focus">◉</button>
              <button class="pm-action-btn pm-icon-btn" data-action="close-activity" data-variant="warn" title="Close">✕</button>
            </div>
          </li>`;
      }).join('');

      return instRow + actRows;
    };
    const sections: string[] = [];
    if (appInstances.length > 0) {
      sections.push(renderSectionHeader('APPS', appInstances.length));
      sections.push(appInstances.map(rowForInstance).join(''));
    }
    if (serviceInstances.length > 0) {
      sections.push(renderSectionHeader('SERVICES', serviceInstances.length));
      sections.push(serviceInstances.map(rowForInstance).join(''));
    }
    list.innerHTML = sections.join('');
  }

  list.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('[data-action]') as HTMLButtonElement | null;
    if (!btn) return;
    const action = btn.dataset['action']!;
    btn.disabled = true;
    try {
      // Activity-level actions: row carries data-activity-id
      const actRow = btn.closest('[data-activity-id]') as HTMLElement | null;
      if (actRow) {
        const activityId       = actRow.dataset['activityId']!;
        const parentInstanceId = actRow.dataset['parentId']!;
        if (action === 'focus-activity') {
          (window as any).auraFocusInstance?.(parentInstanceId, activityId);
          closePanel();
        } else if (action === 'close-activity') {
          await fetch(`/api/activities/${encodeURIComponent(activityId)}/close`, { method: 'POST' });
          (window as any).auraRemoveViewByActivity?.(activityId);
          await refreshList();
        }
        return;
      }

      // Instance-level actions: row carries data-instance-id
      const row = btn.closest('[data-instance-id]') as HTMLElement | null;
      if (!row) return;
      const instanceId = row.dataset['instanceId']!;
      if (action === 'focus') {
        (window as any).auraFocusInstance?.(instanceId);
        closePanel();
      } else if (action === 'new-activity') {
        await (window as any).auraOpenActivityOnInstance?.(instanceId);
        await refreshList();
      } else if (action === 'app-close') {
        await fetch(`/api/instances/${encodeURIComponent(instanceId)}/stop`, { method: 'POST' });
        (window as any).auraRemoveViewsByInstance?.(instanceId);
        await refreshList();
      } else if (action === 'task-kill') {
        await fetch(`/api/instances/${encodeURIComponent(instanceId)}/kill`, { method: 'POST' });
        (window as any).auraRemoveViewsByInstance?.(instanceId);
        await refreshList();
      }
    } finally {
      btn.disabled = false;
    }
  });

  // Live-refresh via SSE from the OS event bus. The list always reacts to
  // events — even when the panel is closed — so the toggle-button's
  // "running apps" badge dot stays in sync. A short debounce coalesces the 6
  // rapid state-transition events that fire during a single app start
  // (creating → created → starting → started → resuming → resumed) into one
  // /api/apps refetch.
  // Listen on the shared socket.io channel — the server drops everything
  // outside app:*/activity:* before the frame is written, so we don't have
  // to branch on event type.
  let refreshDebounce: ReturnType<typeof setTimeout> | null = null;
  function scheduleRefresh() {
    if (refreshDebounce) return;
    refreshDebounce = setTimeout(() => { refreshDebounce = null; refreshList(); }, 80);
  }
  osEvents.subscribe(['app:*', 'activity:*'], () => scheduleRefresh());

  // Initial load to populate the badge dot on the toggle button
  refreshList();
</script>
