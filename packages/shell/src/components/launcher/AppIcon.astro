---
import type { AppManifest } from '@aura/core';

interface Props {
  app: AppManifest;
}
const { app } = Astro.props;
const glyph = (app.icon ?? app.name.charAt(0)).toUpperCase();
---
<button class="app-icon" data-app-id={app.id} title={app.description ?? app.name}>
  <div class="icon-box">
    <span class="initial" data-len={glyph.length}>{glyph}</span>
  </div>
  <span class="name">{app.name}</span>
  <span class="id">{app.id}</span>
</button>

<style>
  .app-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 12px 8px;
    background: transparent;
    border: var(--aura-border);
    color: var(--aura-color-text);
    cursor: pointer;
    font-family: var(--aura-font-mono);
    transition: box-shadow 0.1s, background 0.1s;
    width: 96px;
  }

  .app-icon:hover {
    box-shadow: var(--aura-glow-primary);
    background: color-mix(in srgb, var(--aura-color-primary) 6%, transparent);
    color: var(--aura-color-primary);
  }

  .icon-box {
    width: 48px;
    height: 48px;
    border: var(--aura-border);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--aura-color-surface-2);
  }

  .initial {
    /* Single font-size for every glyph length — 1, 2, or 3 chars render
     * at the same height. Sized to fit the 3-char worst case ("SET") in
     * the 48×48 icon-box with breathing room. */
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--aura-color-primary);
    text-shadow: var(--aura-glow-primary);
    font-weight: 500;
  }

  .name {
    font-size: var(--aura-font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
    word-break: break-word;
  }

  .id {
    font-size: var(--aura-font-size-xs);
    color: var(--aura-color-text-dim);
    text-align: center;
    word-break: break-all;
  }
</style>
