---
import type { AppView } from '@aura/core';

interface Props {
  view: AppView;
  style?: string;
}
const { view, style = '' } = Astro.props;
const isLoading = view.lifecycleState !== 'resumed';
---
<div class="app-slot" data-view-id={view.viewId} data-app-id={view.appId} style={style}>
  <div class="slot-chrome">
    <span class="slot-title">{view.title}</span>
    <div class="slot-actions">
      <button class="slot-btn" data-action="minimize" title="Minimize">_</button>
      <button class="slot-btn danger" data-action="close" title="Close">✕</button>
    </div>
  </div>
  <div class="slot-body">
    {isLoading
      ? <div class="loading">LOADING {view.appId}...</div>
      : <iframe src={view.iframeUrl} title={view.title} allow="clipboard-read; clipboard-write" />
    }
  </div>
</div>

<style>
  .app-slot {
    display: flex;
    flex-direction: column;
    background: var(--aura-color-surface);
    border: var(--aura-border);
    overflow: hidden;
    height: 100%;
  }

  .slot-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
    height: 28px;
    background: var(--aura-color-surface-2);
    border-bottom: var(--aura-border);
    flex-shrink: 0;
    user-select: none;
  }

  .slot-title {
    font-size: var(--aura-font-size-sm);
    color: var(--aura-color-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .slot-actions { display: flex; gap: 4px; }

  .slot-btn {
    background: transparent;
    border: var(--aura-border);
    color: var(--aura-color-text-dim);
    font-family: var(--aura-font-mono);
    font-size: var(--aura-font-size-xs);
    padding: 2px 6px;
    cursor: pointer;
    transition: color 0.1s, box-shadow 0.1s;
  }
  .slot-btn:hover { color: var(--aura-color-primary); box-shadow: var(--aura-glow-subtle); }
  .slot-btn.danger:hover { color: var(--aura-color-danger); box-shadow: var(--aura-glow-danger); }

  .slot-body { flex: 1; overflow: hidden; position: relative; }

  iframe {
    width: 100%;
    height: 100%;
    border: none;
    background: var(--aura-color-bg);
  }

  .loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--aura-color-text-dim);
    font-size: var(--aura-font-size-sm);
    letter-spacing: 0.1em;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
</style>
