---
import type { AppView } from '@aura/core';
import AppSlot from '../AppSlot.astro';

interface Props {
  views: AppView[];
  /** Unused — fullscreen only shows the focused view. Accepted so the
   *  LayoutManager dispatcher can forward layoutState uniformly. */
  layoutState?: Record<string, unknown>;
}
const { views } = Astro.props;
const active = views.find(v => v.isFocused) ?? views[0];
---
{active && (
  <div class="fullscreen-layout">
    <AppSlot view={active} />
  </div>
)}

<style>
  .fullscreen-layout {
    width: 100%;
    height: 100%;
  }
</style>
