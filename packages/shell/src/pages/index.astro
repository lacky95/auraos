    if (ev.type === 'app:crashed') {
      const dead = views.filter((v) => v.instanceId === ev.instanceId);
      if (dead.some((v) => v.viewId === maximizedViewId)) maximizedViewId = null;
      views = views.filter((v) => v.instanceId !== ev.instanceId);
      for (const v of dead) workspaceClient.removeMember(v.viewId).catch(() => undefined);
      if (focusedInstanceId === ev.instanceId) exitFocus();
      renderLayout();
      console.error(`[AuraOS] ${ev.instanceId} crashed:`, ev.error);
    }
    if (ev.type === 'activity:opened') {
      // Render a view for activities the shell didn't initiate (e.g. an app
      // iframe POSTed /api/instances/<id>/activities directly — common when
      // the Settings app opens a sub-section). Skip if:
      //   • a view for this activityId already exists (we initiated it and
      //     the fetch response already added it), or
      //   • the shell is currently mid-flight on a shell-initiated open for
      //     this app — the pending fetch will add the view itself.
      const alreadyHaveView = views.some((v) => v.activityId === ev.activityId);
      const shellInFlight   = (pendingActivityOpens.get(ev.appId) ?? 0) > 0;
      if (alreadyHaveView || shellInFlight) return;

      const cachedName  = manifestCache.get(ev.appId)?.name ?? ev.appId;
      const cachedBg    = manifestCache.get(ev.appId)?.backgroundService === true;
      const title       = ev.title ?? cachedName;
      const minimizable = !!ev.minimizable && cachedBg;
      // We don't know the parent instance's exact lifecycle state from the
      // event payload — default to 'resumed' so the iframe loads right away.
      // (An open activity necessarily means the parent backend is running.)
      views = [...views, buildView(ev.appId, title, ev.parentInstanceId, ev.activityId, ev.path ?? '/', 'resumed', minimizable)];
      // The activity was opened externally (another iframe, an intent, etc.)
      // — claim it on the active workspace so the user can actually see it.
      // Not when a workspace already owns it, and never for a desktop restore:
      // after an OS restart every saved activity is re-opened while this page
      // is still connected, and the workspaces are remapped server-side. An
      // activity that was hidden before the restart (no workspace: a closed
      // window whose handle lived on, a rebind trail) must stay hidden, or the
      // restore piles them all onto the active workspace (seen 2026-10-30).
      if (!(ev as { restored?: boolean }).restored && !workspaceClient.findOwner(ev.activityId)) {
        workspaceClient.addMemberToActive(ev.activityId).catch(() => undefined);
      }
      renderLayout();
    }
    if (ev.type === 'activity:closed') {
      // Backend says this activity is gone — drop the corresponding view
      views = views.filter((v) => v.activityId !== ev.activityId);
      workspaceClient.removeMember(ev.activityId).catch(() => undefined);
      if (focusedActivityId === ev.activityId) exitFocus();
      renderLayout();
    }
    if (ev.type === 'activity:navigated') {
      // In-place activity navigation — the iframe URL changed but the slot
      // stays the same. Update `view.iframeUrl` + `view.title` + the
      // history/breadcrumb pair, then re-point the existing iframe at the
      // new path. No new layout slot, no workspace membership change, no
      // skeleton overlay (the iframe is already mounted, the doc navigates).
      const idx = views.findIndex((v) => v.activityId === ev.activityId);
      if (idx >= 0) {
        const v = views[idx]!;
        const nextPath = ev.path ?? '/';
        const nextTitle = ev.title ?? v.title;
        const minimizable = !!v.minimizable;
        const nextUrl = buildView(v.appId, nextTitle, v.instanceId, v.activityId, nextPath, v.lifecycleState, minimizable).iframeUrl;
        const nextHistory = Array.isArray(ev.history) ? (ev.history as Array<{ path: string; title?: string }>) : v.history;
        const nextBreadcrumb: 'os' | 'off' = ev.breadcrumb === 'off' ? 'off' : 'os';
        views = [
          ...views.slice(0, idx),
          { ...v, iframeUrl: nextUrl, title: nextTitle, history: nextHistory, breadcrumb: nextBreadcrumb },
          ...views.slice(idx + 1),
        ];
        const slot = document.querySelector<HTMLElement>(`.app-slot[data-view-id="${CSS.escape(v.viewId)}"]`);
        const iframe = slot?.querySelector<HTMLIFrameElement>('iframe');
        if (iframe) setIframeUrl(iframe, nextUrl);
        renderLayout(); // refresh title chrome (breadcrumb trail + title)
      }
    }
    if (ev.type === 'activity:breadcrumbChanged') {
      // Runtime breadcrumb toggle — app called `osClient.activity.
      // setBreadcrumb('os' | 'off')`. No iframe change; just refresh
      // the chrome rendering.
      const idx = views.findIndex((v) => v.activityId === ev.activityId);
      if (idx >= 0) {
        const v = views[idx]!;
        const next: 'os' | 'off' = ev.breadcrumb === 'off' ? 'off' : 'os';
        views = [...views.slice(0, idx), { ...v, breadcrumb: next }, ...views.slice(idx + 1)];
        renderLayout();
      }
    }
    if (ev.type === 'activity:focus') {
      // Back-stack pop — bring the named (already-open) activity back to the
      // foreground. Bound to `auraFocusInstance`, the same primitive the
      // Process Manager's FOCUS button uses, so the focus view + iframe
      // routing follow the same code path.
      const target = views.find((v) => v.activityId === ev.activityId);
      if (target) {
        (window as any).auraFocusInstance?.(target.instanceId, ev.activityId);
      }
    }
    if (ev.type === 'workspaces:changed' || ev.type === 'workspace:activated') {
      // The event payload only carries summaries (no member arrays), so we
      // have to re-fetch the full state to reconcile membership. The
      // refresh() call notifies subscribers — which triggers renderLayout()
      // via the subscribe() wire-up further up.
      workspaceClient.refresh().catch((err) => console.warn('[shell] workspace refresh failed', err));
    }
  }
</script>

<style is:global>
  /* Style block is global so the dynamically-rendered skeleton + slot HTML
     (built via innerHTML in renderLayout) gets these rules — Astro's scoped
     styles target `[data-astro-cid-*]` and innerHTML elements don't carry
     that attribute, so a scoped block would leave them unstyled. */
  #desktop-content {
    width: 100%;
    height: 100%;
    position: relative;
  }
  /* #dynamic-layout is NOT sized here: it is `position:absolute` and inset
     by the layout regions (syncLayoutRegions in the script above). */
  #static-layout {
    width: 100%;
    height: 100%;
  }
  .layout-region {
    position: absolute;
    z-index: 40; /* above windows' area, below #focus-view (50) */
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
  }
  .layout-region:empty { display: none; }
  .layout-region[data-side="top"]    { top: 0;    left: 0; right: 0; }
  .layout-region[data-side="bottom"] { bottom: 0; left: 0; right: 0; }
  .layout-region[data-side="left"]   { left: 0;  top: 0; bottom: 0; flex-direction: row; }
  .layout-region[data-side="right"]  { right: 0; top: 0; bottom: 0; flex-direction: row; }
  /* Above every stacked activity (they renormalize below 500) and the in-place
     maximized one (60); below the full-size window (950) and shell panels. */
  #layout-overlay {
    position: absolute;
    inset: 0;
    z-index: 800;
    pointer-events: none;
  }

  /* Focus view: covers the entire desktop area above layouts */
  #focus-view {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    background: var(--aura-color-bg);
    z-index: 50;
  }
  #focus-view[aria-hidden="false"] { display: flex; }
  /* Full-size mode (toggled by the FULL SIZE header button): lift the
     overlay out of the #desktop grid cell so it covers the status bar and
     dock too. `fixed` anchors to the zoom-transformed <body> (the shell
     box), so it respects page zoom + screen-edge margins exactly like the
     bars do. z-index 950 sits above the autohide bars (900) yet below the
     launcher / process-manager panels (1000) and the lock screen (2000),
     so those still open over a full-size focused app. */
  #focus-view[data-fullscreen="true"] {
    position: fixed;
    inset: 0;
    z-index: 950;
  }
  /* Window-selection mode cue while in focus mode. Mirrors the regular
     `.app-slot[data-aura-nav-focus]` look (border + centred ◉ watermark)
     but painted as a pseudo-element OVERLAY rather than `box-shadow` on
     the container — children (the iframe) paint over a parent's
     box-shadow, hiding it. `pointer-events: none` so the watermark +
     border never intercept clicks meant for the focus-frame iframe. */
  #focus-view[data-aura-nav-focus="true"]::after {
    content: '◉';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(3rem, 16vmin, 7rem);
    color: var(--aura-color-text);
    opacity: 1;
    pointer-events: none;
    box-shadow: inset 0 0 0 2px var(--aura-color-text);
    z-index: 2;
  }

  /* Window-selection mode highlight. Recolours the slot's existing thin
     border to the high-contrast text colour. `--aura-color-text` is the
     theme's foreground tone (near-white in dark themes, near-black in
     light themes) so the frame is clearly visible in any palette — the
     brand `--aura-color-primary` looked washed-out against several theme
     surfaces.

     `!important` is unavoidable here: `createSlot()` writes the base
     `border: var(--aura-border)` as an INLINE style on the slot div
     (see line ~1581 in this file), which beats every non-important CSS
     selector. Keeping the inline shorthand simplifies createSlot vs.
     moving its base styles into the global block.

     `position: relative` is added so the watermark `::after` below has a
     positioned containing block in grid layouts. In stack mode the
     inline `position: absolute` set by the Free Window strategy already provides
     that and beats this rule's specificity. */
  .app-slot[data-aura-nav-focus="true"] {
    border-color: var(--aura-color-text) !important;
    position: relative;
    z-index: 2;
  }
  /* Centred watermark glyph above the iframe — at-a-glance "this is the
     selected window" badge even when adjacent windows have similar
     content. Full opacity (the user explicitly didn't want a faded
     watermark) and the same `--aura-color-text` token used for the
     border, so the frame and badge read as one piece. Sized small so
     the badge doesn't obscure the app underneath; `pointer-events:
     none` ensures it never eats clicks. */
  .app-slot[data-aura-nav-focus="true"]::after {
    content: '◉';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(3rem, 16vmin, 7rem);
    color: var(--aura-color-text);
    opacity: 1;
    pointer-events: none;
    z-index: 3;
  }

  /* Maximized (in-place focus) window. renderLayout() promotes the EXISTING
     slot to fill the desktop (position:absolute; inset; z-index:60) without
     touching its iframe — so the app keeps its state, no reload. This rule
     gives it the "shown in a special way" treatment: a primary-toned frame +
     glow so the focused window reads as lifted above its peers. `!important`
     on the border for the same reason as the nav-focus rule above — it beats
     createSlot()'s inline `border` shorthand. */
  .app-slot[data-maximized="true"] {
    border-color: var(--aura-color-primary) !important;
    box-shadow: 0 0 0 1px var(--aura-color-primary), var(--aura-glow-primary), 0 12px 32px rgba(0, 0, 0, 0.5);
  }

  /* Free-Window drag safety net. The stack-mode drag/resize handlers use
     `setPointerCapture` so iframes can't steal the pointermove stream —
     this rule is the redundant CSS guard for browsers/edge cases where
     capture isn't honoured (and to suppress text-selection across the
     whole desktop while a drag is in flight). The body class is toggled
     by the Free Window strategy's gestures (lib/layout/strategies/freeWindow). */
  body.aura-stack-dragging {
    cursor: grabbing;
    user-select: none;
    -webkit-user-select: none;
  }
  body.aura-stack-dragging .app-slot iframe {
    pointer-events: none;
  }

  /* Generic window drag (lib/windowDrag.ts): small fixed-size ghost that
     follows the cursor. --aura-color-text gives a white border on dark
     themes and a dark, contrasting one on light themes. */
  body.aura-window-dragging {
    cursor: grabbing;
    user-select: none;
    -webkit-user-select: none;
  }
  body.aura-window-dragging .app-slot iframe { pointer-events: none; }
  .aura-drag-ghost {
    position: fixed;
    left: 0;
    top: 0;
    width: 160px;
    height: 96px;
    z-index: 2000;
    pointer-events: none;
    border: 2px solid var(--aura-color-text);
    background: color-mix(in srgb, var(--aura-color-surface) 85%, transparent);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }
  .aura-drag-ghost-title {
    height: 20px;
    padding: 0 6px;
    display: flex;
    align-items: center;
    background: var(--aura-color-surface-2);
    border-bottom: 1px solid var(--aura-color-text);
    color: var(--aura-color-text);
    font-family: var(--aura-font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .app-slot[data-drag-source="true"] { opacity: 0.5; }
  .app-slot[data-drop-hover="true"],
  .ws-pill[data-drop-hover="true"],
  .ws-collapse-btn[data-drop-hover="true"] {
    outline: 2px solid var(--aura-color-primary);
    outline-offset: -2px;
    box-shadow: var(--aura-glow-primary);
  }

  /* Free-Window cursor affordance. The chrome (title bar) shows an open
     hand when the slot is drag-enabled (stack mode), and a closed hand
     while a drag/resize is actually in flight. The data attribute is
     set by the Free Window strategy on the slots it places, so chromes in
     tiling/rows/columns/fullscreen stay with the default arrow cursor.
     `!important` overrides the in-drag body-level `grabbing` cursor with
     a more specific feedback (still grabbing — same shape, but the rule
     here wins specificity so nested selectors below don't flicker back
     to grab while the body class is on). */
  .app-slot[data-stack-handlers-bound="1"] .slot-chrome {
    cursor: grab;
  }
  body.aura-stack-dragging .app-slot[data-stack-handlers-bound="1"] .slot-chrome {
    cursor: grabbing;
  }
  /* Buttons inside the chrome (close/minimize/maximize, breadcrumb) keep
     the pointer cursor — the hand only applies to empty drag space. */
  .app-slot[data-stack-handlers-bound="1"] .slot-chrome button {
    cursor: pointer;
  }

  /* ---- Slot chrome (title + breadcrumb + controls) -------------------- */
  .app-slot .slot-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
    height: 28px;
    background: var(--aura-color-surface-2);
    border-bottom: var(--aura-border);
    flex-shrink: 0;
    gap: 8px;
    /* Touch: without this, mobile browsers (Android Chrome) claim a touch
       drag on the title bar as a page pan and fire pointercancel, so the
       window-drag ghost never appears. Buttons inside still get taps. */
    touch-action: none;
    /* min-width:0 so the title can actually shrink past its intrinsic
       width inside this flex container. Without it, long breadcrumb
       trails would force the slot wider than its grid cell. */
    min-width: 0;
  }
  .app-slot .slot-title {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    overflow: hidden;
    color: var(--aura-color-primary);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .app-slot .slot-title-trail {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .app-slot .slot-title-id {
    color: var(--aura-color-text-dim);
    font-size: 0.6rem;
    flex-shrink: 0;
  }
  .app-slot .slot-controls { display: flex; gap: 4px; flex-shrink: 0; }
  .app-slot .slot-controls button,
  .app-slot .crumb-back {
    background: transparent;
    border: var(--aura-border);
    color: var(--aura-color-text-dim);
    font-family: var(--aura-font-mono);
    font-size: 0.65rem;
    padding: 2px 10px;
    cursor: pointer;
    line-height: 1;
  }
  .app-slot .slot-controls button:hover,
  .app-slot .crumb-back:hover,
  .app-slot .crumb-prev:hover {
    color: var(--aura-color-text);
    border-color: var(--aura-color-primary);
  }
  /* Keyboard focus state for chrome buttons. Used by the window
     chrome-select sub-mode (Backspace on a highlighted slot → close
     button gets focus by default; arrows walk siblings). Stronger than
     hover so it stays distinguishable even when the cursor is elsewhere. */
  .app-slot .slot-controls button:focus-visible,
  .app-slot .crumb-back:focus-visible,
  .app-slot .crumb-prev:focus-visible {
    outline: none;
    color: var(--aura-color-text);
    border-color: var(--aura-color-primary);
    box-shadow: 0 0 0 1px var(--aura-color-primary), 0 0 8px var(--aura-color-primary);
  }

  /* ---- Breadcrumb trail ----------------------------------------------- */
  /*
   * Space-aware behaviour:
   *   • Back button (`←`) is always full size — fixed `flex-shrink: 0`.
   *   • Previous crumbs shrink first when room runs short — each has
   *     `min-width: 2ch` so they collapse to roughly two glyphs before
   *     ellipsizing further. The leftmost crumb shrinks first because
   *     flex distribution favours later items.
   *   • Current crumb has slightly higher `min-width` so the user always
   *     sees a recognisable label for where they are.
   *   • The whole trail clips with `overflow: hidden`; nothing escapes
   *     the slot chrome bar.
   */
  .app-slot .crumb {
    color: var(--aura-color-text-dim);
    font-family: inherit;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    padding: 2px 4px;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 2ch;
  }
  .app-slot .crumb-back {
    flex-shrink: 0;
    margin-right: 4px;
  }
  .app-slot .crumb-prev {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--aura-color-text-dim);
    flex-shrink: 1;
    max-width: 18ch;
  }
  .app-slot .crumb-current {
    color: var(--aura-color-primary);
    flex-shrink: 0;
    min-width: 4ch;
    max-width: 24ch;
  }
  .app-slot .crumb-sep {
    color: var(--aura-color-text-dim);
    flex-shrink: 0;
    opacity: 0.5;
  }

  #focus-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 12px;
    height: 32px;
    background: var(--aura-color-surface-2);
    border-bottom: var(--aura-border);
    flex-shrink: 0;
  }
  #focus-title {
    color: var(--aura-color-secondary);
    font-size: var(--aura-font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  #focus-instance-id {
    color: var(--aura-color-text-dim);
    font-size: var(--aura-font-size-xs);
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #focus-exit,
  #focus-fullscreen {
    background: transparent;
    border: var(--aura-border);
    color: var(--aura-color-text-dim);
    font-family: var(--aura-font-mono);
    font-size: var(--aura-font-size-xs);
    letter-spacing: 0.08em;
    padding: 4px 8px;
    cursor: pointer;
    text-transform: uppercase;
  }
  /* Full-size toggle: primary (not danger) accent on hover/keyboard, and a
     filled "engaged" look while full-size mode is active — mirrors the
     status-bar autohide button's pressed state. */
  #focus-fullscreen:hover { color: var(--aura-color-primary); box-shadow: var(--aura-glow-primary); }
  #focus-fullscreen:focus-visible {
    outline: none;
    color: var(--aura-color-primary);
    box-shadow: 0 0 0 1px var(--aura-color-primary), 0 0 8px var(--aura-color-primary);
  }
  #focus-fullscreen[aria-pressed="true"] {
    color: var(--aura-color-bg);
    background: var(--aura-color-primary);
    border-color: var(--aura-color-primary);
  }
  #focus-exit:hover { color: var(--aura-color-danger); box-shadow: var(--aura-glow-danger); }
  /* Keyboard focus state for the Exit Focus button — used when the user
     enters chrome-select inside focus mode (Backspace on the focus-view).
     Same red glow as hover so the keyboard cue matches mouse hover. */
  #focus-exit:focus-visible {
    outline: none;
    color: var(--aura-color-danger);
    box-shadow: 0 0 0 1px var(--aura-color-danger), 0 0 8px var(--aura-color-danger);
  }

  #focus-body {
    flex: 1;
    position: relative;
    overflow: clip; /* not hidden: see #desktop in OSLayout.astro */
  }
  #focus-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    background: var(--aura-color-bg);
  }

  /* ── Per-layer app-content zoom ──────────────────────────────────────────
   * `--aura-iframe-scale` (set on <html> by StatusBar's viewport script) is
   * appZoom ÷ shellZoom. The body transform already scales every app iframe
   * by mainZoom·shellZoom along with the rest of the chrome; counter-scaling
   * the iframe content here by appZoom/shellZoom nets out to mainZoom·appZoom,
   * so app content zooms independently of the OS chrome. Defaults to 1 (a
   * no-op: scale(1) + width/height 100%). !important overrides the inline
   * width/height/inset createSlot() writes on each slot iframe. */
  .app-slot .slot-body > iframe,
  #focus-body > iframe {
    transform-origin: top left;
    transform: scale(var(--aura-iframe-scale, 1)) !important;
    width:  calc(100% / var(--aura-iframe-scale, 1)) !important;
    height: calc(100% / var(--aura-iframe-scale, 1)) !important;
  }

  /* ---------- Boot skeleton shown while an app instance is spawning ---------- */
  .aura-skeleton {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(transparent 50%, rgba(0, 0, 0, 0.25) 50%) 0 0 / 100% 4px,
      var(--aura-color-bg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .aura-skeleton-scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--aura-color-primary) 18%, transparent) 50%,
      transparent 100%
    );
    height: 30%;
    animation: aura-skeleton-scan 2.2s linear infinite;
    pointer-events: none;
  }
  @keyframes aura-skeleton-scan {
    0%   { transform: translateY(-100%); }
    100% { transform: translateY(400%); }
  }
  .aura-skeleton-content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: min(72%, 320px);
    padding: 18px 20px;
    border: var(--aura-border);
    background: color-mix(in srgb, var(--aura-color-surface) 70%, transparent);
    backdrop-filter: blur(2px);
  }
  .aura-skeleton-id {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--aura-font-mono);
    font-size: var(--aura-font-size-sm, 0.8rem);
    color: var(--aura-color-primary);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    animation: aura-skeleton-pulse 1.4s ease-in-out infinite;
  }
  .aura-skeleton-bars {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .aura-skeleton-bar {
    height: 8px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--aura-color-primary) 12%, transparent) 0%,
      color-mix(in srgb, var(--aura-color-primary) 38%, transparent) 50%,
      color-mix(in srgb, var(--aura-color-primary) 12%, transparent) 100%
    );
    background-size: 200% 100%;
    animation: aura-skeleton-shimmer 1.6s linear infinite;
  }
  @keyframes aura-skeleton-shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
