---
import OSLayout from '../layouts/OSLayout.astro';
import Icon from '../components/ui/Icon.astro';
import LayoutManager from '../components/layout/LayoutManager.astro';
import { getAppManager, DEFAULT_WORKSPACE_STATE, type WorkspaceState } from '@aura/core';
import { sharedKv } from '../lib/sharedKv';
import { sessionBootInfo, waitForRestore } from '../lib/desktopSession';
import { slotInnerHtml, iframeHtml, SLOT_STYLE } from '../lib/desktop/slotMarkup';
import { ssrGridLayout } from '../lib/layout/gridShape';

// The shell page must never be served stale: WebView hosts (Android) cache
// heuristically when no Cache-Control is present, which leaves devices
// running old shell code after a deploy/edit even through pull-to-refresh.
Astro.response.headers.set('Cache-Control', 'no-store');

const mgr = getAppManager();
// SSR ALL installed apps + per-app enable state — the dock applies the
// `data-enabled` filter via CSS and flips it live on `app:enabledChanged`
// events (handler at the end of this file). Same trick the LauncherOverlay
// uses; keeps both in sync without a re-fetch on every toggle.
const allApps = mgr.getManifests();
const enabledMap: Record<string, boolean> = mgr.getEnabledState();

// MRU (most-recently-used) ordering for the dock. The /api/apps/<id>/start
// endpoint writes a timestamp to `os/app-mru` on every successful launch;
// apps the user has never touched fall through to alphabetical order so the
// dock never looks empty on a first boot. Disabled apps are filtered out so
// a hidden app can't squat a dock slot.
// A page served while the boot restore is still reopening the windows would
// render a half-empty desktop (lib/desktopSession.ts): wait for it, bounded.
await waitForRestore(15_000);
const session = sessionBootInfo();

// Both SSR reads in one round of the shared KV connection (lib/sharedKv.ts).
const kv = sharedKv();
const [mruMap, storedWorkspaces] = await Promise.all([
  kv.getValue<Record<string, number>>('os', 'app-mru').then((v) => v ?? {}).catch(() => ({} as Record<string, number>)),
  kv.getValue<WorkspaceState>('os', 'workspaces').catch(() => null),
]);
const pinnedApps = [...allApps]
  .filter((m) => enabledMap[m.id] !== false)
  // Services are headless by design — they have no UI and clicking their
  // launcher tile only produces the SERVICE-HAS-NO-UI placeholder. Hide
  // them from the dock + launcher entirely; users start/stop services via
  // Process Manager (or `aura inst …`).
  .filter((m) => m.componentType !== 'service')
  .sort((a, b) => {
    const am = mruMap[a.id] ?? 0;
    const bm = mruMap[b.id] ?? 0;
    if (am !== bm) return bm - am;       // newest first
    return a.name.localeCompare(b.name); // tiebreak: alphabetical
  })
  .slice(0, 5);

// SSR workspace state — comes from the OS KV (`os/workspaces`), populated
// by bootstrapKv() before any request hits this route. Defaults are used
// only if Redis is unhealthy (shouldn't happen in steady state).
let workspaceState: WorkspaceState = DEFAULT_WORKSPACE_STATE;
if (storedWorkspaces && Array.isArray(storedWorkspaces.workspaces) && storedWorkspaces.workspaces.length > 0) {
  workspaceState = storedWorkspaces;
}

/**
 * SSR initial views.
 *   • activityMode='multi' apps → one view per OPEN activity (skip bare instance — that's
 *     just the backend process, no UI).
 *   • activityMode='none'  apps → one view per running instance (legacy 1:1 mapping).
 */
type InitialView = {
  viewId: string;
  appId: string;
  instanceId: string;
  activityId?: string;
  title: string;
  iframeUrl: string;
  state: 'normal' | 'minimized' | 'maximized';
  zIndex: number;
  isFocused: boolean;
  isLoading: boolean;
  lifecycleState: string;
  createdAt: string;
  minimizable?: boolean;
};

const initialViews: InitialView[] = [];
for (const inst of mgr.getAllInstances()) {
  if (inst.state !== 'resumed' || inst.port === null) continue;
  // Skip warm-pool members — they aren't user-owned and must NOT render as
  // iframes on page load (otherwise the user sees N pool terminals appear
  // before they've clicked anything).
  if (inst.inPool) continue;
  // Skip instances of apps the user has explicitly disabled. AppManager
  // already stops them on disable, but this guards against the brief
  // window between the chokidar `add` event and the next SSR pass.
  if (!mgr.isEnabled(inst.appId)) continue;
  const manifest = mgr.getManifest(inst.appId);
  if (!manifest) continue;

  if (manifest.activityMode === 'multi') {
    for (const act of mgr.getActivitiesByInstance(inst.instanceId)) {
      const stripped = (act.path ?? '/').replace(/^\/+/, '');
      // Activity declared minimizable AND the parent is a background
      // service — same gating as the live launchApp path.
      const minimizable = !!act.minimizable && !!manifest.backgroundService;
      initialViews.push({
        viewId:     act.activityId,
        appId:      inst.appId,
        instanceId: inst.instanceId,
        activityId: act.activityId,
        title:      act.title ?? manifest.name,
        iframeUrl:  `/api/proxy/${inst.instanceId}/${stripped}?_aura_activity=${encodeURIComponent(act.activityId)}`,
        state:      'normal',
        zIndex:     0,
        isFocused:  true,
        isLoading:  false,
        lifecycleState: inst.state,
        createdAt:  new Date().toISOString(),
        ...(minimizable ? { minimizable: true } : {}),
      });
    }
  } else {
    initialViews.push({
      viewId:     inst.instanceId,
      appId:      inst.appId,
      instanceId: inst.instanceId,
      title:      manifest.name,
      iframeUrl:  `/api/proxy/${inst.instanceId}/`,
      state:      'normal',
      zIndex:     0,
      isFocused:  true,
      isLoading:  false,
      lifecycleState: inst.state,
      createdAt:  new Date().toISOString(),
      // Non-activity views are minimizable iff the app is a background
      // service (otherwise minimizing strands a dead backend in the strip).
      ...(manifest.backgroundService ? { minimizable: true } : {}),
    });
  }
}

// Backfill orphans — only while no workspaces are stored yet (first boot, or
// the first boot after workspaces shipped): running views then join the
// active workspace instead of leaving an empty desktop. Once workspaces exist
// a reload never changes membership: a view no workspace owns is hidden (a
// closed window whose handle lived on, a restored one that was hidden before
// the restart), and the backfill — persisted with the next workspace write —
// piled those onto the active workspace on every reload (seen 2026-10-30).
// Service components (componentType=service) are deliberately hidden from
// workspace membership — they have no UI.
const knownMembers = new Set<string>(
  workspaceState.workspaces.flatMap((w) => w.members),
);
const active = workspaceState.workspaces.find(w => w.id === workspaceState.activeWorkspaceId)
            ?? workspaceState.workspaces[0]!;
for (const v of workspaceState === DEFAULT_WORKSPACE_STATE ? initialViews : []) {
  // Services don't get added to any workspace — their presence in `views`
  // is incidental (they don't render UI in the desktop), and adding them
  // would clutter the user's app set.
  const m = mgr.getManifest(v.appId);
  if (m?.componentType === 'service') continue;
  // Nor an app whose backend runs without a window (autoStart, or
  // backgroundService — closing its window leaves it running). Without
  // activities its view only says "the instance is up", not "a window was
  // open", so adopting it popped Hermes onto the desktop at every boot and
  // back open on every reload after the user closed it. Its window opens
  // when the user launches it; activity views are still backfilled, since
  // an activity exists only because a window was opened.
  if (!v.activityId && (m?.autoStart || m?.backgroundService)) continue;
  if (!knownMembers.has(v.viewId)) {
    active.members.push(v.viewId);
    knownMembers.add(v.viewId);
  }
}

// Filter the SSR views the same way the JS will at runtime — only the
// active workspace's members render in the first paint. Services still
// SSR (their iframe exists) but Phase 3+ will hide them visually via CSS
// since they're not in `members`. For now: drop services from initial
// render entirely.
const ssrServiceViewIds = new Set<string>(
  initialViews.filter((v) => mgr.getManifest(v.appId)?.componentType === 'service').map((v) => v.viewId),
);
// Sort by workspace.members order so the tiling/stack/rows/columns layout
// hands cell N to the same viewId on every reload. Without this, order
// follows AppManager's instance-creation order (effectively process
// startup time) which has no relation to the user's arrangement. New
// views the workspace doesn't yet know about (backfilled above into
// active.members) keep relative order because they were appended.
const orderIndex = new Map<string, number>(active.members.map((id, i) => [id, i]));
const ssrVisibleViews = initialViews
  .filter((v) => active.members.includes(v.viewId) && !ssrServiceViewIds.has(v.viewId))
  .sort((a, b) => (orderIndex.get(a.viewId) ?? 1e9) - (orderIndex.get(b.viewId) ?? 1e9));

// Apply per-workspace focus state — `Workspace.layoutState.focusedViewId`.
// Fullscreen mode renders only the focused view, so this drives which app
// occupies the screen on cold load. Falls back to the first member when
// unset so the layout never breaks.
{
  const focusedId = active.layoutState?.focusedViewId;
  for (const v of ssrVisibleViews) v.isFocused = focusedId ? v.viewId === focusedId : false;
  if (!ssrVisibleViews.some((v) => v.isFocused) && ssrVisibleViews[0]) ssrVisibleViews[0].isFocused = true;
}

// The active workspace's slots are rendered straight into #dynamic-layout,
// with the same markup the desktop script builds (lib/desktop/slotMarkup), so
// the script ADOPTS them in place: each iframe starts loading while the page
// is still parsing and loads exactly once (moving or recreating an iframe
// reloads it). Activities a hide-minimize layout parked stay in the DOM,
// hidden. Grid cells match the client strategy; Free Window starts as tiling
// and is re-placed once the script runs (restyling never reloads).
const parkedIds = new Set<string>(
  Array.isArray(active.layoutState?.['minimized']) ? (active.layoutState!['minimized'] as string[]) : [],
);
const ssrPlaced = ssrVisibleViews.filter((v) => !parkedIds.has(v.viewId));
const ssrGrid = ssrGridLayout(active.layoutId ?? 'tiling', ssrPlaced.length);
const ssrSlots = ssrVisibleViews.map((v) => {
  const i = ssrPlaced.indexOf(v);
  return {
    viewId: v.viewId, instanceId: v.instanceId, activityId: v.activityId,
    style: SLOT_STYLE + (i >= 0 ? (ssrGrid.slots[i] ?? '') : 'display:none;'),
    html: slotInnerHtml({ minimizable: v.minimizable, bodyHtml: iframeHtml(v.iframeUrl, v.title) }),
  };
});
const dynamicLayoutStyle = ssrPlaced.length > 0 ? ssrGrid.container : 'display:none; position:absolute; inset:0;';
---
<OSLayout pinnedApps={pinnedApps}>
  <div id="desktop-content">
    <div id="static-layout">
      {ssrPlaced.length === 0 && <LayoutManager views={[]} strategyId={active.layoutId} layoutState={active.layoutState} />}
    </div>
    <div id="dynamic-layout" style={dynamicLayoutStyle}>
      {ssrSlots.map((sl) => (
        <div class="app-slot" data-view-id={sl.viewId} data-instance-id={sl.instanceId} data-activity-id={sl.activityId} data-ssr="1" style={sl.style} set:html={sl.html}></div>
      ))}
    </div>
    <!-- Layout-manager extension points (lib/layout/types.ts): the active
         strategy may mount bars into these regions (e.g. Free Window's
         taskbar on top); #dynamic-layout is inset by their measured size, so
         activities, maximize and the viewport broadcast get the remaining box.
         #layout-overlay sits above the activities for previews / splitters. -->
    <div id="layout-region-top"    class="layout-region" data-side="top"></div>
    <div id="layout-region-bottom" class="layout-region" data-side="bottom"></div>
    <div id="layout-region-left"   class="layout-region" data-side="left"></div>
    <div id="layout-region-right"  class="layout-region" data-side="right"></div>
    <div id="layout-overlay" aria-hidden="true"></div>
    <script type="application/json" id="aura-initial-views" set:html={JSON.stringify(initialViews)}></script>
    <script type="application/json" id="aura-initial-workspaces" set:html={JSON.stringify(workspaceState)}></script>
    <script type="application/json" id="aura-boot" set:html={JSON.stringify(session)}></script>

    <!-- Focus mode: covers the entire viewport when activated from Process Manager -->
    <div id="focus-view" aria-hidden="true">
      <header id="focus-header">
        <span id="focus-title">FOCUS</span>
        <span id="focus-instance-id"></span>
        <button id="focus-fullscreen" title="Toggle full size (overlay top + bottom bars)" aria-pressed="false"><Icon name="maximize" /> FULL SIZE</button>
        <button id="focus-exit" title="Exit focus (Esc)"><Icon name="x" /> EXIT FOCUS</button>
      </header>
      <!-- Positioned wrapper so #focus-frame can be absolutely sized and
           counter-scaled by --aura-iframe-scale (app zoom), exactly like a
           windowed app's .slot-body iframe. -->
      <div id="focus-body">
        <iframe id="focus-frame" title="Focused app"></iframe>
      </div>
    </div>
  </div>
</OSLayout>

<script>
  import * as workspaceClient from '../lib/workspaceClient';
  import * as nativeSurface from '../lib/nativeSurface.ts';
  import { getKeyDispatcher } from '../lib/keyDispatcher.ts';
  import { nextInDirection, getViewRects } from '../lib/windowNav.ts';
  import type { LayoutNavContext } from '../lib/windowNav.ts';
  import { osEvents } from '../lib/osEvents.ts';
  import { registerUiCommand, registerSnapshotPart, invokeLocal, startUiCommandListener } from '../lib/uiCommands.ts';
  import { markLaunchedHere } from '../lib/launchOrigin.ts';
  import { beginWindowDrag, handOffActivityDrag, registerDropTarget, setLayoutDragPolicy, getLayoutDragPolicy } from '../lib/windowDrag.ts';
  import { dragPolicyFor } from '../lib/layoutDragPolicies.ts';
  import { shellLayoutFor } from '../lib/layout/registry.ts';
  import type { LayoutHost, LayoutRenderContext, LayoutViewInfo, RegionSide, ShellLayoutStrategy } from '../lib/layout/types.ts';
  import {
    queueViewportBroadcast,
    observeIframe,
    unobserveIframe,
    postViewportMount,
    setROSuppressed,
  } from '../lib/viewportBroadcaster.ts';
  import { createLogger } from '@aura/core/logger';
  import { mark, markTime, onStage, resolveStage, isStageDone, idle, addReportField } from '../lib/bootTimeline.ts';
  import {
    createIframeWarmer, parsePolicy, warmOrder, rememberRecentWorkspace, recentWorkspaces,
    LAZY_KV_KEY, LAZY_STORAGE_KEY,
  } from '../lib/iframeWarmer.ts';
  import { subscribeKv } from '../lib/kvClient.ts';
  import { appsSnapshotStats } from '../lib/appsSnapshot.ts';
  import { slotInnerHtml, SLOT_STYLE, IFRAME_STYLE } from '../lib/desktop/slotMarkup.ts';

  const layoutLog = createLogger('shell:layout');
  const iframeLog = createLogger('shell:iframe');
  resolveStage('chrome-ready');

  const keyDispatcher = getKeyDispatcher();

  // -------- Iframe key bridge ---------------------------------------------
  //
  // The proxy injects a passive forwarder into every app iframe. That
  // forwarder watches keydown events, canonicalises the combo, and only
  // posts up the ones in its `aura.key.claim` list — everything else flows
  // to the app and to the browser's native handling untouched (the
  // "browser-default guarantee").
  //
  // Here we (a) listen for those forwarded combos and feed them to the
  // dispatcher and (b) push the current claim list down to every iframe
  // whenever it changes (state/catalogue/focus). Re-broadcast also happens
  // on each iframe's `load` event so a freshly-mounted iframe never has an
  // empty claim list.
  window.addEventListener('message', (ev: MessageEvent) => {
    const d = ev.data as { type?: string; combo?: string; appId?: string; actionIds?: string[]; reason?: string } | null;
    if (!d || typeof d !== 'object') return;

    // Forwarded keystroke from an app iframe.
    if (d.type === 'aura.key') {
      if (typeof d.combo !== 'string' || typeof d.appId !== 'string') return;
      const res = keyDispatcher.handleIframeCombo(d.combo, d.appId);
      // App-scope action that the shell can't run itself — bounce back so
      // the SDK in-iframe fires the registered handler.
      if (res.actionId && res.actionId.startsWith('app.') && !res.fired) {
        try {
          (ev.source as Window | null)?.postMessage(
            { type: 'aura.action.fire', actionId: res.actionId, combo: d.combo },
            '*',
          );
        } catch { /* iframe gone */ }
      }
      return;
    }

    // App SDK subscribed/unsubscribed from a set of actions. The claim list
    // for the iframe is already derived from manifest declarations (every
    // declared app action is claimed regardless of subscription state) — we
    // just rebroadcast in case the iframe missed the initial send, and
    // mirror the SDK contract that subscribe is the trigger.
    if (d.type === 'aura.keymap.subscribe') {
      const target = ev.source as Window | null;
      try {
        const combos = (() => {
          if (typeof d.appId !== 'string') return [];
          return keyDispatcher.getClaimListForApp(d.appId);
        })();
        target?.postMessage({ type: 'aura.key.claim', combos }, '*');
      } catch { /* iframe gone */ }
      return;
    }

    // App startup marks (e.g. the Terminal's script → socket → replay): into
    // the boot timeline as `app:<window>:<name>`, next to the window's own
    // `src` / `load` marks. `appT` is the app page's own clock.
    if (d.type === 'aura.perf.mark') {
      const name = (d as { name?: unknown }).name;
      if (typeof name !== 'string' || !name || name.length > 64) return;
      const frame = appFrameFor(ev.source as Window | null);
      const viewId = frame?.closest<HTMLElement>('.app-slot')?.dataset['viewId'];
      if (!viewId) return;
      const extra = (d as { detail?: unknown }).detail;
      mark(`app:${viewId}:${name}`, { appT: (d as { t?: unknown }).t, ...(extra && typeof extra === 'object' ? extra as Record<string, unknown> : {}) });
      return;
    }

    // App reporting what its window should be called. Same trust model as
    // rebind: resolved from the sender's frame, so an app can only rename the
    // window it is running in, and the text is only ever set as textContent.
    if (d.type === 'aura.window.label') {
      const text = (d as { text?: unknown }).text;
      if (text !== null && typeof text !== 'string') return;
      const frame = appFrameFor(ev.source as Window | null);
      const viewId = frame?.closest<HTMLElement>('.app-slot')?.dataset['viewId'];
      if (!viewId) return;
      const idx = views.findIndex((v) => v.viewId === viewId);
      if (idx < 0) return;
      const v = views[idx]!;
      const next = typeof text === 'string' && text ? text : undefined;
      if (v.sessionLabel === next) return;
      const updated = { ...v, sessionLabel: next };
      views = [...views.slice(0, idx), updated, ...views.slice(idx + 1)];
      // Only this window's title text changes — repaint its slot, not the
      // whole desktop (every terminal reports its label as it loads).
      const slot = frame?.closest<HTMLElement>('.app-slot');
      if (slot) updateSlot(slot, updated); else renderLayout();
      return;
    }

    // App asking to move ITS OWN window to another backend instance of the
    // same app (the Terminal's container switcher). Resolved from the sender's
    // frame, never from a payload-supplied view id — an app may only move the
    // window it is actually running in.
    if (d.type === 'aura.window.rebind') {
      const targetId = (d as { instanceId?: unknown }).instanceId;
      if (typeof targetId !== 'string' || !targetId) return;
      const frame = appFrameFor(ev.source as Window | null);
      const viewId = frame?.closest<HTMLElement>('.app-slot')?.dataset['viewId'];
      if (viewId) void rebindViewToInstance(viewId, targetId);
      return;
    }

    // App SDK requesting a system action.
    if (d.type && d.type.startsWith('aura.system.')) {
      handleSystemAction(d.type, d as { type: string });
      return;
    }

    // Host URL-relay: a script the WebView host injects into every
    // nested frame postMessages `window.top` on every navigation it
    // sees (initial load, SPA pushState, popstate, hashchange, title
    // mutations). We route the event by `activityId` (or instanceId
    // for non-activity apps) to the iframe that owns that view, and
    // postMessage it down to the app so its URL bar can update.
    if (d.type === 'aura.host.url-changed') {
      const p = d as unknown as { type: string; source?: unknown; activityId?: unknown; instanceId?: unknown };
      if (p.source !== 'host') return;
      const aid = typeof p.activityId === 'string' ? p.activityId : null;
      const iid = typeof p.instanceId === 'string' ? p.instanceId : null;
      let slot: HTMLElement | null = null;
      if (aid) slot = document.querySelector<HTMLElement>(`.app-slot[data-activity-id="${CSS.escape(aid)}"]`);
      if (!slot && iid) slot = document.querySelector<HTMLElement>(`.app-slot[data-instance-id="${CSS.escape(iid)}"]`);
      const target = slot?.querySelector<HTMLIFrameElement>('iframe');
      try { target?.contentWindow?.postMessage(d, '*'); } catch { /* iframe gone */ }
      return;
    }

    // Native popup intercepted by the host WebView (Android/Electron).
    // The host denies the real popup and posts the URL here; we dispatch
    // an aura.intent.action.VIEW so whichever app claims http/https
    // picks it up (Browser, today). userGesture==false is treated as a
    // pop-up-blocker drop; non-http(s) schemes are also rejected.
    if (d.type === 'aura.host.popup') {
      const p = d as unknown as {
        type: string; source?: unknown; url?: unknown;
        userGesture?: unknown; platform?: unknown; disposition?: unknown;
      };
      if (p.source !== 'host') return;
      if (p.userGesture !== true) return;
      const url = typeof p.url === 'string' ? p.url.trim() : '';
      if (!url || url === 'about:blank') return;
      if (!/^https?:\/\//i.test(url)) return;
      void dispatchHostPopup(url, p.platform, p.disposition);
      return;
    }

    // A framed site that can only run as a top-level document. The host
    // detects this from an unhandled cross-origin frame SecurityError raised
    // inside the frame itself, and posts from there — so ev.source identifies
    // the failing frame, which is the only way to know WHICH window is
    // affected (the native side sees a URL and nothing more).
    //
    // The OS does not decide what to do about it. It resolves the owning app
    // and hands the app the notification; the app asks for a native surface if
    // it wants one. Routing it straight to the Browser app would be wrong on
    // its own terms anyway — that app renders in a nested <iframe>, so it
    // would re-frame the URL and reproduce the exact failure.
    if (d.type === 'aura.frame.needsTopLevel') {
      const p = d as unknown as { type: string; url?: unknown; reason?: unknown };
      const url = typeof p.url === 'string' ? p.url.trim() : '';
      if (!url || !/^https?:\/\//i.test(url)) return;
      const owner = ownerFrameOf(ev.source as Window | null);
      if (!owner) { console.debug('[needsTopLevel] no owning window for', url); return; }
      try {
        owner.contentWindow?.postMessage(
          { type: 'aura.host.needsTopLevel', url, reason: p.reason ?? 'detector' }, '*');
      } catch { /* frame gone */ }
      return;
    }

    // Native-originated notification (a host already known to need top-level
    // context, reported before the page loads). Same routing, but we have to
    // find the owner by URL because there is no source frame to walk.
    if (d.type === 'aura.host.needsTopLevel') {
      const p = d as unknown as { type: string; source?: unknown; url?: unknown; reason?: unknown };
      if (p.source !== 'host') return;
      const url = typeof p.url === 'string' ? p.url.trim() : '';
      if (!url || !/^https?:\/\//i.test(url)) return;
      // Broadcast: only the app that actually framed this URL will act on it.
      document.querySelectorAll<HTMLIFrameElement>('.app-slot iframe').forEach((f) => {
        try { f.contentWindow?.postMessage({ type: 'aura.host.needsTopLevel', url, reason: p.reason ?? 'known-host' }, '*'); }
        catch { /* frame gone */ }
      });
      return;
    }

    // ── Native surface API (osClient.surface) ────────────────────────────
    // The OS supplies the capability; the requesting app supplies the policy.
    // Every call is bound to the caller's own frame, so an app can only ever
    // place a surface over itself.
    // Capability probe. An app iframe cannot see window.Capacitor — the host
    // injects its bridge only into the shell's own document — so "am I running
    // under the native host?" is a question only the OS can answer.
    if (d.type === 'aura.surface.query') {
      const src = ev.source as Window | null;
      if (!appFrameFor(src)) return;
      try {
        src?.postMessage({ type: 'aura.surface.capability', supported: nativeSurface.isSupported() }, '*');
      } catch { /* frame gone */ }
      return;
    }

    // Navigation commands from the app that owns the surface.
    if (d.type === 'aura.surface.command') {
      const frame = appFrameFor(ev.source as Window | null);
      if (!frame) return;
      const p = d as unknown as { surfaceId?: unknown; action?: unknown; payload?: unknown };
      const surfaceId = typeof p.surfaceId === 'string' ? p.surfaceId : '';
      const action = typeof p.action === 'string' ? p.action : '';
      const allowed = ['navigate', 'goBack', 'goForward', 'reload', 'setZoom', 'getState', 'setVisible'];
      if (!surfaceId || !allowed.includes(action)) return;
      const payload = (p.payload && typeof p.payload === 'object')
        ? p.payload as Record<string, unknown> : {};
      nativeSurface.command(frame, surfaceId, action as nativeSurface.SurfaceCommand, payload);
      return;
    }

    if (d.type === 'aura.surface.attach'
     || d.type === 'aura.surface.setRect'
     || d.type === 'aura.surface.detach') {
      const frame = appFrameFor(ev.source as Window | null);
      if (!frame) return;
      const p = d as unknown as { surfaceId?: unknown; url?: unknown; rect?: unknown };
      const surfaceId = typeof p.surfaceId === 'string' ? p.surfaceId : '';
      if (!surfaceId) return;

      if (d.type === 'aura.surface.detach') {
        nativeSurface.detach(frame, surfaceId);
        return;
      }
      const rect = readRect(p.rect);
      if (!rect) return;
      if (d.type === 'aura.surface.setRect') {
        nativeSurface.setRect(frame, surfaceId, rect);
        return;
      }
      const url = typeof p.url === 'string' ? p.url.trim() : '';
      if (!url || !/^https?:\/\//i.test(url)) return;
      const chrome = (d as unknown as { chrome?: unknown }).chrome !== false;
      nativeSurface.attach(frame, surfaceId, url, rect, { chrome });
      return;
    }
  });

  function readRect(v: unknown): nativeSurface.SurfaceRect | null {
    if (!v || typeof v !== 'object') return null;
    const r = v as Record<string, unknown>;
    // Read each field by name rather than mapping into an array and
    // destructuring it: the array form is identical at runtime, but its
    // elements type as `number | undefined`, so every use downstream needs a
    // non-null assertion that would outlive whatever made it true.
    const x = Number(r['x']);
    const y = Number(r['y']);
    const width = Number(r['width']);
    const height = Number(r['height']);
    // Rejects NaN and Infinity, which is what a missing or non-numeric field
    // becomes — this rect crosses a postMessage boundary from an app.
    if (![x, y, width, height].every((n) => Number.isFinite(n))) return null;
    if (width <= 0 || height <= 0) return null;
    return { x, y, width, height };
  }

  /** The `.app-slot` iframe whose contentWindow is exactly `w`. */
  function appFrameFor(w: Window | null): HTMLIFrameElement | null {
    if (!w) return null;
    for (const f of document.querySelectorAll<HTMLIFrameElement>('.app-slot iframe')) {
      if (f.contentWindow === w) return f;
    }
    return null;
  }

  /**
   * Walk up from an arbitrary (possibly deeply nested, cross-origin) frame to
   * the app window that contains it.
   *
   * Reading `.parent` on a cross-origin WindowProxy and comparing WindowProxy
   * references are both permitted — it is reading *properties* of a
   * cross-origin document that is blocked. So the chain can be climbed even
   * though nothing inside those frames is readable.
   */
  function ownerFrameOf(w: Window | null): HTMLIFrameElement | null {
    let cur: Window | null = w;
    for (let hops = 0; cur && hops < 20; hops++) {
      const match = appFrameFor(cur);
      if (match) return match;
      let parent: Window | null = null;
      try { parent = cur.parent; } catch { return null; }
      if (!parent || parent === cur) return null;
      cur = parent;
    }
    return null;
  }

  // Tells the host a handler is installed AND able to act. If the bridge is
  // missing (desktop browser, Electron parity pending) we leave this unset so
  // the native side falls back to opening the overlay fullscreen itself,
  // rather than claiming the event and dropping it.
  if (nativeSurface.isSupported()) {
    (window as { __auraHandlesNeedsTopLevel?: boolean }).__auraHandlesNeedsTopLevel = true;
  }

  async function dispatchHostPopup(url: string, platform: unknown, disposition: unknown): Promise<void> {
    try {
      const r = await fetch('/api/intents/start', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({
          action:   'aura.intent.action.VIEW',
          uri:      url,
          category: ['aura.intent.category.DEFAULT'],
          extras:   {
            url,
            fromHost:    true,
            platform:    typeof platform    === 'string' ? platform    : null,
            disposition: typeof disposition === 'string' ? disposition : null,
          },
        }),
      });
      if (!r.ok) { console.warn('[popup] intent rejected', r.status); return; }
      const res = await r.json() as { kind?: string; candidates?: Array<{ appId: string }> };
      if (res.kind === 'disambiguation' && res.candidates?.[0]) {
        // v1: no chooser UI — pick the top candidate.
        await fetch(`/api/apps/${res.candidates[0].appId}/start`, { method: 'POST' });
      }
    } catch (err) {
      console.warn('[popup] dispatch failed', err);
    }
  }

  function handleSystemAction(type: string, payload: { type: string }): void {
    if (type === 'aura.system.openLauncher')        (window as { auraOpenLauncher?: () => void }).auraOpenLauncher?.();
    else if (type === 'aura.system.closeLauncher')  (window as { auraCloseLauncher?: () => void }).auraCloseLauncher?.();
    else if (type === 'aura.system.toggleLauncher') (window as { auraToggleLauncher?: () => void }).auraToggleLauncher?.();
    else if (type === 'aura.system.toggleNavMode')  keyDispatcher.setMode(keyDispatcher.getMode() === 'nav' ? 'app' : 'nav');
    else if (type === 'aura.system.toggleHome')     keyDispatcher.setMode('nav');
    else if (type === 'aura.system.lockScreen')     (window as { auraLockScreen?: () => void }).auraLockScreen?.();
    // The SDK has posted these four for a long time; nothing answered them.
    // They are the same operations the shell MCP drives, so route them
    // through the same command table rather than a second set of globals.
    else if (type === 'aura.system.openProcessManager')   void invokeLocal('openProcessManager').catch((err) => console.warn('[shell]', err));
    else if (type === 'aura.system.closeProcessManager')  void invokeLocal('closeProcessManager').catch((err) => console.warn('[shell]', err));
    else if (type === 'aura.system.toggleProcessManager') void invokeLocal('toggleProcessManager').catch((err) => console.warn('[shell]', err));
    else if (type === 'aura.system.switchWorkspace') {
      const slot = Number((payload as { slot?: unknown }).slot);
      const target = workspaceClient.getCached()?.workspaces[slot - 1];
      if (target) workspaceClient.setActive(target.id).catch((err) => console.warn('[shell] setActive failed', err));
    }
  }

  function appIdFromIframe(frame: HTMLIFrameElement): string | null {
    const m = (frame.getAttribute('src') ?? '').match(/^\/api\/proxy\/([^/]+)\//);
    if (!m) return null;
    return (m[1] ?? '').replace(/-\d+$/, '');
  }

  function sendClaimList(frame: HTMLIFrameElement): void {
    const appId    = appIdFromIframe(frame);
    const combos   = keyDispatcher.getClaimListForApp(appId);
    const bindings = keyDispatcher.getBindingsForApp(appId);
    try {
      frame.contentWindow?.postMessage({ type: 'aura.key.claim',     combos   }, '*');
      // Bindings travel separately so the SDK's getBinding() can refresh
      // without parsing the claim list. Sent on every iframe-load + every
      // state change so menu shortcut hints stay current.
      frame.contentWindow?.postMessage({ type: 'aura.keymap.changed', bindings }, '*');
    } catch { /* cross-origin or torn-down frame */ }
  }

  function broadcastClaims(): void {
    // Cold iframes (no src yet) get their list on their first `load`.
    document.querySelectorAll('iframe').forEach((f) => {
      if ((f as HTMLIFrameElement).getAttribute('src')) sendClaimList(f as HTMLIFrameElement);
    });
  }

  // Tell app iframes their usable size / scale changed, carrying that iframe's
  // exact logical content box so the app does pure arithmetic instead of
  // re-measuring its own settling DOM. Two kinds of signal:
  //   • GEOMETRY (tiling reflow, window open/close, fullscreen, rows,
  //     free-window resize, maximize, browser resize) — driven by the
  //     per-iframe ResizeObserver (observeIframe), which fires once per real
  //     box change. No layout code has to remember to broadcast.
  //   • NON-GEOMETRY (viewport zoom: a paint-only `transform: scale()` no
  //     observer can see; first mount) — stays explicit via
  //     queueViewportBroadcast('zoom') in StatusBar.astro and postViewportMount.
  // Apps consume it via the SDK's onViewportChange(). All of this lives in
  // ../lib/viewportBroadcaster.ts — the single broadcaster shared with
  // StatusBar.astro (was duplicated per island).

  // Dispatcher re-emits on every setActions/setState — push the latest list
  // to every mounted iframe so SDK subscriptions and remap events apply
  // without an iframe reload.
  keyDispatcher.onClaimListChange(() => broadcastClaims());

  // OS Home — switches to Nav mode AND highlights the first window so the
  // next arrow press picks a neighbour rather than the same slot.
  keyDispatcher.bind('aura.nav.home', () => {
    keyDispatcher.setMode('nav');
    if (!navHighlightedViewId) {
      const first = visibleViewIds()[0];
      if (first) setNavHighlight(first);
    }
  });

  // OS Back. Android-spirit chain:
  //   1. Send `aura.back` to the focused iframe. The app's
  //      `osClient.nav.onBack` listeners can `preventDefault()` to keep
  //      Back inside the app and ack via `aura.back.ack`.
  //   2. If not acked within 100ms, ask the OS to pop the in-activity
  //      history (POST /api/activities/<id>/back). The endpoint's
  //      AppManager.goBack() pops history if non-empty, else closes
  //      the activity / refocuses parent.
  //   3. If there is nothing to pop and no stacked activity, switch to
  //      Nav mode as the final fallback.
  //
  // Source resolution: when Back came from an iframe-forwarded combo,
  // `ctx.appId` carries the source app id. When it came from a shell-side
  // keydown (focus on launcher/dock/etc.), `ctx.appId` is null and we
  // fall straight through to Nav mode.
  keyDispatcher.bind('aura.nav.back', async (ctx) => {
    if (keyDispatcher.getMode() !== 'app') return;
    const sourceFrame = findIframeByAppId(ctx.appId);
    if (!sourceFrame) {
      keyDispatcher.setMode('nav');
      return;
    }
    const handled = await sendBackAndWaitForAck(sourceFrame, 100);
    if (handled) return;
    const activityId = activityIdOfFrame(sourceFrame);
    if (activityId) {
      // The endpoint's goBack pops in-activity history when non-empty,
      // else closes/refocuses parent — fire-and-forget.
      void fetch(`/api/activities/${encodeURIComponent(activityId)}/back`, { method: 'POST' });
      return;
    }
    keyDispatcher.setMode('nav');
  });

  function findIframeByAppId(appId: string | null): HTMLIFrameElement | null {
    if (!appId) return null;
    for (const frame of document.querySelectorAll<HTMLIFrameElement>('iframe')) {
      const src = frame.getAttribute('src') ?? '';
      const m = src.match(/^\/api\/proxy\/([^/]+)\//);
      if (m && (m[1] ?? '').replace(/-\d+$/, '') === appId) return frame;
    }
    return null;
  }

  function activityIdOfFrame(frame: HTMLIFrameElement): string | null {
    const slot = frame.closest<HTMLElement>('.app-slot[data-view-id]');
    return slot?.dataset['activityId'] ?? null;
  }

  async function sendBackAndWaitForAck(frame: HTMLIFrameElement, timeoutMs: number): Promise<boolean> {
    return new Promise((resolve) => {
      let done = false;
      const handler = (ev: MessageEvent) => {
        if (ev.source !== frame.contentWindow) return;
        const d = ev.data as { type?: string; handled?: boolean } | null;
        if (!d || d.type !== 'aura.back.ack') return;
        if (done) return;
        done = true;
        window.removeEventListener('message', handler);
        resolve(!!d.handled);
      };
      window.addEventListener('message', handler);
      try { frame.contentWindow?.postMessage({ type: 'aura.back' }, '*'); }
      catch { /* iframe gone */ }
      setTimeout(() => {
        if (done) return;
        done = true;
        window.removeEventListener('message', handler);
        resolve(false);
      }, timeoutMs);
    });
  }

  // -------- Nav-mode window focus -----------------------------------------
  // In Nav mode arrow keys move a focus ring between visible windows; Enter
  // hands focus to that window (and the OS flips to App mode). The ring is
  // drawn via `data-aura-nav-focus="true"` on the highlighted `.app-slot`
  // (see the <style is:global> at the bottom of this file).
  let navHighlightedViewId: string | null = null;

  // Sub-mode within Nav: "chrome-select" lets the user walk the highlighted
  // window's title-bar buttons (close / minimize / maximize / breadcrumb)
  // with arrows. Entered by Backspace on a highlighted window; second
  // Backspace returns to window-selection. Default selection = the Close
  // button, since it's the rightmost / most prominent chrome action.
  let chromeSelectActive = false;

  function visibleViewIds(): string[] {
    return Array.from(document.querySelectorAll<HTMLElement>('.app-slot[data-view-id]'))
      .filter((el) => el.offsetParent !== null) // not display:none
      .map((el) => el.dataset['viewId'] ?? '')
      .filter(Boolean);
  }

  function setNavHighlight(viewId: string | null): void {
    document.querySelectorAll<HTMLElement>('.app-slot[data-aura-nav-focus]').forEach((el) => {
      el.removeAttribute('data-aura-nav-focus');
    });
    navHighlightedViewId = viewId;
    if (!viewId) return;
    const slot = document.querySelector<HTMLElement>(`.app-slot[data-view-id="${CSS.escape(viewId)}"]`);
    if (slot) slot.setAttribute('data-aura-nav-focus', 'true');
  }

  keyDispatcher.onModeChange((mode) => {
    if (mode === 'nav') {
      // If the user is currently in focus mode (a window maximized to the
      // full-viewport overlay), entering window-selection should land on
      // THAT window — otherwise the focused app is the obvious starting
      // point but the default-first-visible logic would pick whichever
      // slot is earliest in workspace member order. Exiting focus mode
      // also matters: the overlay is z-50 over the desktop, so without
      // exiting the user couldn't see the highlight ring or arrow-walk
      // to any other window.
      // Focus mode + nav mode: the focused window is the ONLY visible
      // window, so it's also the "highlighted" one for window-selection.
      // Don't exit focus mode — the user still sees the full-screen app,
      // and chrome-select (Backspace) walks the focus-view's own header
      // buttons (Exit Focus) instead of the hidden slot's chrome.
      if (focusedInstanceId !== null) {
        // Mark the focus-view as the selection target FIRST. We don't
        // gate this on finding the view in `views` — stale workspace
        // state could leave the user staring at a focused app with no
        // visible "selected" cue. The visual is the load-bearing part
        // for the user; the id tracking is for chrome-select to know
        // which slot to fall back to after Exit Focus.
        focusView.setAttribute('data-aura-nav-focus', 'true');
        const fIid = focusedInstanceId;
        const fAid = focusedActivityId;
        const v = views.find((vv) =>
          vv.instanceId === fIid && (fAid ? vv.activityId === fAid : true)
        );
        if (v) navHighlightedViewId = v.viewId;
      } else if (!navHighlightedViewId) {
        const first = visibleViewIds()[0];
        if (first) setNavHighlight(first);
      } else {
        setNavHighlight(navHighlightedViewId); // refresh outline class
      }
    } else {
      // App mode — drop the ring AND tear down any chrome-select sub-state.
      setNavHighlight(null);
      chromeSelectActive = false;
      // Clear the focus-view nav cue too (no-op if it wasn't set).
      focusView.removeAttribute('data-aura-nav-focus');
    }
    // Mirror the dispatcher mode onto the `◐` chip so its active style
    // (filled primary background, set via CSS in Dock.astro) tracks the
    // actual window-select state. Done here rather than in Dock.astro so
    // the dispatcher reference stays inside this script's scope.
    const navEntry = document.getElementById('dock-nav-entry');
    if (navEntry) navEntry.dataset['mode'] = mode === 'nav' ? 'active' : '';
  });

  function moveNav(dir: 'up' | 'down' | 'left' | 'right'): void {
    if (keyDispatcher.getMode() !== 'nav') return;
    // Focus mode: only one visible window (the focus overlay). Arrows
    // would otherwise swap `navHighlightedViewId` to a slot hidden under
    // the z-50 overlay — confusing. The user exits focus first if they
    // want to walk other windows, or presses Backspace to enter
    // chrome-select on the focus-view's own buttons.
    if (focusedInstanceId !== null && !chromeSelectActive) return;
    // Sub-mode: walking the chrome buttons of the highlighted slot.
    // Only horizontal movement makes sense (single row of buttons); up/down
    // is a no-op here so the user doesn't accidentally jump back to window
    // selection by pressing the wrong axis. Backspace toggles out.
    if (chromeSelectActive) {
      if (dir !== 'left' && dir !== 'right') return;
      // In focus mode the navigable chrome is the focus-view's header
      // (currently just the Exit Focus button). In normal mode it's the
      // highlighted slot's `.slot-chrome` buttons.
      let btns: HTMLButtonElement[];
      if (focusedInstanceId !== null) {
        const header = document.getElementById('focus-header');
        btns = header ? Array.from(header.querySelectorAll<HTMLButtonElement>('button')) : [];
      } else {
        if (!navHighlightedViewId) return;
        const slot = document.querySelector<HTMLElement>(`.app-slot[data-view-id="${CSS.escape(navHighlightedViewId)}"]`);
        if (!slot) return;
        btns = Array.from(slot.querySelectorAll<HTMLButtonElement>('.slot-chrome button'));
      }
      if (btns.length === 0) return;
      const cur = btns.indexOf(document.activeElement as HTMLButtonElement);
      const nextIdx = dir === 'left'
        ? Math.max(0, cur - 1)
        : Math.min(btns.length - 1, cur + 1);
      btns[nextIdx]?.focus();
      return;
    }
    const ids = visibleViewIds();
    if (ids.length === 0) return;
    const current = navHighlightedViewId && ids.includes(navHighlightedViewId)
      ? navHighlightedViewId
      : ids[0]!;
    // Route through `getViewRects` so a future layout-strategy plugin can
    // register a custom `(viewIds, ctx) => ViewRect[]` and override the
    // default (live DOM bboxes). Every shipped strategy is bbox-driven, so
    // the fallback inside getViewRects matches the previous behaviour.
    const wsState = workspaceClient.getCached();
    const active  = wsState?.workspaces.find((w) => w.id === wsState.activeWorkspaceId);
    const ctx: LayoutNavContext = {
      layoutId:      active?.layoutId ?? 'tiling',
      desktopWidth:  dynamicLayout.clientWidth  || window.innerWidth,
      desktopHeight: dynamicLayout.clientHeight || window.innerHeight,
      layoutState:   active?.layoutState as Record<string, unknown> | undefined,
      slotFor:       (vid) => document.querySelector(`.app-slot[data-view-id="${CSS.escape(vid)}"]`),
    };
    const rects = getViewRects(ids, ctx);
    const next  = nextInDirection(rects, current, dir);
    setNavHighlight(next);
  }

  keyDispatcher.bind('aura.nav.up',    () => moveNav('up'));
  keyDispatcher.bind('aura.nav.down',  () => moveNav('down'));
  keyDispatcher.bind('aura.nav.left',  () => moveNav('left'));
  keyDispatcher.bind('aura.nav.right', () => moveNav('right'));

  keyDispatcher.bind('aura.nav.enter', () => {
    if (keyDispatcher.getMode() !== 'nav' || !navHighlightedViewId) return;
    // In chrome-select sub-mode Enter activates the focused title-bar
    // button (close, minimize, etc.). The dispatcher's capture-phase
    // listener has already preventDefault'd the keystroke, so the
    // browser's native Enter→click on a focused button won't fire — we
    // have to dispatch the click manually.
    if (chromeSelectActive) {
      const btn = document.activeElement as HTMLButtonElement | null;
      const wasCloseAction = btn?.dataset?.['action'] === 'close';
      const closedViewId = wasCloseAction ? navHighlightedViewId : null;
      btn?.click?.();
      // The button's effect (close, minimize, exit-focus…) drives
      // downstream state. Reset chrome-select so the user emerges in a
      // clean window-selection state from whichever slot now holds the
      // highlight.
      chromeSelectActive = false;
      // Close specifically: keep the user in window-selection mode and
      // re-highlight the next visible window so they can continue
      // arrow-walking without going through Ctrl+Alt+Space → Enter
      // again. The slot removal is processed by renderLayout in the
      // same task as the close click (closeView_ → views state update
      // → renderLayout); rAF defers until AFTER that layout pass so
      // `visibleViewIds()` reflects the post-close state.
      if (wasCloseAction) {
        requestAnimationFrame(() => {
          const remaining = visibleViewIds().filter((id) => id !== closedViewId);
          if (remaining.length === 0) {
            // Nothing left to select — exit nav mode entirely and land
            // focus on the ◐ chip so Esc / Ctrl+Alt+Space's end state
            // is consistent.
            keyDispatcher.setMode('app');
            refocusDockChip();
            return;
          }
          setNavHighlight(remaining[0] ?? null);
        });
      }
      return;
    }
    // Focus-mode + nav: the visible iframe is `#focus-frame`, not the
    // slot's hidden iframe. Focus that one so the user lands directly
    // on the live app the overlay is showing.
    if (focusedInstanceId !== null) {
      focusFrame.focus();
      try { focusFrame.contentWindow?.postMessage({ type: 'aura.window.focus' }, '*'); }
      catch { /* iframe gone or cross-origin */ }
      keyDispatcher.setMode('app');
      return;
    }
    const slot = document.querySelector<HTMLElement>(`.app-slot[data-view-id="${CSS.escape(navHighlightedViewId)}"]`);
    const iframe = slot?.querySelector<HTMLIFrameElement>('iframe');
    iframe?.focus();
    // Ask the app to route focus to its primary input. Plain
    // `iframe.focus()` only focuses the iframe element — the browser then
    // restores the iframe's LAST-focused descendant, which is nothing if
    // the user has never interacted with this window. For apps with a
    // dedicated input (xterm textarea in the terminal, search box in the
    // launcher, etc.) we need them to explicitly call their inner
    // `.focus()`. Apps opt in by listening for this message; apps that
    // don't keep the default browser behaviour (the iframe stays focused
    // at its outer element). Posted AFTER iframe.focus() so the inner
    // focus call doesn't compete with the browser's focus restoration.
    try { iframe?.contentWindow?.postMessage({ type: 'aura.window.focus' }, '*'); }
    catch { /* iframe gone or cross-origin */ }
    keyDispatcher.setMode('app');
  });

  // ── Window-selection mode plumbing ──────────────────────────────────────
  // The `◐` chip at the start of the dock is the keyboard entry point.
  // Focusing it (Ctrl+Alt+Space) and pressing Enter dispatches a custom
  // event we listen for here; that flips dispatcher into Nav mode, which
  // the `onModeChange` hook above turns into a window highlight.
  //
  // Three exit paths converge on the same end state ("dispatcher back to
  // 'app', focus on the ◐ chip"):
  //   • Escape  — modal-dismiss convention
  //   • mousedown anywhere outside an `.app-slot` (and outside the chip
  //     itself, so re-clicking it doesn't immediately re-toggle)
  //   • the same `aura:window-select.toggle` event again
  // The fourth exit — Enter on the highlighted window — is already wired
  // by the `aura.nav.enter` binding above (it sets 'app' mode + focuses
  // the iframe, so we don't refocus the chip in that case).
  function refocusDockChip(): void {
    (document.getElementById('dock-nav-entry') as HTMLButtonElement | null)?.focus();
  }
  document.addEventListener('aura:window-select.toggle', () => {
    if (keyDispatcher.getMode() === 'nav') {
      keyDispatcher.setMode('app');
      refocusDockChip();
    } else {
      keyDispatcher.setMode('nav');
    }
  });
  // Escape exit. Gated on nav mode so app-side Esc handlers (terminal,
  // launcher overlay, dialogs) keep their own semantics in app mode.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (keyDispatcher.getMode() !== 'nav') return;
    e.preventDefault();
    keyDispatcher.setMode('app');
    refocusDockChip();
  });
  // Backspace toggles chrome-select sub-mode (window header buttons).
  // Plain Backspace only — `aura.nav.back` (RShift+Backspace) is owned by
  // the OS dispatcher and routes through activity history. We gate on
  // (a) no modifiers, (b) Nav mode active, (c) a window is highlighted,
  // (d) target isn't a text input (defensive — chip / chrome buttons
  // aren't inputs, but a stray focus could land there).
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Backspace') return;
    if (e.ctrlKey || e.altKey || e.metaKey || e.shiftKey) return;
    if (keyDispatcher.getMode() !== 'nav') return;
    if (!navHighlightedViewId) return;
    const t = e.target as Element | null;
    if (t && t.matches?.('input, textarea, [contenteditable]')) return;
    e.preventDefault();
    if (chromeSelectActive) {
      // Second Backspace — exit chrome-select. Window stays highlighted
      // (border + watermark intact); take focus off the chrome button so
      // subsequent arrows walk windows again.
      chromeSelectActive = false;
      if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
      return;
    }
    // First Backspace — enter chrome-select. In focus mode the visible
    // chrome is the focus-view's own header (Exit Focus button); in
    // normal mode it's the highlighted slot's title-bar buttons.
    if (focusedInstanceId !== null) {
      const exitBtn = document.getElementById('focus-exit') as HTMLButtonElement | null;
      if (!exitBtn) return;
      chromeSelectActive = true;
      exitBtn.focus();
      return;
    }
    const slot = document.querySelector<HTMLElement>(`.app-slot[data-view-id="${CSS.escape(navHighlightedViewId)}"]`);
    if (!slot) return;
    const target = slot.querySelector<HTMLButtonElement>('.slot-chrome button[data-action="close"]')
                ?? slot.querySelector<HTMLButtonElement>('.slot-chrome button');
    if (!target) return;
    chromeSelectActive = true;
    target.focus();
  });
  // Click-outside exit. mousedown anywhere that isn't an `.app-slot`
  // cancels nav mode — chrome (status bar, dock buttons including the
  // ◐ chip itself), the empty desktop area, etc. The chip is INCLUDED:
  // a mouse click on the chip while in nav mode exits the mode, even
  // though a click in app mode is still a no-op (the mode gate at the
  // top of this handler covers that asymmetry).
  document.addEventListener('mousedown', (e) => {
    if (keyDispatcher.getMode() !== 'nav') return;
    const t = e.target as HTMLElement | null;
    if (!t) return;
    if (t.closest('.app-slot')) return;
    keyDispatcher.setMode('app');
    refocusDockChip();
  });

  interface AppView {
    viewId: string;
    appId: string;
    instanceId: string;
    activityId?: string;
    title: string;
    iframeUrl: string;
    state: 'normal' | 'minimized' | 'maximized';
    zIndex: number;
    isFocused: boolean;
    isLoading: boolean;
    lifecycleState: string;
    createdAt: string;
    /**
     * Whether the user can minimize this view. True only when the app
     * declared the activity as minimizable AND the app is a background
     * service (otherwise minimizing would orphan the activity onto a
     * backend about to auto-stop). Default false → only close button.
     * For non-activity views (1:1 instance/view), this is set from
     * `manifest.backgroundService` directly.
     */
    minimizable?: boolean;
    /**
     * What the app wants shown as this window's id, when that differs from its
     * OS handle. The Terminal reports which SESSION it is showing: a window can
     * change session without the shell being involved at all (same instance,
     * new socket), so the activity id alone would sit there naming a shell the
     * user is no longer looking at.
     */
    sessionLabel?: string;
    /**
     * Window handles (activities) this view still holds on instances it was
     * switched away from. Reused on a switch back so handles don't pile up,
     * and closed with the window. NOT sessions: which shell a window shows is
     * the app's own business — see the terminal's session picker.
     */
    rebindTrail?: string[];
    /**
     * In-activity history trail — the prior path/title pairs the iframe
     * visited. Populated by `activity:navigated` SSE events when the
     * activity used the "replace-current" launch mode. Drives the OS
     * breadcrumb chrome.
     */
    history?: Array<{ path: string; title?: string }>;
    /**
     * Whether the slot chrome renders the OS breadcrumb trail. Mirrors
     * `AppActivity.breadcrumb`. 'os' (default) shows the trail; 'off'
     * lets the app render its own header.
     */
    breadcrumb?: 'os' | 'off';
  }

  interface AppManifestLite {
    id: string;
    name: string;
    componentType: 'activity' | 'service';
    instanceMode: 'single' | 'multi';
    activityMode: 'none' | 'multi';
    defaultLaunch: 'new-instance' | 'new-activity';
    backgroundService: boolean;
  }

  let views: AppView[] = [];
  let focusedInstanceId: string | null = null;
  let focusedActivityId: string | null = null;
  // In-place "focus/maximize": the viewId of the window promoted to fill the
  // desktop. Unlike the old #focus-frame overlay (which spun up a SECOND
  // iframe and reloaded the app), this just restyles the EXISTING slot — its
  // iframe is never moved or re-created, so the app keeps its state exactly
  // like it does across a workspace switch. null = nothing maximized.
  let maximizedViewId: string | null = null;
  // Full-size focus: when true, the maximized window covers the WHOLE shell
  // (over the status bar + dock) instead of just the desktop area — the
  // in-place equivalent of the old focus overlay's "FULL SIZE" toggle. Always
  // starts windowed for each new focus session (reset in maximize/unmaximize).
  let maximizedFull = false;
  const manifestCache = new Map<string, AppManifestLite>();

  // Per-window USER LABEL — an ephemeral, instance-only name the user types in
  // the title bar (the ✎ button, or double-click the title). Keyed by viewId
  // (the per-window identity: activityId for activity views, instanceId
  // otherwise). Deliberately in-memory ONLY: NOT persisted to the server,
  // workspace, or localStorage, so it vanishes on window close and on page
  // reload — exactly the "just for this instance" contract. renderLayout()
  // prunes entries whose window has gone away.
  const windowNames = new Map<string, string>();

  // ---- Persisted per-activity shell state (workspace `activities`) ---------
  // Activity names and the maximized state live in the workspace that owns
  // the activity, so they survive reloads and OS restarts. `␀0␀` /
  // `maximizedViewId` stay the in-memory view of it.
  type PersistedActivity = { name?: string; maximized?: 'area' | 'full' };
  function patchActivityState(viewId: string, patch: PersistedActivity): void {
    const st = workspaceClient.getCached();
    if (!st) return;
    const ws = st.workspaces.find((w) => w.members.includes(viewId))
      ?? st.workspaces.find((w) => w.id === st.activeWorkspaceId);
    if (!ws) return;
    const activities: Record<string, PersistedActivity> = { ...((ws as { activities?: Record<string, PersistedActivity> }).activities ?? {}) };
    const entry: PersistedActivity = { ...(activities[viewId] ?? {}) };
    for (const [k, v] of Object.entries(patch) as Array<[keyof PersistedActivity, string | undefined]>) {
      if (v === undefined) delete entry[k]; else (entry as Record<string, string>)[k] = v;
    }
    if (JSON.stringify(entry) === JSON.stringify(activities[viewId] ?? {})) return;
    if (Object.keys(entry).length) activities[viewId] = entry; else delete activities[viewId];
    workspaceClient.patchWorkspaceDebounced(ws.id, { activities } as never);
  }
  /** Names saved for activities of any workspace → the in-memory map. */
  function hydrateActivityNames(): void {
    const st = workspaceClient.getCached();
    for (const w of st?.workspaces ?? []) {
      for (const [id, e] of Object.entries((w as { activities?: Record<string, PersistedActivity> }).activities ?? {})) {
        if (e?.name && !windowNames.has(id)) windowNames.set(id, e.name);
      }
    }
  }
  // Maximized state: restored once on load, written whenever it changes.
  let maximizeRestored = false;
  let persistedMax: { viewId: string | null; full: boolean } = { viewId: null, full: false };
  function restoreMaximized(visibleIds: Set<string>): void {
    if (maximizeRestored) return;
    const st = workspaceClient.getCached();
    const active = st?.workspaces.find((w) => w.id === st.activeWorkspaceId);
    if (!active) return;
    maximizeRestored = true;
    for (const [id, e] of Object.entries((active as { activities?: Record<string, PersistedActivity> }).activities ?? {})) {
      if (e?.maximized && visibleIds.has(id)) {
        maximizedViewId = id;
        maximizedFull = e.maximized === 'full';
        persistedMax = { viewId: id, full: maximizedFull };
        return;
      }
    }
  }
  function persistMaximized(): void {
    if (!maximizeRestored) return;
    if (persistedMax.viewId === maximizedViewId && persistedMax.full === maximizedFull) return;
    if (persistedMax.viewId && persistedMax.viewId !== maximizedViewId) patchActivityState(persistedMax.viewId, { maximized: undefined });
    if (maximizedViewId) patchActivityState(maximizedViewId, { maximized: maximizedFull ? 'full' : 'area' });
    persistedMax = { viewId: maximizedViewId, full: maximizedFull };
  }

  const staticLayout  = document.getElementById('static-layout')!;
  const dynamicLayout = document.getElementById('dynamic-layout')!;

  // ---- Lazy activities (lib/iframeWarmer.ts) --------------------------------
  // Only the active workspace loads at boot; the others warm in idle time
  // after it ('warm-idle'), load when opened ('on-demand'), or all at once
  // ('eager'). Policy: KV os/lazyActivities, localStorage override.
  const iframeWarmer = createIframeWarmer({
    load(viewId, reason) {
      const ifr = dynamicLayout.querySelector<HTMLIFrameElement>(`.app-slot[data-view-id="${CSS.escape(viewId)}"] iframe`);
      if (!ifr || ifr.dataset['src'] === undefined) return false;
      loadDeferredIframe(ifr, viewId, reason);
      return true;
    },
    idle: (fn) => idle(fn, { timeout: 3000 }),
    isHidden: () => document.visibilityState === 'hidden',
    onVisible: (fn) => {
      const h = () => { if (document.visibilityState !== 'hidden') { document.removeEventListener('visibilitychange', h); fn(); } };
      document.addEventListener('visibilitychange', h);
    },
    mark: (name, detail) => {
      mark(name, detail);
      if (name === 'warm:end') resolveStage('warm:end', detail);
    },
  });
  {
    let local: string | null = null;
    try { local = localStorage.getItem(LAZY_STORAGE_KEY); } catch { /* blocked */ }
    const p = parsePolicy(local);
    if (p) iframeWarmer.setPolicy(p);
  }

  /** After the active workspace loaded: read the policy, then warm the rest. */
  function startWarming(): void {
    let localOverride = false;
    try { localOverride = parsePolicy(localStorage.getItem(LAZY_STORAGE_KEY)) !== null; } catch { /* blocked */ }
    const begin = () => {
      const st = workspaceClient.getCached();
      if (!st) return;
      const active = st.workspaces.find((w) => w.id === st.activeWorkspaceId);
      const parked = (active?.layoutState as { minimized?: unknown } | undefined)?.minimized;
      const live = new Set(views.map((v) => v.viewId));
      const order = warmOrder({
        workspaces: st.workspaces, activeWorkspaceId: st.activeWorkspaceId,
        recent: recentWorkspaces(),
        parked: Array.isArray(parked) ? parked.filter((x): x is string => typeof x === 'string') : [],
      }).filter((id) => live.has(id));
      layoutLog.debug('warm order', iframeWarmer.policy(), order);
      iframeWarmer.start(order);
      if (iframeWarmer.policy() !== 'warm-idle') resolveStage('warm:end', { policy: iframeWarmer.policy() });
    };
    if (localOverride) { begin(); return; }
    fetch(`/api/kv/os/${LAZY_KV_KEY}`)
      .then((r) => (r.ok ? r.json() as Promise<{ value?: unknown }> : null))
      .then((body) => { const p = parsePolicy(body?.value); if (p) iframeWarmer.setPolicy(p); })
      .catch(() => { /* default policy */ })
      .finally(begin);
    subscribeKv({ namespace: 'os', key: LAZY_KV_KEY }, (ev) => {
      let override = false;
      try { override = parsePolicy(localStorage.getItem(LAZY_STORAGE_KEY)) !== null; } catch { /* blocked */ }
      if (override) return;
      iframeWarmer.setPolicy(parsePolicy(ev.value) ?? 'warm-idle');
    });
  }

  /** Stage 1 is done when every visible activity of the active workspace loaded. */
  function trackActiveWorkspaceLoad(slots: HTMLElement[]): void {
    const frames = slots
      .map((el) => el.querySelector<HTMLIFrameElement>('iframe'))
      .filter((f): f is HTMLIFrameElement => !!f && !!f.getAttribute('src'));
    if (frames.length === 0) { resolveStage('ws:active-loaded', { frames: 0 }); return; }
    let left = frames.length;
    const one = () => { if (--left === 0) resolveStage('ws:active-loaded', { frames: frames.length }); };
    for (const f of frames) {
      if (isIframeLoaded(f)) one();
      else f.addEventListener('load', one, { once: true });
    }
    // An app that never fires `load` must not hold the rest of the boot back.
    setTimeout(() => {
      if (!isStageDone('ws:active-loaded')) resolveStage('ws:active-loaded', { frames: frames.length, pending: left, timeout: true });
    }, 8000);
  }
  let bootRendered = false;
  /** Other workspaces' slots are built only after boot stage 1. */
  let hiddenSlotsReady = false;
  let lastActiveWsId: string | null = null;
  let renderCount = 0;
  addReportField('desktop', () => ({
    lazyPolicy: iframeWarmer.policy(),
    renders: renderCount,
    renderCallers: Object.fromEntries(renderCallers),
    iframes: document.querySelectorAll('#dynamic-layout iframe').length,
    iframesWithSrc: iframeSrcCount,
    warmPending: iframeWarmer.pending().length,
    appsSnapshot: appsSnapshotStats(),
  }));

  // ---- Layout-manager host (lib/layout/types.ts) ----------------------------
  //
  // renderLayout() delegates activity placement to the active workspace's
  // ShellLayoutStrategy and gives it this host: regions in the content space,
  // an overlay layer, layoutState access and the activity actions. Nothing here
  // knows a specific layout.
  const layoutOverlay = document.getElementById('layout-overlay')!;
  const layoutRegions: Record<RegionSide, HTMLElement> = {
    top:    document.getElementById('layout-region-top')!,
    bottom: document.getElementById('layout-region-bottom')!,
    left:   document.getElementById('layout-region-left')!,
    right:  document.getElementById('layout-region-right')!,
  };
  let currentStrategy: ShellLayoutStrategy | null = null;
  /** Every activity of the active workspace as of the last render (taskbar etc.). */
  let lastLayoutViews: LayoutViewInfo[] = [];

  /** Inset the activities area (and the overlay) by the regions' measured size. */
  function syncLayoutRegions(): void {
    const t = layoutRegions.top.offsetHeight;
    const b = layoutRegions.bottom.offsetHeight;
    for (const side of ['left', 'right'] as const) {
      layoutRegions[side].style.top = t + 'px';
      layoutRegions[side].style.bottom = b + 'px';
    }
    const l = layoutRegions.left.offsetWidth;
    const r = layoutRegions.right.offsetWidth;
    const inset = `${t}px ${r}px ${b}px ${l}px`;
    if (dynamicLayout.style.inset !== inset) {
      dynamicLayout.style.inset = inset;
      layoutOverlay.style.inset = inset;
    }
  }
  if (typeof ResizeObserver !== 'undefined') {
    const regionRo = new ResizeObserver(() => syncLayoutRegions());
    for (const el of Object.values(layoutRegions)) regionRo.observe(el);
  }

  function activeWorkspaceOf(): workspaceClient.Workspace | null {
    const ws = workspaceClient.getCached();
    return ws?.workspaces.find((w) => w.id === ws.activeWorkspaceId) ?? null;
  }
  function patchActiveLayoutState(patch: Record<string, unknown>): void {
    const active = activeWorkspaceOf();
    if (!active) return;
    const next: Record<string, unknown> = { ...(active.layoutState ?? {}) };
    for (const [k, v] of Object.entries(patch)) {
      if (v === undefined) delete next[k]; else next[k] = v;
    }
    workspaceClient.patchWorkspaceDebounced(active.id, { layoutState: next });
  }
  /** Activities hidden by a `minimize: 'hide'` layout, for the active workspace. */
  function parkedViewIds(): string[] {
    const m = activeWorkspaceOf()?.layoutState?.minimized;
    return Array.isArray(m) ? m.filter((x): x is string => typeof x === 'string') : [];
  }
  function setParked(viewId: string, on: boolean): void {
    const cur = parkedViewIds();
    const has = cur.includes(viewId);
    if (on === has) return;
    const next = on ? [...cur, viewId] : cur.filter((x) => x !== viewId);
    patchActiveLayoutState({ minimized: next.length ? next : undefined });
  }

  /** Release a slot from the strategy that last placed it (layout switch,
   *  maximize, hide). Strategies tag nothing themselves — the host tracks it. */
  function releaseSlot(el: HTMLElement): void {
    const owner = el.dataset['layoutOwner'];
    if (!owner) return;
    shellLayoutFor(owner).release?.(el);
    delete el.dataset['layoutOwner'];
  }

  /** Swap the active strategy: tear down the old one's regions + overlay,
   *  mount the new one's. */
  function switchStrategy(next: ShellLayoutStrategy): void {
    if (currentStrategy === next) return;
    const prev = currentStrategy;
    if (prev) {
      for (const side of Object.keys(prev.regions ?? {}) as RegionSide[]) {
        prev.regions![side]!.unmount?.();
        layoutRegions[side].replaceChildren();
      }
      prev.deactivate?.(layoutHost);
      layoutOverlay.replaceChildren();
    }
    currentStrategy = next;
    next.activate?.(layoutHost);
    for (const side of Object.keys(next.regions ?? {}) as RegionSide[]) {
      next.regions![side]!.mount(layoutRegions[side], layoutHost);
    }
    syncLayoutRegions();
  }

  function toLayoutViewInfo(v: AppView): LayoutViewInfo {
    return {
      viewId: v.viewId, appId: v.appId, title: v.title,
      userLabel: windowNames.get(v.viewId),
      minimized: v.state === 'minimized' || parkedViewIds().includes(v.viewId),
      isFocused: v.isFocused,
    };
  }

  const layoutHost: LayoutHost = {
    container: dynamicLayout,
    overlay: () => layoutOverlay,
    views: () => lastLayoutViews,
    slotOf: (viewId) => dynamicLayout.querySelector<HTMLElement>(`:scope > .app-slot[data-view-id="${CSS.escape(viewId)}"]`),
    maximizedViewId: () => maximizedViewId,
    // Read-only (LayoutHost contract): served from the cache without a copy —
    // layouts read it per activity, per render.
    layoutState: () => {
      const st = workspaceClient.peekCached();
      return (st?.workspaces.find((w) => w.id === st.activeWorkspaceId)?.layoutState ?? {}) as Record<string, unknown>;
    },
    patchLayoutState: patchActiveLayoutState,
    focus: (viewId) => focusView_(viewId),
    minimize: (viewId) => minimizeView_(viewId),
    restore: (viewId) => restoreView_(viewId),
    close: (viewId) => closeView_(viewId),
    toggleMaximize: (viewId) => toggleMaximizeView_(viewId),
    requestRender: () => renderLayout(),
    broadcastViewport: () => queueViewportBroadcast('layout'),
    setGestureActive: (on) => setROSuppressed(on),
    toLocal(clientX, clientY) {
      // The shell zooms <body> with a transform; client coords are post-
      // transform, layout px are pre-transform.
      const r = dynamicLayout.getBoundingClientRect();
      const scale = dynamicLayout.clientWidth > 0 ? r.width / dynamicLayout.clientWidth : 1;
      return { x: (clientX - r.left) / scale, y: (clientY - r.top) / scale, scale };
    },
    isOverShellBar(clientX, clientY) {
      const desktop = document.getElementById('desktop');
      if (desktop && clientY < desktop.getBoundingClientRect().top) return true;
      // Autohide bars overlay the desktop; the folded workspace dropdown hangs
      // below the bar — both are inside #statusbar.
      return !!document.elementFromPoint(clientX, clientY)?.closest('#statusbar');
    },
    handOffActivityDrag(ev, viewId, handle, opts) {
      const slot = layoutHost.slotOf(viewId);
      if (!slot) return false;
      return handOffActivityDrag(ev, { viewId, title: slotDragTitle(slot, viewId) }, slot, handle, opts);
    },
  };

  /** Label for the drag ghost: activity name › breadcrumb › id. */
  function slotDragTitle(slot: HTMLElement, viewId: string): string {
    return slot.querySelector('.slot-window-name')?.textContent?.trim()
      || slot.querySelector('.slot-title-trail')?.textContent?.trim()
      || slot.querySelector('.slot-title-id')?.textContent?.trim()
      || viewId;
  }

  // A click INSIDE an app activity never reaches the shell's DOM (the iframe is
  // its own document), so the active layout learns about it from:
  //   • the proxy-injected focus-on-click script, which posts
  //     `aura.pointerdown` from every app page (covers iframe → iframe), and
  //   • as a fallback for frames without the injection, the shell activity's
  //     blur — focus just moved into an iframe.
  // Both end in the strategy's `onActivate` (Free Window raises the activity).
  function activateViewOfFrame(frame: HTMLIFrameElement | null): void {
    const slot = frame?.closest<HTMLElement>('#dynamic-layout > .app-slot[data-view-id]');
    const viewId = slot?.dataset['viewId'];
    if (viewId && currentStrategy) currentStrategy.onActivate?.(viewId, layoutHost);
  }
  window.addEventListener('message', (ev: MessageEvent) => {
    if ((ev.data as { type?: unknown } | null)?.type !== 'aura.pointerdown') return;
    activateViewOfFrame(ownerFrameOf(ev.source as Window | null));
  });
  window.addEventListener('blur', () => {
    // activeElement is updated to the iframe right after blur fires.
    setTimeout(() => {
      const a = document.activeElement;
      if (a instanceof HTMLIFrameElement) activateViewOfFrame(a);
    }, 0);
  });

  // ---- Window drag & drop (lib/windowDrag.ts) ----
  // Title-bar drag shows a small ghost; the active layout's policy decides
  // whether drags are allowed at all and what dropping on another window
  // does. Workspace pills register their own drop target in StatusBar.astro.
  dynamicLayout.addEventListener('pointerdown', (e) => {
    const t = e.target as HTMLElement | null;
    const chrome = t?.closest<HTMLElement>('.slot-chrome');
    if (!chrome || t!.closest('button, input, textarea, select')) return;
    const slot = chrome.closest<HTMLElement>('.app-slot[data-view-id]');
    const viewId = slot?.dataset['viewId'];
    if (!slot || !viewId || slot.dataset['maximized'] === 'true') return;
    beginWindowDrag(e, { viewId, title: slotDragTitle(slot, viewId) }, slot);
  });
  registerDropTarget({
    id: 'slot',
    resolve(el, src) {
      if (!getLayoutDragPolicy()?.slotDrop) return null;
      const slot = el.closest<HTMLElement>('#dynamic-layout > .app-slot[data-view-id]');
      const viewId = slot?.dataset['viewId'];
      if (!slot || !viewId || viewId === src.viewId) return null;
      return { el: slot, data: viewId };
    },
    drop(src, data) {
      return getLayoutDragPolicy()?.slotDrop?.(src, data as string);
    },
  });
  const focusView     = document.getElementById('focus-view')!;
  const focusFrame    = document.getElementById('focus-frame') as HTMLIFrameElement;
  // Persistent (never torn down) — observe it once so a focused/nav app refits
  // when the focus overlay box changes (fullscreen toggle, browser resize).
  if (focusFrame) observeIframe(focusFrame);
  const focusInstIdEl = document.getElementById('focus-instance-id')!;
  const focusTitleEl  = document.getElementById('focus-title')!;
  const focusExitBtn  = document.getElementById('focus-exit')!;
  const focusFullscreenBtn = document.getElementById('focus-fullscreen') as HTMLButtonElement;

  // Hydrate from SSR initial views so the JS-side state matches what's already on screen.
  // Once we have data, switch to the JS-managed dynamicLayout immediately so close/minimize
  // and SSE updates work uniformly across SSR-rendered and dynamically-created slots.
  try {
    const wsJson = document.getElementById('aura-initial-workspaces')?.textContent;
    if (wsJson) workspaceClient.hydrate(JSON.parse(wsJson) as workspaceClient.WorkspaceState);
  } catch (err) { console.warn('[shell] failed to hydrate workspaceState', err); }
  try {
    const ssrJson = document.getElementById('aura-initial-views')?.textContent;
    if (ssrJson) {
      const parsed = JSON.parse(ssrJson) as AppView[];
      if (parsed.length > 0) views = parsed;
    }
  } catch (err) { console.warn('[shell] failed to hydrate initialViews', err); }

  async function getManifest(appId: string): Promise<AppManifestLite> {
    const cached = manifestCache.get(appId);
    if (cached) return cached;
    const data = (await (await fetch(`/api/apps/${appId}/status`)).json()) as { manifest: AppManifestLite };
    manifestCache.set(appId, data.manifest);
    return data.manifest;
  }

  function buildView(
    appId: string,
    name: string,
    instanceId: string,
    activityId: string | undefined,
    path: string,
    lifecycleState: string,
    minimizable: boolean,
  ): AppView {
    const stripped = path.replace(/^\/+/, '');
    const query = activityId ? `?_aura_activity=${encodeURIComponent(activityId)}` : '';
    return {
      viewId:         activityId ?? instanceId,
      appId,
      instanceId,
      ...(activityId ? { activityId } : {}),
      title:          name,
      iframeUrl:      `/api/proxy/${instanceId}/${stripped}${query}`,
      state:          'normal',
      zIndex:         views.length,
      isFocused:      true,
      isLoading:      lifecycleState !== 'resumed',
      lifecycleState,
      createdAt:      new Date().toISOString(),
      ...(minimizable ? { minimizable: true } : {}),
    };
  }

  /**
   * Launch an app from the dock/launcher. Behavior depends on the manifest:
   *   - activityMode='none'           → start instance + open view
   *   - activityMode='multi', single  → reuse instance if running, always open new activity view
   *   - activityMode='multi', multi   → defaultLaunch decides ('new-instance' vs 'new-activity')
   */
  /**
   * Synchronously add a placeholder "pending" view + render, before any await.
   * The user sees the boot skeleton the instant they click — no waiting on the
   * backend's `start` round-trip for first paint. The returned helpers swap the
   * placeholder for the real view (or drop it on error).
   */
  // Workspace pin for pending placeholders. Keyed by the placeholder's
  // viewId, the value is the workspace id active at the moment the user
  // clicked launch. Read by:
  //   • renderLayout — placeholders only render in their pinned workspace,
  //     so switching workspaces mid-load doesn't drag the skeleton with you.
  //   • pending.replaceWith — the real view is claimed for the pinned
  //     workspace, not whichever workspace is active at fetch-completion
  //     time (which would be a race if the user switched mid-flight).
  const pendingWorkspace = new Map<string, string>();

  function pushPendingView(appId: string, displayTitle: string): {
    pendingId: string;
    replaceWith: (real: AppView) => void;
    drop: () => void;
  } {
    const pendingId = `pending-${appId}-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`;
    const pinnedWsId = workspaceClient.getCached()?.activeWorkspaceId ?? null;
    if (pinnedWsId) pendingWorkspace.set(pendingId, pinnedWsId);
    views = [...views, {
      viewId:         pendingId,
      appId,
      instanceId:     '',
      title:          displayTitle,
      iframeUrl:      '',
      state:          'normal',
      zIndex:         views.length,
      isFocused:      true,
      isLoading:      true,
      lifecycleState: 'starting',
      createdAt:      new Date().toISOString(),
    }];
    renderLayout();
    return {
      pendingId,
      replaceWith: (real) => {
        // Carry the pin from the placeholder over to the real view so
        // workspace membership lands on the workspace where the user
        // launched, not whichever workspace is active now.
        const wsId = pendingWorkspace.get(pendingId) ?? null;
        pendingWorkspace.delete(pendingId);
        views = views.map((v) => v.viewId === pendingId ? real : v);
        if (wsId) {
          workspaceClient.addMemberToWorkspace(wsId, real.viewId).catch(() => undefined);
        } else {
          // Fallback: no pin captured (workspace state wasn't hydrated
          // yet). Drop on the active workspace as before.
          workspaceClient.addMemberToActive(real.viewId).catch(() => undefined);
        }
        renderLayout();
      },
      drop: () => {
        pendingWorkspace.delete(pendingId);
        views = views.filter((v) => v.viewId !== pendingId);
        renderLayout();
      },
    };
  }

  window.auraLaunchApp = async (appId: string, opts?: { workspaceId?: string }) => {
    // Optional target workspace: switch to it FIRST so `pushPendingView` and
    // the eventual `addMemberToActive` from `pending.replaceWith` claim the
    // app for that workspace (the context-menu "Open in workspace ▸ X" path).
    // Fire-and-await so the launch only proceeds once the active workspace
    // has flipped — otherwise the membership claim races and lands on the
    // workspace the user came from.
    if (opts?.workspaceId) {
      try { await workspaceClient.setActive(opts.workspaceId); } catch { /* ignore */ }
    }

    // First paint: skeleton in the layout, before any network I/O.
    const cached = manifestCache.get(appId);
    const pending = pushPendingView(appId, cached?.name ?? appId);

    try {
      const manifest = await getManifest(appId);

      // Activities not supported → original 1:1 instance/view behavior
      if (manifest.activityMode === 'none') {
        const res = await fetch(`/api/apps/${appId}/start`, { method: 'POST' });
        if (!res.ok) { console.error(`Failed to start ${appId}`); pending.drop(); return; }
        const { instanceId, instance } = await res.json();

        // If a view for this instance is already open, drop the placeholder and focus it.
        //
        // BUT: services (e.g. Console) are autostarted by AppManager.bootstrap()
        // and arrive in SSR's `initialViews`, yet are deliberately excluded from
        // workspace.members on SSR — they're headless by default. When the user
        // clicks the launcher icon for such a service, the view exists but is
        // display:none in renderLayout (workspace filter). Focusing alone won't
        // show it; we must explicitly claim workspace membership too.
        const existing = views.find((v) => v.viewId !== pending.pendingId && v.instanceId === instanceId && !v.activityId);
        if (existing) {
          pending.drop();
          workspaceClient.addMemberToActive(existing.viewId).catch(() => undefined);
          focusView_(existing.viewId);
          return;
        }

        // For activityMode='none' apps, a "view" maps 1:1 to an instance.
        // The window is minimizable only if the app keeps running with no
        // visible UI (backgroundService=true). Otherwise minimize would
        // leave a dead backend in the strip — better to force close.
        const real = buildView(appId, manifest.name, instanceId, undefined, '/', instance?.state ?? 'creating', !!manifest.backgroundService);
        pendingAutoFocusViewIds.add(real.viewId);
        markLaunchedHere(real.viewId);
        pending.replaceWith(real);
        return;
      }

      // activityMode='multi' branch
      const wantNewInstance =
        manifest.instanceMode === 'multi' && manifest.defaultLaunch === 'new-instance';

      let targetInstanceId: string | null = null;
      let targetInstanceState = 'creating';

      if (!wantNewInstance) {
        const apps = await (await fetch('/api/apps')).json() as Array<{ manifest: { id: string }; instances: Array<{ instanceId: string; state: string; inPool?: boolean }> }>;
        // Skip warm-pool members — opening an activity directly on them
        // would bypass claimFromPool and leave the AppManager thinking the
        // instance is still idle. The fall-through below calls /start which
        // does claim properly.
        const inst = apps.find((a) => a.manifest.id === appId)?.instances?.find((i) => !i.inPool);
        if (inst) { targetInstanceId = inst.instanceId; targetInstanceState = inst.state; }
      }

      if (!targetInstanceId) {
        const res = await fetch(`/api/apps/${appId}/start`, { method: 'POST' });
        if (!res.ok) { console.error(`Failed to start ${appId}`); pending.drop(); return; }
        const { instanceId, instance } = await res.json();
        targetInstanceId = instanceId;
        targetInstanceState = instance?.state ?? 'creating';
      }
      // The start response is untyped JSON: if it came back without an
      // instanceId we would otherwise carry a null through the activity call
      // and build a view pointing at "null".
      if (!targetInstanceId) {
        console.error(`No instance id for ${appId} — cannot open an activity`);
        pending.drop();
        return;
      }

      // Open the activity, replacing the placeholder with the real activity view.
      markActivityOpenStart(appId);
      try {
        const actRes = await fetch(`/api/instances/${encodeURIComponent(targetInstanceId)}/activities`, { method: 'POST' });
        if (!actRes.ok) {
          console.error(`Failed to open activity on ${targetInstanceId}`, await actRes.text());
          pending.drop();
          return;
        }
        const { activityId, activity } = await actRes.json() as { activityId: string; activity: { path: string; title?: string; minimizable?: boolean } };
        // Activity must declare itself minimizable AND parent app must be a
        // background service — the OS already enforces the second condition
        // server-side (openActivity strips minimizable=true when the app
        // isn't backgroundable), but we mirror the check here so the chrome
        // matches the server's view either way.
        const minimizable = !!activity.minimizable && !!manifest.backgroundService;
        const real = buildView(appId, activity.title ?? manifest.name, targetInstanceId, activityId, activity.path ?? '/', targetInstanceState, minimizable);
        pendingAutoFocusViewIds.add(real.viewId);
        markLaunchedHere(real.viewId);
        pending.replaceWith(real);
      } finally {
        markActivityOpenEnd(appId);
      }
    } catch (err) {
      console.error('[shell] launch failed', err);
      pending.drop();
    }
  };

  // Tracks how many shell-initiated activity opens are currently in flight per
  // appId. The SSE handler uses this to decide whether to render a view for an
  // incoming activity:opened — if we initiated it, the in-flight fetch will
  // add the view via pending.replaceWith(); the SSE event is just a duplicate.
  const pendingActivityOpens = new Map<string, number>();

  // ── Restart that keeps windows (server: lib/appRestart.ts) ──────────────
  // `app:restarting` names the instances about to go down. Their windows stay
  // as loading placeholders — the teardown events that follow (destroyed,
  // activity:closed, …) are expected and must not close them or strip them
  // from their workspace. `app:restarted` maps every old viewId to the new
  // one; the server has already remapped `os:workspaces` the same way.
  const restartingInstances = new Set<string>();
  const restartingApps = new Map<string, ReturnType<typeof setTimeout>>();
  // A restart that never reports back (shell crash) must not pin dead
  // windows forever — after this, fall back to the normal teardown.
  const RESTART_GIVE_UP_MS = 10 * 60_000;
  // A restart can hand the new instance / windows the SAME ids as the old
  // ones (single-window apps: the instance id is the app id; `#a1` → `#a1`).
  // Teardown events of the old backend that arrive after `app:restarted`
  // would then close the NEW window and strip it from its workspace. For a
  // while after a restart such an event is checked against the server first.
  const RESTART_ECHO_MS = 30_000;
  const reusedAfterRestart = new Map<string, number>();   // instanceId → until
  function reusedRecently(instanceId: string): boolean {
    const until = reusedAfterRestart.get(instanceId);
    if (until === undefined) return false;
    if (Date.now() < until) return true;
    reusedAfterRestart.delete(instanceId);
    return false;
  }
  /** Is `instanceId` (and, given, its activity `activityId`) still alive on the server? */
  async function stillAlive(instanceId: string, activityId?: string): Promise<boolean> {
    try {
      const r = await fetch(`/api/instances/${encodeURIComponent(instanceId)}/status`, { cache: 'no-store' });
      if (!r.ok) return false;
      const st = (await r.json() as { instance?: { state?: string } }).instance?.state;
      if (!st || st === 'destroyed' || st === 'error') return false;
      if (!activityId) return true;
      const a = await fetch(`/api/instances/${encodeURIComponent(instanceId)}/activities`, { cache: 'no-store' });
      if (!a.ok) return false;
      return (await a.json() as Array<{ activityId: string }>).some((x) => x.activityId === activityId);
    } catch { return false; }
  }

  function slotIframe(viewId: string): HTMLIFrameElement | null {
    return document.querySelector<HTMLIFrameElement>(`.app-slot[data-view-id="${CSS.escape(viewId)}"] iframe`);
  }

  function beginRestart(ev: { appId: string; instanceIds?: string[] }) {
    const ids = ev.instanceIds ?? [];
    for (const id of ids) restartingInstances.add(id);
    clearTimeout(restartingApps.get(ev.appId));
    restartingApps.set(ev.appId, setTimeout(() => failRestart(ev.appId, ids), RESTART_GIVE_UP_MS));
    if (focusedInstanceId && restartingInstances.has(focusedInstanceId)) exitFocus();
    views = views.map((v) => restartingInstances.has(v.instanceId)
      ? { ...v, isLoading: true, lifecycleState: 'restarting' }
      : v);
    // Drop the old iframes now so each slot shows the boot skeleton, not a
    // backend that is going away.
    for (const v of views) if (restartingInstances.has(v.instanceId)) slotIframe(v.viewId)?.remove();
    renderLayout();
  }

  async function finishRestart(ev: {
    appId: string;
    oldInstanceIds?: string[];
    restored?: Array<{
      from: string; to: string; instanceId: string; activityId?: string; path: string; title?: string;
      minimizable?: boolean; history?: Array<{ path: string; title?: string }>; breadcrumb?: 'os' | 'off';
    }>;
  }) {
    clearTimeout(restartingApps.get(ev.appId));
    restartingApps.delete(ev.appId);
    const oldIds = new Set(ev.oldInstanceIds ?? []);
    // Load the remapped workspaces BEFORE the new views exist, so nothing
    // adopts them onto the active workspace in between.
    await workspaceClient.refresh().catch(() => undefined);
    for (const id of oldIds) restartingInstances.delete(id);

    const restored = ev.restored ?? [];
    for (const r of restored) {
      if (oldIds.has(r.instanceId)) reusedAfterRestart.set(r.instanceId, Date.now() + RESTART_ECHO_MS);
    }
    const byFrom = new Map(restored.map((r) => [r.from, r]));
    const name = manifestCache.get(ev.appId)?.name ?? ev.appId;
    const bg = manifestCache.get(ev.appId)?.backgroundService === true;
    const toView = (r: (typeof restored)[number]): AppView => {
      const nv = buildView(ev.appId, r.title ?? name, r.instanceId, r.activityId, r.path, 'resumed',
        r.activityId ? !!r.minimizable && bg : bg);
      return {
        ...nv,
        ...(r.history ? { history: r.history } : {}),
        ...(r.breadcrumb ? { breadcrumb: r.breadcrumb } : {}),
      } as AppView;
    };

    const placed = new Set<string>();
    const next: AppView[] = [];
    for (const v of views) {
      if (!oldIds.has(v.instanceId)) { next.push(v); continue; }
      // New ids can equal old ones (`#a1` → `#a1`): clear the slot's iframe
      // so updateSlot mounts a fresh one on the new backend.
      slotIframe(v.viewId)?.remove();
      const r = byFrom.get(v.viewId);
      if (!r || placed.has(r.to)) continue;
      placed.add(r.to);
      if (maximizedViewId === v.viewId) maximizedViewId = r.to;
      next.push({ ...toView(r), zIndex: v.zIndex, state: v.state, isFocused: v.isFocused });
    }
    // Windows this tab never showed (opened from another browser) still come
    // back; their workspace membership decides where.
    for (const r of restored) {
      if (placed.has(r.to) || next.some((v) => v.viewId === r.to)) continue;
      placed.add(r.to);
      next.push(toView(r));
    }
    views = next;
    renderLayout();
  }

  /** Restart failed or never reported back: tear the windows down like a stop. */
  function failRestart(appId: string, instanceIds: string[]) {
    clearTimeout(restartingApps.get(appId));
    restartingApps.delete(appId);
    const ids = new Set(instanceIds);
    for (const id of ids) restartingInstances.delete(id);
    const dead = views.filter((v) => ids.has(v.instanceId));
    if (dead.some((v) => v.viewId === maximizedViewId)) maximizedViewId = null;
    views = views.filter((v) => !ids.has(v.instanceId));
    for (const v of dead) workspaceClient.removeMember(v.viewId).catch(() => undefined);
    renderLayout();
  }

  // ViewIds of windows the user *just launched*. Every site that arms this set
  // also calls `markLaunchedHere` (lib/launchOrigin.ts): both answer the same
  // question — "did THIS browser start this window?" — one for focus, one so an
  // app that can only be live in one browser (the Terminal) takes the session
  // here instead of losing a race to another browser's iframe.
  //
  // When their iframe finishes
  // loading, `updateSlot` (the only place that creates the <iframe> element)
  // fires focus() + a `aura.window.focus` postMessage and drops the id —
  // same end-state as pressing Enter on a highlighted slot in window-select
  // mode. Only user-initiated launches get added; SSE-driven views
  // (activity:opened from elsewhere, orphan adoption) don't.
  const pendingAutoFocusViewIds = new Set<string>();
  function markActivityOpenStart(appId: string) {
    pendingActivityOpens.set(appId, (pendingActivityOpens.get(appId) ?? 0) + 1);
  }
  function markActivityOpenEnd(appId: string) {
    const n = (pendingActivityOpens.get(appId) ?? 1) - 1;
    if (n <= 0) pendingActivityOpens.delete(appId);
    else        pendingActivityOpens.set(appId, n);
  }

  /** Open an explicit activity on an existing instance. Honors the path the app returns from onActivityCreate. */
  async function openActivityOnInstance(instanceId: string, appId: string, name: string, lifecycleState: string, data?: Record<string, unknown>) {
    const pending = pushPendingView(appId, name);
    markActivityOpenStart(appId);
    try {
      const res = await fetch(`/api/instances/${encodeURIComponent(instanceId)}/activities`, {
        method:  'POST',
        headers: data ? { 'Content-Type': 'application/json' } : undefined,
        body:    data ? JSON.stringify(data) : undefined,
      });
      if (!res.ok) { console.error(`Failed to open activity on ${instanceId}`, await res.text()); pending.drop(); return; }
      const { activityId, activity } = await res.json() as { activityId: string; activity: { path: string; title?: string; minimizable?: boolean } };
      // Same gating as launchApp's activity branch — see comment there.
      const manifest = await getManifest(appId).catch(() => null);
      const minimizable = !!activity.minimizable && !!manifest?.backgroundService;
      const real = buildView(appId, activity.title ?? name, instanceId, activityId, activity.path ?? '/', lifecycleState, minimizable);
      pendingAutoFocusViewIds.add(real.viewId);
      markLaunchedHere(real.viewId);
      pending.replaceWith(real);
    } catch (err) {
      console.error('[shell] openActivityOnInstance failed', err);
      pending.drop();
    } finally {
      markActivityOpenEnd(appId);
    }
  }
  /**
   * Move an existing window to a DIFFERENT backend instance of the same app.
   *
   * Why the shell has to do this rather than the app self-navigating: the app
   * could set `location` itself (the iframe is same-origin), but `views[]`
   * would keep the old `instanceId` — and that field is what drives the
   * chrome's id label, the `data-instance-id` routing for host URL relays, and
   * the `app:stateChanged` / `app:crashed` reconciliation. A self-navigated
   * window would survive the wrong crash and die on the wrong one, and
   * `updateSlot` would snap the iframe back to the old instance on remount.
   *
   * The activity moves with the window because an activity belongs to exactly
   * one instance. We ADOPT an existing activity on the target that no window
   * is showing before opening a new one — for the Terminal that is what makes
   * switching back and forth land in the same shell each time, since its PTY
   * session is keyed by activity id. The old activity is deliberately left
   * OPEN for the same reason: closing it would drop the session you are
   * switching away from, which is never what "show me the other container"
   * means.
   */
  async function rebindViewToInstance(viewId: string, targetInstanceId: string): Promise<void> {
    const v = views.find((x) => x.viewId === viewId);
    if (!v || v.instanceId === targetInstanceId) return;

    // Refuse a cross-app move: the window's chrome, keymap claim and manifest
    // gating all belong to `v.appId`, and the target's app id is the only
    // thing that makes an activity on it meaningful.
    const status = await fetch(`/api/instances/${encodeURIComponent(targetInstanceId)}/status`)
      .then((r) => (r.ok ? r.json() : null))
      .catch(() => null);
    const target = status?.instance;
    if (!target || target.appId !== v.appId) {
      console.error(`[shell] rebind refused: ${targetInstanceId} is not a live instance of ${v.appId}`);
      return;
    }

    // Only activities a VISIBLE window holds are off-limits; a view that exists
    // but sits in no workspace is a leftover handle, free to reuse.
    const shown = new Set(views
      .filter((x) => workspaceClient.findOwner(x.viewId))
      .map((x) => x.activityId).filter(Boolean) as string[]);
    let nextActivityId: string | undefined;
    let nextPath = '/';
    let nextTitle = v.title;

    markActivityOpenStart(v.appId);
    try {
      const existing: Array<{ activityId: string; path?: string; title?: string }> =
        await fetch(`/api/instances/${encodeURIComponent(targetInstanceId)}/activities`)
          .then((r) => (r.ok ? r.json() : []))
          .catch(() => []);
      // Reuse a window handle this view already held on the target, else one no
      // VISIBLE window is using, else make one. An activity here is just the
      // window's handle on that instance — which shell it shows is the app's
      // own business (see the terminal's session picker) — so this only needs
      // to keep handles from piling up on every switch.
      //
      // The "no window shows it" test is deliberately second: SSR builds a view
      // for every open activity, including ones hidden by workspace membership,
      // so without the workspace check almost nothing looks free and every
      // switch would mint another handle.
      const adopt = existing.find((a) => (v.rebindTrail ?? []).includes(a.activityId))
                 ?? existing.find((a) => !shown.has(a.activityId));
      if (adopt) {
        nextActivityId = adopt.activityId;
        nextPath  = adopt.path ?? '/';
        nextTitle = adopt.title ?? v.title;
      } else {
        const res = await fetch(`/api/instances/${encodeURIComponent(targetInstanceId)}/activities`, { method: 'POST' });
        if (!res.ok) { console.error(`[shell] rebind: could not open an activity on ${targetInstanceId}`, await res.text()); return; }
        const body = await res.json() as { activityId: string; activity?: { path?: string; title?: string } };
        nextActivityId = body.activityId;
        nextPath  = body.activity?.path ?? '/';
        nextTitle = body.activity?.title ?? v.title;
      }
    } finally {
      markActivityOpenEnd(v.appId);
    }
    if (!nextActivityId) return;

    // viewId is `activityId ?? instanceId`, so it changes with the activity.
    // Everything keyed by it has to come along, or the window silently leaves
    // its workspace (and loses its user-given name) on a switch.
    // The activity we are leaving joins the trail; the one we just adopted
    // leaves it (it is the current activity again).
    const trail = [...(v.rebindTrail ?? []), ...(v.activityId ? [v.activityId] : [])]
      .filter((a) => a !== nextActivityId);

    const next = buildView(v.appId, nextTitle, targetInstanceId, nextActivityId, nextPath, target.state ?? 'resumed', !!v.minimizable);
    // Absorb the placeholder view SSR made for this activity while no window
    // was showing it — viewId IS the activity id, so leaving it would put two
    // entries with the same key in views[].
    views = views.filter((x) => x.viewId !== next.viewId || x.viewId === viewId);
    const idx  = views.findIndex((x) => x.viewId === viewId);
    if (idx < 0) return;
    views = [
      ...views.slice(0, idx),
      { ...next, state: v.state, zIndex: v.zIndex, isFocused: true, history: [], breadcrumb: v.breadcrumb,
        ...(trail.length ? { rebindTrail: [...new Set(trail)] } : {}) },
      ...views.slice(idx + 1),
    ];

    const customName = windowNames.get(viewId);
    if (customName) {
      windowNames.delete(viewId); windowNames.set(next.viewId, customName);
      patchActivityState(viewId, { name: undefined });
      patchActivityState(next.viewId, { name: customName });
    }
    if (maximizedViewId === viewId) maximizedViewId = next.viewId;

    // Move workspace membership from the old view id to the new one, as ONE
    // write computed from a fresh server read.
    //
    // Both halves matter. Fresh, because a remove-then-add-then-reorder built
    // its final array from a cached workspace that hadn't caught up, so the
    // reorder wrote the old id straight back — the window it had just left
    // stayed on the desktop as a second copy. And one write, because tiling
    // order comes from `members`: appending would shunt the window to the end
    // of the layout on every switch, so the id is swapped in place instead.
    const state = await workspaceClient.refresh().catch(() => workspaceClient.getCached());
    const owner = state?.workspaces.find((w) => w.members.includes(viewId));
    if (owner) {
      const seen = new Set<string>();
      const members = owner.members
        .map((m) => (m === viewId ? next.viewId : m))
        .filter((m) => (seen.has(m) ? false : (seen.add(m), true)));
      await workspaceClient.patchWorkspace(owner.id, { members }).catch(() => undefined);
      // A view belongs to exactly one workspace; the id we just claimed may
      // have been left in another one by an earlier switch.
      for (const w of state?.workspaces ?? []) {
        if (w.id === owner.id || !w.members.includes(next.viewId)) continue;
        await workspaceClient.patchWorkspace(w.id, {
          members: w.members.filter((m) => m !== next.viewId),
        }).catch(() => undefined);
      }
    } else {
      await workspaceClient.addMemberToActive(next.viewId).catch(() => undefined);
    }

    // The slot element is keyed by viewId; re-point it so renderLayout reuses
    // the existing DOM (and its iframe) instead of tearing the window down.
    const slot = document.querySelector<HTMLElement>(`.app-slot[data-view-id="${CSS.escape(viewId)}"]`);
    if (slot) {
      slot.dataset['viewId']     = next.viewId;
      slot.dataset['instanceId'] = next.instanceId;
      slot.dataset['activityId'] = next.activityId ?? '';
      const iframe = slot.querySelector<HTMLIFrameElement>('iframe');
      if (iframe) setIframeUrl(iframe, next.iframeUrl);
    }
    markLaunchedHere(next.viewId);
    renderLayout();
  }

  (window as any).auraOpenActivityOnInstance = async (instanceId: string) => {
    const inst = await (await fetch(`/api/instances/${encodeURIComponent(instanceId)}/status`)).json();
    const appId = inst.instance?.appId;
    if (!appId) return;
    const manifest = await getManifest(appId);
    await openActivityOnInstance(instanceId, appId, manifest.name, inst.instance?.state ?? 'resumed');
  };

  function focusView_(viewId: string) {
    // Focusing an activity hidden by the layout's minimize brings it back too
    // (dock click, keyboard nav, workspace jump…).
    setParked(viewId, false);
    views = views.map((v) =>
      v.viewId === viewId
        // un-minimize when focused, so clicking the app icon brings it back
        ? { ...v, isFocused: true, state: v.state === 'minimized' ? 'normal' : v.state }
        : { ...v, isFocused: false },
    );
    // Persist the focus pick so fullscreen-mode reloads land on the same
    // view. patchWorkspaceDebounced collapses bursts (e.g. tabbing through
    // windows) into a single Redis write.
    const ws = workspaceClient.getCached();
    if (ws) {
      const active = ws.workspaces.find((w) => w.id === ws.activeWorkspaceId);
      if (active && active.layoutState?.focusedViewId !== viewId) {
        workspaceClient.patchWorkspaceDebounced(active.id, {
          layoutState: { ...(active.layoutState ?? {}), focusedViewId: viewId },
        });
      }
    }
    renderLayout();
  }

  // Promote a window to fill the desktop WITHOUT reloading it. The slot stays
  // exactly where it is in the DOM (so its iframe's browsing context survives,
  // per the HTML spec — moving an iframe reloads it); renderLayout() just
  // restyles it to span the whole canvas, on top of its siblings, with a
  // focused glow. This is the no-reload counterpart of the old #focus-frame
  // overlay. Toggling the same window restores it. Maximizing also focuses it.
  function maximizeView_(viewId: string) {
    maximizedViewId = viewId;
    maximizedFull = false; // each focus session starts windowed (desktop area)
    focusView_(viewId); // sets isFocused + persists focus; calls renderLayout()
  }
  function unmaximizeView_() {
    if (maximizedViewId === null) return;
    maximizedViewId = null;
    maximizedFull = false;
    renderLayout();
  }
  function toggleMaximizeView_(viewId: string) {
    if (maximizedViewId === viewId) unmaximizeView_();
    else                            maximizeView_(viewId);
  }
  // Full-size toggle for the focused window: covers the whole shell (over the
  // bars) ⇄ desktop area only. No-op unless something is maximized.
  function toggleMaximizeFull_() {
    if (maximizedViewId === null) return;
    maximizedFull = !maximizedFull;
    renderLayout();
  }

  function closeView_(viewId: string) {
    // A maximized window that's being closed must release the maximize state,
    // or the desktop would stay "stuck" promoting a dead viewId.
    if (maximizedViewId === viewId) maximizedViewId = null;
    const v = views.find((x) => x.viewId === viewId);
    if (v && v.instanceId) {
      // Skip backend call for placeholder views (no instance yet).
      // Services are headless by design — their iframe rendering is just
      // the proxy's SERVICE-HAS-NO-UI placeholder, so closing that window
      // must NOT stop the underlying backend (sidecars + state would die
      // with it). Drop the visual slot only; the AppManager keeps the
      // service running.
      const manifest = manifestCache.get(v.appId);
      if (manifest?.componentType === 'service') {
        // No stop / close call. Just remove the view from the layout.
      } else if (v.activityId) {
        // Activity view — close only this activity. Auto-stop handled server-side.
        fetch(`/api/activities/${encodeURIComponent(v.activityId)}/close`, { method: 'POST' }).catch(() => undefined);
        // …plus the handles this window still holds on instances it was
        // switched away from. A handle is not a session — the app owns those,
        // and they outlive every window — so nothing a user cares about is
        // lost here; skipping it just leaves dead handles that come back as
        // hidden views on the next shell load.
        for (const a of v.rebindTrail ?? []) {
          fetch(`/api/activities/${encodeURIComponent(a)}/close`, { method: 'POST' }).catch(() => undefined);
        }
      } else if (manifest?.backgroundService) {
        // activityMode='none' app that declares backgroundService=true (e.g.
        // Hermes): closing its window must NOT stop the backend — the sidecar
        // runtime + agent keep running. Drop the visual slot only; the instance
        // stays live in the dock / Process Manager and reopens on next launch.
        // Same rationale as the service branch above.
      } else {
        fetch(`/api/instances/${encodeURIComponent(v.instanceId)}/stop`, { method: 'POST' }).catch(() => undefined);
      }
    }
    workspaceClient.removeMember(viewId).catch(() => undefined);
    views = views.filter((x) => x.viewId !== viewId);
    renderLayout();
  }

  function minimizeView_(viewId: string) {
    // Minimizing the maximized window cancels the maximize so the desktop
    // returns to its normal layout instead of promoting an off-screen slot.
    if (maximizedViewId === viewId) { maximizedViewId = null; maximizedFull = false; }
    if (currentStrategy?.minimize === 'hide') {
      // Layout-owned minimize: hide the slot, keep the app running.
      setParked(viewId, true); // patches layoutState → re-renders
      renderLayout();
      return;
    }
    views = views.map((v) => v.viewId === viewId ? { ...v, state: 'minimized' as const } : v);
    renderLayout();
  }

  /**
   * Hard-reload the iframe inside a slot. Every Aura iframe is same-origin
   * (proxied through the shell), so `contentWindow.location.reload()`
   * works without the `src='about:blank'` dance — and avoids the white
   * flash that re-assigning src would cause. The skeleton overlay is
   * re-shown for the reload's duration so the user sees an immediate
   * "something happened" signal, matching the cold-launch visual.
   */
  function refreshView_(viewId: string) {
    const slot = dynamicLayout.querySelector<HTMLElement>(`.app-slot[data-view-id="${CSS.escape(viewId)}"]`);
    if (!slot) return;
    const body = slot.querySelector<HTMLElement>('.slot-body');
    const ifr  = slot.querySelector<HTMLIFrameElement>('iframe');
    if (!body || !ifr) return;
    // Never loaded yet (cold): reloading it means loading it.
    if (ifr.dataset['src'] !== undefined) {
      iframeWarmer.allow([viewId]);
      loadDeferredIframe(ifr, viewId, 'refresh');
      return;
    }
    // Re-arm the skeleton overlay — the initial load listener installed in
    // updateSlot is `{ once: true }` and has already been consumed.
    if (!body.querySelector('[data-aura-skeleton]')) {
      const v = views.find((x) => x.viewId === viewId);
      if (v) {
        const sk = document.createElement('div');
        sk.setAttribute('data-aura-skeleton', '1');
        sk.style.cssText = 'position:absolute;inset:0;z-index:5;background:var(--aura-color-bg);';
        sk.innerHTML = renderSkeleton(v);
        body.appendChild(sk);
      }
    }
    // Remove the skeleton once the reload's `load` event has fired + the
    // browser has painted (double-rAF, same pattern as cold launch).
    ifr.addEventListener('load', () => {
      requestAnimationFrame(() => requestAnimationFrame(() => {
        const sk = body.querySelector('[data-aura-skeleton]');
        if (sk) sk.remove();
      }));
    }, { once: true });
    try {
      ifr.contentWindow?.location.reload();
    } catch {
      // Cross-origin guard (shouldn't trigger for Aura proxied iframes —
      // defensive fallback). Re-assigning src to itself forces a navigate.
      const url = ifr.src;
      ifr.src = 'about:blank';
      ifr.src = url;
    }
  }

  /**
   * Boot skeleton shown inside an AppSlot while a backend instance transitions
   * through created → started → resumed. Lifecycle state is surfaced as a chip
   * so the user can see _why_ they're still waiting (e.g. "STARTED" vs "CREATED").
   */
  function renderSkeleton(v: AppView): string {
    const stateLabel = (v.lifecycleState ?? 'creating').toUpperCase();
    return `
      <div class="aura-skeleton">
        <div class="aura-skeleton-scan"></div>
        <div class="aura-skeleton-content">
          <div class="aura-skeleton-id">
            <span class="sci-spinner sci-spinner--md" aria-hidden="true">|</span>
            <span>${v.appId}</span>
          </div>
          <div class="aura-skeleton-bars">
            <div class="aura-skeleton-bar" style="width:62%;"></div>
            <div class="aura-skeleton-bar" style="width:84%;"></div>
            <div class="aura-skeleton-bar" style="width:48%;"></div>
            <div class="aura-skeleton-bar" style="width:72%;"></div>
          </div>
          <div class="aura-skeleton-status">
            <span class="aura-skeleton-dot"></span>
            <span>${stateLabel}</span>
            <span class="aura-skeleton-dim">· LOADING PROCESS</span>
          </div>
        </div>
      </div>`;
  }

  /**
   * Keyed DOM reconciler over `views`. Critical UX property: an existing slot's
   * `<iframe>` is NEVER recreated across renders — once a viewId has an iframe,
   * it survives every subsequent state event (other apps starting/stopping,
   * resize, minimize/restore of OTHER views, lifecycle transitions). Replacing
   * `innerHTML` on every event used to nuke every iframe and force every app
   * to fully reload (terminal WS reconnect, lost form state, etc.).
   *
   * Three independent reconcile passes per call:
   *   1. Empty state — wipe everything, show the launch button.
   *   2. Grid container styles — recomputed each call (cheap, no children touched).
   *   3. Minimized strip — stateless markup, rebuilt cleanly inside its host node.
   *   4. App slots — diff by viewId: keep, create, or remove. Reorder via
   *      `appendChild` (which moves an existing node, no re-mount).
   */
  /** Who asked for renders (only tracked while shell:layout logging is on). */
  const renderCallers = new Map<string, number>();
  function renderLayout() {
    const t0 = performance.now();
    renderCount++;
    if (layoutLog.isEnabled()) {
      const caller = (new Error().stack ?? '').split('\n')[2]?.trim().replace(/https?:\/\/[^/]+/, '').replace(/\?[^:]*/, '') ?? '?';
      renderCallers.set(caller, (renderCallers.get(caller) ?? 0) + 1);
    }
    // Once JS is in charge, never fall back to the SSR static layout — its
    // buttons are bound to a snapshot and would show stale content after close.
    staticLayout.style.display = 'none';

    // Drop ephemeral window labels whose window is gone (closed/crashed by any
    // path). `views` holds every running view across all workspaces — a viewId
    // missing from it means the window no longer exists, so the label dies with
    // it. (Minimized + other-workspace views remain in `views`, so their labels
    // survive, as intended.)
    hydrateActivityNames();
    if (windowNames.size > 0) {
      const live = new Set(views.map((v) => v.viewId));
      for (const id of windowNames.keys()) if (!live.has(id)) windowNames.delete(id);
    }

    // Workspace filter:
    //   • Views belonging to the active workspace render normally.
    //   • Views from OTHER workspaces stay in the DOM (display:none) so
    //     their iframes survive workspace switches — switching back is
    //     instant + state-preserving instead of reloading the app.
    //   • Views removed from `views` entirely (close, crash) get pruned
    //     from the DOM later in this function.
    const wsState = workspaceClient.peekCached();   // read-only: no deep copy per render
    let workspaceMembers: Set<string> | null = null;
    if (wsState) {
      const ws = wsState.workspaces.find(w => w.id === wsState.activeWorkspaceId);
      if (ws) workspaceMembers = new Set(ws.members);
    }
    const activeWsId = wsState?.activeWorkspaceId ?? null;
    if (activeWsId && activeWsId !== lastActiveWsId) {
      lastActiveWsId = activeWsId;
      rememberRecentWorkspace(activeWsId);
    }
    const inActiveWorkspace = (v: AppView) => {
      // Placeholders (instanceId === '') are pinned to the workspace that
      // was active at the moment of launch — see `pendingWorkspace` map.
      // Switching workspaces mid-load doesn't drag the skeleton along,
      // and the eventual real view ends up on the launch workspace too.
      if (v.instanceId === '') {
        const pinned = pendingWorkspace.get(v.viewId);
        if (pinned) return pinned === activeWsId;
        return true; // unpinned placeholder (pre-hydration launch): show inline
      }
      // Without hydrated workspace state, behave like the pre-workspaces
      // shell — every view counts as active.
      if (!workspaceMembers) return true;
      return workspaceMembers.has(v.viewId);
    };

    // ---- Layout strategy (lib/layout) ----
    // The active workspace's layoutId picks a ShellLayoutStrategy; unknown ids
    // fall back to tiling. The strategy decides the container shape, places
    // each activity, and may own regions / overlay / minimize behaviour.
    const activeWs = wsState?.workspaces.find((w) => w.id === wsState.activeWorkspaceId);
    const layoutId = activeWs?.layoutId ?? 'tiling';
    const strategy = shellLayoutFor(layoutId);
    switchStrategy(strategy);
    setLayoutDragPolicy(strategy.dragPolicy ?? dragPolicyFor(layoutId));
    const layoutState = (activeWs?.layoutState ?? {}) as Record<string, unknown>;
    // Activities a `minimize: 'hide'` layout hid (app alive, slot kept). Under a
    // layout without that policy they show again and the stale list goes.
    const parkedIds = new Set(strategy.minimize === 'hide' ? parkedViewIds() : []);
    if (strategy.minimize !== 'hide' && Array.isArray(layoutState['minimized'])) {
      queueMicrotask(() => patchActiveLayoutState({ minimized: undefined }));
    }

    const nonMinimized = views.filter((v) => v.state !== 'minimized');
    // Sort by the active workspace's `members[]` order so the placement
    // pass below assigns cell N to the same viewId on every render.
    // Without this, the runtime order would follow `views[]` mutation
    // history — adding the 3rd window then removing the 1st would leave
    // the (former) 2nd/3rd windows swapped relative to their workspace
    // member positions on the next reload.
    const memberOrder = workspaceMembers
      ? new Map<string, number>([...workspaceMembers].map((id, i) => [id, i] as [string, number]))
      : null;
    const orderKey = (v: AppView): number =>
      memberOrder ? (memberOrder.get(v.viewId) ?? 1e9) : views.indexOf(v);
    const inWorkspace  = nonMinimized.filter(inActiveWorkspace).sort((a, b) => orderKey(a) - orderKey(b));
    const visible      = inWorkspace.filter((v) => !parkedIds.has(v.viewId));
    const parked       = inWorkspace.filter((v) => parkedIds.has(v.viewId));
    const hidden       = nonMinimized.filter((v) => !inActiveWorkspace(v));
    const minimized    = views.filter((v) => v.state === 'minimized' && inActiveWorkspace(v));

    const toLayoutView = (v: AppView, isMin: boolean): LayoutViewInfo => ({
      viewId: v.viewId, appId: v.appId, title: v.title,
      userLabel: windowNames.get(v.viewId), minimized: isMin, isFocused: v.isFocused,
    });
    const visibleInfo = visible.map((v) => toLayoutView(v, false));
    restoreMaximized(new Set(visible.map((v) => v.viewId)));
    lastLayoutViews = views.filter(inActiveWorkspace)
      .sort((a, b) => orderKey(a) - orderKey(b))
      .map((v) => toLayoutView(v, v.state === 'minimized' || parkedIds.has(v.viewId)));

    // ---- 1) Empty-state overlay ----
    // Use a separate <div data-aura-empty> child instead of overwriting
    // dynamicLayout.innerHTML — that would nuke any hidden-other-workspace
    // slot iframes we're holding alive across workspace switches.
    let emptyEl = dynamicLayout.querySelector(':scope > [data-aura-empty]') as HTMLElement | null;
    const desktopIsEmpty = visible.length === 0 && minimized.length === 0 && parked.length === 0;
    if (desktopIsEmpty) {
      if (!emptyEl) {
        emptyEl = document.createElement('div');
        emptyEl.setAttribute('data-aura-empty', '1');
        emptyEl.style.cssText = 'position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:transparent;color:var(--aura-color-text-dim);font-size:0.8rem;letter-spacing:0.15em;text-align:center;pointer-events:auto;';
        // The autohide reveal button is rendered next to the launcher in
        // the empty state ONLY when autohide is active — that's the mode
        // where the bars are tucked off-screen and the user has no
        // ambient way to dismiss it. CSS at `:scope` level toggles its
        // display from body[data-autohide-bars="on"]; see global.css.
        const btnStyle = 'color: var(--aura-color-primary); border: var(--aura-border); padding: 8px 24px; background: transparent; cursor: pointer; font-family: var(--aura-font-mono); letter-spacing: 0.1em;';
        emptyEl.innerHTML = `
          <div style="margin-bottom: 12px;">// NO ACTIVE PROCESSES</div>
          <button type="button" onclick="window.auraOpenLauncher && window.auraOpenLauncher()" style="${btnStyle}">[ LAUNCH APP ]</button>
          <button type="button" data-aura-show-bars="1" onclick="window.auraToggleAutohideBars && window.auraToggleAutohideBars()" style="${btnStyle} margin-top: 10px;">[ SHOW BARS ]</button>`;
        dynamicLayout.appendChild(emptyEl);
      }
    } else if (emptyEl) {
      emptyEl.remove();
    }

    // ---- 2) Container ----
    const stripShown = minimized.length > 0 && strategy.showsMinimizedStrip !== false;
    const layoutCtx: LayoutRenderContext = {
      visible: visibleInfo, baseRow: stripShown ? 2 : 1, stripShown, layoutState,
    };
    if (visible.length === 0) {
      Object.assign(dynamicLayout.style, {
        display: 'block', gridTemplateColumns: '', gridTemplateRows: '',
        gap: '', background: 'transparent',
      });
    } else {
      Object.assign(dynamicLayout.style, strategy.containerStyle(layoutCtx));
    }

    // ---- 3) Minimized strip ----
    //
    // Pinned at grid-row 1 spanning all columns. EXPLICIT grid placement
    // (instead of relying on auto-flow + DOM order + `order` property) so
    // it cannot end up below an app slot — which is exactly the "header on
    // the bottom" bug that auto-placement caused when DOM order drifted.
    // A strategy that lists minimized activities itself (taskbar) turns it off.
    let strip = dynamicLayout.querySelector(':scope > [data-aura-strip]') as HTMLElement | null;
    if (!stripShown) {
      strip?.remove();
      strip = null;
    } else {
      if (!strip) {
        strip = document.createElement('div');
        strip.setAttribute('data-aura-strip', '1');
      }
      strip.style.cssText = 'grid-row:1;grid-column:1 / -1;display:flex;gap:6px;padding:4px 8px;background:var(--aura-color-surface);border-bottom:var(--aura-border);overflow-x:auto;';
      strip.innerHTML = `<span style="font-size:0.6rem; color: var(--aura-color-text-dim); letter-spacing:0.12em; align-self:center;">MIN ▾</span>${
        minimized.map((v) => `
          <button data-action="restore" data-view-id="${escapeAttr(v.viewId)}"
            style="background:transparent; border:var(--aura-border); color:var(--aura-color-secondary); font-family:var(--aura-font-mono); font-size:0.65rem; padding:2px 8px; cursor:pointer; white-space:nowrap;"
            title="Restore ${escapeAttr(v.title)}">${escapeHtml(v.title)}</button>`).join('')
      }`;
      if (strip.parentElement !== dynamicLayout) dynamicLayout.appendChild(strip);
    }

    // ---- 4) App slots ----
    //
    // CRITICAL: an iframe re-attached to the DOM is RELOADED by the browser
    // (this is the HTML spec: moving an iframe element invalidates its
    // browsing context). We therefore must NOT call `appendChild` on a slot
    // that's already in `dynamicLayout` — even just to "move it to the end"
    // counts as a re-attach and would reload the iframe inside it. The
    // strategy positions each slot explicitly (grid cell / absolute rect),
    // independent of DOM order.
    const existing = new Map<string, HTMLElement>();
    dynamicLayout.querySelectorAll(':scope > .app-slot[data-view-id]').forEach((el) => {
      const id = (el as HTMLElement).dataset['viewId'];
      if (id) existing.set(id, el as HTMLElement);
    });
    const keep = new Set<string>();

    // The active workspace's activities may load now. Those that were cold
    // (a switch onto a workspace the warmer had not reached) load right here.
    const coldNow = iframeWarmer.allow(visible.map((v) => v.viewId)).filter((id) => existing.has(id));
    if (bootRendered && coldNow.length) mark('ws:switch-cold', { ws: activeWsId, views: coldNow.length });
    // Views no workspace owns (services, background apps without a window)
    // keep loading at once, as before: only other workspaces' activities wait.
    if (wsState) {
      const owned = new Set(wsState.workspaces.flatMap((w) => w.members));
      iframeWarmer.allow(hidden.filter((v) => !owned.has(v.viewId)).map((v) => v.viewId));
    }

    visible.forEach((v, i) => {
      keep.add(v.viewId);
      let el = existing.get(v.viewId);
      if (!el) {
        el = createSlot(v);
        dynamicLayout.appendChild(el); // OK: brand-new slot, no iframe to reload
      } else {
        updateSlot(el, v);
      }
      el.style.display = 'flex';
      el.style.removeProperty('order');

      // Maximized (in-place focus): promote this slot to cover the whole
      // activities area, on top of its siblings, WITHOUT moving its iframe — so
      // the app keeps its state (no reload). The strategy releases it first
      // (no drag/resize while maximized); the inline geometry set here is
      // cleared again when the activity is un-maximized, below.
      if (v.viewId === maximizedViewId) {
        releaseSlot(el);
        el.dataset['maximized'] = 'true';
        el.dataset['maximizedFull'] = maximizedFull ? 'true' : 'false';
        if (maximizedFull) {
          // Full size: cover the WHOLE shell (over the bars). `fixed` anchors
          // to the zoom-transformed <body>, so it respects page zoom + margins
          // exactly like the bars; z-index 950 matches the old focus overlay —
          // above the autohide bars (900), below launcher/PM panels (1000).
          el.style.position = 'fixed';
        } else {
          // Maximized: fill just the activities area, on top of sibling slots,
          // below the bars and the layout's regions.
          el.style.position = 'absolute';
        }
        el.style.left   = '0';
        el.style.top    = '0';
        el.style.width  = '100%';
        el.style.height = '100%';
        el.style.zIndex = maximizedFull ? '950' : '60';
        el.style.removeProperty('grid-column');
        el.style.removeProperty('grid-row');
        return;
      }
      if (el.dataset['maximized']) {
        delete el.dataset['maximized'];
        delete el.dataset['maximizedFull'];
        for (const p of ['position', 'left', 'top', 'width', 'height', 'z-index']) el.style.removeProperty(p);
      }

      if (el.dataset['layoutOwner'] && el.dataset['layoutOwner'] !== strategy.id) releaseSlot(el);
      strategy.place(el, visibleInfo[i]!, i, layoutCtx, layoutHost);
      el.dataset['layoutOwner'] = strategy.id;
    });

    // Hidden by the layout's minimize ('hide' policy): keep the slot and its
    // iframe — the app keeps running — just take it off screen.
    for (const v of parked) {
      keep.add(v.viewId);
      let el = existing.get(v.viewId);
      if (!el) {
        el = createSlot(v);
        dynamicLayout.appendChild(el);
      } else {
        updateSlot(el, v);
      }
      releaseSlot(el);
      el.style.display = 'none';
    }

    // #static-layout only holds the server-rendered empty-desktop hint; the
    // server-rendered activity slots live in #dynamicLayout and were adopted
    // above (an iframe moved or recreated would load its app a second time).
    if (staticLayout.firstChild) staticLayout.replaceChildren();

    // Hidden-in-other-workspace slots: keep DOM + iframe alive but make
    // them invisible AND unreachable for layout. `display:none` removes
    // them from the grid so they don't reserve a track; the iframe stays
    // mounted, so switching workspaces restores the app instantly.
    for (const v of hidden) {
      keep.add(v.viewId);
      let el = existing.get(v.viewId);
      // Until the active workspace has loaded, other workspaces' slots are
      // not built at all (boot stage 1 stays short); the idle pass after it
      // builds them, then the warmer fills them.
      if (!el && !hiddenSlotsReady) continue;
      if (!el) {
        // First time we're seeing this view AND it's not in the active
        // workspace — still create the slot (otherwise switching to its
        // workspace later would require a full mount). Cheap.
        el = createSlot(v);
        dynamicLayout.appendChild(el);
      } else {
        updateSlot(el, v);
      }
      el.style.display = 'none';
    }

    // Views removed from the `views` array entirely (close, crash, etc.)
    // get pruned here. iframes inside DO reload if recreated later — but
    // by definition they're gone, so this is the right teardown point.
    //
    // Graceful shutdown: postMessage 'aura.shutdown' into the iframe so the
    // proxy-injected lifecycle agent can .close() all open EventSource +
    // WebSocket cleanly before the iframe element is destroyed. Otherwise
    // the iframe's auto-reconnect retries leak past the close, producing
    // noisy "ws: connection refused" / "EventSource error" lines in the
    // Console + browser DevTools. We hard-cap the wait at 200ms so a
    // hanging app can't block the shell.
    for (const [viewId, el] of existing) {
      if (keep.has(viewId)) continue;
      iframeWarmer.forget(viewId);
      const ifr = el.querySelector('iframe') as HTMLIFrameElement | null;
      if (ifr) unobserveIframe(ifr); // stop the RO before the element is torn down
      if (ifr && !ifr.getAttribute('src')) {
        el.remove(); // never loaded: no app to shut down
      } else if (ifr?.contentWindow) {
        try { ifr.contentWindow.postMessage({ type: 'aura.shutdown' }, '*'); } catch (_) { /* ignore */ }
        // Race the ack against a hard timeout. Either way el.remove() runs.
        const done = new Promise<void>((resolve) => {
          const onAck = (ev: MessageEvent) => {
            if (ev.source === ifr.contentWindow && (ev.data as { type?: string } | null)?.type === 'aura.shutdown.done') {
              window.removeEventListener('message', onAck);
              resolve();
            }
          };
          window.addEventListener('message', onAck);
        });
        const timeout = new Promise<void>((resolve) => setTimeout(resolve, 200));
        void Promise.race([done, timeout]).then(() => el.remove());
      } else {
        el.remove();
      }
    }

    persistMaximized();
    // Strategy post-pass (splitters, …) + its regions (taskbar, …).
    strategy.afterRender?.(layoutCtx, layoutHost);
    for (const region of Object.values(strategy.regions ?? {})) region?.update?.(layoutHost);

    // The grid just reflowed (open/close/minimize/workspace switch/focus toggle
    // / maximize all funnel through here): broadcast every iframe its (possibly
    // new) box. This explicit pass is the PRIMARY, proven driver — it reaches
    // every iframe regardless of engine quirks. The per-iframe ResizeObserver
    // (observeIframe) is a supplementary geometry hook for changes that don't
    // route through renderLayout. Both are idempotent at the app (the terminal
    // only resizes when cols/rows actually change), so the overlap is a no-op.
    queueViewportBroadcast('layout');
    // Phase 4: window-bound UI (notification dialogues) re-checks where its
    // windows are — a minimized slot was just destroyed, a restored one re-created.
    document.dispatchEvent(new CustomEvent('aura:views.changed'));

    const ms = performance.now() - t0;
    if (layoutLog.isEnabled()) {
      layoutLog.debug(`render #${renderCount}`, `${ms.toFixed(1)}ms`, { visible: visible.length, parked: parked.length, hidden: hidden.length, layout: layoutId });
    }
    if (!bootRendered) {
      bootRendered = true;
      mark('layout:first-render', { visible: visible.length, hidden: hidden.length, ms: Math.round(ms) });
      const visibleSlots = visible
        .map((v) => dynamicLayout.querySelector<HTMLElement>(`:scope > .app-slot[data-view-id="${CSS.escape(v.viewId)}"]`))
        .filter((el): el is HTMLElement => !!el);
      trackActiveWorkspaceLoad(visibleSlots);
      onStage('ws:active-loaded', () => idle(() => {
        hiddenSlotsReady = true;
        renderLayout();
        mark('layout:hidden-slots', { slots: dynamicLayout.querySelectorAll(':scope > .app-slot').length });
        startWarming();
      }, { timeout: 1500 }));
    }
  }

  function createSlot(v: AppView): HTMLElement {
    const slot = document.createElement('div');
    slot.className = 'app-slot';
    slot.dataset['viewId']     = v.viewId;
    slot.dataset['instanceId'] = v.instanceId;
    if (v.activityId) slot.dataset['activityId'] = v.activityId;
    slot.style.cssText = SLOT_STYLE;
    // Same markup the server renders for the active workspace
    // (lib/desktop/slotMarkup.ts): minimize is opt-in per view, the rest of
    // the title bar is filled by updateSlot().
    slot.innerHTML = slotInnerHtml({ minimizable: v.minimizable });
    updateSlot(slot, v);
    return slot;
  }

  function updateSlot(slot: HTMLElement, v: AppView): void {
    // Title chrome: when the activity has a non-empty back stack AND the
    // app hasn't opted out (`breadcrumb === 'off'`), render an OS-managed
    // breadcrumb trail with the back button + clickable prior crumbs.
    // Otherwise render the plain title.
    const trail = slot.querySelector('.slot-title-trail') as HTMLElement | null;
    if (trail) {
      const history     = v.history ?? [];
      const mode        = v.breadcrumb ?? 'os';
      const showTrail   = mode === 'os' && history.length > 0;
      const escHtml = (s: string) => s
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      // Inline styles mirror the .crumb / .crumb-back / .crumb-prev /
      // .crumb-current / .crumb-sep CSS at the bottom of this file. They
      // exist as belt-and-suspenders: an iframe-side dev-overlay or a
      // mid-deploy CSS-load skew shouldn't be able to make the chrome
      // invisible — the slot-body needs the chrome height to compute its
      // own height, otherwise the whole slot collapses.
      const crumbBase = 'font-family:inherit;font-size:0.7rem;letter-spacing:0.05em;padding:2px 4px;line-height:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:2ch;';
      const crumbPrev = `${crumbBase}background:transparent;border:none;cursor:pointer;color:var(--aura-color-text-dim);flex-shrink:1;max-width:18ch;`;
      const crumbCurrent = `${crumbBase}color:var(--aura-color-primary);flex-shrink:0;min-width:4ch;max-width:24ch;`;
      const crumbSep = 'color:var(--aura-color-text-dim);flex-shrink:0;opacity:0.5;';
      const crumbBack = 'background:transparent;border:var(--aura-border);color:var(--aura-color-text-dim);font-family:var(--aura-font-mono);font-size:0.65rem;padding:2px 10px;cursor:pointer;line-height:1;flex-shrink:0;margin-right:4px;';
      if (showTrail) {
        const fallback = (entry: { path: string; title?: string }) =>
          entry.title ?? (entry.path === '/' ? '·' : entry.path.replace(/^\//, '').replace(/\/$/, '').split('/').slice(-1)[0] ?? '·');
        const crumbs = history.map((h, i) =>
          `<button class="crumb crumb-prev" data-action="back-to" data-index="${i}" title="${escHtml(h.path)}" style="${crumbPrev}">${escHtml(fallback(h))}</button>`
        ).join(`<span class="crumb-sep" aria-hidden="true" style="${crumbSep}"><svg class="aura-icon" aria-hidden="true"><use href="/api/os/icons.svg#lucide-chevron-right"/></svg></span>`);
        trail.innerHTML =
          `<button class="crumb-back" data-action="back" title="Back" style="${crumbBack}">&lt;</button>` +
          crumbs +
          `<span class="crumb-sep" aria-hidden="true" style="${crumbSep}"><svg class="aura-icon" aria-hidden="true"><use href="/api/os/icons.svg#lucide-chevron-right"/></svg></span>` +
          `<span class="crumb crumb-current" title="${escHtml(v.title)}" style="${crumbCurrent}">${escHtml(v.title)}</span>`;
      } else {
        // Plain title — current behaviour. The .crumb-current span keeps
        // the same DOM hook so CSS doesn't need a separate selector.
        trail.innerHTML = `<span class="crumb crumb-current" style="${crumbCurrent}">${escHtml(v.title)}</span>`;
      }
    }
    const titleId = slot.querySelector('.slot-title-id') as HTMLElement | null;
    const idText = v.sessionLabel ?? v.activityId ?? v.instanceId;
    if (titleId && titleId.textContent !== idText) titleId.textContent = idText;

    // The ephemeral user label (if set) renders as a pill BEFORE the app
    // title, so both are visible: "[My Notes]  EDITOR". textContent, not
    // innerHTML — the name is user input and must not be interpreted as markup.
    const nameEl = slot.querySelector('.slot-window-name') as HTMLElement | null;
    if (nameEl) {
      const custom = windowNames.get(v.viewId);
      if (custom) {
        if (nameEl.textContent !== custom) nameEl.textContent = custom;
        nameEl.style.display = '';
        nameEl.title = `Window name: ${custom}`;
      } else {
        nameEl.textContent = '';
        nameEl.style.display = 'none';
        nameEl.removeAttribute('title');
      }
    }

    // Layout-driven controls: minimize for every activity under a 'hide'
    // minimize policy, plus the strategy's own title-bar buttons.
    const minBtn = slot.querySelector('.slot-minimize-btn') as HTMLElement | null;
    if (minBtn) minBtn.style.display = (v.minimizable || currentStrategy?.minimize === 'hide') ? '' : 'none';
    const layoutBtnHost = slot.querySelector('.slot-layout-btns') as HTMLElement | null;
    if (layoutBtnHost) {
      const btns = currentStrategy?.chromeButtons?.(toLayoutViewInfo(v), layoutHost) ?? [];
      const sig = (currentStrategy?.id ?? '') + JSON.stringify(btns);
      if (layoutBtnHost.dataset['sig'] !== sig) {
        layoutBtnHost.dataset['sig'] = sig;
        const style = 'background:transparent;border:var(--aura-border);color:var(--aura-color-text-dim);font-family:var(--aura-font-mono);font-size:0.65rem;padding:2px 10px;cursor:pointer;line-height:1;';
        layoutBtnHost.innerHTML = btns.map((b) =>
          `<button data-action="layout:${escapeAttr(b.action)}" title="${escapeAttr(b.title)}"`
          + ` aria-pressed="${b.pressed ? 'true' : 'false'}" style="${style}">${b.html}</button>`).join('');
      }
    }

    // Reflect focus-mode state on the maximize + full-size controls. When this
    // window is the maximized (focused) one, the maximize button becomes an
    // "exit focus" affordance and the full-size toggle appears beside it; both
    // are hidden / reset otherwise.
    const isMax = v.viewId === maximizedViewId;
    const maxBtn = slot.querySelector('.slot-maximize-btn') as HTMLButtonElement | null;
    if (maxBtn) {
      maxBtn.textContent = isMax ? '⊟' : '[ ]';
      maxBtn.title = isMax ? 'Exit focus (Esc)' : 'Focus this window (maximize)';
    }
    const fullBtn = slot.querySelector('.slot-fullsize-btn') as HTMLButtonElement | null;
    if (fullBtn) {
      fullBtn.style.display = isMax ? '' : 'none';
      fullBtn.innerHTML = maximizedFull ? '<svg class="aura-icon" aria-hidden="true"><use href="/api/os/icons.svg#lucide-minimize"/></svg>' : '<svg class="aura-icon" aria-hidden="true"><use href="/api/os/icons.svg#lucide-maximize"/></svg>';
      fullBtn.title = maximizedFull ? 'Exit full size' : 'Full size (cover bars)';
    }
    // Hide the destructive close (✕) while focused — exiting focus is the
    // expected action there (⊟ / Esc), not tearing the window down — and show
    // a short "we're in focus mode" hint in its place.
    const closeBtn = slot.querySelector('.slot-close-btn') as HTMLButtonElement | null;
    if (closeBtn) closeBtn.style.display = isMax ? 'none' : '';
    const focusHint = slot.querySelector('.slot-focus-hint') as HTMLElement | null;
    if (focusHint) focusHint.style.display = isMax ? 'inline-flex' : 'none';

    const body = slot.querySelector('.slot-body') as HTMLElement | null;
    if (!body) return;
    const hasIframe   = !!body.querySelector('iframe');
    const hasSkeleton = !!body.querySelector('[data-aura-skeleton]');

    // ALWAYS ensure a skeleton overlay exists when the slot is created. It
    // covers the iframe area until the iframe finishes loading — without
    // this overlay, the user stares at a black rectangle during the
    // ~150-300ms between iframe-element creation and the embedded app's
    // first paint. The skeleton is removed via iframe.onload below.
    if (!hasSkeleton && !hasIframe) {
      const sk = document.createElement('div');
      sk.setAttribute('data-aura-skeleton', '1');
      sk.style.cssText = 'position:absolute;inset:0;z-index:5;background:var(--aura-color-bg);';
      sk.innerHTML = renderSkeleton(v);
      body.appendChild(sk);
    }

    // If the view is still mid-spawn (isLoading=true) we don't have an
    // iframeUrl yet (placeholder views set iframeUrl=''). Don't create the
    // iframe element until we have a real URL.
    if (v.isLoading) return;

    const existing = body.querySelector('iframe') as HTMLIFrameElement | null;
    if (existing) {
      // A server-rendered iframe (adopted in place, already loading or done)
      // gets the same listeners as one we create. A cold iframe (other
      // workspace, src still in data-src) loads once the warmer allows it.
      if (!existing.dataset['wired']) wireIframe(existing, body, v);
      if (existing.dataset['src'] !== undefined && iframeWarmer.isWarm(v.viewId)) {
        loadDeferredIframe(existing, v.viewId, 'active');
      }
      return;
    }

    // Transition: backend says resumed → mount the iframe ONCE under the
    // skeleton overlay. The skeleton stays until the iframe's `load` (the
    // embedded app's document has loaded, splash painted).
    if (v.iframeUrl) {
      const iframe = document.createElement('iframe');
      iframe.title = v.title;
      // No `allow=` attribute: our iframes are same-origin (proxied through
      // /api/proxy/<id>/ on the shell's port), so clipboard, microphone, etc.
      // are inherited from the parent. Firefox warns ("unsupported feature
      // name") on Chrome-specific Permissions Policy strings like
      // `clipboard-read`/`clipboard-write`, which we don't need anyway.
      iframe.style.cssText = IFRAME_STYLE;
      wireIframe(iframe, body, v);
      // Only activities that may load now get a src (lib/iframeWarmer.ts):
      // the active workspace at once, the others when warmed or opened.
      if (iframeWarmer.isWarm(v.viewId)) {
        iframe.src = v.iframeUrl;
        noteIframeSrc(v.viewId, 'active');
      } else {
        iframe.dataset['src'] = v.iframeUrl;
      }
      // Insert as the FIRST child so the skeleton (appended above) stays on top.
      body.insertBefore(iframe, body.firstChild);
      // Geometry-driven refit hook — a SUPPLEMENT to the explicit broadcasts in
      // renderLayout / window-resize / stack-release. Observe AFTER attach so the
      // observation reliably registers (observing a detached element doesn't
      // fire in every engine). Catches box changes that don't route through
      // renderLayout; deduped + idempotent at the app, so it never double-fits.
      observeIframe(iframe);
    }
  }

  /** True once `iframe` shows its app's document (not the initial about:blank). */
  function isIframeLoaded(iframe: HTMLIFrameElement): boolean {
    if (!iframe.getAttribute('src')) return false;
    try {
      const doc = iframe.contentDocument;
      return !!doc && doc.readyState === 'complete' && doc.URL !== 'about:blank';
    } catch { return true; /* not same-origin: it navigated, so it loaded */ }
  }

  /**
   * Hook an activity iframe's lifecycle: skeleton removal, the key-claim list
   * and viewport on every load, the one-shot auto-focus of a just-launched
   * window. For an adopted server-rendered iframe that already finished
   * loading, the per-load work runs right away (its `load` came before this
   * script).
   */
  function wireIframe(iframe: HTMLIFrameElement, body: HTMLElement, v: AppView): void {
    iframe.dataset['wired'] = '1';
    const viewId = v.viewId;
    let firstLoadDone = false;
    const onLoad = (adopted: boolean) => {
      // A src-less (cold) iframe fires `load` for its initial about:blank.
      if (!iframe.getAttribute('src')) return;
      if (!firstLoadDone) {
        firstLoadDone = true;
        if (markTime('iframe:first-load') === null) mark('iframe:first-load', viewId);
        mark(`app:${viewId}:load`, adopted ? 'adopted' : undefined);
        iframeLog.debug('load', viewId, adopted ? '(adopted, already loaded)' : '');
        // Two RAFs = "wait until the browser has actually painted the iframe
        // contents, then remove the overlay". Without this, fast-loading
        // iframes flash black for one frame between onload and first paint.
        requestAnimationFrame(() => requestAnimationFrame(() => {
          const sk = body.querySelector('[data-aura-skeleton]');
          if (sk) sk.remove();
        }));
        // Auto-enter newly-launched windows: same end-state as Enter on a
        // highlighted slot in window-select mode — focus the iframe + post
        // `aura.window.focus` so the app's SDK helper (installGridNav)
        // routes focus to its first interactive element. One-shot per view.
        if (pendingAutoFocusViewIds.has(viewId)) {
          pendingAutoFocusViewIds.delete(viewId);
          // rAF defer past the browser's iframe-focus-transfer microtask
          // (same race the terminal's `term.focus()` hit on Enter).
          requestAnimationFrame(() => {
            iframe.focus();
            try { iframe.contentWindow?.postMessage({ type: 'aura.window.focus' }, '*'); }
            catch { /* iframe gone or cross-origin */ }
          });
        }
      }
      // Every load (each in-iframe navigation re-emits it): the current claim
      // list, and the viewport scale so an app opened INTO an already-zoomed
      // shell fits on first paint (seeds the observer's dedupe too).
      sendClaimList(iframe);
      postViewportMount(iframe);
    };
    iframe.addEventListener('load', () => onLoad(false));
    if (iframe.isConnected && isIframeLoaded(iframe)) onLoad(true);
    if (iframe.isConnected) observeIframe(iframe);
  }

  /** Give a cold iframe its src (lib/iframeWarmer.ts decided it may load). */
  function loadDeferredIframe(iframe: HTMLIFrameElement, viewId: string, reason: string): void {
    const src = iframe.dataset['src'];
    delete iframe.dataset['src'];
    if (!src) return;
    iframe.src = src;
    noteIframeSrc(viewId, reason);
  }

  /** Point an iframe at `url` — a cold one just keeps the new url for later. */
  function setIframeUrl(iframe: HTMLIFrameElement, url: string): void {
    if (iframe.dataset['src'] !== undefined) { iframe.dataset['src'] = url; return; }
    if (iframe.getAttribute('src') !== url) iframe.src = url;
  }

  let iframeSrcCount = 0;
  function noteIframeSrc(viewId: string, reason: string): void {
    iframeSrcCount++;
    mark(`app:${viewId}:src`, reason);
    if (iframeSrcCount === 1) mark('iframe:first-src', viewId);
    iframeLog.debug('src', viewId, reason, `#${iframeSrcCount}`);
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  function escapeAttr(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }

  function renderMinimizedStrip(minimized: AppView[]): string {
    if (minimized.length === 0) return '';
    return `
      <div style="margin-top: 28px; display:flex; flex-wrap:wrap; justify-content:center; gap:6px;">
        <span style="font-size:0.6rem; color: var(--aura-color-text-dim); letter-spacing:0.12em; align-self:center;">MIN ▾</span>
        ${minimized.map((v) => `
          <button data-action="restore" data-view-id="${v.viewId}"
            style="background:transparent; border:var(--aura-border); color:var(--aura-color-secondary); font-family:var(--aura-font-mono); font-size:0.65rem; padding:3px 8px; cursor:pointer; white-space:nowrap;"
            title="Restore ${v.title}">
            ${v.title}
          </button>
        `).join('')}
      </div>`;
  }

  /**
   * Event delegation for view actions. Works for both the SSR-rendered AppSlot
   * (FullscreenLayout / TilingLayout in `#static-layout`) and the JS-generated
   * `.app-slot`s plus minimized-strip chips inside `#dynamic-layout`.
   *
   * For close/minimize: the slot carries `data-view-id`, the button `data-action`.
   * For restore: the button itself carries both `data-action="restore"` and
   * `data-view-id`, since chips don't live inside a slot.
   */
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const btn = target.closest('button[data-action]') as HTMLButtonElement | null;
    if (!btn) return;
    const action = btn.dataset['action'];

    // Restore: viewId is on the button itself
    if (action === 'restore') {
      const viewId = btn.dataset['viewId'];
      if (viewId) { e.preventDefault(); restoreView_(viewId); }
      return;
    }

    // close/minimize: viewId is on the surrounding .app-slot
    const slot = btn.closest('.app-slot[data-view-id]') as HTMLElement | null;
    if (!slot) return;
    const viewId = slot.dataset['viewId'];
    if (!viewId) return;
    if (action?.startsWith('layout:')) {
      e.preventDefault();
      currentStrategy?.onChromeAction?.(action.slice('layout:'.length), viewId, layoutHost);
      return;
    }
    if (action === 'close')    { e.preventDefault(); closeView_(viewId); }
    if (action === 'minimize') { e.preventDefault(); minimizeView_(viewId); }
    if (action === 'refresh')  { e.preventDefault(); refreshView_(viewId); }
    if (action === 'rename')   { e.preventDefault(); beginRenameWindow(slot, viewId); }
    if (action === 'maximize') {
      // In-place focus: promote/restore THIS slot without reloading its
      // iframe (see maximizeView_). Toggles, so the same button collapses a
      // maximized window back into the layout.
      e.preventDefault();
      toggleMaximizeView_(viewId);
    }
    if (action === 'maximize-full') {
      // Toggle the focused window between full size (over the bars) and the
      // desktop-area view. Only meaningful while this window is maximized.
      e.preventDefault();
      toggleMaximizeFull_();
    }
    // Breadcrumb crumb clicks → POST /back or /back-to.
    if (action === 'back') {
      e.preventDefault();
      const activityId = slot.dataset['activityId'];
      if (activityId) {
        void fetch(`/api/activities/${encodeURIComponent(activityId)}/back`, { method: 'POST' });
      }
    }
    if (action === 'back-to') {
      e.preventDefault();
      const activityId = slot.dataset['activityId'];
      const idx = Number(btn.dataset['index']);
      if (activityId && Number.isInteger(idx) && idx >= 0) {
        void fetch(`/api/activities/${encodeURIComponent(activityId)}/back-to`, {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ index: idx }),
        });
      }
    }
  });

  // Double-click the title (anywhere but the crumb buttons) to rename — the
  // familiar desktop "rename" gesture, complementing the ✎ control. Delegated
  // on document so it covers both SSR and JS-generated slots, like the click
  // handler above.
  document.addEventListener('dblclick', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target || target.closest('button')) return;
    const titleEl = target.closest('.slot-title') as HTMLElement | null;
    if (!titleEl) return;
    const slot = titleEl.closest('.app-slot[data-view-id]') as HTMLElement | null;
    const viewId = slot?.dataset['viewId'];
    if (!slot || !viewId) return;
    e.preventDefault();
    beginRenameWindow(slot, viewId);
  });

  /**
   * Swap the slot title for an inline text input to set this window's
   * ephemeral label. Commits on Enter/blur (empty clears the label), cancels
   * on Escape. The existing title spans are hidden (not removed) so the
   * subsequent updateSlot() — the single rendering path — can repaint them.
   */
  /** Repaint one window through the canonical path. */
  function repaintSlot(viewId: string): void {
    const liveSlot = document.querySelector<HTMLElement>(`.app-slot[data-view-id="${CSS.escape(viewId)}"]`);
    const liveView = views.find((x) => x.viewId === viewId);
    if (liveSlot && liveView) updateSlot(liveSlot, liveView);
  }

  /**
   * Set (or, with an empty name, clear) a window's user label and repaint.
   * Shared by the inline ✎ editor and the shell MCP's rename_window, so the
   * pill can never disagree with the map whichever side wrote it.
   */
  function setWindowName(viewId: string, raw: string): string | null {
    const name = raw.trim().slice(0, 60);
    if (name) windowNames.set(viewId, name);
    else      windowNames.delete(viewId);
    // Kept in the owning workspace (`activities`) so the name survives a
    // reload and an OS restart (lib/desktopSession.ts remaps it with the activity).
    patchActivityState(viewId, { name: name || undefined });
    repaintSlot(viewId);
    return windowNames.get(viewId) ?? null;
  }

  function beginRenameWindow(slot: HTMLElement, viewId: string): void {
    const titleEl = slot.querySelector('.slot-title') as HTMLElement | null;
    if (!titleEl || titleEl.querySelector('input[data-window-rename]')) return;
    const v = views.find((x) => x.viewId === viewId);

    const hidden = (Array.from(titleEl.children) as HTMLElement[]);
    hidden.forEach((k) => { k.dataset['renamePrev'] = k.style.display; k.style.display = 'none'; });

    const input = document.createElement('input');
    input.setAttribute('data-window-rename', '1');
    input.type = 'text';
    input.value = windowNames.get(viewId) ?? '';
    input.placeholder = v?.title ?? 'Window name';
    input.maxLength = 60;
    input.style.cssText =
      'flex:1;min-width:0;background:var(--aura-color-surface);border:var(--aura-border);'
      + 'color:var(--aura-color-primary);font:inherit;font-size:0.72rem;text-transform:none;'
      + 'letter-spacing:0.04em;padding:1px 6px;outline:none;';
    // Stop pointerdown reaching the chrome's stack-drag handler (which only
    // skips <button> targets, not inputs) so typing/selecting doesn't drag.
    input.addEventListener('pointerdown', (ev) => ev.stopPropagation());
    input.addEventListener('mousedown',   (ev) => ev.stopPropagation());

    let settled = false;
    const finish = (save: boolean) => {
      if (settled) return;
      settled = true;
      const name = input.value;
      input.remove();
      hidden.forEach((k) => { k.style.display = k.dataset['renamePrev'] ?? ''; delete k.dataset['renamePrev']; });
      // Repaint through the canonical path so the name pill reflects the edit.
      if (save) setWindowName(viewId, name);
      else      repaintSlot(viewId);
    };
    input.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter')       { ev.preventDefault(); finish(true); }
      else if (ev.key === 'Escape') { ev.preventDefault(); finish(false); }
    });
    input.addEventListener('blur', () => finish(true));

    titleEl.appendChild(input);
    input.focus();
    input.select();
  }

  function restoreView_(viewId: string) {
    setParked(viewId, false);
    views = views.map((v) =>
      v.viewId === viewId
        ? { ...v, state: 'normal' as const, isFocused: true }
        : { ...v, isFocused: false },
    );
    renderLayout();
    currentStrategy?.onActivate?.(viewId, layoutHost);
  }

  // After hydration, push the views through the JS pipeline so close/minimize/
  // SSE updates are wired up uniformly. The server-rendered slots of the active
  // workspace are adopted in place (same markup, lib/desktop/slotMarkup.ts) —
  // their iframes keep loading, nothing is rendered twice.
  //
  // Workspace state mutations (active switch, member edits made from another
  // tab / the Settings page, etc.) re-render the desktop — `inActiveWorkspace`
  // picks up the new filter via `workspaceClient.getCached()`. subscribe()
  // replays the hydrated state at once, which IS the boot render; render
  // explicitly only when there was nothing to replay.
  const hadWorkspaceState = workspaceClient.getCached() !== null;
  workspaceClient.subscribe(() => renderLayout());
  if (!hadWorkspaceState && views.length > 0) renderLayout();

  // Browser window resize changes every iframe's content box without a
  // renderLayout (the CSS Grid just reflows). Rebroadcast centrally so apps
  // re-fit; the double-rAF in queueViewportBroadcast coalesces the resize burst
  // and waits for the grid to settle before measuring. (The per-iframe RO also
  // catches this; the explicit call guarantees it.)
  window.addEventListener('resize', () => queueViewportBroadcast('layout'));

  (window as any).auraClose    = closeView_;
  (window as any).auraMinimize = minimizeView_;

  // -------- Focus mode --------
  /**
   * Focus any running instance or activity in the full-viewport overlay above the layout.
   * Pass instanceId for a plain instance view, or both (instanceId, activityId) for an activity.
   */
  async function focusInstance(instanceId: string, activityId?: string) {
    // Prefer focusing the EXISTING window in place — no reload. Only fall back
    // to the legacy overlay iframe (further down) when this instance/activity
    // has no live window to promote (e.g. a headless service with no slot).
    const view = activityId
      ? views.find((v) => v.activityId === activityId)
      : (views.find((v) => v.instanceId === instanceId && !v.activityId)
          ?? views.find((v) => v.instanceId === instanceId));
    if (view) {
      // If the window lives in another workspace, bring that workspace forward
      // so the promoted slot is actually on screen. The resulting refresh
      // re-renders the layout, which promotes the maximized slot once it
      // becomes visible.
      const ws = workspaceClient.getCached();
      if (ws) {
        const owner = ws.workspaces.find((w) => w.members.includes(view.viewId));
        if (owner && owner.id !== ws.activeWorkspaceId) {
          workspaceClient.setActive(owner.id).catch((err) => console.warn('[shell] setActive failed', err));
        }
      }
      // Un-minimize, then maximize in place (focuses + re-renders).
      if (view.state === 'minimized') {
        views = views.map((v) => v.viewId === view.viewId ? { ...v, state: 'normal' as const } : v);
      }
      maximizeView_(view.viewId);
      return;
    }

    // ── Fallback: no live window to reuse → mount the overlay iframe. This
    // path DOES load the app fresh, but there's nothing warm to promote. ──
    let title = instanceId;
    try {
      const res = await fetch(`/api/instances/${encodeURIComponent(instanceId)}/status`);
      if (res.ok) {
        const data = await res.json();
        title = data.instance?.appId ?? instanceId;
      }
    } catch {}

    focusedInstanceId = instanceId;
    focusedActivityId = activityId ?? null;
    const suffix = activityId ? `?_aura_activity=${encodeURIComponent(activityId)}` : '';
    focusFrame.src = `/api/proxy/${instanceId}/${suffix}`;
    focusTitleEl.textContent = title;
    focusInstIdEl.textContent = activityId ? `${instanceId}  ${activityId}` : instanceId;
    focusView.setAttribute('aria-hidden', 'false');
  }

  function exitFocus() {
    focusView.setAttribute('aria-hidden', 'true');
    focusFrame.src = 'about:blank';
    focusedInstanceId = null;
    focusedActivityId = null;
    // Drop back to windowed so the next focus session starts inside the
    // desktop area, not spanning the bars.
    setFocusFullscreen(false);
  }

  // Full-size toggle: lift the focus overlay above the status bar + dock so
  // the focused app spans the whole shell. The `[data-fullscreen="true"]`
  // CSS state switches the overlay to `position: fixed`, escaping the
  // #desktop grid cell (see the focus-view rules in the style block).
  function setFocusFullscreen(on: boolean) {
    focusView.setAttribute('data-fullscreen', on ? 'true' : 'false');
    focusFullscreenBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
    focusFullscreenBtn.innerHTML = on ? '<svg class="aura-icon" aria-hidden="true"><use href="/api/os/icons.svg#lucide-minimize"/></svg> EXIT FULL SIZE' : '<svg class="aura-icon" aria-hidden="true"><use href="/api/os/icons.svg#lucide-maximize"/></svg> FULL SIZE';
  }
  focusFullscreenBtn.addEventListener('click', () => {
    setFocusFullscreen(focusView.getAttribute('data-fullscreen') !== 'true');
  });

  focusExitBtn.addEventListener('click', exitFocus);

  // Esc-out-of-focus is contextual to the focus overlay, not an OS action.
  // Local DOM listener — only consumes the keystroke while the overlay is up,
  // so it doesn't compete with the dispatcher's `aura.nav.back` chain.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    // In-place maximize exits first (it's the common, no-reload focus path);
    // otherwise dismiss the legacy overlay if it's up.
    if (maximizedViewId !== null) {
      e.preventDefault();
      unmaximizeView_();
    } else if (focusedInstanceId !== null) {
      e.preventDefault();
      exitFocus();
    }
  });

  /** Remove all views belonging to an instance (called from Process Manager after close/kill). */
  function removeViewsByInstance(instanceId: string) {
    const dead = views.filter((v) => v.instanceId === instanceId);
    if (dead.some((v) => v.viewId === maximizedViewId)) maximizedViewId = null;
    views = views.filter((v) => v.instanceId !== instanceId);
    for (const v of dead) workspaceClient.removeMember(v.viewId).catch(() => undefined);
    if (focusedInstanceId === instanceId) exitFocus();
    renderLayout();
  }

  /** Remove a single activity view. */
  function removeViewByActivity(activityId: string) {
    const dead = views.find((v) => v.activityId === activityId);
    if (dead && dead.viewId === maximizedViewId) maximizedViewId = null;
    views = views.filter((v) => v.activityId !== activityId);
    workspaceClient.removeMember(activityId).catch(() => undefined);
    if (focusedActivityId === activityId) exitFocus();
    renderLayout();
  }

  // "Show" (Process Manager): reveal a window in its workspace WITHOUT going
  // fullscreen — switch to the owning workspace, focus it in place, and flash
  // the existing keyboard-select frame (border + ◉) on it for 1.5s.
  async function revealInstance(instanceId: string, activityId?: string) {
    const view = activityId
      ? views.find((v) => v.activityId === activityId)
      : (views.find((v) => v.instanceId === instanceId && !v.activityId)
          ?? views.find((v) => v.instanceId === instanceId));
    if (!view) return; // headless/no live window — nothing to show
    const ws = workspaceClient.getCached();
    const owner = ws?.workspaces.find((w) => w.members.includes(view.viewId)) ?? null;
    if (ws && owner && owner.id !== ws.activeWorkspaceId) {
      await workspaceClient.setActive(owner.id).catch((err) => console.warn('[shell] setActive failed', err));
    }
    // Never leave another window maximized over the one we're revealing.
    if (maximizedViewId && maximizedViewId !== view.viewId) { maximizedViewId = null; maximizedFull = false; }
    if (view.state === 'minimized') {
      views = views.map((v) => v.viewId === view.viewId ? { ...v, state: 'normal' as const } : v);
    }
