      ? document.querySelector<HTMLElement>(`.app-slot[data-activity-id="${CSS.escape(activityId)}"]`)
      : null;
    if (!slot && instanceId) slot = document.querySelector<HTMLElement>(`.app-slot[data-instance-id="${CSS.escape(instanceId)}"]`);
    // The owning workspace may still be rendering after setActive — retry a few frames.
    if ((!slot || slot.offsetParent === null) && tries < 30) {
      requestAnimationFrame(() => flashSelectFrame(activityId, instanceId, tries + 1));
      return;
    }
    if (!slot) return;
    const target = slot;
    // Same clear-then-set the keyboard window-nav uses.
    document.querySelectorAll('.app-slot[data-aura-nav-focus]').forEach((el) => el.removeAttribute('data-aura-nav-focus'));
    target.setAttribute('data-aura-nav-focus', 'true');
    target.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    window.setTimeout(() => {
      if (target.getAttribute('data-aura-nav-focus') === 'true') target.removeAttribute('data-aura-nav-focus');
    }, 1500);
  }

  // ── Process Manager "Show": tap = jump & stay; press-and-hold = peek while
