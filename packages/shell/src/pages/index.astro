      requestAnimationFrame(() => pmSetSelectFrame(activityId, instanceId, tries + 1));
      return;
    }
    if (!slot) return;
    document.querySelectorAll('.app-slot[data-aura-nav-focus]').forEach((el) => el.removeAttribute('data-aura-nav-focus'));
    slot.setAttribute('data-aura-nav-focus', 'true');
    slot.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  }
