  (window as any).auraViewState = (instanceId: string, activityId?: string) => viewDetail(instanceId, activityId)?.state ?? 'none';

  (window as any).auraFocusInstance        = focusInstance;
  (window as any).auraRevealInstance       = revealInstance;
  (window as any).auraRemoveViewsByInstance = removeViewsByInstance;
  (window as any).auraRemoveViewByActivity  = removeViewByActivity;

  // ── Shell UI commands (server → this page; see ../lib/uiCommands.ts) ─────
  // The desktop registers what only it can do: the live window list, focus,
  // close, reload, rename, launching into a workspace — and the workspace
  // operations, routed through workspaceClient so this page stays the single
  // writer of that state and the MCP never races the browser on the KV blob.
  const needView = (raw: unknown): AppView => {
    const id = String(raw ?? '');
    const v = views.find((x) => x.viewId === id);
    if (!v) throw new Error(`no window "${id}" is open`);
    return v;
  };
  const ownerOf = (viewId: string) =>
    workspaceClient.getCached()?.workspaces.find((w) => w.members.includes(viewId)) ?? null;

  registerUiCommand('launchApp', async ({ appId, workspaceId }) => {
    if (typeof appId !== 'string' || !appId) throw new Error('appId required');
    const wsId = typeof workspaceId === 'string' && workspaceId ? workspaceId : undefined;
    await (window as any).auraLaunchApp(appId, wsId ? { workspaceId: wsId } : undefined);
    return { launched: appId, workspaceId: wsId ?? workspaceClient.getCached()?.activeWorkspaceId ?? null };
  });
  registerUiCommand('focusWindow', async ({ viewId }) => {
    const v = needView(viewId);
    const ws = workspaceClient.getCached();
    const owner = ownerOf(v.viewId);
    // Bring the owning workspace forward first, exactly like focusInstance.
    if (ws && owner && owner.id !== ws.activeWorkspaceId) await workspaceClient.setActive(owner.id);
    focusView_(v.viewId);
    return { viewId: v.viewId, workspaceId: owner?.id ?? ws?.activeWorkspaceId ?? null };
  });
  registerUiCommand('closeWindow',  ({ viewId }) => { const v = needView(viewId); closeView_(v.viewId);   return { closed: v.viewId }; });
  registerUiCommand('reloadWindow', ({ viewId }) => { const v = needView(viewId); refreshView_(v.viewId); return { reloaded: v.viewId }; });
  registerUiCommand('renameWindow', ({ viewId, name }) => {
    const v = needView(viewId);
    return { viewId: v.viewId, name: setWindowName(v.viewId, typeof name === 'string' ? name : '') };
  });
  registerUiCommand('switchWorkspace', async ({ workspaceId }) => {
    const id = String(workspaceId ?? '');
    if (!workspaceClient.getCached()?.workspaces.some((w) => w.id === id)) throw new Error(`no workspace "${id}"`);
    await workspaceClient.setActive(id);
    return { workspaceId: id };
  });
  registerUiCommand('renameWorkspace', async ({ workspaceId, name }) => {
    const id = String(workspaceId ?? '');
    if (typeof name !== 'string' || !name.trim()) throw new Error('name required');
    await workspaceClient.patchWorkspace(id, { name: name.trim() });
    return { workspaceId: id, name: name.trim() };
  });
  registerUiCommand('newWorkspace', async ({ name }) => {
    const w = await workspaceClient.createWorkspace(typeof name === 'string' && name.trim() ? name.trim() : undefined);
    return { workspace: { id: w.id, name: w.name, layoutId: w.layoutId } };
  });
  registerUiCommand('lockScreen', ({ mode }) => {
    const w = window as { auraLockScreen?: () => void; auraUnlockScreen?: () => void; auraLockScreenActive?: () => boolean };
    if (mode === 'on') w.auraLockScreen?.(); else w.auraUnlockScreen?.();
    return { locked: w.auraLockScreenActive?.() ?? null };
  });
  registerSnapshotPart('desktop', () => {
    const ws = workspaceClient.getCached();
    return {
      activeWorkspaceId: ws?.activeWorkspaceId ?? null,
      focusedViewId: views.find((v) => v.isFocused)?.viewId ?? null,
      maximizedViewId,
      maximizedFull,
      navMode: keyDispatcher.getMode(),
      windows: views.map((v) => ({
        viewId: v.viewId, appId: v.appId, instanceId: v.instanceId, activityId: v.activityId ?? null,
        title: v.title, name: windowNames.get(v.viewId) ?? null, sessionLabel: v.sessionLabel ?? null,
        state: v.state, isFocused: v.isFocused, workspaceId: ownerOf(v.viewId)?.id ?? null,
      })),
    };
  });
  registerSnapshotPart('lockScreen', () => ({
    active: (window as { auraLockScreenActive?: () => boolean }).auraLockScreenActive?.() ?? null,
  }));
  startUiCommandListener();

  // SSE: live state updates per-instance / per-activity
  // Drive every `.sci-spinner` on the page through the | / - \ ASCII frame
  // cycle at ~120ms per frame. One global interval handles all instances —
  // newly-rendered skeletons (added by renderLayout/innerHTML) join the
  // rotation automatically since we query the DOM each tick.
  const SPINNER_FRAMES = ['|', '/', '-', '\\'];
  let spinnerFrame = 0;
  setInterval(() => {
    spinnerFrame = (spinnerFrame + 1) % SPINNER_FRAMES.length;
    const ch = SPINNER_FRAMES[spinnerFrame] as string;
    document.querySelectorAll('.sci-spinner').forEach((el) => {
      el.textContent = ch;
    });
  }, 120);

  // Desktop reacts to app/activity lifecycle + workspace changes (filter,
  // switch, member edits) over the shared socket.io channel. Theme + mode
  // events have their own listener wired in OSLayout. `activity:*` includes
  // the back-stack `activity:focus` event; `workspaces:*` is the bulk
  // update pushed by Settings when the user (or any other tab) edits the
  // list.
  // ---- OS restarts (lib/plannedRestart.ts, lib/desktopSession.ts) ----------
  // Before a planned restart every tab flushes what it has not written yet
  // (a live layout gesture, debounced workspace patches) and shows that the
  // OS is restarting; when the shell is back the page reloads onto the
  // restored desktop. A stop nobody announced (docker stop, a recreate) sends
  // the same warning from server.mjs; a crash sends none, so every reconnect
  // compares the boot id the page was served with (/api/os/about → session):
  // a new boot reloads once its restore is done, at most once per boot.
  function flushDesktopState(): void {
    try { currentStrategy?.saveState?.(layoutHost); } catch { /* best-effort */ }
  }
  window.addEventListener('beforeunload', () => {
    flushDesktopState();
    workspaceClient.flushPendingOnUnload();
  });
  let restartPending = false;
  function showRestartOverlay(restore: boolean): void {
    if (document.getElementById('aura-restart-overlay')) return;
    const el = document.createElement('div');
    el.id = 'aura-restart-overlay';
    el.setAttribute('role', 'status');
    el.style.cssText = 'position:fixed;inset:0;z-index:3000;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:color-mix(in srgb, var(--aura-color-bg) 88%, transparent);color:var(--aura-color-primary);font-family:var(--aura-font-mono);letter-spacing:0.12em;font-size:0.8rem;text-align:center;';
    el.innerHTML = '<div>// AURAOS IS RESTARTING</div><div style="color:var(--aura-color-text-dim);font-size:0.65rem;letter-spacing:0.08em">'
      + (restore ? 'your work comes back in a moment' : 'starting with an empty desktop') + '</div>'
      + '<div style="color:var(--aura-color-text-dim);font-size:0.6rem;letter-spacing:0.08em;opacity:0.7;margin-top:12px">double-click / double-tap to hide</div>';
    // Double-click / double-tap hides it: the desktop stays usable while the
    // OS restarts (the page still reloads by itself once the shell is back).
    el.addEventListener('dblclick', () => el.remove());
    let lastTap = 0;
    el.addEventListener('touchend', (e) => {
      const now = Date.now();
      if (now - lastTap < 350) { e.preventDefault(); el.remove(); }
      lastTap = now;
    });
    document.body.appendChild(el);
    // Never leave the desktop covered if the restart did not happen.
    setTimeout(() => { if (!restartPending) el.remove(); }, 5_000);
    setTimeout(() => el.remove(), 180_000);
  }
  let pageBootId: string | null = null;
  try { pageBootId = JSON.parse(document.getElementById('aura-boot')?.textContent ?? 'null')?.bootId ?? null; } catch { /* old page */ }
  const RELOADED_FOR_KEY = 'aura.reloadedForBoot';
