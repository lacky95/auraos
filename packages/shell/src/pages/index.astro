  function reloadForBoot(bootId: string): boolean {
    let done: string | null = null;
    try { done = sessionStorage.getItem(RELOADED_FOR_KEY); } catch { /* no storage */ }
    if (done === bootId) return false;
    try { sessionStorage.setItem(RELOADED_FOR_KEY, bootId); } catch { /* no storage */ }
