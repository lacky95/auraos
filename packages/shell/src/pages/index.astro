      const restoredIds = Object.values((ev.idMap ?? {}) as Record<string, string>);
      const missing = restoredIds.filter((id) => !views.some((v) => v.viewId === id));
      if (!missing.length) {
        try { currentStrategy?.onRestored?.(layoutHost, ev.idMap ?? {}); } catch { /* best-effort */ }
        return;
      }
