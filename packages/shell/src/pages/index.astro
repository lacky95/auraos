          if (r.ok) {
            const session = ((await r.json()) as { session?: { bootId?: string; restore?: string } }).session;
            // The same shell: a dropped connection only — unless a restart
            // was announced, then the shell is about to go down: keep waiting.
            if (session?.bootId && session.bootId === pageBootId) {
