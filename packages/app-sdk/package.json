{
  "name": "@aura/app-sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./integration": {
      "import": "./dist/integration.mjs"
    },
    "./proxy": {
      "import": "./dist/proxy.js",
      "types": "./dist/proxy.d.ts"
    },
    "./runtime/next": {
      "import": "./dist/runtime/next.js",
      "types": "./dist/runtime/next.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/integration.mjs','dist/integration.mjs')\"",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@aura/core": "workspace:*"
  },
  "peerDependencies": {
    "astro": "^4 || ^5 || ^6",
    "next": "^15"
  },
  "peerDependenciesMeta": {
    "astro": { "optional": true },
    "next":  { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0",
    "astro": "^6"
  }
}
