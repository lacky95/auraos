node_modules/
dist/
.astro/
*.log
.DS_Store

# Runtime data, never source. In the user and global scopes this directory is
# also where the app's instances keep their data: /data of instance <id> is
# <id>/ here ({{APP_ID}}/, {{APP_ID}}-2/, …) and sidecar volumes are
# .sidecars/<service>/<volume> (logins, databases). `aura dev publish` refuses
# while any of it is tracked.
/{{APP_ID}}/
/{{APP_ID}}-[0-9]*/
.sidecars/
/.data/

# Credentials and local databases
.env
.env.*
!.env.example
secrets.json
auth.json
.credentials.json
.claude.json
*.db
*.db-*
*.sqlite
*.sqlite3
