{
  "name": "@aura/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./theme": {
      "import": "./dist/theme/index.js",
      "types": "./dist/theme/index.d.ts"
    },
    "./keymap": {
      "import": "./dist/keymap/index.js",
      "types": "./dist/keymap/index.d.ts"
    },
    "./logger": {
      "import": "./dist/logger.js",
      "types": "./dist/logger.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/identity-routing.test.mjs test/container-volume.test.mjs test/updater-script.test.mjs test/intent-resolver.test.mjs test/interface-registry.test.mjs test/store-entry.test.mjs test/store-assets.test.mjs"
  },
  "dependencies": {
    "@aura/kv-store": "workspace:*",
    "chokidar": "^3.6.0",
    "eventemitter3": "^5.0.1",
    "node-fetch": "^3.3.2",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}
